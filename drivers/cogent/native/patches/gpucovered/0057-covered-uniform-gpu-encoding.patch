+func TestVellumScenePlanGPUCoveredMixedOracle(t *testing.T) {
+	random := rand.New(rand.NewSource(9057))
+	for trial := 0; trial < 100; trial++ {
+		// The independent expected stream is an existing mixed fixture. Only explicit
+		// inserted clears are removable; all other original mask/pixel/span bytes stay.
+		want := stagingFixture(129, true)
+		expanded := *want
+		expanded.ops = nil
+		removed := 0
+		for _, o := range want.ops {
+			if o.kind == Uniform && o.op == draw.Over && o.color[3] == 65535 {
+				clear := o
+				clear.op = draw.Src
+				clear.color = [4]uint32{0, 0, 0, 0}
+				expanded.ops = append(expanded.ops, clear)
+				removed++
+			}
+			expanded.ops = append(expanded.ops, o)
+		}
+		original, ok := expanded.Encode()
+		if !ok {
+			t.Fatal("original refused")
+		}
+		before := stagingDigest(&expanded)
+		e, ok := expanded.EncodeGPU()
+		oracle, _ := want.Encode()
+		if !ok || !reflect.DeepEqual(e, oracle) || removed == 0 {
+			t.Fatal("compact ABI differs from independent original stream", trial)
+		}
+		if len(e.Ops) != len(original.Ops)-removed*opWords*4 {
+			t.Fatal("no exact operation reduction")
+		}
+		seed := image.NewRGBA(want.bounds)
+		random.Read(seed.Pix)
+		got := image.NewRGBA(seed.Rect)
+		copy(got.Pix, seed.Pix)
+		if !expanded.Replay(seed) {
+			t.Fatal("original replay refused")
+		}
+		replayEncodedGPU(t, e, got)
+		if !bytes.Equal(got.Pix, seed.Pix) {
+			t.Fatal("serialized tile execution changed pixels", trial)
+		}
+		// A second encoding is detached from both the packet and a previous encoding.
+		saved := append([]byte(nil), e.Refs...)
+		clear(e.Ops)
+		again, _ := expanded.EncodeGPU()
+		if !reflect.DeepEqual(again, oracle) || !bytes.Equal(e.Refs, saved) || stagingDigest(&expanded) != before || expanded.Independent() != want.Independent() {
+			t.Fatal("encoding mutated packet or held result")
+		}
+	}
+}

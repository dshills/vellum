+func TestVellumScenePlanGPUCoveredOriginalLimits(t *testing.T) {
+	bounds := image.Rect(0, 0, 8192, 2048)
+	for _, n := range []int{32, 33} {
+		b := New(bounds)
+		for i := 0; i < n; i++ {
+			b.Draw(bounds, image.White, image.Point{}, nil, image.Point{}, draw.Op(1-i%2))
+		}
+		p := b.Seal(false)
+		if p == nil {
+			t.Fatal("bounded builder unexpectedly refused")
+		}
+		_, oldOK := p.Encode()
+		e, newOK := p.EncodeGPU()
+		if oldOK != newOK || newOK != (n == 32) {
+			t.Fatal("original tile-reference admission changed", n)
+		}
+		if newOK && len(e.Ops) != 16*opWords*4 {
+			t.Fatal("exact reference boundary not compacted")
+		}
+	}
+	// A real builder packet fits retained bytes but exceeds encoded bytes because
+	// tile references and headers add to a large image+mask. Covered draws cannot
+	// rescue this refusal. Mask snapshots are charged by their full validated size.
+	bounds = image.Rect(0, 0, 3072, 2048)
+	b := New(bounds)
+	for i := 0; i < 42; i++ {
+		b.Draw(bounds, image.White, image.Point{}, nil, image.Point{}, draw.Op(1-i%2))
+	}
+	img := image.NewRGBA(bounds)
+	mask := image.NewAlpha(image.Rect(0, 0, 2048, 2048))
+	b.Draw(image.Rect(0, 0, 1, 1), image.White, image.Point{}, mask, image.Point{}, draw.Over)
+	b.Draw(bounds, img, image.Point{}, nil, image.Point{}, draw.Src)
+	p := b.Seal(false)
+	if p == nil || p.Bytes() > MaxBytes {
+		t.Fatal("retained-byte fixture refused")
+	}
+	if _, ok := p.Encode(); ok {
+		t.Fatal("original encoded-byte fixture did not refuse")
+	}
+	if _, ok := p.EncodeGPU(); ok {
+		t.Fatal("covered clear revived encoded-byte refusal")
+	}
+	for _, count := range []int{MaxOps, MaxOps + 1} {
+		b := New(image.Rect(0, 0, 1, 1))
+		for i := 0; i < count; i++ {
+			b.Draw(b.packet.bounds, image.White, image.Point{}, nil, image.Point{}, draw.Op(1-i%2))
+		}
+		p := b.Seal(false)
+		if count > MaxOps {
+			if p != nil {
+				t.Fatal("logical op limit revived")
+			}
+			continue
+		}
+		e, ok := p.EncodeGPU()
+		if !ok || p.Operations() != MaxOps || len(e.Ops) != MaxOps/2*opWords*4 {
+			t.Fatal("exact op limit changed")
+		}
+	}
+	b = New(image.Rect(0, 0, 1, 1))
+	b.packet.bytes = MaxBytes - int(unsafe.Sizeof(operation{}))
+	b.Draw(b.packet.bounds, image.Black, image.Point{}, nil, image.Point{}, draw.Src)
+	b.Draw(b.packet.bounds, image.White, image.Point{}, nil, image.Point{}, draw.Over)
+	if !b.Failed() || b.Seal(false) != nil {
+		t.Fatal("covered clear revived builder byte refusal")
+	}
+}

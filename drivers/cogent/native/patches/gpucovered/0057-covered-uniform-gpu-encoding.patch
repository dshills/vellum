+func TestVellumScenePlanGPUCoveredBoundaries(t *testing.T) {
+	bounds := image.Rect(0, 0, 35, 33)
+	for _, tc := range []struct {
+		name            string
+		rect            image.Rectangle
+		alpha           uint16
+		op              draw.Op
+		mask, interrupt bool
+		removed         int
+	}{
+		{"opaque", image.Rect(1, 2, 20, 19), 65535, draw.Over, false, false, 1},
+		{"clipped", image.Rect(-4, -2, 40, 37), 65535, draw.Over, false, false, 1},
+		{"full-default", image.Rectangle{}, 65535, draw.Over, false, false, 1},
+		{"almost-opaque", bounds, 65534, draw.Over, false, false, 0},
+		{"src", bounds, 65535, draw.Src, false, false, 0},
+		{"masked", bounds, 65535, draw.Over, true, false, 0},
+		{"intervening-span", bounds, 65535, draw.Over, false, true, 0},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			b := New(bounds)
+			u := image.NewUniform(color.NRGBA64{17, 31, 63, 511})
+			b.Draw(tc.rect, u, image.Pt(7, 9), nil, image.Pt(-2, 3), draw.Src)
+			if tc.interrupt {
+				b.BeginSpans(color.RGBA{1, 3, 5, 7}, draw.Over)
+				b.Span(4, 0, 5, 32768)
+			}
+			var mask image.Image
+			if tc.mask {
+				m := image.NewAlpha(bounds)
+				for i := range m.Pix {
+					m.Pix[i] = 255
+				}
+				mask = m
+			}
+			b.Draw(tc.rect, image.NewUniform(color.NRGBA64{333, 1777, 6333, tc.alpha}), image.Pt(-7, -9), mask, image.Point{}, tc.op)
+			p := b.Seal(true)
+			if p == nil {
+				t.Fatal("valid fixture refused")
+			}
+			u.C = color.RGBA{255, 0, 0, 255}
+			old, ok := p.Encode()
+			if !ok {
+				t.Fatal("original encode refused")
+			}
+			e, ok := p.EncodeGPU()
+			if !ok || len(e.Ops) != len(old.Ops)-tc.removed*opWords*4 {
+				t.Fatal("wrong compact operation count")
+			}
+			seed := image.NewRGBA(bounds)
+			for i := range seed.Pix {
+				seed.Pix[i] = byte(i*71 + 3)
+			}
+			got := image.NewRGBA(bounds)
+			copy(got.Pix, seed.Pix)
+			p.Replay(seed)
+			replayEncodedGPU(t, e, got)
+			if !bytes.Equal(seed.Pix, got.Pix) {
+				t.Fatal("boundary serialized pixels changed")
+			}
+			if tc.removed == 0 && !reflect.DeepEqual(e, old) {
+				t.Fatal("ineligible pair encoded bytes changed")
+			}
+		})
+	}
+	empty := New(bounds).Seal(false)
+	a, _ := empty.Encode()
+	b, _ := empty.EncodeGPU()
+	if !reflect.DeepEqual(a, b) {
+		t.Fatal("empty encoding changed")
+	}
+	var nilPacket *Packet
+	if e, ok := nilPacket.EncodeGPU(); e != nil || ok {
+		t.Fatal("nil packet admitted")
+	}
+	// Unequal rectangles and Src/Src/Over chains only drop the final covered Src.
+	bld := New(bounds)
+	bld.Draw(bounds, image.Black, image.Point{}, nil, image.Point{}, draw.Src)
+	bld.Draw(bounds.Inset(1), image.Black, image.Point{}, nil, image.Point{}, draw.Src)
+	bld.Draw(bounds.Inset(1), image.White, image.Point{}, nil, image.Point{}, draw.Over)
+	p := bld.Seal(false)
+	e, _ := p.EncodeGPU()
+	if len(e.Ops) != 2*opWords*4 || p.Operations() != 3 || !p.Independent() {
+		t.Fatal("chain changed original accounting/reset")
+	}
+}

+func TestVellumGPUSceneNativeCoveredUniforms(t *testing.T) {
+	_, dev := nativeDevice(t)
+	size := image.Pt(35, 33)
+	res := &resources{}
+	defer res.release()
+	reserve := func(n uint64) error {
+		if n > 128<<20 {
+			return fmt.Errorf("test budget")
+		}
+		return nil
+	}
+	if err := res.initialize(dev, size, reserve); err != nil {
+		t.Fatal(err)
+	}
+	want := image.NewRGBA(image.Rectangle{Max: size})
+	for frame := 0; frame < 12; frame++ {
+		b := sceneplan.New(want.Rect)
+		rect := image.Rect(frame%7, frame%5, 27, 29)
+		if frame == 0 {
+			rect = want.Rect
+		}
+		b.Draw(rect, image.NewUniform(color.RGBA{1, 3, 5, 7}), image.Point{}, nil, image.Point{}, draw.Src)
+		b.Draw(rect, image.NewUniform(color.NRGBA64{333, 1777, 6333, 65535}), image.Point{}, nil, image.Point{}, draw.Over)
+		b.BeginSpans(color.RGBA{13, 19, 31, 71}, draw.Over)
+		b.Span(2, 0, 31, 32767)
+		p := b.Seal(frame%2 == 0)
+		if p == nil {
+			t.Fatal("fixture refused")
+		}
+		original, ok := p.Encode()
+		if !ok {
+			t.Fatal("original encoding refused")
+		}
+		encoded, ok := p.EncodeGPU()
+		if !ok || len(encoded.Ops) != len(original.Ops)-64 {
+			t.Fatal("covered pair was not compacted")
+		}
+		if err := res.render(encoded, reserve); err != nil {
+			t.Fatal(err)
+		}
+		p.Replay(want)
+		got := readTexture(t, dev, res.texture)
+		if !bytes.Equal(got.Pix, want.Pix) {
+			t.Fatal("native compacted partial output differs", frame)
+		}
+	}

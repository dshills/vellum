+// Copyright (c) 2026, Davin Hills. SPDX-License-Identifier: MIT
+package sceneplan
+
+import (
+	"image"
+	"image/draw"
+	"unsafe"
+)
+
+// MaskResource owns a detached, immutable snapshot. No accessor exposes its
+// image or pixels; builders and live packets may share it after owner eviction.
+type MaskResource struct{ mask *image.Alpha }
+
+func NewMaskResource(source *image.Alpha) *MaskResource {
+	if source == nil || !validAlpha(source) {
+		return nil
+	}
+	r := source.Rect
+	if r.Dx()*r.Dy() > MaxBytes-int(unsafe.Sizeof(image.Alpha{}))-int(unsafe.Sizeof(MaskResource{})) {
+		return nil
+	}
+	own := image.NewAlpha(image.Rectangle{Max: r.Size()})
+	for y := 0; y < r.Dy(); y++ {
+		copy(own.Pix[y*own.Stride:], source.Pix[source.PixOffset(r.Min.X, r.Min.Y+y):][:r.Dx()])
+	}
+	return &MaskResource{mask: own}
+}
+func (m *MaskResource) Bytes() int {
+	if m == nil || m.mask == nil {
+		return 0
+	}
+	return len(m.mask.Pix) + int(unsafe.Sizeof(image.Alpha{})) + int(unsafe.Sizeof(MaskResource{}))
+}
+
+// DrawMaskResource has Draw's uniform-source mask semantics. Positions use the
+// snapshot's zero origin. The resource is charged once per packet even though
+// its immutable backing may also be retained by an originating renderer.
+func (b *Builder) DrawMaskResource(rect image.Rectangle, source image.Image, resource *MaskResource, mp image.Point, op draw.Op) {
+	b.flush()
+	c, ok := Color(source)
+	if b.failed || !ok || resource == nil || resource.mask == nil || (op != draw.Src && op != draw.Over) || mp.X < -1<<20 || mp.X > 1<<20 || mp.Y < -1<<20 || mp.Y > 1<<20 {
+		b.Refuse()
+		return
+	}
+	if rect == (image.Rectangle{}) {
+		rect = b.packet.bounds
+	}
+	original := rect
+	if !validRect(original) {
+		b.Refuse()
+		return
+	}
+	rect = rect.Intersect(b.packet.bounds).Intersect(resource.mask.Rect.Add(original.Min.Sub(mp)))
+	if rect.Empty() {
+		return
+	}
+	if !b.maskResources[resource] {
+		if !b.reserve(resource.Bytes()) {
+			return
+		}
+		if b.maskResources == nil {
+			b.maskResources = make(map[*MaskResource]bool)
+		}
+		b.maskResources[resource] = true
+	}
+	b.add(operation{rect: rect, kind: Mask, op: op, color: c, mask: resource.mask, maskPos: mp.Add(rect.Min.Sub(original.Min))})
+}

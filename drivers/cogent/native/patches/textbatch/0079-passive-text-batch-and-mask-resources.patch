+func TestMaskResourceDetachedClippedAndStable(t *testing.T) {
+	source := image.NewAlpha(image.Rect(3, 4, 11, 13))
+	for i := range source.Pix {
+		source.Pix[i] = byte(i * 13)
+	}
+	resource := NewMaskResource(source)
+	if resource == nil {
+		t.Fatal("snapshot refused")
+	}
+	bounds := image.Rect(0, 0, 30, 30)
+	b := New(bounds)
+	reference := New(bounds)
+	fill := image.NewUniform(color.NRGBA{R: 230, G: 61, B: 82, A: 191})
+	// Original Draw's mp is in source coordinates. Resource mp uses zero origin.
+	for _, r := range []image.Rectangle{image.Rect(-2, 1, 8, 11), image.Rect(7, 8, 18, 20), image.Rect(22, 24, 35, 39)} {
+		b.DrawMaskResource(r, fill, resource, image.Pt(1, 2), draw.Over)
+		reference.Draw(r, fill, image.Point{}, source, image.Pt(4, 6), draw.Over)
+	}
+	p, q := b.Seal(false), reference.Seal(false)
+	if p == nil || q == nil {
+		t.Fatal("refused")
+	}
+	// Mutating caller-owned bytes or dropping originating references cannot change
+	// sealed packet pixels or legacy wire output.
+	clear(source.Pix)
+	source = nil
+	resource = nil
+	a, z := image.NewRGBA(bounds), image.NewRGBA(bounds)
+	p.Replay(a)
+	q.Replay(z)
+	if !bytes.Equal(a.Pix, z.Pix) {
+		t.Fatal("detached mask/clipping mismatch")
+	}
+	x, ok := p.Encode()
+	y, ok2 := q.Encode()
+	if !ok || !ok2 || !bytes.Equal(x.Ops, y.Ops) || !bytes.Equal(x.Data, y.Data) || !bytes.Equal(x.Rows, y.Rows) || !bytes.Equal(x.Refs, y.Refs) {
+		t.Fatal("legacy encoding differs")
+	}
+	if b.DrawMaskResource(image.Rect(0, 0, 2, 2), fill, NewMaskResource(image.NewAlpha(image.Rect(0, 0, 2, 2))), image.Point{}, draw.Over); !b.Failed() {
+		t.Fatal("retired builder accepted mutation")
+	}
+}
+func TestMaskResourceAdmissionAndRecovery(t *testing.T) {
+	for _, a := range []*image.Alpha{nil, {Rect: image.Rect(0, 0, 4, 4), Stride: 1, Pix: make([]byte, 4)}} {
+		if NewMaskResource(a) != nil {
+			t.Fatal("malformed mask admitted")
+		}
+	}
+	r := NewMaskResource(image.NewAlpha(image.Rect(0, 0, 4, 4)))
+	b := New(image.Rect(0, 0, 8, 8))
+	b.packet.bytes = MaxBytes - r.Bytes() + 1
+	b.DrawMaskResource(image.Rect(0, 0, 4, 4), image.White, r, image.Point{}, draw.Over)
+	if b.Seal(false) != nil {
+		t.Fatal("overbudget packet accepted")
+	}
+	b = New(image.Rect(0, 0, 8, 8))
+	b.DrawMaskResource(image.Rect(0, 0, 4, 4), image.White, r, image.Point{}, draw.Over)
+	first := b.packet.bytes
+	b.DrawMaskResource(image.Rect(4, 0, 8, 4), image.White, r, image.Point{}, draw.Over)
+	if b.packet.bytes-first != int(unsafe.Sizeof(operation{})) {
+		t.Fatal("resource was charged more than once")
+	}
+	if b.Seal(false) == nil {
+		t.Fatal("fresh recovery failed")
+	}
+}

+func TestGlyphMaskResourceBoundsEvictionAndRetirement(t *testing.T) {
+	for _, size := range []int{8, 128} {
+		cache := &glyphMaskResourceCache{}
+		source := image.NewAlpha(image.Rect(0, 0, size, size))
+		for i := range source.Pix {
+			source.Pix[i] = 127
+		}
+		resource := cache.get(source)
+		if resource == nil || cache.get(source) != resource || cache.hits != 1 {
+			t.Fatal("warm identity miss")
+		}
+		b := sceneplan.New(image.Rect(0, 0, 256, 256))
+		b.DrawMaskResource(image.Rect(5, 6, size+5, size+6), image.White, resource, image.Point{}, draw.Over)
+		packet := b.Seal(false)
+		before := image.NewRGBA(packet.Bounds())
+		packet.Replay(before)
+		for range glyphMaskResourceEntries + 1 {
+			cache.get(image.NewAlpha(image.Rect(0, 0, size, size)))
+		}
+		if cache.entries[source] != nil || cache.count > glyphMaskResourceEntries || cache.bytes > glyphMaskResourceBytes {
+			t.Fatal("unbounded mask retention")
+		}
+		after := image.NewRGBA(packet.Bounds())
+		packet.Replay(after)
+		if !bytes.Equal(before.Pix, after.Pix) {
+			t.Fatal("eviction changed live packet")
+		}
+	}
+	rs := New(math32.Vec2(32, 32)).(*Renderer)
+	rs.maskResources().get(image.NewAlpha(image.Rect(0, 0, 4, 4)))
+	rs.SetSize(0, math32.Vec2(33, 32))
+	if rs.glyphMasks != nil {
+		t.Fatal("resize retained masks")
+	}
+	rs.maskResources().get(image.NewAlpha(image.Rect(0, 0, 4, 4)))
+	rs.Release()
+	rs.Release()
+	if rs.glyphMasks != nil {
+		t.Fatal("release retained masks")
+	}
+}

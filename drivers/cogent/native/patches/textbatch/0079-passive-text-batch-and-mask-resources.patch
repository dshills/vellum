+// TextBatchRenderer admits this transient command form. Other renderers retain
+// ordinary Text commands. Shapes have the same borrowed lifetime as NewText;
+// no layout identity or immutability is inferred across frames.
+type TextBatchRenderer interface{ SupportsTextBatch() bool }
+
+type TextEntry struct {
+	Text     *shaped.Lines
+	Position math32.Vector2
+	Bounds   image.Rectangle
+}
+
+type TextBatch struct {
+	context Context
+	entries []TextEntry
+}
+
+func NewTextBatch(parent *Context) *TextBatch {
+	// Reproduce StartRender's default cell context followed by NewText's context.
+	// Every eligible cell has a rectangular, zero-radius clip.
+	cell := NewContext(nil, &parent.Bounds, parent)
+	var defaults styles.Paint
+	defaults.Defaults()
+	batch := &TextBatch{}
+	batch.context.Init(&defaults, nil, cell)
+	return batch
+}
+func (b *TextBatch) Add(lines *shaped.Lines, position math32.Vector2, bounds image.Rectangle) {
+	b.entries = append(b.entries, TextEntry{lines, position, bounds})
+}
+func (b *TextBatch) Len() int {
+	if b == nil {
+		return 0
+	}
+	return len(b.entries)
+}
+func (b *TextBatch) At(i int) Text {
+	e := b.entries[i]
+	t := Text{Text: e.Text, Position: e.Position, Context: b.context}
+	t.Context.Bounds = Bounds{Rect: math32.B2FromRect(e.Bounds)}
+	return t
+}
+func (*TextBatch) IsRenderItem()    {}
+func (b *TextBatch) String() string { return fmt.Sprintf("passive text batch: %d", b.Len()) }

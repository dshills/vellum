+// Copyright (c) 2026, Davin Hills. SPDX-License-Identifier: MIT
+package rasterx
+
+import (
+	"cogentcore.org/core/paint/renderers/sceneplan"
+	"image"
+	"unsafe"
+)
+
+const glyphMaskResourceEntries = 1024
+const glyphMaskResourceBytes = 8 << 20
+
+type glyphMaskResourceEntry struct {
+	source   *image.Alpha
+	resource *sceneplan.MaskResource
+	bytes    int
+}
+
+// Keys come exclusively from the private immutable bitmap glyph cache. Account
+// for both the strongly retained original backing and the detached snapshot.
+// No font, layout, painter, packet or application references are retained.
+type glyphMaskResourceCache struct {
+	entries            map[*image.Alpha]*glyphMaskResourceEntry
+	queue              [glyphMaskResourceEntries]*glyphMaskResourceEntry
+	head, count, bytes int
+	hits, misses       uint64
+}
+
+func (rs *Renderer) maskResources() *glyphMaskResourceCache {
+	if rs.glyphMasks == nil {
+		rs.glyphMasks = &glyphMaskResourceCache{}
+	}
+	return rs.glyphMasks
+}
+func (c *glyphMaskResourceCache) get(mask *image.Alpha) *sceneplan.MaskResource {
+	if e := c.entries[mask]; e != nil {
+		c.hits++
+		return e.resource
+	}
+	c.misses++
+	if mask == nil || mask.Rect.Min != (image.Point{}) || mask.Rect.Dx() > glyphMaxSize || mask.Rect.Dy() > glyphMaxSize {
+		return nil
+	}
+	resource := sceneplan.NewMaskResource(mask)
+	if resource == nil {
+		return nil
+	}
+	cost := len(mask.Pix) + int(unsafe.Sizeof(image.Alpha{})) + resource.Bytes() + int(unsafe.Sizeof(glyphMaskResourceEntry{}))
+	if cost > glyphMaskResourceBytes {
+		return nil
+	}
+	for c.count > 0 && (c.count == glyphMaskResourceEntries || c.bytes+cost > glyphMaskResourceBytes) {
+		e := c.queue[c.head]
+		delete(c.entries, e.source)
+		c.bytes -= e.bytes
+		c.queue[c.head] = nil
+		c.head = (c.head + 1) % glyphMaskResourceEntries
+		c.count--
+	}
+	if c.entries == nil {
+		c.entries = make(map[*image.Alpha]*glyphMaskResourceEntry)
+	}
+	e := &glyphMaskResourceEntry{mask, resource, cost}
+	c.entries[mask] = e
+	c.queue[(c.head+c.count)%glyphMaskResourceEntries] = e
+	c.count++
+	c.bytes += cost
+	return resource
+}

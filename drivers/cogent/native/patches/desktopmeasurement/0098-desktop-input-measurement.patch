+func TestVellumFrameTraceGroupUnsupportedPrefixRetainsFinalStageSum(t *testing.T) {
+	tr := &FrameTrace{}
+	first, second := &events.CustomEvent{}, &events.CustomEvent{}
+	if err := tr.BeginGroup(41, []events.Event{first, second}); err != nil {
+		t.Fatal(err)
+	}
+	tag, start := tr.startEvent(first)
+	tr.endEvent(tag, start)
+	tr.GroupOwnerWork(41, 7)
+	tr.Reconciled(41, 11)
+	if tr.startFrame() != 41 {
+		t.Fatal("missing prefix frame")
+	}
+	tr.frameWork(41, 13, 17)
+	tr.finishFrame(41, composer.ComposeTiming{Failure: "unsupported compositor", RasterUploadNS: 19, EncodeSubmitNS: 23})
+	if tr.GroupReady(41) {
+		t.Fatal("known earlier failure reached acceptance gate")
+	}
+	if _, ok := tr.Take(); ok {
+		t.Fatal("prefix failure released original input/owner reservation")
+	}
+	tag, start = tr.startEvent(second)
+	tr.endEvent(tag, start)
+	tr.GroupOwnerWork(41, 29)
+	tr.pending.InputNS = 31 // Controlled total; this is not an actual CPU measurement.
+	got, ok := tr.Take()
+	if !ok || got.Completed || got.Failure != "unsupported compositor" || got.OwnerNS != 36 || got.TotalUIWorkNS != 150 {
+		t.Fatalf("late terminal work omitted %+v/%v", got, ok)
+	}

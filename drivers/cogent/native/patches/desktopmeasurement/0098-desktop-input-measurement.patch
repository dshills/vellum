+// BeginGroup traces one bounded originating FIFO input group. Unlike Begin,
+// owner/reconcile completion cannot arm this transaction until CommitGroup.
+// Callers must supply actual event identities, then close the checked owner
+// drain with GroupOwnerWork. No event, callback or generation is manufactured.
+func (trace *FrameTrace) BeginGroup(tag uint64, group []events.Event) error {
+	if tag == 0 || len(group) == 0 || len(group) > 4 {
+		return errors.New("core: invalid traced input group")
+	}
+	for i, e := range group {
+		if e == nil || reflect.ValueOf(e).Kind() != reflect.Pointer || reflect.ValueOf(e).IsNil() {
+			return errors.New("core: invalid traced input group")
+		}
+		for _, earlier := range group[:i] {
+			if earlier == e {
+				return errors.New("core: duplicate traced input")
+			}
+		}
+	}
+	trace.mu.Lock()
+	defer trace.mu.Unlock()
+	if trace.pending != nil {
+		return ErrFrameTraceBusy
+	}
+	trace.pending = &frameTracePending{FrameTraceSample: FrameTraceSample{Tag: tag}, group: append([]events.Event(nil), group...), transaction: true, ownerExpected: true, queued: time.Now()}
+	return nil
+}
+
+// GroupOwnerWork accumulates observed originating owner drains after dispatch
+// has begun. Only a drain after the final input closes the owner terminal;
+// intermediate work cannot arm a composition or assert an application transition.
+func (trace *FrameTrace) GroupOwnerWork(tag uint64, duration int64) {
+	if trace == nil || tag == 0 {
+		return
+	}
+	trace.mu.Lock()
+	defer trace.mu.Unlock()
+	if p := trace.pending; p != nil && p.Tag == tag && p.transaction && p.groupDone > 0 && !p.armed {
+		p.OwnerNS += duration
+		if p.inputDone {
+			p.ownerDone = true
+		}
+	}
+}
+
+// CommitGroup arms only a checked reconciled view generation. The caller must
+// independently validate accepted application state before committing, while
+// holding event/render ownership. A previous composition remains unarmed.
+func (trace *FrameTrace) CommitGroup(tag, generation uint64) error {
+	trace.mu.Lock()
+	defer trace.mu.Unlock()
+	if !trace.groupReadyLocked(tag) || generation == 0 {
+		return errors.New("core: traced input group is not reconciled")
+	}
+	p := trace.pending
+	p.Generation = generation
+	p.transition = true
+	p.armed = true
+	return nil
+}
+
+// GroupReady checks the actual original group/owner/reconcile terminals and
+// excludes a known earlier failure or in-flight composition before app-state
+// observation. This is not a reservation: CommitGroup rechecks the same gate.
+func (trace *FrameTrace) GroupReady(tag uint64) bool {
+	if trace == nil || tag == 0 {
+		return false
+	}
+	trace.mu.Lock()
+	defer trace.mu.Unlock()
+	return trace.groupReadyLocked(tag)
+}
+func (trace *FrameTrace) groupReadyLocked(tag uint64) bool {
+	p := trace.pending
+	return p != nil && p.Tag == tag && p.transaction && p.inputDone && p.ownerDone && p.reconciled && !p.ready && !p.armed && !p.rendering
+}

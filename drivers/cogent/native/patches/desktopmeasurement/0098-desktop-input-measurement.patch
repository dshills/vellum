+// Controlled composition terminals, never real native callback evidence.
+func TestVellumFrameTraceGroupCausalOwnerReconcileAndNoRetroactiveArm(t *testing.T) {
+	tr := &FrameTrace{}
+	first, second := &events.CustomEvent{}, &events.CustomEvent{}
+	if err := tr.BeginGroup(21, []events.Event{first, second}); err != nil {
+		t.Fatal(err)
+	}
+	if err := tr.CommitGroup(21, 8); err == nil {
+		t.Fatal("armed before original events")
+	}
+	// Admission/setup before any original dispatch is outside this group.
+	tr.GroupOwnerWork(21, 101)
+	tr.Reconciled(21, 103)
+	if tr.OwnerTag() != 0 || tr.ReconcileTag() != 0 || tr.startFrame() != 0 || tr.GroupReady(21) || tr.pending.OwnerNS != 0 || tr.pending.ReconcileNS != 0 {
+		t.Fatal("pre-input work was counted")
+	}
+	tag, start := tr.startEvent(first)
+	tr.endEvent(tag, start)
+	if tr.OwnerTag() != 21 || tr.ReconcileTag() != 21 {
+		t.Fatal("intermediate accounting unavailable")
+	}
+	tr.GroupOwnerWork(21, 11)
+	tr.Reconciled(21, 13)
+	if tr.pending.ownerDone || tr.pending.inputDone || tr.pending.armed {
+		t.Fatal("group terminal before all events")
+	}
+	if err := tr.CommitGroup(21, 8); err == nil {
+		t.Fatal("intermediate work armed a composition")
+	}
+	if tr.pending.OwnerNS != 11 || tr.pending.ReconcileNS != 13 {
+		t.Fatal("intermediate work omitted")
+	}
+	// A supported real-prefix terminal is controlled here, never native proof.
+	if tr.startFrame() != 21 || tr.pending.frameArmed {
+		t.Fatal("missing unarmed between-event frame")
+	}
+	if tag, generation, armed := tr.presentationStamp(21); tag != 21 || generation != 0 || armed {
+		t.Fatal("intermediate frame acquired final identity", tag, generation, armed)
+	}
+	tr.frameWork(21, 3, 5)
+	tr.finishFrame(21, composer.ComposeTiming{Supported: true, Submitted: true, RasterUploadNS: 7, EncodeSubmitNS: 11, AcquireNS: 13, PresentCallNS: 17})
+	if tr.GroupReady(21) {
+		t.Fatal("prefix frame made original group complete")
+	}
+	tag, start = tr.startEvent(second)
+	tr.endEvent(tag, start)
+	if tr.OwnerTag() != 21 {
+		t.Fatal("missing original dispatch terminal")
+	}
+	if tag := tr.startFrame(); tag != 21 {
+		t.Fatal("missing intermediate tag")
+	}
+	tr.GroupOwnerWork(21, 17)
+	tr.Reconciled(21, 19)
+	if err := tr.CommitGroup(21, 8); err == nil {
+		t.Fatal("retroactively armed in-flight intermediate")
+	}
+	tr.finishFrame(21, composer.ComposeTiming{Supported: true, Submitted: true})
+	if _, ok := tr.Take(); ok {
+		t.Fatal("unarmed intermediate finalized")
+	}
+	if !tr.GroupReady(21) {
+		t.Fatal("final original/owner/reconcile gate missing")
+	}
+	if err := tr.CommitGroup(21, 8); err != nil {
+		t.Fatal(err)
+	}
+	if tr.startFrame() != 21 || !tr.pending.frameArmed || tr.pending.frameGeneration != 8 {
+		t.Fatal("wrong armed identity")
+	}
+	if tag, generation, armed := tr.presentationStamp(21); tag != 21 || generation != 8 || !armed {
+		t.Fatal("wrong final identity", tag, generation, armed)
+	}
+	tr.frameWork(21, 19, 23)
+	tr.finishFrame(21, composer.ComposeTiming{Supported: true, Submitted: true, RasterUploadNS: 29, EncodeSubmitNS: 31, AcquireNS: 37, PresentCallNS: 41})
+	got, ok := tr.Take()
+	if !ok || !got.Completed || got.Tag != 21 || got.Generation != 8 || got.OwnerNS != 28 || got.ReconcileNS != 32 || got.LayoutPaintNS != 22 || got.GatherNS != 28 || got.RasterUploadNS != 36 || got.EncodeSubmitNS != 42 || got.AcquireNS != 50 || got.PresentCallNS != 58 || got.TotalUIWorkNS != got.InputNS+188 {
+		t.Fatalf("terminal %+v/%v", got, ok)
+	}
+	if tr.Pending() {
+		t.Fatal("retained event group")
+	}
+}
+func TestVellumFrameTraceGroupCancellationPreservesInputAndOwnerTerminals(t *testing.T) {
+	tr := &FrameTrace{}
+	e := &events.CustomEvent{}
+	if err := tr.BeginGroup(5, []events.Event{e}); err != nil {
+		t.Fatal(err)
+	}
+	tr.Fail(5, "canceled")
+	if _, ok := tr.Take(); ok {
+		t.Fatal("cancellation released queued input")
+	}
+	tag, start := tr.startEvent(e)
+	tr.endEvent(tag, start)
+	if _, ok := tr.Take(); ok {
+		t.Fatal("cancellation released queued owner work")
+	}
+	tr.GroupOwnerWork(5, 7)
+	if got, ok := tr.Take(); !ok || got.Completed || got.Failure != "canceled" {
+		t.Fatalf("canceled terminal %+v/%v", got, ok)
+	}
+	if err := tr.BeginGroup(6, []events.Event{e}); err != nil {
+		t.Fatal(err)
+	}
+	tr.Retire(6, "window closed")
+	if got, ok := tr.Take(); !ok || got.Failure != "window closed" {
+		t.Fatal("retirement did not release queued references")
+	}
+}
+func TestVellumFrameTraceGroupBoundsIdentityAndOrdinaryCompatibility(t *testing.T) {
+	e := &events.CustomEvent{}
+	for _, group := range [][]events.Event{nil, {nil}, {e, e}, {e, &events.CustomEvent{}, &events.CustomEvent{}, &events.CustomEvent{}, &events.CustomEvent{}}} {
+		tr := &FrameTrace{}
+		if err := tr.BeginGroup(1, group); err == nil {
+			t.Fatal("invalid group admitted")
+		}
+	}
+	tr := &FrameTrace{}
+	if err := tr.BeginGroup(1, []events.Event{e}); err != nil {
+		t.Fatal(err)
+	}
+	if err := tr.Begin(2, e); !errors.Is(err, ErrFrameTraceBusy) {
+		t.Fatal("parallel ordinary trace admitted", err)
+	}
+	tr.Retire(1, "done")
+	tr.Take()
+	if err := tr.Begin(2, e); err != nil {
+		t.Fatal("ordinary trace broken", err)
+	}
+	tag, start := tr.startEvent(e)
+	tr.endEvent(tag, start)
+	if got, ok := tr.Take(); !ok || got.Failure != "traced input did not post owner work" {
+		t.Fatal("ordinary no-handler behavior changed")
+	}
+}
+
+func TestVellumFrameTraceGroupCanceledBetweenEventsKeepsFinalTerminal(t *testing.T) {
+	tr := &FrameTrace{}
+	first, second := &events.CustomEvent{}, &events.CustomEvent{}
+	if err := tr.BeginGroup(31, []events.Event{first, second}); err != nil {
+		t.Fatal(err)
+	}
+	tag, start := tr.startEvent(first)
+	tr.endEvent(tag, start)
+	tr.GroupOwnerWork(31, 7)
+	tr.Reconciled(31, 11)
+	if tr.startFrame() != 31 {
+		t.Fatal("missing canceled prefix frame")
+	}
+	tr.frameWork(31, 2, 3)
+	tr.finishFrame(31, composer.ComposeTiming{Supported: true, Submitted: true, RasterUploadNS: 5, EncodeSubmitNS: 7})
+	tr.Fail(31, "canceled")
+	if _, ok := tr.Take(); ok {
+		t.Fatal("cancellation released incomplete original group")
+	}
+	tag, start = tr.startEvent(second)
+	tr.endEvent(tag, start)
+	if tr.OwnerTag() != 31 {
+		t.Fatal("canceled group lost final drain token")
+	}
+	tr.GroupOwnerWork(31, 13)
+	got, ok := tr.Take()
+	if !ok || got.Completed || got.Failure != "canceled" || got.OwnerNS != 20 || got.ReconcileNS != 11 || got.TotalUIWorkNS != got.InputNS+48 {
+		t.Fatalf("canceled group accounting/terminal %+v/%v", got, ok)
+	}
+}

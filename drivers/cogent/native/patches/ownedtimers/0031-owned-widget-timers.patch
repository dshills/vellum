+func TestVellumManualTextCoreAmbientReaderFaultReleasesAdoption(t *testing.T) {
+	for _, kind := range []string{"panic", "goexit"} {
+		t.Run(kind, func(t *testing.T) {
+			ls := lines.NewLinesExact()
+			view := ls.NewView(80)
+			ob := &OutputBuffer{Lines: ls, Output: strings.NewReader("one\n"), MarkupFunc: func(*lines.Lines, []rune) rich.Text {
+				if kind == "goexit" {
+					runtime.Goexit()
+				}
+				panic("ambient markup")
+			}}
+			done := make(chan struct{})
+			go func() { defer close(done); defer func() { _ = recover() }(); ob.MonitorOutput() }()
+			select {
+			case <-done:
+			case <-time.After(5 * time.Second):
+				t.Fatal("reader fault retained batch mutex/lifetime")
+			}
+			var failure error
+			execution := &lines.ManualExecution{Now: func() time.Time { return time.Unix(1700000000, 0) }, AfterFunc: func(time.Duration, func()) (lines.Timer, error) { return nil, errors.New("unexpected timer") }, Failure: func(err error) { failure = err }}
+			if err := ls.BindManualExecution(view, execution); err != nil || failure != nil {
+				t.Fatal("reader worker did not retire", err, failure)
+			}
+			ls.Close()
+		})
+	}

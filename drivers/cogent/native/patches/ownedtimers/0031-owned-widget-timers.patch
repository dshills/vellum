+//go:build offscreen
+
+package textcore
+
+import (
+	"bytes"
+	"cogentcore.org/core/core"
+	"cogentcore.org/core/events"
+	"cogentcore.org/core/events/key"
+	"cogentcore.org/core/styles/states"
+	"cogentcore.org/core/text/fonts"
+	"cogentcore.org/core/text/lines"
+	"cogentcore.org/core/text/rich"
+	"cogentcore.org/core/text/shaped"
+	"cogentcore.org/core/text/shaped/shapers/shapedgt"
+	"context"
+	"errors"
+	"image"
+	"io/fs"
+	"runtime"
+	"strings"
+	"testing"
+	"time"
+)
+
+type ownedFixtureClock struct {
+	now    time.Time
+	timers []*ownedFixtureTimer
+}
+type ownedFixtureTimer struct {
+	due      time.Time
+	callback func()
+	stopped  bool
+}
+
+func (t *ownedFixtureTimer) Stop() bool { was := !t.stopped; t.stopped = true; return was }
+func (c *ownedFixtureClock) After(ctx context.Context, delay time.Duration, fn func()) (core.ManualTimer, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	t := &ownedFixtureTimer{due: c.now.Add(delay), callback: fn}
+	c.timers = append(c.timers, t)
+	return t, nil
+}
+func (c *ownedFixtureClock) Advance(delay time.Duration) {
+	c.now = c.now.Add(delay)
+	var callbacks []func()
+	for _, t := range c.timers {
+		if !t.stopped && !t.due.After(c.now) {
+			t.stopped = true
+			callbacks = append(callbacks, t.callback)
+		}
+	}
+	for _, fn := range callbacks {
+		fn()
+	}
+}
+func ownedEditorFixture(t *testing.T) (*core.ManualWindow, *Editor, *core.Body, *ownedFixtureClock) {
+	t.Helper()
+	c := &ownedFixtureClock{now: time.Unix(1730000000, 0).UTC()}
+	b := core.NewBody("manual editor timers")
+	ed := NewEditor(b)
+	old := ed.Lines
+	ed.SetLines(lines.NewLinesExact())
+	old.Close()
+	m, err := b.NewWindow().RunManual(context.Background(), core.ManualWindowConfig{Size: image.Pt(600, 300), LogicalDPI: 160, EventCapacity: 64, Now: func() time.Time { return c.now }, AfterFunc: c.After, NewShaper: func() (shaped.Shaper, error) { return shapedgt.NewShaperWithFonts([]fs.FS{fonts.Default}), nil }})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := m.Close(context.Background()); err != nil && !errors.Is(err, core.ErrManualCallback) && !errors.Is(err, lines.ErrManualViews) {
+			t.Error(err)
+		}
+	})
+	ownedDrain(t, m)
+	return m, ed, b, c
+}
+func ownedDrain(t *testing.T, m *core.ManualWindow) {
+	t.Helper()
+	for range 256 {
+		s, err := m.Snapshot(context.Background())
+		if err != nil {
+			t.Fatal(err)
+		}
+		if s.Events == 0 && !s.ReadyPaint {
+			return
+		}
+		if s.Blocked && !s.ReadyPaint {
+			t.Fatal("blocked owner FIFO")
+		}
+		if _, err = m.Step(context.Background(), 1); err != nil {
+			t.Fatal(err)
+		}
+	}
+	t.Fatal("event budget exhausted")
+}
+func TestVellumManualTextCoreMarkupDebounceAndRetirement(t *testing.T) {
+	m, ed, _, c := ownedEditorFixture(t)
+	if ed.manualLines != ed.Lines {
+		t.Fatal("buffer not bound before style")
+	}
+	ed.Lines.SetString("{\"a\":1}\n")
+	ed.Lines.SetFileExt("json")
+	if !ed.Lines.Highlighter.Has {
+		t.Fatal("real highlighter not enabled")
+	}
+	inputs := 0
+	var inputTimes []time.Time
+	ed.Lines.OnInput(ed.viewId, func(e events.Event) { inputs++; inputTimes = append(inputTimes, e.Time()) })
+	c.Advance(250 * time.Millisecond)
+	edit := ed.Lines.InsertTextBytes(ed.Lines.EndPos(), []byte(" "))
+	if edit == nil || !edit.Region.Time.Time().Equal(c.now) {
+		t.Fatalf("edit stamp %+v now%v", edit, c.now)
+	}
+	before := inputs
+	c.Advance(250 * time.Millisecond)
+	ownedDrain(t, m)
+	if inputs != before {
+		t.Fatal("superseded markup debounce fired", inputs, before)
+	}
+	c.Advance(250 * time.Millisecond)
+	if inputs != before {
+		t.Fatal("clock ran parser/widget work")
+	}
+	ownedDrain(t, m)
+	if len(ed.Lines.HiTags(0)) == 0 {
+		t.Fatal("owned parser produced no real highlighting tags")
+	}
+	if inputs != before+1 || !inputTimes[len(inputTimes)-1].Equal(c.now) {
+		t.Fatal("one owned markup update missing", inputs, before, inputTimes)
+	}
+	before = inputs
+	ed.Lines.ReMarkup()
+	if inputs != before {
+		t.Fatal("zero-delay reparse ran inline")
+	}
+	c.Advance(0)
+	if inputs != before {
+		t.Fatal("clock invoked reparse work")
+	}
+	ownedDrain(t, m)
+	if inputs != before+1 {
+		t.Fatal("explicit reparse not delivered", inputs, before)
+	}
+	ed.Lines.StartDelayedReMarkup()
+	ed.SetLines(lines.NewLinesExact())
+	before = inputs
+	c.Advance(time.Second)
+	ownedDrain(t, m)
+	if inputs != before {
+		t.Fatal("retired buffer emitted input")
+	}
+	snap, err := m.Snapshot(context.Background())
+	if err != nil || snap.Failure != nil {
+		t.Fatalf("buffer retirement %+v %v", snap, err)
+	}
+}

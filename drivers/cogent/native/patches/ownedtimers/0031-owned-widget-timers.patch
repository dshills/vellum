+func TestVellumManualRequestFrameDoesNotDispatch(t *testing.T) {
+	m, _, c := manualFixture(t, nil)
+	drainManual(t, m)
+	before, err := m.Snapshot(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	for range 3 {
+		if err := m.RequestFrame(context.Background()); err != nil {
+			t.Fatal(err)
+		}
+	}
+	after, err := m.Snapshot(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if after.Frames != before.Frames || after.Events != before.Events || !after.ReadyPaint || !after.Now.Equal(c.Now()) {
+		t.Fatalf("request dispatched %+v -> %+v", before, after)
+	}
+	result, err := m.Step(context.Background(), 1)
+	if err != nil || result.Frames != 1 || result.Events != 1 {
+		t.Fatalf("one explicit frame %+v %v", result, err)
+	}
+}
+func TestVellumManualCompletionDelayedResetCancel(t *testing.T) {
+	var field *TextField
+	m, _, clock := manualFixture(t, func(b *Body) { field = NewTextField(b).SetText("A") })
+	drainManual(t, m)
+	completion := NewComplete()
+	var matched []string
+	completion.MatchFunc = func(_ any, s string, _, _ int) complete.Matches {
+		matched = append(matched, s)
+		return complete.Matches{Seed: s, Matches: complete.Completions{{Text: s + "-option"}}}
+	}
+	wait := 200 * time.Millisecond
+	if err := completion.SetWaitDuration(wait); err != nil {
+		t.Fatal(err)
+	}
+	completion.Show(field, image.Pt(20, 20), "old")
+	clock.Advance(wait / 2)
+	completion.Show(field, image.Pt(20, 20), "new")
+	clock.Advance(wait / 2)
+	drainManual(t, m)
+	if len(matched) != 0 || !completion.IsAboutToShow() {
+		t.Fatal("reset fired old completion", matched)
+	}
+	clock.Advance(wait)
+	if len(matched) != 0 {
+		t.Fatal("clock invoked widget callback")
+	}
+	drainManual(t, m)
+	if len(matched) != 1 || matched[0] != "new" || completion.stage == nil || completion.IsAboutToShow() {
+		t.Fatal("completion not shown exactly once", matched)
+	}
+	completion.Cancel()
+	completion.Show(field, image.Pt(20, 20), "cancel")
+	clock.Advance(wait)
+	if !completion.Cancel() {
+		t.Fatal("queued cancellation not acknowledged")
+	}
+	drainManual(t, m)
+	if len(matched) != 1 {
+		t.Fatal("canceled completion shown", matched)
+	}
+}
+func TestVellumManualSnackbarTimeoutAndRetirement(t *testing.T) {
+	m, body, clock := manualFixture(t, nil)
+	drainManual(t, m)
+	first := NewBody("snackbar-one").AddSnackbarText("One").NewSnackbar(body).SetTimeout(time.Second).Run()
+	drainManual(t, m)
+	if first.Main == nil {
+		t.Fatal("snackbar not mounted")
+	}
+	clock.Advance(time.Second)
+	if first.Main == nil {
+		t.Fatal("clock retired popup outside origin")
+	}
+	drainManual(t, m)
+	if first.Main != nil {
+		t.Fatal("explicit step did not expire snackbar")
+	}
+	second := NewBody("snackbar-two").AddSnackbarText("Two").NewSnackbar(body).SetTimeout(time.Second).Run()
+	drainManual(t, m)
+	if !second.ClosePopup() {
+		t.Fatal("manual popup close refused")
+	}
+	clock.Advance(time.Second)
+	drainManual(t, m)
+	snap, err := m.Snapshot(context.Background())
+	if err != nil || snap.Failure != nil || snap.Timers != 0 {
+		t.Fatalf("retirement %+v %v", snap, err)
+	}
+}
+func TestVellumManualFieldCursorExplicitBlink(t *testing.T) {
+	var field *TextField
+	m, _, clock := manualFixture(t, func(b *Body) { field = NewTextField(b).SetText("A") })
+	drainManual(t, m)
+	clickManual(t, m, center(field))
+	first, err := m.Image(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	interval := TimingSettings.CursorBlinkTime
+	if interval <= 0 {
+		t.Fatal("fixture needs existing positive blink interval")
+	}
+	clock.Advance(interval)
+	if err = m.RequestFrame(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	drainManual(t, m)
+	second, err := m.Image(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if bytes.Equal(first.Pix, second.Pix) {
+		t.Fatal("manual cursor did not blink at virtual deadline")
+	}
+	clock.Advance(interval)
+	drainManual(t, m)
+	third, err := m.Image(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(first.Pix, third.Pix) {
+		t.Fatal("manual cursor did not return on explicit second deadline")
+	}
+	if err = m.Close(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	if err = m.RequestFrame(context.Background()); !errors.Is(err, ErrManualClosed) {
+		t.Fatal("closed frame request", err)
+	}
+}
+func TestVellumManualCompletionFailureAndLifetime(t *testing.T) {
+	m, b, c := manualFixture(t, nil)
+	drainManual(t, m)
+	field := NewTextField(b).SetText("A")
+	drainManual(t, m)
+	comp := NewComplete()
+	if err := comp.SetWaitDuration(time.Second); err != nil {
+		t.Fatal(err)
+	}
+	calls := 0
+	comp.MatchFunc = func(_ any, s string, _, _ int) complete.Matches { calls++; return complete.Matches{} }
+	comp.Show(field, image.Point{}, "retired")
+	if err := m.Close(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	c.Advance(time.Second)
+	if calls != 0 {
+		t.Fatal("closed completion callback")
+	}
+	m, b, c = manualFixture(t, nil)
+	drainManual(t, m)
+	field = NewTextField(b)
+	drainManual(t, m)
+	comp = NewComplete()
+	if err := comp.SetWaitDuration(time.Second); err != nil {
+		t.Fatal(err)
+	}
+	comp.MatchFunc = func(any, string, int, int) complete.Matches { panic(maliciousPanic{}) }
+	comp.Show(field, image.Point{}, "fault")
+	c.Advance(time.Second)
+	if _, err := m.Step(context.Background(), 1); !errors.Is(err, ErrManualCallback) {
+		t.Fatalf("completion panic %v", err)
+	}
+	if err := m.Close(context.Background()); err != nil && !errors.Is(err, ErrManualCallback) {
+		t.Fatal(err)
+	}
+}

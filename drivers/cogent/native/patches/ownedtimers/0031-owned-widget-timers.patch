+			ls := NewLinesExact()
+			view := ls.NewView(80)
+			var failure error
+			execution := testExecution(&failure)
+			switch kind {
+			case "pending":
+				ls.markupDelayTimer = &manualTestTimer{}
+			case "running":
+				ls.markupActive = 1
+			case "autosave":
+				ls.Autosave = true
+			case "two-views":
+				ls.NewView(80)
+			}
+			want := ErrManualAmbient
+			if kind == "two-views" {
+				want = ErrManualViews
+			}
+			if err := ls.BindManualExecution(view, execution); !errors.Is(err, want) {
+				t.Fatal(kind, err)
+			}
+			if ls.manualExecution != nil {

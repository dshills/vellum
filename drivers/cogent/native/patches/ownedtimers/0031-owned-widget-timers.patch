+package lines
+
+import (
+	"cogentcore.org/core/events"
+	"cogentcore.org/core/text/textpos"
+	"errors"
+	"reflect"
+	"sync"
+	"time"
+)
+
+var ErrManualViews = errors.New("lines: manual execution requires exactly one live view")
+var ErrManualAmbient = errors.New("lines: cannot adopt pending or running ambient work or autosave")
+var ErrManualExecution = errors.New("lines: invalid or conflicting manual execution binding")
+
+type Timer interface{ Stop() bool }
+
+// ManualExecution is immutable while bound. AfterFunc must admit to the view's
+// bounded originating FIFO; callbacks execute only under that event owner.
+// A manual buffer supports one view, not implicit cross-scene scheduling.
+type ManualExecution struct {
+	Now       func() time.Time
+	AfterFunc func(time.Duration, func()) (Timer, error)
+	Failure   func(error)
+}
+
+func (ls *Lines) BindManualExecution(view int, execution *ManualExecution) error {
+	if ls == nil || execution == nil || execution.Now == nil || execution.AfterFunc == nil || execution.Failure == nil {
+		return ErrManualExecution
+	}
+	ls.Lock()
+	defer ls.Unlock()
+	ls.markupDelayMu.Lock()
+	defer ls.markupDelayMu.Unlock()
+	if len(ls.views) != 1 || ls.views[view] == nil {
+		return ErrManualViews
+	}
+	if ls.manualExecution != nil {
+		if ls.manualExecution != execution || ls.manualView != view {
+			return ErrManualExecution
+		}
+		return nil
+	}
+	if ls.markupDelayTimer != nil || ls.markupActive != 0 || ls.ambientActive != 0 || ls.Autosave {
+		return ErrManualAmbient
+	}
+	ls.manualExecution = execution
+	ls.manualView = view
+	return nil
+}
+func (ls *Lines) ReleaseManualExecution(execution *ManualExecution) {
+	if ls == nil {
+		return
+	}
+	ls.Lock()
+	defer ls.Unlock()
+	if ls.manualExecution != execution {
+		return
+	}
+	ls.stopDelayedReMarkup()
+	ls.manualExecution = nil
+	ls.manualView = -1
+}
+func (ls *Lines) now() time.Time {
+	if ls.manualExecution != nil {
+		return ls.manualExecution.Now()
+	}
+	return time.Now()
+}
+func (ls *Lines) newTimedRegion(start, end textpos.Pos) textpos.Region {
+	if ls.manualExecution == nil {
+		return textpos.NewRegionPos(start, end)
+	}
+	region := textpos.Region{Start: start, End: end}
+	region.Time.SetTime(ls.now())
+	return region
+}
+func (ls *Lines) stampEvent(event events.Event) {
+	if ls.manualExecution != nil {
+		event.AsBase().GenTime.SetTime(ls.now())
+	}
+}
+
+// A typed nil is not a usable cancellation handle.
+func invalidManualTimer(timer Timer) bool {
+	if timer == nil {
+		return true
+	}
+	value := reflect.ValueOf(timer)
+	switch value.Kind() {
+	case reflect.Chan, reflect.Func, reflect.Interface, reflect.Map, reflect.Pointer, reflect.Slice:
+		return value.IsNil()
+	}
+	return false
+}
+
+// BeginAmbientWork reserves a real-mode worker lifetime before it starts.
+// The caller must defer the returned release until all of its worker/timer work
+// has stopped. Manual buffers refuse and record ErrManualAmbient instead of
+// launching an unclocked goroutine, reader batch timer or filesystem autosave.
+func (ls *Lines) BeginAmbientWork() (func(), error) {
+	if ls == nil {
+		return nil, ErrManualExecution
+	}
+	ls.Lock()
+	defer ls.Unlock()
+	return ls.beginAmbientWork()
+}
+
+// beginAmbientWork requires the buffer lock, shared with manual adoption.
+func (ls *Lines) beginAmbientWork() (func(), error) {
+	if ls.manualExecution != nil {
+		ls.manualExecution.Failure(ErrManualAmbient)
+		return nil, ErrManualAmbient
+	}
+	ls.ambientActive++
+	var once sync.Once
+	return func() { once.Do(func() { ls.Lock(); ls.ambientActive--; ls.Unlock() }) }, nil
+}
+
+// startAutoSave requires the buffer lock. The edit itself remains accepted;
+// unsupported manual autosave is refused before any worker/file work begins.
+func (ls *Lines) startAutoSave(edit *textpos.Edit) {
+	if edit == nil || !ls.Autosave {
+		return
+	}
+	finish, err := ls.beginAmbientWork()
+	if err != nil {
+		return
+	}
+	go func() { defer finish(); _ = ls.autoSave() }()
+}

+func TestVellumManualLinesAdoptionAndLease(t *testing.T) {
+	var failure error
+	ls := NewLinesExact()
+	view := ls.NewView(80)
+	execution := testExecution(&failure)
+	if err := ls.BindManualExecution(view, execution); err != nil {
+		t.Fatal(err)
+	}
+	if err := ls.BindManualExecution(view, execution); err != nil {
+		t.Fatal("same lease refused", err)
+	}
+	other := testExecution(&failure)
+	if err := ls.BindManualExecution(view, other); !errors.Is(err, ErrManualExecution) {
+		t.Fatal("foreign lease accepted", err)
+	}
+	ls.ReleaseManualExecution(other)
+	if got := ls.NewView(80); got != -1 || !errors.Is(failure, ErrManualViews) {
+		t.Fatal("foreign release removed lease", got, failure)
+	}
+	ls.DeleteView(view)
+	replacement := ls.NewView(60)
+	if replacement < 0 {
+		t.Fatal("retired lease retained")
+	}
+	if err := ls.BindManualExecution(replacement, other); err != nil {
+		t.Fatal("new origin could not adopt retired buffer", err)
+	}
+	ls.Close()
+	if ls.manualExecution != nil || len(ls.views) != 0 {
+		t.Fatal("close retained lease/views")
+	}
+}

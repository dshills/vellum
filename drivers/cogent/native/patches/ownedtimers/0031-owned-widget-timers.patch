+// ManualExecution reports whether this scene has the explicit manual owner.
+// It does not switch driver mode or create a timer.
+func (sc *Scene) ManualExecution() bool {
+	if sc == nil {
+		return false
+	}
+	rc := sc.renderContext()
+	return rc != nil && rc.manual != nil
+}
+
+// ManualAfterFunc admits a bounded callback to this scene's originating FIFO.
+// Clock callbacks only enqueue; the callback itself runs during ManualWindow.Step.
+// This API refuses normal mode rather than silently creating a wall timer.
+func (sc *Scene) ManualAfterFunc(delay time.Duration, callback func()) (ManualTimer, error) {
+	if !sc.ManualExecution() {
+		return nil, ErrManualUnsupported
+	}
+	m := sc.renderContext().manual
+	if callback == nil || delay < 0 {
+		return nil, ErrManualConfig
+	}
+	if err := m.lifetime.Err(); err != nil {
+		return nil, err
+	}
+	timer := sc.afterEvent(delay, callback)
+	if timer != nil {
+		return timer, nil
+	}
+	m.mu.Lock()
+	err := m.failure
+	m.mu.Unlock()
+	if err == nil {
+		err = m.lifetime.Err()
+	}
+	if err == nil {
+		err = ErrManualConfig
+	}
+	return nil, err
+}
+
+// ManualFailure records a checked scheduling refusal in the manual controller.
+func (sc *Scene) ManualFailure(err error) {
+	if err != nil && sc.ManualExecution() {
+		sc.renderContext().manual.fail(err)
+	}

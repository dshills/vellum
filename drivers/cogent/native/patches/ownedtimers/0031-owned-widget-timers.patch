+func TestVellumManualLinesAmbientWorkAndAutosaveRefusal(t *testing.T) {
+	ls := NewLinesExact()
+	view := ls.NewView(80)
+	var failure error
+	execution := testExecution(&failure)
+	finish, err := ls.BeginAmbientWork()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := ls.BindManualExecution(view, execution); !errors.Is(err, ErrManualAmbient) {
+		t.Fatal("running ambient worker adopted", err)

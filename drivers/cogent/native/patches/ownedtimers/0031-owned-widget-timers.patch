+func TestVellumManualTextCoreMarkupCallbackFaultUnwinds(t *testing.T) {
+	for _, kind := range []string{"panic", "goexit"} {
+		t.Run(kind, func(t *testing.T) {
+			m, ed, _, clock := ownedEditorFixture(t)
+			ed.Lines.SetString("{\"a\":1}\n")
+			ed.Lines.SetFileExt("json")
+			ed.Lines.StopDelayedReMarkup()
+			ownedDrain(t, m)
+			ed.Lines.OnInput(ed.viewId, func(events.Event) {
+				if kind == "goexit" {
+					runtime.Goexit()
+				}
+				panic("parser listener")
+			})
+			ed.Lines.ReMarkup()
+			clock.Advance(0)
+			done := make(chan struct{})
+			var stepErr error
+			go func() { defer close(done); _, stepErr = m.Step(context.Background(), 64) }()
+			select {
+			case <-done:
+			case <-time.After(5 * time.Second):
+				t.Fatal("callback ownership did not unwind")
+			}
+			snap, err := m.Snapshot(context.Background())
+			if err != nil || !errors.Is(snap.Failure, core.ErrManualCallback) {
+				t.Fatal("fault not terminal", snap, err, stepErr)
+			}
+			// Buffer and window lock ownership must have unwound before cleanup.
+			done = make(chan struct{})
+			go func() { defer close(done); ed.Lines.StopDelayedReMarkup(); _ = m.Close(context.Background()) }()
+			select {
+			case <-done:
+			case <-time.After(5 * time.Second):
+				t.Fatal("buffer/window remained locked after fault")
+			}
+		})
+	}
+}

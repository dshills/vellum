+// Grapheme boundary helpers for the disposable Vellum remediation patch.
+package textpos
+
+import "github.com/go-text/typesetting/segmenter"
+
+// GraphemeBounds returns rune offsets including zero and the end of text.
+// Offsets are logical, not visual bidi positions. The result is owned.
+func GraphemeBounds(text []rune) []int {
+	var seg segmenter.Segmenter
+	seg.Init(text)
+	it := seg.GraphemeIterator()
+	bounds := []int{0}
+	for it.Next() {
+		g := it.Grapheme()
+		bounds = append(bounds, g.Offset+len(g.Text))
+	}
+	return bounds
+}
+
+// NextGrapheme returns the first boundary strictly after pos, or end of text.
+func NextGrapheme(text []rune, pos int) int {
+	pos = max(0, min(pos, len(text)))
+	for _, boundary := range GraphemeBounds(text) {
+		if boundary > pos {
+			return boundary
+		}
+	}
+	return len(text)
+}
+
+// PrevGrapheme returns the last boundary strictly before pos, or zero.
+func PrevGrapheme(text []rune, pos int) int {
+	pos = max(0, min(pos, len(text)))
+	prev := 0
+	for _, boundary := range GraphemeBounds(text) {
+		if boundary >= pos {
+			return prev
+		}
+		prev = boundary
+	}
+	return prev
+}
+
+// GraphemeAtOrBefore returns a valid boundary at or before the clamped offset.
+func GraphemeAtOrBefore(text []rune, pos int) int {
+	pos = max(0, min(pos, len(text)))
+	previous := 0
+	for _, boundary := range GraphemeBounds(text) {
+		if boundary > pos {
+			break
+		}
+		previous = boundary
+	}
+	return previous
+}
+
+// GraphemeAtOrAfter returns a valid boundary at or after the clamped offset.
+func GraphemeAtOrAfter(text []rune, pos int) int {
+	pos = max(0, min(pos, len(text)))
+	for _, boundary := range GraphemeBounds(text) {
+		if boundary >= pos {
+			return boundary
+		}
+	}
+	return len(text)
+}

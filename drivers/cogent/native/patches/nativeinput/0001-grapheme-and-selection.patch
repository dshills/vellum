+// Experimental editing-state seam for Vellum's native adapter.
+package core
+
+import (
+	"cogentcore.org/core/text/textpos"
+	"image"
+	"slices"
+)
+
+// TextFieldEditingState is an owned logical snapshot. All offsets are runes.
+// Caret bounds are scene pixels. Read and mutate only on the UI goroutine.
+type TextFieldEditingState struct {
+	Text                  string
+	Cursor, Anchor, Focus int
+	Caret                 image.Rectangle
+}
+
+// EditingState exposes the field's logical selection without native encoding.
+func (tf *TextField) EditingState() TextFieldEditingState {
+	state := TextFieldEditingState{Text: string(tf.editText), Cursor: tf.cursorPos, Anchor: tf.cursorPos, Focus: tf.cursorPos}
+	if tf.selectRange.Start >= 0 && tf.selectRange.Start < tf.selectRange.End && tf.selectRange.End <= len(tf.editText) {
+		state.Anchor, state.Focus = tf.selectRange.Start, tf.selectRange.End
+		if tf.cursorPos == state.Anchor {
+			state.Anchor, state.Focus = state.Focus, state.Anchor
+		}
+	}
+	if tf.Scene != nil && tf.renderAll != nil && tf.renderVisible != nil {
+		pos := tf.charRenderPos(tf.cursorPos).ToPointFloor()
+		state.Caret = image.Rectangle{Min: pos, Max: pos.Add(image.Pt(max(1, int(tf.CursorWidth.Dots)), max(1, int(tf.lineHeight))))}
+	}
+	return state
+}
+
+// SetEditingSelection rejects out-of-range and interior-grapheme positions.
+// It keeps anchor/focus direction and does not edit or reset undo history.
+func (tf *TextField) SetEditingSelection(anchor, focus int) bool {
+	bounds := textpos.GraphemeBounds(tf.editText)
+	if !slices.Contains(bounds, anchor) || !slices.Contains(bounds, focus) {
+		return false
+	}
+	tf.selectInit = anchor
+	tf.cursorPos = focus
+	tf.selectRange = textpos.Range{Start: min(anchor, focus), End: max(anchor, focus)}
+	tf.selectMode, tf.selectModeShift = false, false
+	tf.updateLinePos()
+	tf.NeedsRender()
+	return true
+}

+package core
+
+import (
+	"cogentcore.org/core/text/textpos"
+	"testing"
+)
+
+func TestVellumFieldEditing(t *testing.T) {
+	for _, text := range []string{"AB", "e\u0301", "👩‍💻", "🇺🇳", "👍🏽"} {
+		t.Run(text, func(t *testing.T) {
+			tf := &TextField{editText: []rune(text), cursorPos: len([]rune(text))}
+			start := textpos.PrevGrapheme(tf.editText, tf.cursorPos)
+			tf.cursorBackspace(tf.cursorPos - start)
+			if tf.cursorPos != start || string(tf.editText) != string([]rune(text)[:start]) {
+				t.Fatalf("backspace = %q @%d", string(tf.editText), tf.cursorPos)
+			}
+			tf = &TextField{editText: []rune(text)}
+			end := textpos.NextGrapheme(tf.editText, 0)
+			tf.cursorDelete(end)
+			if string(tf.editText) != string([]rune(text)[end:]) || tf.cursorPos != 0 {
+				t.Fatal("delete")
+			}
+		})
+	}
+	tf := &TextField{editText: []rune("A👩‍💻e\u0301Z")}
+	if tf.SetEditingSelection(1, 2) || tf.SetEditingSelection(-1, 0) || tf.SetEditingSelection(0, 8) {
+		t.Fatal("invalid selection accepted")
+	}
+	if !tf.SetEditingSelection(6, 1) {
+		t.Fatal("valid reversed selection rejected")
+	}
+	state := tf.EditingState()
+	if state.Anchor != 6 || state.Focus != 1 || state.Cursor != 1 {
+		t.Fatalf("reversed selection: %+v", state)
+	}
+	tf.deleteSelection()
+	if string(tf.editText) != "AZ" {
+		t.Fatalf("selection delete: %q", string(tf.editText))
+	}
+	tf = &TextField{editText: []rune("AB"), cursorPos: 1}
+	tf.insertAtCursor("👩‍💻")
+	if string(tf.editText) != "A👩‍💻B" || tf.cursorPos != 4 {
+		t.Fatal("insertion lost rune offset")
+	}
+}
+
+func TestVellumEditingSnapshotIsReadOnly(t *testing.T) {
+	tf := &TextField{editText: []rune("A👩‍💻Z"), cursorPos: 4, selectRange: textpos.Range{Start: 1, End: 4}, selectMode: true, edited: true}
+	for i := 0; i < 3; i++ {
+		state := tf.EditingState()
+		if state.Anchor != 1 || state.Focus != 4 {
+			t.Fatal("selection not observed")
+		}
+	}
+	if !tf.edited || !tf.selectMode || tf.selectRange.Start != 1 || tf.selectRange.End != 4 {
+		t.Fatal("inspection mutated editing")
+	}
+	tf.cursorPos = 2
+	tf.SetText("👩‍💻")
+	if tf.cursorPos != 0 || !tf.SetEditingSelection(3, 3) {
+		t.Fatal("replacement left interior caret")
+	}
+	tf.selectRange = textpos.Range{Start: 1, End: 2}
+	tf.deleteSelection()
+	if len(tf.editText) != 0 {
+		t.Fatal("partial selection split a grapheme")
+	}
+}

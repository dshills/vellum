+package textpos
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestVellumGraphemeBoundaries(t *testing.T) {
+	cases := []struct {
+		text   string
+		bounds []int
+	}{
+		{"", []int{0}}, {"AB", []int{0, 1, 2}}, {"e\u0301", []int{0, 2}},
+		{"👩‍💻", []int{0, 3}}, {"👨‍👩‍👧‍👦", []int{0, 7}}, {"🇺🇳🇯🇵", []int{0, 2, 4}},
+		{"👍🏽", []int{0, 2}}, {"\r\n", []int{0, 2}}, {"가", []int{0, 2}},
+		{"A👩‍💻e\u0301Z", []int{0, 1, 4, 6, 7}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.text, func(t *testing.T) {
+			text := []rune(tc.text)
+			if got := GraphemeBounds(text); !reflect.DeepEqual(got, tc.bounds) {
+				t.Fatalf("%v != %v", got, tc.bounds)
+			}
+			for i := 0; i < len(tc.bounds)-1; i++ {
+				start, end := tc.bounds[i], tc.bounds[i+1]
+				if got := NextGrapheme(text, start); got != end {
+					t.Fatalf("next %d = %d", start, got)
+				}
+				if got := PrevGrapheme(text, end); got != start {
+					t.Fatalf("prev %d = %d", end, got)
+				}
+				for p := start + 1; p < end; p++ {
+					if NextGrapheme(text, p) != end || PrevGrapheme(text, p) != start {
+						t.Fatalf("interior %d", p)
+					}
+				}
+			}
+			if PrevGrapheme(text, 0) != 0 || NextGrapheme(text, len(text)) != len(text) {
+				t.Fatal("endpoint")
+			}
+		})
+	}
+}
+
+func TestVellumInclusiveGraphemeBounds(t *testing.T) {
+	text := []rune("A👩‍💻Z")
+	for _, boundary := range []int{0, 1, 4, 5} {
+		if GraphemeAtOrBefore(text, boundary) != boundary || GraphemeAtOrAfter(text, boundary) != boundary {
+			t.Fatal("valid boundary changed")
+		}
+	}
+	if GraphemeAtOrBefore(text, 2) != 1 || GraphemeAtOrAfter(text, 2) != 4 {
+		t.Fatal("interior boundary")
+	}
+}

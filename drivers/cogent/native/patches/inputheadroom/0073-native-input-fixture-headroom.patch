+func inputTimingFixture(t *testing.T, bounds image.Rectangle) (*sceneplan.Packet, *sceneplan.Encoded) {
+	t.Helper()
+	b := sceneplan.New(bounds)
+	b.Draw(bounds, image.NewUniform(color.RGBA{13, 31, 59, 255}), image.Point{}, nil, image.Point{}, draw.Src)
+	// Three operations force a non-power-of-two Ops encoding. Buffer growth
+	// rounds capacity upward; metrics must still count the shorter payload.
+	b.Draw(image.Rect(2, 3, 8, 9), image.NewUniform(color.RGBA{71, 19, 103, 255}), image.Point{}, nil, image.Point{}, draw.Src)
+	b.Draw(image.Rect(11, 4, 20, 16), image.NewUniform(color.RGBA{29, 83, 47, 255}), image.Point{}, nil, image.Point{}, draw.Src)
+	packet := b.Seal(false)
+	if packet == nil {
+		t.Fatal("fixture capture refused")
+	}
+	encoded, ok := packet.EncodeGPU()
+	if !ok {
+		t.Fatal("fixture encoding refused")
+	}
+	return packet, encoded
+}
+
+func TestVellumGPUSceneInputTimingFixtureHeadroom(t *testing.T) {
+	_, encoded := inputTimingFixture(t, image.Rect(0, 0, 23, 19))
+	for _, input := range [][]byte{encoded.Ops, encoded.Rows, encoded.Refs, encoded.Data} {
+		n := len(input)
+		if n > 0 && n&(n-1) != 0 {
+			return
+		}
+	}
+	t.Fatal("fixture has no input requiring capacity beyond its encoded length")
+}
 

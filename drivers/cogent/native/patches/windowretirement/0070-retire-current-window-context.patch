 // renderWindowList is a list of [renderWindow]s.
 type renderWindowList []*renderWindow
+
+// unregister removes all registry ownership and withdraws a retired construction
+// context in one transaction. The returned focus candidate must be used outside
+// the mutex; this snapshot does not extend its native lifetime.
+func (w *renderWindow) unregister() *renderWindow {
+	renderWindowGlobalMu.Lock()
+	defer renderWindowGlobalMu.Unlock()
+	for _, list := range []*renderWindowList{&AllRenderWindows, &mainRenderWindows, &dialogRenderWindows} {
+		*list = slices.DeleteFunc(*list, func(candidate *renderWindow) bool { return candidate == w })
+	}
+	var next *renderWindow
+	if len(AllRenderWindows) > 0 {
+		next = AllRenderWindows[len(AllRenderWindows)-1]
+	}
+	if currentRenderWindow == w {
+		currentRenderWindow = next
+	}
+	return next
+}
+
+// publishFocus checks live membership, orders focus and publishes the current
+// context under the same mutex as unregister. A delayed native focus event must
+// not republish a window removed by a concurrent close.
+func (w *renderWindow) publishFocus() bool {
+	renderWindowGlobalMu.Lock()
+	defer renderWindowGlobalMu.Unlock()
+	i := slices.Index(AllRenderWindows, w)
+	if i < 0 {
+		return false
+	}
+	copy(AllRenderWindows[i:], AllRenderWindows[i+1:])
+	AllRenderWindows[len(AllRenderWindows)-1] = w
+	currentRenderWindow = w
+	return true
+}
 
 // add adds a window to the list.

+func TestVellumRetiredManualWindowAllowsOrdinaryWindow(t *testing.T) {
+	m, _, _ := manualFixture(t, nil)
+	drainManual(t, m)
+	retired := m.window
+	if err := m.Close(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	if currentRenderWindowSnapshot() == retired || slices.Contains(AllRenderWindows.snapshot(), retired) || slices.Contains(mainRenderWindows.snapshot(), retired) || slices.Contains(dialogRenderWindows.snapshot(), retired) {
+		t.Fatal("closed manual window retained the construction context or registry ownership")
+	}
+	body := NewBody("ordinary after manual close")
+	shown := make(chan struct{}, 1)
+	body.OnFinal(events.Show, func(events.Event) {
+		select {
+		case shown <- struct{}{}:
+		default:
+		}
+	})
+	body.RunWindow()
+	w := body.Scene.RenderWindow()
+	if w == nil || w.manual != nil {
+		t.Fatal("ordinary construction inherited the retired manual context")
+	}
+	t.Cleanup(func() {
+		rc := w.renderContext()
+		rc.Lock()
+		body.Close()
+		rc.Unlock()
+		deadline := time.Now().Add(3 * time.Second)
+		for slices.Contains(AllRenderWindows.snapshot(), w) {
+			if time.Now().After(deadline) {
+				t.Error("ordinary window did not retire")
+				return
+			}
+			time.Sleep(time.Millisecond)
+		}
+	})
+	select {
+	case <-shown:
+	case <-time.After(3 * time.Second):
+		t.Fatal("ordinary window did not show after manual retirement")
+	}
+}
+
+func windowRetirementRegistryFixture(t *testing.T) {
+	t.Helper()
+	renderWindowGlobalMu.Lock()
+	all, main, dialogs, current := AllRenderWindows, mainRenderWindows, dialogRenderWindows, currentRenderWindow
+	AllRenderWindows, mainRenderWindows, dialogRenderWindows, currentRenderWindow = nil, nil, nil, nil
+	renderWindowGlobalMu.Unlock()
+	t.Cleanup(func() {
+		renderWindowGlobalMu.Lock()
+		AllRenderWindows, mainRenderWindows, dialogRenderWindows, currentRenderWindow = all, main, dialogs, current
+		renderWindowGlobalMu.Unlock()
+	})
+}
+
+func TestVellumWindowRetirementSelectsLiveContextAndReleasesBeforeRaise(t *testing.T) {
+	windowRetirementRegistryFixture(t)
+	a := &renderWindow{SystemWindow: &vellumWindowListNative{}}
+	b := &renderWindow{SystemWindow: &vellumWindowListNative{}}
+	raises := 0
+	c := &renderWindow{SystemWindow: &vellumWindowListNative{raise: func() {
+		raises++
+		// Reenter the registry from the native callout. Retirement must have
+		// released its mutex and removed the closed window from every list.
+		if slices.Contains(AllRenderWindows.snapshot(), b) || slices.Contains(mainRenderWindows.snapshot(), b) || slices.Contains(dialogRenderWindows.snapshot(), b) {
+			t.Error("native focus restoration ran before registry withdrawal")
+		}
+	}}}
+	renderWindowGlobalMu.Lock()
+	AllRenderWindows, mainRenderWindows, dialogRenderWindows = renderWindowList{a, b, c}, renderWindowList{a, b, c}, renderWindowList{b}
+	currentRenderWindow = a
+	renderWindowGlobalMu.Unlock()
+	b.closed()
+	if currentRenderWindowSnapshot() != c || raises != 1 {
+		t.Fatal("focus restoration did not select a registered survivor")
+	}
+	a.closed()
+	if currentRenderWindowSnapshot() != c || raises != 2 {
+		t.Fatal("closing the current window did not select the survivor")
+	}
+	c.closed()
+	c.closed()
+	if currentRenderWindowSnapshot() != nil || len(AllRenderWindows.snapshot()) != 0 || len(mainRenderWindows.snapshot()) != 0 || len(dialogRenderWindows.snapshot()) != 0 {
+		t.Fatal("last or repeated close retained registry or current-window state")
+	}
+}
+
+func TestVellumWindowRetirementRaiseCannotRepublishAfterNativeClose(t *testing.T) {
+	windowRetirementRegistryFixture(t)
+	w := &renderWindow{}
+	raises := 0
+	w.SystemWindow = &vellumWindowListNative{raise: func() {
+		raises++
+		w.closed()
+	}}
+	renderWindowGlobalMu.Lock()
+	AllRenderWindows, mainRenderWindows = renderWindowList{w}, renderWindowList{w}
+	currentRenderWindow = w
+	renderWindowGlobalMu.Unlock()
+	w.Raise()
+	w.Raise() // A second request for the retired window must not call native code.
+	if raises != 1 || currentRenderWindowSnapshot() != nil || len(AllRenderWindows.snapshot()) != 0 {
+		t.Fatal("native Raise republished a closed window or called it after retirement")
+	}
+}
+
+func TestVellumWindowRetirementConcurrentRaiseCloseKeepsContextWithdrawn(t *testing.T) {
+	windowRetirementRegistryFixture(t)
+	entered, release, done := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	var once sync.Once
+	unblock := func() { once.Do(func() { close(release) }) }
+	defer unblock()
+	w := &renderWindow{SystemWindow: &vellumWindowListNative{raise: func() {
+		// Pause the admitted backend call while another goroutine retires
+		// the window. Real Mac native handle checks run on its main queue;
+		// this fixture tests only the core context publication contract.
+		close(entered)
+		<-release
+	}}}
+	renderWindowGlobalMu.Lock()
+	AllRenderWindows, mainRenderWindows = renderWindowList{w}, renderWindowList{w}
+	currentRenderWindow = w
+	renderWindowGlobalMu.Unlock()
+	go func() { defer close(done); w.Raise() }()
+	t.Cleanup(func() {
+		unblock()
+		select {
+		case <-done:
+		case <-time.After(3 * time.Second):
+			t.Error("Raise worker outlived its fixture")
+		}
+	})
+	select {
+	case <-entered:
+	case <-time.After(3 * time.Second):
+		t.Fatal("registered Raise did not enter backend")
+	}
+	w.handleWindowEvents(events.NewWindow(events.WinClose))
+	unblock()
+	select {
+	case <-done:
+	case <-time.After(3 * time.Second):
+		t.Fatal("admitted Raise did not finish after close")
+	}
+	if currentRenderWindowSnapshot() != nil || len(AllRenderWindows.snapshot()) != 0 || len(mainRenderWindows.snapshot()) != 0 {
+		t.Fatal("concurrent native Raise completion republished a retired context")
+	}
+}

+func TestVellumWindowFocusRetirementCannotRepublishClosedWindow(t *testing.T) {
+	windowRetirementRegistryFixture(t)
+	for round := 0; round < 64; round++ {
+		survivor := &renderWindow{SystemWindow: &vellumWindowListNative{}}
+		closing := &renderWindow{SystemWindow: &vellumWindowListNative{}}
+		renderWindowGlobalMu.Lock()
+		AllRenderWindows = renderWindowList{survivor, closing}
+		mainRenderWindows = slices.Clone(AllRenderWindows)
+		dialogRenderWindows = nil
+		currentRenderWindow = closing
+		renderWindowGlobalMu.Unlock()
+		start := make(chan struct{})
+		var workers sync.WaitGroup
+		workers.Add(2)
+		go func() {
+			defer workers.Done()
+			<-start
+			for range 512 {
+				closing.handleWindowEvents(events.NewWindow(events.WinFocus))
+			}
+		}()
+		go func() {
+			defer workers.Done()
+			<-start
+			closing.handleWindowEvents(events.NewWindow(events.WinClose))
+		}()
+		close(start)
+		workers.Wait()
+		closing.handleWindowEvents(events.NewWindow(events.WinFocus))
+		if currentRenderWindowSnapshot() != survivor || !slices.Equal(AllRenderWindows.snapshot(), renderWindowList{survivor}) || !slices.Equal(mainRenderWindows.snapshot(), renderWindowList{survivor}) {
+			t.Fatal("late focus republished a retired window or changed membership")
+		}
+		survivor.closed()
+	}
+}

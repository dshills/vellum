+
+// Embedded Cursor supplies the public enum interface, while String selects an
+// existing SVG. No built-in hotspot entry exists for this application enum.
+type vellumApplicationCursor struct {
+	cursors.Cursor
+	name string
+}
+
+func (c vellumApplicationCursor) String() string { return c.name }
+
+func TestVellumOwnedRasterMatrix(t *testing.T) {
+	oldTheme := matcolor.SchemeIsDark
+	oldCache := Cursors
+	t.Cleanup(func() { colors.SetScheme(oldTheme); Cursors = oldCache })
+	count := 0
+	for _, dark := range []bool{false, true} {
+		colors.SetScheme(dark)
+		Cursors = make(map[enums.Enum]map[int]*Cursor)
+		for _, cursor := range cursors.CursorValues()[1:] {
+			for _, size := range []int{16, 24, 32, 48, 64} {
+				t.Run(fmt.Sprintf("dark=%v/%s/%d", dark, cursor, size), func(t *testing.T) {
+					body, err := cursors.SVG(cursor.String())
+					if err != nil {
+						t.Fatal(err)
+					}
+					sv := svg.NewSVG(math32.Vec2(float32(size), float32(size)))
+					if err := sv.ReadXML(bytes.NewReader(body)); err != nil {
+						t.Fatal(err)
+					}
+					primary := sv.RenderImage()
+					bounds := image.Rect(0, 0, size, size)
+					if primary.Bounds() != bounds {
+						t.Fatal("primary bounds", primary.Bounds())
+					}
+					hot := cursors.Hotspots[cursor].Mul(size).Div(256)
+					if !hot.In(bounds) {
+						t.Fatal("hotspot outside image", hot)
+					}
+					_, _, _, alpha := primary.At(hot.X, hot.Y).RGBA()
+					if alpha < 0x1000 {
+						t.Fatalf("hotspot misses unshadowed primary geometry: %v alpha=%d", hot, alpha)
+					}
+					ink, colored := 0, 0
+					for y := 0; y < size; y++ {
+						for x := 0; x < size; x++ {
+							r, g, b, a := primary.At(x, y).RGBA()
+							if a > 0x1000 {
+								ink++
+								if r != g || g != b {
+									colored++
+								}
+							}
+						}
+					}
+					if ink < size*size/50 || ink > size*size*4/5 {
+						t.Fatal("empty or excessive cursor coverage", ink)
+					}
+					for _, p := range []image.Point{{0, 0}, {size - 1, 0}, {0, size - 1}, {size - 1, size - 1}} {
+						_, _, _, a := primary.At(p.X, p.Y).RGBA()
+						if a != 0 {
+							t.Fatal("clipped cursor corner", p)
+						}
+					}
+					switch cursor {
+					case cursors.Copy, cursors.Progress, cursors.NotAllowed, cursors.Poof:
+						if colored == 0 {
+							t.Fatal("lost semantic badge color")
+						}
+					}
+					rendered, err := Get(cursor, size)
+					if err != nil {
+						t.Fatal(err)
+					}
+					expected := image.Rect(0, 0, size+size/16, size+size/16)
+					if rendered.Size != size || rendered.Hotspot != hot || rendered.Image.Bounds() != expected {
+						t.Fatal("rendered cursor contract", rendered)
+					}
+					cached, err := Get(cursor, size)
+					if err != nil || cached != rendered {
+						t.Fatal("same enum/size cache identity", err)
+					}
+					count++
+				})
+			}
+		}
+	}
+	if count != 390 {
+		t.Fatal("incomplete raster matrix", count)
+	}
+}
+
+func TestVellumOwnedNoneAndCustomFallback(t *testing.T) {
+	old := Cursors
+	Cursors = make(map[enums.Enum]map[int]*Cursor)
+	t.Cleanup(func() { Cursors = old })
+	if _, err := Get(cursors.None, 32); err == nil {
+		t.Fatal("None gained an image")
+	}
+	custom := vellumApplicationCursor{cursors.Cursor(-1), "arrow"}
+	rendered, err := Get(custom, 32)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if rendered.Hotspot != image.Pt(16, 16) {
+		t.Fatal("custom cursor fallback changed", rendered.Hotspot)
+	}
+	if _, err := Get(vellumApplicationCursor{cursors.Cursor(-2), "vellum-unknown"}, 32); err == nil {
+		t.Fatal("unknown custom cursor gained an image")
+	}
+}

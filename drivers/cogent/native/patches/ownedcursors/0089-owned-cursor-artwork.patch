+// Copyright (c) 2026 Davin Hills. SPDX-License-Identifier: MIT.
+package cursors
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"image"
+	"io/fs"
+	"os"
+	"reflect"
+	"sort"
+	"strings"
+	"testing"
+)
+
+func TestVellumOwnedArtworkManifest(t *testing.T) {
+	data, err := os.ReadFile("owned-assets.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var m struct {
+		Schema   int
+		License  string
+		Extent   int
+		Files    map[string]string
+		Hotspots map[string][2]int `json:"hotspots_256"`
+		Names    []string          `json:"public_cursor_names"`
+	}
+	if err := json.Unmarshal(data, &m); err != nil {
+		t.Fatal(err)
+	}
+	if m.Schema != 1 || m.License != "MIT" || m.Extent != 256 {
+		t.Fatal("wrong artwork metadata", m)
+	}
+	names := []string{"arrow", "context-menu", "help", "pointer", "progress", "wait", "cell", "crosshair", "text", "vertical-text", "alias", "copy", "move", "not-allowed", "grab", "grabbing", "resize-col", "resize-row", "resize-up", "resize-right", "resize-down", "resize-left", "resize-n", "resize-e", "resize-s", "resize-w", "resize-ne", "resize-nw", "resize-se", "resize-sw", "resize-ew", "resize-ns", "resize-nesw", "resize-nwse", "zoom-in", "zoom-out", "screenshot-selection", "screenshot-window", "poof"}
+	values := CursorValues()
+	if len(values) != 40 || values[0] != None || None != 0 || len(m.Files) != 39 || len(m.Hotspots) != 39 {
+		t.Fatal("cursor identities changed")
+	}
+	for i, name := range names {
+		cursor := values[i+1]
+		if int(cursor) != i+1 || cursor.String() != name {
+			t.Fatalf("public identity changed at %d: %v", i, cursor)
+		}
+		body, err := fs.ReadFile(Cursors, "svg/"+name+".svg")
+		if err != nil {
+			t.Fatal(err)
+		}
+		digest := sha256.Sum256(body)
+		if hex.EncodeToString(digest[:]) != m.Files[name+".svg"] {
+			t.Fatal("artwork checksum", name)
+		}
+		if !strings.Contains(string(body), "SPDX-License-Identifier: MIT") || !strings.Contains(string(body), `viewBox="0 0 256 256"`) {
+			t.Fatal("artwork declaration/extent", name)
+		}
+		hot := m.Hotspots[name]
+		if Hotspots[cursor] != image.Pt(hot[0], hot[1]) {
+			t.Fatal("hotspot metadata", name)
+		}
+	}
+	sort.Strings(names)
+	if !reflect.DeepEqual(names, m.Names) {
+		t.Fatal("manifest identities")
+	}
+	entries, err := fs.ReadDir(Cursors, "svg")
+	if err != nil || len(entries) != 39 {
+		t.Fatal("embedded artwork set", err, len(entries))
+	}
+	fixture, err := os.ReadFile("../svg/testdata/svg/zoom-in.svg")
+	if err != nil {
+		t.Fatal(err)
+	}
+	zoom, err := fs.ReadFile(Cursors, "svg/zoom-in.svg")
+	if err != nil || !bytes.Equal(fixture, zoom) {
+		t.Fatal("SVG regression fixture must use original Vellum artwork", err)
+	}
+	if _, err := SVG("none"); err == nil {
+		t.Fatal("None unexpectedly has an image")
+	}
+	if _, err := SVG("vellum-unknown"); err == nil {
+		t.Fatal("unknown cursor unexpectedly has an image")
+	}
+}

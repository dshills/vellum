+			}
+		})
+	}
+}
+func TestVellumCursorFastDuplicateAvoidsRasterCopyAllocation(t *testing.T) {
+	a, cu, _, q := fastCursorFixture(t)
+	cu.SetSize(units.Dp(256))
+	if err := fastCursorQueue(t, a, q, func() error { return cu.Set(cursors.Arrow) }); err != nil {
+		t.Fatal(err)
+	}
+	// A pump keeps an accidental slow implementation bounded and gives a real
+	// queue count. No native API is called by the fixture backend.
+	stop, joined := make(chan struct{}), make(chan struct{})
+	var queued atomic.Int64
+	go func() {
+		defer close(joined)
+		for {
+			select {
+			case <-stop:
+				return
+			case call := <-q:
+				queued.Add(1)
+				a.ExecuteMain(call)
+			}
+		}
+	}()
+	var before, after runtime.MemStats
+	runtime.ReadMemStats(&before)
+	var err error
+	const n = 16
+	for i := 0; i < n; i++ {
+		if err = cu.Set(cursors.Arrow); err != nil {
+			break
+		}
+	}
+	runtime.ReadMemStats(&after)
+	close(stop)
+	<-joined
+	if err != nil {
+		t.Fatal(err)
+	}
+	if queued.Load() != 0 {
+		t.Fatal("duplicate native roundtrip", queued.Load())
+	}
+	// One256px RGBA copy needs at least256KiB. Sixteen copies exceed4MiB.
+	// Leave1MiB for all metadata/runtime allocation: this catches copying while
+	// avoiding a brittle zero-allocation or compiler-specific count promise.
+	if delta := after.TotalAlloc - before.TotalAlloc; delta > 1<<20 {
+		t.Fatal("duplicate retained full raster-copy allocation", delta)
+	}
+}

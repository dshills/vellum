+func TestVellumCursorFastCustomUnitsStillRunAndRetire(t *testing.T) {
+	a, cu, _, q := fastCursorFixture(t)
+	calls := 0
+	value := units.Dp(32)
+	value.Custom = func(*units.Context) float32 { calls++; return 32 }
+	cu.SetSize(value)
+	if err := fastCursorQueue(t, a, q, func() error { return cu.Set(cursors.Arrow) }); err != nil {
+		t.Fatal(err)
+	}
+	if err := fastCursorNoQueue(t, a, q, func() error { return cu.Set(cursors.Arrow) }); err != nil {
+		t.Fatal(err)
+	}
+	if calls != 2 {
+		t.Fatal("custom conversion omitted", calls)
+	}
+	value.Custom = func(*units.Context) float32 { cu.SetSize(units.Dp(32)); return 32 }
+	cu.SetSize(value)
+	if err := fastCursorQueue(t, a, q, func() error { return cu.Set(cursors.Arrow) }); err == nil {
+		t.Fatal("reentrant size request did not retire old request")
+	}
+}
+func TestVellumCursorFastMalformedRasterRetainsCopyRefusal(t *testing.T) {
+	for _, kind := range []string{"nil-image", "size", "hotspot"} {
+		t.Run(kind, func(t *testing.T) {
+			a, cu, _, q := fastCursorFixture(t)
+			if err := fastCursorQueue(t, a, q, func() error { return cu.Set(cursors.Arrow) }); err != nil {
+				t.Fatal(err)
+			}
+			ci, err := cursorimg.Get(cursors.Arrow, 32)
+			if err != nil {
+				t.Fatal(err)
+			}
+			original := *ci
+			defer func() { *ci = original }()
+			switch kind {
+			case "nil-image":

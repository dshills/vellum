+// reusableCursorRaster keeps the early no-op narrower than Copy's accepted
+// image interface. It invokes no caller callbacks and admits only a valid RGBA
+// header with enough backing storage. Other images retain the ordinary Copy path.
+func reusableCursorRaster(ci *cursorimg.Cursor, pixels int) bool {
+	if ci == nil || ci.Size != pixels || pixels < 1 || pixels > cursorimg.MaxSize {
+		return false
+	}
+	im, ok := ci.Image.(*image.RGBA)
+	if !ok || im == nil {
+		return false
+	}
+	b := im.Rect
+	limit := pixels + pixels/16
+	if b.Min != (image.Point{}) || b.Dx() < 1 || b.Dy() < 1 || b.Max.X > limit || b.Max.Y > limit || !ci.Hotspot.In(b) {
+		return false
+	}
+	row := 4 * b.Dx()
+	if im.Stride < row || len(im.Pix) < row {
+		return false
+	}
+	return b.Dy() == 1 || im.Stride <= (len(im.Pix)-row)/(b.Dy()-1)
+}

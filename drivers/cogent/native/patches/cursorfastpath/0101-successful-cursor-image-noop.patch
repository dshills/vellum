+func TestVellumCursorFastDefaultConstructorIsEligible(t *testing.T) {
+	a, previous, _, q := fastCursorFixture(t)
+	// Use the actual constructor called by App.newWindowOnMain, with no native
+	// allocation: construction only installs backend closures. Substitute those
+	// closures before exercising Set or cleanup against the software live token.
+	TheCursor.mu.Lock()
+	defaults := TheCursor.CursorBase
+	TheCursor.Size = units.Dp(32)
+	TheCursor.mu.Unlock()
+	defer func() { TheCursor.mu.Lock(); TheCursor.CursorBase = defaults; TheCursor.mu.Unlock() }()
+	w := previous.window
+	cu := newWindowCursor(w)
+	w.cursor = cu
+	cu.owner, _ = fakeCursors()
+	cu.pointer, _ = fakePointer()
+	cu.pointer.live = func() bool { return w.pointerLive() }
+	if cu.modeSequence != 0 || !cu.modeKnown || !cu.wantEnabled || cu.wantRaw {
+		t.Fatal("default constructor excludes ordinary pointer mode")
+	}
+	if err := fastCursorQueue(t, a, q, func() error { return cu.Set(cursors.Arrow) }); err != nil {
+		t.Fatal(err)
+	}
+	if err := fastCursorNoQueue(t, a, q, func() error { return cu.Set(cursors.Arrow) }); err != nil {
+		t.Fatal(err)
+	}
+}

+// Actual Cursor.Set and native queue admission, using the existing fake native
+// allocator/binder. The live composer token is software-only; no GLFW API runs.
+func fastCursorFixture(t *testing.T) (*App, *Cursor, *Cursor, chan base.FuncRun) {
+	t.Helper()
+	a, c1, c2, q := cursorHarness(t)
+	for _, cu := range []*Cursor{c1, c2} {
+		cu.window.composerPointer.Store(&composer.ComposerDrawer{})
+	}
+	return a, c1, c2, q
+}
+func fastCursorQueue(t *testing.T, a *App, q chan base.FuncRun, fn func() error) error {
+	t.Helper()
+	done := make(chan error, 1)
+	go func() { done <- fn() }()
+	select {
+	case call := <-q:
+		a.ExecuteMain(call)
+	case err := <-done:
+		t.Fatalf("request omitted required native admission: %v", err)
+	case <-time.After(2 * time.Second):
+		t.Fatal("native admission did not arrive")
+	}
+	select {
+	case err := <-done:
+		return err
+	case <-time.After(2 * time.Second):
+		t.Fatal("native request did not retire")
+	}
+	return nil
+}
+func fastCursorNoQueue(t *testing.T, a *App, q chan base.FuncRun, fn func() error) error {
+	t.Helper()
+	done := make(chan error, 1)
+	go func() { done <- fn() }()
+	select {
+	case err := <-done:
+		return err
+	case call := <-q:
+		a.ExecuteMain(call)
+		select {
+		case <-done:
+		case <-time.After(2 * time.Second):
+			t.Fatal("unexpected queued request did not retire")
+		}
+		t.Fatal("duplicate cursor entered native queue")
+	case <-time.After(2 * time.Second):
+		t.Fatal("cursor caller did not retire")
+	}
+	return nil
+}
+func TestVellumCursorFastDuplicateSkipsNativeQueue(t *testing.T) {
+	a, cu, _, q := fastCursorFixture(t)
+	if err := fastCursorQueue(t, a, q, func() error { return cu.Set(cursors.Arrow) }); err != nil {
+		t.Fatal(err)
+	}
+	for i := 0; i < 4; i++ {
+		if err := fastCursorNoQueue(t, a, q, func() error { return cu.Set(cursors.Arrow) }); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if cu.Current() != cursors.Arrow {
+		t.Fatal("accepted duplicate did not preserve Current")
+	}
+}
+func TestVellumCursorFastInvalidatorsRetainNativeAdmission(t *testing.T) {
+	for _, kind := range []string{"size", "scale-same-pixels", "reset", "theme", "failed-request", "different-image"} {
+		t.Run(kind, func(t *testing.T) {
+			a, cu, _, q := fastCursorFixture(t)
+			if err := fastCursorQueue(t, a, q, func() error { return cu.Set(cursors.Arrow) }); err != nil {
+				t.Fatal(err)
+			}
+			next := cursors.Arrow
+			switch kind {
+			case "size":
+				cu.SetSize(units.Dp(32)) // even an equal request retires ordering
+			case "scale-same-pixels":
+				w := cu.window
+				w.Mu.Lock()
+				w.LogDPI = math.Nextafter32(w.LogDPI, float32(math.Inf(1)))
+				w.publishCursorScale()
+				w.Mu.Unlock()
+			case "reset":
+				cursorimg.Clear()
+			case "theme":
+				scheme, dark := colors.Scheme, matcolor.SchemeIsDark
+				t.Cleanup(func() { colors.SetScheme(dark); colors.Scheme = scheme })
+				colors.SetScheme(!dark)
+			case "failed-request":
+				if err := cu.Set(cursors.None); err == nil {
+					t.Fatal("None unexpectedly accepted")
+				}
+			case "different-image":
+				next = cursors.Text
+			}
+			if err := fastCursorQueue(t, a, q, func() error { return cu.Set(next) }); err != nil {
+				t.Fatal(err)
+			}
+			if cu.Current() != next {
+				t.Fatal("new image not published")
+			}
+		})
+	}
+}
+func TestVellumCursorFastInFlightRequestCannotBeBypassed(t *testing.T) {
+	a, cu, _, q := fastCursorFixture(t)
+	if err := fastCursorQueue(t, a, q, func() error { return cu.Set(cursors.Arrow) }); err != nil {
+		t.Fatal(err)
+	}
+	old := make(chan error, 1)
+	go func() { old <- cu.Set(cursors.Text) }()
+	var first base.FuncRun
+	select {
+	case first = <-q:
+	case <-time.After(2 * time.Second):
+		t.Fatal("older call not admitted")
+	}
+	newer := make(chan error, 1)
+	go func() { newer <- cu.Set(cursors.Arrow) }()
+	var second base.FuncRun
+	select {
+	case second = <-q:
+	case err := <-newer:
+		a.ExecuteMain(first)
+		<-old
+		t.Fatalf("in-flight request was bypassed: %v", err)
+	case <-time.After(2 * time.Second):
+		a.ExecuteMain(first)
+		<-old
+		t.Fatal("newer call did not queue")
+	}
+	a.ExecuteMain(first)
+	a.ExecuteMain(second)
+	if err := <-old; err == nil {
+		t.Fatal("older native assignment was not retired")
+	}
+	if err := <-newer; err != nil || cu.Current() != cursors.Arrow {
+		t.Fatal("newer exact image not applied", err)
+	}
+}
+func TestVellumCursorFastSuccessfulBindAfterLaterRefusalStillPublishes(t *testing.T) {
+	a, cu, _, q := fastCursorFixture(t)
+	bind := cu.owner.backend.bind
+	cu.owner.backend.bind = func(h any) {
+		bind(h)
+		if h != nil {
+			if err := cu.Set(cursors.None); err == nil {
+				t.Error("None accepted during native bind")
+			}
+		}
+	}
+	if err := fastCursorQueue(t, a, q, func() error { return cu.Set(cursors.Arrow) }); err != nil {
+		t.Fatal(err)
+	}
+	cu.owner.backend.bind = bind
+	if cu.Current() != cursors.Arrow {
+		t.Fatal("successful native assignment was suppressed")
+	}
+	// Failed sequence2 intervened during successful sequence1. Same image must
+	// still make one native admission before its mirror can be reused.
+	if err := fastCursorQueue(t, a, q, func() error { return cu.Set(cursors.Arrow) }); err != nil {
+		t.Fatal(err)
+	}
+}
+func TestVellumCursorFastClosedAndStoppedNeverSucceed(t *testing.T) {
+	for _, kind := range []string{"closed", "stopped", "exhausted"} {
+		t.Run(kind, func(t *testing.T) {
+			a, cu, _, q := fastCursorFixture(t)
+			if err := fastCursorQueue(t, a, q, func() error { return cu.Set(cursors.Arrow) }); err != nil {
+				t.Fatal(err)
+			}
+			switch kind {
+			case "closed":
+				cu.retireStatus()
+			case "stopped":
+				a.StopMain()
+			case "exhausted":
+				cu.mu.Lock()
+				cu.sequence = ^uint64(0)
+				cu.mu.Unlock()
+			}
+			err := cu.Set(cursors.Arrow)
+			if err == nil {
+				t.Fatal("terminal duplicate falsely succeeded")
+			}
+			if kind == "stopped" && !errors.Is(err, base.ErrMainStopped) {
+				t.Fatal("changed stopped refusal", err)
+			}
+		})
+	}
+}

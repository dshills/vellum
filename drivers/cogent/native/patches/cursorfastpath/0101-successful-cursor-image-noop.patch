+func TestVellumCursorFastModeRequestsRetainNativeAdmission(t *testing.T) {
+	for _, kind := range []string{"hide-show", "disabled", "raw-intent", "unknown"} {
+		t.Run(kind, func(t *testing.T) {
+			a, cu, _, q := fastCursorFixture(t)
+			if err := fastCursorQueue(t, a, q, func() error { return cu.Set(cursors.Arrow) }); err != nil {
+				t.Fatal(err)
+			}
+			switch kind {
+			case "hide-show":
+				if err := fastCursorQueue(t, a, q, func() error { cu.Hide(); return nil }); err != nil {
+					t.Fatal(err)
+				}
+				if err := fastCursorQueue(t, a, q, func() error { cu.Show(); return nil }); err != nil {
+					t.Fatal(err)
+				}
+			case "disabled":
+				if err := fastCursorQueue(t, a, q, func() error { cu.window.SetCursorEnabled(false, false); return nil }); err != nil {
+					t.Fatal(err)
+				}
+			case "raw-intent":
+				if err := fastCursorQueue(t, a, q, func() error { cu.window.SetCursorEnabled(true, true); return nil }); err != nil {
+					t.Fatal(err)
+				}
+			case "unknown":
+				cu.mu.Lock()
+				cu.modeKnown = false
+				cu.mu.Unlock()
+			}
+			cu.mu.Lock()
+			beforeMode, beforeKnown := cu.mode, cu.modeKnown
+			cu.mu.Unlock()
+			if err := fastCursorQueue(t, a, q, func() error { return cu.Set(cursors.Arrow) }); err != nil {
+				t.Fatal(err)
+			}
+			cu.mu.Lock()
+			same := cu.mode == beforeMode && cu.modeKnown == beforeKnown
+			cu.mu.Unlock()
+			if !same {
+				t.Fatal("image assignment changed pointer mode status")
+			}
+		})
+	}
+}

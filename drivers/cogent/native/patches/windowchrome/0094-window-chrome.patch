+// Copyright (c) 2026 Davin Hills. SPDX-License-Identifier: MIT.
+package system
+
+import "fmt"
+
+type ChromeStyle uint8
+
+const (
+	ChromeStandard ChromeStyle = iota
+	ChromeUnified
+)
+
+type WindowAppearance uint8
+
+const (
+	AppearanceAutomatic WindowAppearance = iota
+	AppearanceLight
+	AppearanceDark
+)
+
+// WindowChrome is copied into native creation before the surface is constructed.
+// Nonzero policy is currently macOS-only. Zero preserves native defaults.
+type WindowChrome struct {
+	Style      ChromeStyle
+	Appearance WindowAppearance
+}
+
+func (c WindowChrome) Validate() error {
+	if c.Style > ChromeUnified || c.Appearance > AppearanceDark {
+		return fmt.Errorf("system: invalid window chrome")
+	}
+	return nil
+}

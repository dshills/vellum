+// Copyright (c) 2026 Davin Hills. SPDX-License-Identifier: MIT.
+#import <Cocoa/Cocoa.h>
+#include <math.h>
+#include "window_chrome_darwin.h"
+
+// Called only on native main. No Go pointers, subclassing, swizzling or globals.
+int vellumSetFullContentSize(void *pointer,double width,double height) {
+ @autoreleasepool {
+  if (![NSThread isMainThread] || !pointer || !isfinite(width)||!isfinite(height)||width<=0||height<=0) return 0;
+  NSWindow *window=(__bridge NSWindow *)pointer;
+  NSView *view=window.contentView;
+  if(!view)return 0;
+  [view.superview layoutSubtreeIfNeeded];
+  NSRect frame=window.frame;
+  NSSize prior=view.bounds.size;
+  NSSize delta=NSMakeSize(frame.size.width-prior.width,frame.size.height-prior.height);
+  NSSize desired=NSMakeSize(width+delta.width,height+delta.height);
+  if(!isfinite(desired.width)||!isfinite(desired.height)||desired.width<=0||desired.height<=0)return 0;
+  frame.origin.y+=frame.size.height-desired.height;
+  frame.size=desired;
+  [window setFrame:frame display:NO];
+  [view.superview layoutSubtreeIfNeeded];
+  NSSize actual=view.bounds.size;
+  return fabs(actual.width-width)<=0.5 && fabs(actual.height-height)<=0.5;
+ }
+}
+int vellumApplyWindowChrome(void *pointer,int style,int appearance) {
+ @autoreleasepool {
+  if(![NSThread isMainThread]||!pointer||style<0||style>1||appearance<0||appearance>2)return 0;
+  if(style==0&&appearance==0)return 1;
+  NSWindow *window=(__bridge NSWindow *)pointer;
+  NSView *view=window.contentView;
+  if(!view)return 0;
+  NSSize client=view.bounds.size;
+  if(style==1) {
+   if(!(window.styleMask&NSWindowStyleMaskTitled))return 0;
+   if(@available(macOS 11.0,*)) {
+    NSToolbar *toolbar=[[NSToolbar alloc]initWithIdentifier:@"VellumUnifiedWindowToolbar"];
+    toolbar.allowsUserCustomization=NO;
+    toolbar.autosavesConfiguration=NO;
+    toolbar.displayMode=NSToolbarDisplayModeIconOnly;
+    window.styleMask|=NSWindowStyleMaskFullSizeContentView;
+    window.titleVisibility=NSWindowTitleHidden;
+    window.titlebarAppearsTransparent=YES;
+    window.toolbarStyle=NSWindowToolbarStyleUnified;
+    window.titlebarSeparatorStyle=NSTitlebarSeparatorStyleNone;
+    window.toolbar=toolbar; // retained by NSWindow; ends with the native owner.
+#if !__has_feature(objc_arc)
+    [toolbar release];
+#endif
+    window.movableByWindowBackground=NO; // controls below header keep their clicks.
+   } else return 0;
+  }
+  if(appearance==1)window.appearance=[NSAppearance appearanceNamed:NSAppearanceNameAqua];
+  if(appearance==2) {
+   if(@available(macOS 10.14,*))window.appearance=[NSAppearance appearanceNamed:NSAppearanceNameDarkAqua];
+   else return 0;
+  }
+  // Do not replace GLFWContentView, its delegate, first responder or Metal layer.
+  if(style==1&&!vellumSetFullContentSize(pointer,client.width,client.height))return 0;
+  return window.contentView==view;
+ }
+}
+void vellumFullContentFrameInsets(void *pointer,double *left,double *top,double *right,double *bottom){
+ if(left)*left=0;if(top)*top=0;if(right)*right=0;if(bottom)*bottom=0;
+ @autoreleasepool {
+  if(![NSThread isMainThread]||!pointer)return;
+  NSWindow *window=(__bridge NSWindow *)pointer;NSView *view=window.contentView;if(!view)return;
+  NSRect frame=window.frame;
+  NSRect content=[window convertRectToScreen:[view convertRect:view.bounds toView:nil]];
+  if(left)*left=fmax(0,NSMinX(content)-NSMinX(frame));
+  if(top)*top=fmax(0,NSMaxY(frame)-NSMaxY(content));
+  if(right)*right=fmax(0,NSMaxX(frame)-NSMaxX(content));
+  if(bottom)*bottom=fmax(0,NSMinY(content)-NSMinY(frame));
+ }
+}
+
+int vellumFullContentPosition(void *pointer,double *x,double *y) {
+ @autoreleasepool {
+  if(![NSThread isMainThread]||!pointer||!x||!y)return 0;
+  NSWindow *window=(__bridge NSWindow *)pointer;NSView *view=window.contentView;if(!view)return 0;
+  NSRect rect=[window convertRectToScreen:[view convertRect:view.bounds toView:nil]];
+  double px=NSMinX(rect),py=CGDisplayBounds(CGMainDisplayID()).size.height-NSMaxY(rect);
+  if(!isfinite(px)||!isfinite(py))return 0;
+  *x=px;*y=py;return 1;
+ }
+}
+int vellumSetFullContentPosition(void *pointer,double x,double y) {
+ @autoreleasepool {
+  if(![NSThread isMainThread]||!pointer||!isfinite(x)||!isfinite(y))return 0;
+  NSWindow *window=(__bridge NSWindow *)pointer;NSView *view=window.contentView;if(!view)return 0;
+  NSRect rect=[window convertRectToScreen:[view convertRect:view.bounds toView:nil]];
+  NSRect frame=window.frame;
+  frame.origin.x+=x-NSMinX(rect);
+  frame.origin.y+=CGDisplayBounds(CGMainDisplayID()).size.height-y-NSMaxY(rect);
+  if(!isfinite(frame.origin.x)||!isfinite(frame.origin.y))return 0;
+  [window setFrameOrigin:frame.origin];
+  double actualX,actualY;
+  return vellumFullContentPosition(pointer,&actualX,&actualY)&&fabs(actualX-x)<=.5&&fabs(actualY-y)<=.5;
+ }
+}

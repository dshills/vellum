+//go:build darwin
+
+// Copyright (c) 2026 Davin Hills. SPDX-License-Identifier: MIT.
+package desktop
+
+/*
+#cgo LDFLAGS: -framework Cocoa
+#include "window_chrome_darwin.h"
+*/
+import "C"
+import (
+	"cogentcore.org/core/system"
+	"fmt"
+	"github.com/go-gl/glfw/v3.4/glfw"
+	"image"
+	"log"
+	"unsafe"
+)
+
+func validateNativeWindowChrome(chrome system.WindowChrome) error { return chrome.Validate() }
+func applyNativeWindowChrome(window *glfw.Window, chrome system.WindowChrome) error {
+	if chrome == (system.WindowChrome{}) {
+		return nil
+	}
+	if C.vellumApplyWindowChrome(unsafe.Pointer(window.GetCocoaWindow()), C.int(chrome.Style), C.int(chrome.Appearance)) == 0 {
+		return fmt.Errorf("desktop: requested window chrome is unavailable")
+	}
+	return nil
+}
+
+// full-content size is measured from the existing GLFW view, not AppKit's
+// narrower nominal contentRect. Cocoa setters remain on native main.
+func (w *Window) setChromeSizeOnMain(width, height int) bool {
+	if w.chrome.Style != system.ChromeUnified {
+		return false
+	}
+	if w.Glw != nil {
+		if C.vellumSetFullContentSize(unsafe.Pointer(w.Glw.GetCocoaWindow()), C.double(width), C.double(height)) == 0 {
+			log.Printf("desktop: Cocoa refused unified client size %dx%d", width, height)
+		}
+	}
+	return true
+}
+func (w *Window) chromeFrameSizeOnMain() (left, top, right, bottom int) {
+	if w.chrome.Style == system.ChromeUnified && w.Glw != nil {
+		var l, t, r, b C.double
+		C.vellumFullContentFrameInsets(unsafe.Pointer(w.Glw.GetCocoaWindow()), &l, &t, &r, &b)
+		return int(l), int(t), int(r), int(b)
+	}
+	return w.Glw.GetFrameSize()
+}
+
+// Unified positions use the existing view's screen rect, in GLFW's global
+// top-left coordinate convention. Cocoa observation stays on native main.
+func (w *Window) recordChromePositionOnMain(glw *glfw.Window) {
+	if w.chrome.Style != system.ChromeUnified || glw == nil {
+		return
+	}
+	var x, y C.double
+	if C.vellumFullContentPosition(unsafe.Pointer(glw.GetCocoaWindow()), &x, &y) != 0 {
+		p := image.Pt(int(x), int(y))
+		w.chromeClientPosition.Store(&p)
+	}
+}
+func (w *Window) chromePositionSnapshot() (image.Point, bool) {
+	if w.chrome.Style == system.ChromeUnified {
+		if p := w.chromeClientPosition.Load(); p != nil {
+			return *p, true
+		}
+	}
+	return image.Point{}, false
+}
+func (w *Window) setChromePositionOnMain(glw *glfw.Window, x, y int) bool {
+	if w.chrome.Style != system.ChromeUnified {
+		return false
+	}
+	if glw != nil {
+		if C.vellumSetFullContentPosition(unsafe.Pointer(glw.GetCocoaWindow()), C.double(x), C.double(y)) == 0 {
+			log.Printf("desktop: Cocoa refused unified client position %d,%d", x, y)
+		}
+		w.recordChromePositionOnMain(glw)
+	}
+	return true
+}

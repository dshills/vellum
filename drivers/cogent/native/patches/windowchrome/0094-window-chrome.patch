+// Copyright (c) 2026 Davin Hills. SPDX-License-Identifier: MIT.
+package system
+
+import "testing"
+
+func TestWindowChromeValidation(t *testing.T) {
+	for style := ChromeStandard; style <= ChromeUnified; style++ {
+		for appearance := AppearanceAutomatic; appearance <= AppearanceDark; appearance++ {
+			if err := (WindowChrome{style, appearance}).Validate(); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+	for _, p := range []WindowChrome{{Style: 2}, {Appearance: 3}, {Style: 255, Appearance: 255}} {
+		if p.Validate() == nil {
+			t.Fatal("invalid policy admitted", p)
+		}
+	}
+}

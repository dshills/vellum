+func TestVellumWindowChromeDefaultHelpers(t *testing.T) {
+	w := &Window{}
+	p := image.Pt(91, 92)
+	w.chromeClientPosition.Store(&p)
+	if _, known := w.chromePositionSnapshot(); known {
+		t.Fatal("standard chrome used Unified position cache")
+	}
+	if w.setChromePositionOnMain(nil, 5, 6) || w.setChromeSizeOnMain(230, 408) {
+		t.Fatal("default chrome intercepted GLFW geometry")
+	}
+	w.recordChromePositionOnMain(nil)
+	if *w.chromeClientPosition.Load() != p {
+		t.Fatal("nil/default helper mutated geometry")
+	}
+}
+func TestVellumUnifiedPositionSnapshotIsDetached(t *testing.T) {
+	w := &Window{chrome: system.WindowChrome{Style: system.ChromeUnified}}
+	if _, known := w.chromePositionSnapshot(); known {
+		t.Fatal("unobserved geometry fabricated")
+	}
+	p := image.Pt(-300, 420)
+	w.chromeClientPosition.Store(&p)
+	got, known := w.chromePositionSnapshot()
+	if !known || got != p {
+		t.Fatal("position snapshot missing", got, known)
+	}
+	got.X = 999
+	again, known := w.chromePositionSnapshot()
+	if !known || again != p {
+		t.Fatal("snapshot aliased internal state")
+	}
+	w.recordChromePositionOnMain(nil)
+	if actual, _ := w.chromePositionSnapshot(); actual != p {
+		t.Fatal("nil native handle destroyed last observation")
+	}
+}

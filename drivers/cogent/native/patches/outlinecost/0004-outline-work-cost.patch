+// Copyright (c) 2026, Davin Hills.
+// SPDX-License-Identifier: MIT
+
+package font
+
+// GlyphOutlineCost is the opaque logical work charged by a successful bounded
+// static outline retrieval. It contains no font/face/outline references. It is
+// reusable only with that exact immutable outline; it is not a byte measurement.
+// The zero value is invalid. Ordinary GlyphDataOutline ownership is unchanged.
+type GlyphOutlineCost struct {
+	points, operations int
+	valid              bool
+}
+
+// Charge applies the original successful retrieval's aggregate logical cost.
+// Exhaustion or an invalid cost latches refusal, as with bounded retrieval.
+// A failed batch performs no further work. Partial charges on failure need not
+// match a fresh traversal, since that batch is already terminal.
+func (cost GlyphOutlineCost) Charge(budget *GlyphOutlineBudget) bool {
+	if budget == nil {
+		return false
+	}
+	if !cost.valid {
+		budget.failed = true
+		return false
+	}
+	return budget.take(cost.points, cost.operations)
+}
+
+// GlyphDataOutlineBoundedCost returns the ordinary bounded result and its exact
+// successful work charge. The caller owns the new segment slice. A renderer can
+// privately retain it and replay the cost before reading a cached immutable
+// outline. Refused retrievals never produce a valid cost or negative cache entry.
+func (f *Face) GlyphDataOutlineBoundedCost(gid GID, budget *GlyphOutlineBudget) (GlyphOutline, GlyphOutlineCost, bool) {
+	if budget == nil {
+		return GlyphOutline{}, GlyphOutlineCost{}, false
+	}
+	points, operations := budget.points, budget.operations
+	outline, ok := f.GlyphDataOutlineBounded(gid, budget)
+	if !ok {
+		return GlyphOutline{}, GlyphOutlineCost{}, false
+	}
+	return outline, GlyphOutlineCost{points - budget.points, operations - budget.operations, true}, true
+}

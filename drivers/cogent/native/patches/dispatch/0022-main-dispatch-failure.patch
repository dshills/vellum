+package desktop
+
+import (
+	"errors"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"cogentcore.org/core/system/driver/base"
+)
+
+func nativeEventWait(t *testing.T, ch <-chan struct{}) {
+	t.Helper()
+	select {
+	case <-ch:
+	case <-time.After(3 * time.Second):
+		t.Fatal("native event lifecycle blocked")
+	}
+}
+
+func TestVellumNativeEventLifecycleSerializesTerminationAndWake(t *testing.T) {
+	var n nativeEventLifecycle
+	var initialized, terminated, posts atomic.Int32
+	n.wake(func() { t.Error("pre-initialization wake posted") })
+	if err := n.start(func() error { initialized.Add(1); return nil }); err != nil {
+		t.Fatal(err)
+	}
+	if err := n.start(func() error { t.Error("duplicate initialization"); return nil }); err != nil {
+		t.Fatal(err)
+	}
+	started, release, posted := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	go func() {
+		n.wake(func() {
+			close(started)
+			<-release
+			if terminated.Load() != 0 {
+				t.Error("termination overlapped post")
+			}
+			posts.Add(1)
+		})
+		close(posted)
+	}()
+	nativeEventWait(t, started)
+	stopping, stopped := make(chan struct{}), make(chan struct{})
+	go func() {
+		close(stopping)
+		n.stop(func() {
+			if posts.Load() != 1 {
+				t.Error("termination preceded accepted post")
+			}
+			terminated.Add(1)
+		})
+		close(stopped)
+	}()
+	nativeEventWait(t, stopping)
+	select {
+	case <-stopped:
+		t.Fatal("termination returned while posting")
+	case <-time.After(10 * time.Millisecond):
+	}
+	close(release)
+	nativeEventWait(t, posted)
+	nativeEventWait(t, stopped)
+	n.wake(func() { t.Error("wake posted after termination") })
+	n.stop(func() { t.Error("duplicate termination") })
+	if err := n.start(func() error { t.Error("terminal restart"); return nil }); !errors.Is(err, base.ErrMainStopped) {
+		t.Fatal("restart status", err)
+	}
+	if initialized.Load() != 1 || terminated.Load() != 1 || posts.Load() != 1 {
+		t.Fatal("lifecycle invocation counts changed")
+	}
+}
+
+func TestVellumNativeEventLifecycleConcurrentPostsAndStop(t *testing.T) {
+	for round := 0; round < 20; round++ {
+		var n nativeEventLifecycle
+		var alive atomic.Bool
+		var terminations atomic.Int32
+		if err := n.start(func() error { alive.Store(true); return nil }); err != nil {
+			t.Fatal(err)
+		}
+		var workers sync.WaitGroup
+		for i := 0; i < 100; i++ {
+			workers.Add(1)
+			go func() {
+				defer workers.Done()
+				for j := 0; j < 10; j++ {
+					n.wake(func() {
+						if !alive.Load() {
+							t.Error("post entered terminated native API")
+						}
+					})
+				}
+			}()
+		}
+		for i := 0; i < 10; i++ {
+			workers.Add(1)
+			go func() { defer workers.Done(); n.stop(func() { alive.Store(false); terminations.Add(1) }) }()
+		}
+		done := make(chan struct{})
+		go func() { workers.Wait(); close(done) }()
+		nativeEventWait(t, done)
+		if terminations.Load() != 1 || alive.Load() {
+			t.Fatal("native termination was not once")
+		}
+	}
+}
+
+func TestVellumNativeEventLifecycleInitFailureAndEarlyStop(t *testing.T) {
+	var n nativeEventLifecycle
+	sentinel := errors.New("initialization refused")
+	if err := n.start(func() error { return sentinel }); err != sentinel {
+		t.Fatal(err)
+	}
+	n.wake(func() { t.Error("failed initialization enabled wake") })
+	if err := n.start(func() error { return nil }); err != nil {
+		t.Fatal("failed initialization could not retry", err)
+	}
+	n.stop(func() {})
+	var early nativeEventLifecycle
+	early.stop(func() { t.Error("uninitialized native termination") })
+	if err := early.start(func() error { t.Error("stopped startup initialized"); return nil }); !errors.Is(err, base.ErrMainStopped) {
+		t.Fatal(err)
+	}
+}
+
+func TestVellumNativeEventLifecyclePanicReleasesBarrier(t *testing.T) {
+	var n nativeEventLifecycle
+	if err := n.start(func() error { return nil }); err != nil {
+		t.Fatal(err)
+	}
+	sentinel := errors.New("native post panic")
+	func() {
+		defer func() {
+			if recover() != sentinel {
+				t.Error("post panic identity changed")
+			}
+		}()
+		n.wake(func() { panic(sentinel) })
+	}()
+	func() {
+		defer func() {
+			if recover() != sentinel {
+				t.Error("termination panic identity changed")
+			}
+		}()
+		n.stop(func() { panic(sentinel) })
+	}()
+	n.wake(func() { t.Error("terminated panic path enabled wake") })
+	n.stop(func() { t.Error("termination panic retried") })
+}

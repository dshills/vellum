+package core
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"cogentcore.org/core/system"
+)
+
+type terminalRecoveryApp struct {
+	system.App
+	dir string
+}
+
+func (*terminalRecoveryApp) MainStopped() bool                { return true }
+func (a *terminalRecoveryApp) AppDataDir() string             { return a.dir }
+func (*terminalRecoveryApp) Platform() system.Platforms       { return system.MacOS }
+func (*terminalRecoveryApp) SystemPlatform() system.Platforms { return system.MacOS }
+func (*terminalRecoveryApp) SystemInfo() string               { return "terminal recovery fixture" }
+
+func TestVellumTerminalMainRecoveryRethrowsWithoutCrashWindow(t *testing.T) {
+	original := system.TheApp
+	dir := t.TempDir()
+	system.TheApp = &terminalRecoveryApp{dir: dir}
+	defer func() { system.TheApp = original }()
+	before := timesCrashed
+	sentinel := errors.New("terminal original panic")
+	returned := false
+	func() {
+		defer func() {
+			if got := recover(); got != sentinel {
+				t.Fatalf("terminal recovery changed panic: %v", got)
+			}
+		}()
+		handleRecover(sentinel)
+		returned = true
+	}()
+	if returned || timesCrashed != before {
+		t.Fatal("terminal recovery entered GUI crash bookkeeping")
+	}
+	logs, err := filepath.Glob(filepath.Join(dir, "crash-logs", "crash_*"))
+	if err != nil || len(logs) != 1 {
+		t.Fatal("terminal panic omitted crash log", logs, err)
+	}
+	if info, err := os.Stat(logs[0]); err != nil || info.Size() == 0 {
+		t.Fatal("empty terminal crash log", err)
+	}
+}

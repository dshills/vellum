+package base
+
+import (
+	"errors"
+	"runtime"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+type failureOutcome struct {
+	returned bool
+	value    any
+}
+
+func observeFailure(f func()) (out failureOutcome) {
+	defer func() { out.value = recover() }()
+	f()
+	out.returned = true
+	return
+}
+
+func failureWait(t *testing.T, ch <-chan failureOutcome) failureOutcome {
+	t.Helper()
+	select {
+	case out := <-ch:
+		return out
+	case <-time.After(3 * time.Second):
+		t.Fatal("callback failure stranded its caller or loop")
+		return failureOutcome{}
+	}
+}
+
+func TestVellumMainQueueFailureReplaysPanicAndReleasesPendingCallers(t *testing.T) {
+	a := &App{This: &queueTestApp{}}
+	a.InitMainQueue()
+	loop := make(chan failureOutcome, 1)
+	go func() { loop <- observeFailure(a.MainLoop) }()
+	started, release := make(chan struct{}), make(chan struct{})
+	sentinel := errors.New("callback panic identity")
+	caller := make(chan failureOutcome, 1)
+	output := 0
+	go func() {
+		caller <- observeFailure(func() {
+			a.RunOnMainIfOpen(func() { output = 42; close(started); <-release; panic(sentinel) })
+		})
+	}()
+	stopWait(t, started)
+	var waiting sync.WaitGroup
+	var pendingRan atomic.Bool
+	for i := 0; i < 64; i++ {
+		waiting.Add(1)
+		go func() {
+			defer waiting.Done()
+			if a.RunOnMainIfOpen(func() { pendingRan.Store(true) }) {
+				t.Error("pending work escaped fail-stop")
+			}
+		}()
+	}
+	close(release)
+	gotCaller, gotLoop := failureWait(t, caller), failureWait(t, loop)
+	if gotCaller.returned || gotLoop.returned || gotCaller.value != sentinel || gotLoop.value != sentinel || output != 42 {
+		t.Fatalf("panic/output publication changed: caller=%+v loop=%+v output=%d", gotCaller, gotLoop, output)
+	}
+	done := make(chan struct{})
+	go func() { waiting.Wait(); close(done) }()
+	stopWait(t, done)
+	if !a.MainStopped() || pendingRan.Load() || a.RunOnMainIfOpen(func() { t.Error("terminal callback executed") }) {
+		t.Fatal("panic did not close admission")
+	}
+}
+
+func TestVellumMainQueueFailurePreservesNilPanic(t *testing.T) {
+	a := &App{This: &queueTestApp{}}
+	a.InitMainQueue()
+	loop, caller := make(chan failureOutcome, 1), make(chan failureOutcome, 1)
+	go func() { loop <- observeFailure(a.MainLoop) }()
+	go func() { caller <- observeFailure(func() { a.RunOnMainIfOpen(func() { panic(nil) }) }) }()
+	gotCaller, gotLoop := failureWait(t, caller), failureWait(t, loop)
+	if gotCaller.returned || gotLoop.returned || gotCaller.value == nil || gotCaller.value != gotLoop.value {
+		t.Fatalf("nil panic lost: caller=%+v loop=%+v", gotCaller, gotLoop)
+	}
+	if _, ok := gotCaller.value.(*runtime.PanicNilError); !ok {
+		t.Fatalf("nil panic became %T", gotCaller.value)
+	}
+}
+
+func TestVellumMainQueueFailureGoexitAcknowledgesIncomplete(t *testing.T) {
+	a := &App{This: &queueTestApp{}}
+	a.InitMainQueue()
+	exited, caller := make(chan struct{}), make(chan failureOutcome, 1)
+	go func() { defer close(exited); a.MainLoop(); t.Error("Goexit loop returned") }()
+	go func() { caller <- observeFailure(func() { a.RunOnMainIfOpen(runtime.Goexit) }) }()
+	got := failureWait(t, caller)
+	stopWait(t, exited)
+	if got.returned || got.value != ErrMainCallbackIncomplete || !a.MainStopped() {
+		t.Fatalf("incomplete callback outcome=%+v", got)
+	}
+}
+
+func TestVellumMainQueueFailureInlineStartup(t *testing.T) {
+	for _, dispatch := range []func(*App, func()){
+		func(a *App, f func()) { a.RunOnMain(f) },
+		func(a *App, f func()) { a.RunOnMainIfOpen(f) },
+	} {
+		a := &App{}
+		sentinel := errors.New("startup callback panic")
+		got := observeFailure(func() { dispatch(a, func() { panic(sentinel) }) })
+		if got.returned || got.value != sentinel || !a.MainStopped() {
+			t.Fatalf("inline callback outcome=%+v", got)
+		}
+		queue, stopped := a.mainQueueChannels()
+		if queue != nil {
+			t.Fatal("failure published a queue")
+		}
+		stopWait(t, stopped)
+	}
+}
+
+func TestVellumMainQueueFailureDirectAcknowledgementIsNotSuccess(t *testing.T) {
+	a := &App{}
+	completed := true
+	var failure mainFailure
+	done := make(chan struct{}, 1)
+	sentinel := errors.New("direct callback panic")
+	got := observeFailure(func() {
+		a.ExecuteMain(FuncRun{F: func() { panic(sentinel) }, Done: done, executed: &completed, failure: &failure})
+	})
+	if got.returned || got.value != sentinel || completed || !failure.present || failure.value != sentinel {
+		t.Fatal("failed callback acknowledged as success", got, completed, failure)
+	}
+	stopWait(t, done)
+	select {
+	case <-done:
+		t.Fatal("duplicate acknowledgement")
+	default:
+	}
+}

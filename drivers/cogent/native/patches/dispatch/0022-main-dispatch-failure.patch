+package desktop
+
+import (
+	"sync"
+
+	"cogentcore.org/core/system/driver/base"
+)
+
+// GLFW is process-wide. Only initialization, event posting and termination use
+// this barrier; never hold it over polling, queue delivery, or user callbacks.
+var desktopEvents nativeEventLifecycle
+
+type nativeEventLifecycle struct {
+	mu      sync.Mutex
+	ready   bool
+	stopped bool
+}
+
+// start and stop are called on the native main thread. Native operations supplied
+// to these methods must not reenter the barrier. A failed init can be retried;
+// a terminated process loop cannot be restarted.
+func (n *nativeEventLifecycle) start(initialize func() error) error {
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	if n.stopped {
+		return base.ErrMainStopped
+	}
+	if n.ready {
+		return nil
+	}
+	if err := initialize(); err != nil {
+		return err
+	}
+	n.ready = true
+	return nil
+}
+
+// wake can run on any thread. Late posts, including a callback caller's trailing
+// wake, are ignored. A post admitted here finishes before native termination.
+func (n *nativeEventLifecycle) wake(post func()) {
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	if n.ready && !n.stopped {
+		post()
+	}
+}
+
+func (n *nativeEventLifecycle) stop(terminate func()) {
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	n.stopped = true
+	wasReady := n.ready
+	n.ready = false
+	if wasReady {
+		terminate()
+	}
+}

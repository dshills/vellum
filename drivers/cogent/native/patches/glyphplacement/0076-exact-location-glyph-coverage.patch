+func TestVellumGlyphPlacementEpochExhaustionAndLayout(t *testing.T) {
+	type legacyOutlineEntry struct {
+		key     outlineKey
+		outline font.GlyphOutline
+		cost    font.GlyphOutlineCost
+		bytes   int
+		extrema outlineExtrema
+	}
+	if unsafe.Sizeof(uintptr(0)) == 8 && unsafe.Sizeof(outlineEntry{}) != unsafe.Sizeof(legacyOutlineEntry{}) {
+		t.Fatal("64-bit outline metadata grew")
+	}
+	face := vellumOutlineFace(t)
+	gid, _ := face.NominalGlyph('A')
+	c := &staticOutlineCache{nextIdentity: ^uint32(0) - 1}
+	own, ok := c.ordinary(face, gid)
+	if !ok {
+		t.Fatal("outline")
+	}
+	epoch, id := c.placementIdentity(face.Font, gid, own)
+	if epoch == nil || id != ^uint32(0) {
+		t.Fatal("last identity not issued")
+	}
+	otherGID, _ := face.NominalGlyph('B')
+	other, _ := c.ordinary(face, otherGID)
+	_, exhausted := c.placementIdentity(face.Font, otherGID, other)
+	if exhausted != 0 || c.nextIdentity != ^uint32(0) {
+		t.Fatal("exhaustion wrapped")
+	}
+	again, live := c.placementIdentity(face.Font, gid, own)
+	if again != epoch || live != id {
+		t.Fatal("exhaustion revoked live identity")
+	}
+	fresh := &staticOutlineCache{}
+	replacement, _ := fresh.ordinary(face, gid)
+	newEpoch, newID := fresh.placementIdentity(face.Font, gid, replacement)
+	if newEpoch == nil || newEpoch == epoch || newID != 1 {
+		t.Fatal("cache epochs alias")
+	}
+	r, key, e := placementUnit(t)
+	key.generation = 0
+	if r.drawPlacedGlyphCoverage(image.NewUniform(color.White), key) {
+		t.Fatal("zero generation reused")
+	}
+	r.glyphCoverage.placements = nil
+	r.glyphCoverage.rememberPlacement(key, e, image.Point{}, image.Rectangle{})
+	if r.glyphCoverage.placements != nil {
+		t.Fatal("zero generation learned")
+	}
+}

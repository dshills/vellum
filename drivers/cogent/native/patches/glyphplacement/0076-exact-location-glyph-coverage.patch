+func placementFixture() [2]render.Render {
+	item := coverageSmallItem()
+	var result [2]render.Render
+	for frame := range result {
+		for row := 0; row < 50; row++ {
+			for col := 0; col < 8; col++ {
+				v := *item
+				v.Context.Bounds.Rect = math32.B2(0, 0, 1519, 1266)
+				v.Position = math32.Vec2(float32(10+col*96), float32(24+row*12+frame*12))
+				result[frame] = append(result[frame], &v)
+			}
+		}
+	}
+	return result
+}

+func TestVellumGlyphPlacementExactLogicalWorkCharge(t *testing.T) {
+	item := coverageSmallItem()
+	r := New(math32.Vec2(256, 64)).(*Renderer)
+	defer r.Release()
+	for range 3 {
+		if r.ScenePacket(render.Render{item}) == nil {

+func placementUnit(t *testing.T) (*Renderer, glyphPlacementKey, *glyphCoverageEntry) {
+	t.Helper()
+	r := New(math32.Vec2(256, 64)).(*Renderer)
+	t.Cleanup(r.Release)
+	r.Scanner.SetClip(r.image.Bounds())
+	r.Path = coverageGlyphPath(coverageSmallItem(), math32.Vec2(8, 24))
+	key := glyphPlacementKey{outline: &outlineIdentity{1}, generation: 1, scale: 1, x: 2, y: 3}
+	fill := image.NewUniform(color.NRGBA{31, 77, 119, 193})
+	if !r.drawGlyphCoverageAt(fill, key) {
+		t.Fatal("warm draw refused")
+	}
+	if r.glyphCoverage.placements == nil || r.glyphCoverage.placements.count != 1 {
+		t.Fatal("no learned placement")
+	}
+	v := r.glyphCoverage.placements.entries[key]
+	e := r.glyphCoverage.entries[v.hash]
+	if e == nil {
+		t.Fatal("no live coverage")
+	}
+	r.Path.Clear()
+	return r, key, e
+}

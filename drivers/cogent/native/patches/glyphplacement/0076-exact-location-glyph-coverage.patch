+func TestVellumGlyphPlacementCannotLearnHashCollision(t *testing.T) {
+	r, key, e := placementUnit(t)
+	c := r.glyphCoverage
+	c.placements = nil
+	// An occupied fingerprint with a different full path must preserve drawing
+	// while refusing to teach the placement index a false identity.
+	fake := *e
+	fake.path = append(Path(nil), e.path...)
+	fake.path[1]++
+	fake.identity = &glyphCoverageIdentity{1}
+	c.entries[e.hash] = &fake
+	r.Path = coverageGlyphPath(coverageSmallItem(), math32.Vec2(8, 24))
+	if !r.drawGlyphCoverageAt(image.NewUniform(color.White), key) {
+		t.Fatal("collision prevented original draw")
+	}
+	if c.placements != nil {
+		t.Fatal("handled-but-unretained draw learned a placement")
+	}
+}

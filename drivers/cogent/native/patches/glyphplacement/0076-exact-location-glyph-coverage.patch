+func TestVellumGlyphPlacementCooldownThresholdAndRouting(t *testing.T) {
+	for _, wins := range []uint32{glyphPlacementProbeWindow/8 - 1, glyphPlacementProbeWindow / 8} {
+		p := &glyphPlacementCache{count: glyphPlacementEntries}
+		for i := uint32(0); i < glyphPlacementProbeWindow; i++ {
+			p.observe(i < wins)
+		}
+		if (p.skip != 0) != (wins < glyphPlacementProbeWindow/8) {
+			t.Fatal("cooldown threshold changed", wins)
+		}
+	}
+	item := coverageSmallItem()
+	run := item.Text.Lines[0].Runs[0].(*shapedgt.Run)
+	originalGlyphs := run.Glyphs
+	run.Glyphs = run.Glyphs[:1]
+	defer func() { run.Glyphs = originalGlyphs }()
+	item.Context.Bounds.Rect = math32.B2(0, 0, 512, 64)
+	r := New(math32.Vec2(512, 64)).(*Renderer)
+	defer r.Release()
+	original := New(math32.Vec2(512, 64)).(*Renderer)
+	defer original.Release()
+	for i := 0; i < glyphPlacementEntries; i++ {
+		item.Position = math32.Vec2(8+float32(i%2048)*.125, 24+float32(i/2048)*.125)
+		if r.ScenePacket(render.Render{item}) == nil {
+			t.Fatal("placement fill refused", i)
+		}
+	}
+	p := r.glyphCoverage.placements
+	if p == nil || p.count != glyphPlacementEntries {
+		t.Fatal("actual index not populated")
+	}
+	p.skip = 2
+	head, count, hits := p.head, p.count, p.hits
+	retained := item.Position
+	item.Position = math32.Vec2(300, 24)
+	placementCompare(t, r, original, render.Render{item})
+	if p.skip != 1 || p.head != head || p.count != count || p.hits != hits {
+		t.Fatal("cooldown learned or reused a placement")
+	}
+	item.Position = retained
+	placementCompare(t, r, original, render.Render{item})
+	if p.skip != 0 || p.head != head || p.hits != hits {
+		t.Fatal("cooldown did not preserve original routing")
+	}
+	placementCompare(t, r, original, render.Render{item})
+	if p.hits != hits+1 {
+		t.Fatal("exact reuse did not resume after bounded cooldown")
+	}
+}

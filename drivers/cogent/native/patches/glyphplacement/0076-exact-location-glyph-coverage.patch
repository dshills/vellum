+	g := &run.Glyphs[0]
+	outline, _ := r.staticOutlines().ordinary(run.Face, g.GlyphID)
+	scale := math32.FromFixed(run.Size) / float32(run.Face.Upem())
+	bounds, ok := originalOutlineBounds(outline, scale, item.Position)
+	if !ok {
+		t.Fatal("bounds")
+	}
+	extent := 1 + int(bounds.Size().X) + int(bounds.Size().Y)
+	const initial = 1 << 20
+	r.sceneRecord = sceneplan.New(r.image.Bounds())
+	r.sceneWork = &sceneWorkBudget{remaining: initial, outlines: font.NewGlyphOutlineBudget(1<<20, 1<<20)}
+	originalSpanner := r.Scanner.Spanner
+	r.Scanner.Spanner = &sceneSpanner{builder: r.sceneRecord}
+	defer func() { r.Scanner.Spanner = originalSpanner; r.sceneRecord = nil; r.sceneWork = nil }()
+	r.Scanner.SetClip(r.image.Bounds())
+	r.GlyphOutline(&item.Context, run, g, outline, image.NewUniform(item.Text.Color), nil, run.GlyphBoundsBox(g), item.Position, true)
+	if r.sceneRecord.Failed() || r.sceneWork.remaining != initial-len(outline.Segments)*(1+extent) {
+		t.Fatal("original logical work charge differs", r.sceneWork.remaining)
+	}
+}

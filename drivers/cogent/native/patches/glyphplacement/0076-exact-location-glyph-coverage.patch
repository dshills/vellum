+func BenchmarkVellumGlyphPlacementCapture(b *testing.B) {
+	for _, mode := range []string{"fixed", "alternating-rows", "cold-coordinates"} {
+		b.Run(mode, func(b *testing.B) {
+			commands := placementFixture()
+			r := New(math32.Vec2(1519, 1266)).(*Renderer)
+			defer r.Release()
+			for i := 0; i < 4; i++ {
+				if r.ScenePacket(commands[i%2]) == nil {
+					b.Fatal("warmup refused")
+				}
+			}
+			b.ReportAllocs()
+			b.ResetTimer()
+			for i := 0; i < b.N; i++ {
+				n := 0
+				if mode == "alternating-rows" {
+					n = i % 2
+				}
+				if mode == "cold-coordinates" {
+					for index, item := range commands[0] {
+						v := item.(*render.Text)
+						v.Position.Y = float32(24+(index/8)*12) + float32(i%128)*.125
+					}
+				}
+				if r.ScenePacket(commands[n]) == nil {
+					b.Fatal("capture refused")
+				}
+			}
+		})
+	}

+func TestVellumGlyphPlacementCurrentGuards(t *testing.T) {
+	changes := map[string]func(*Renderer){
+		"width":         func(r *Renderer) { r.Scanner.Width-- },
+		"height":        func(r *Renderer) { r.Scanner.CellIndex = r.Scanner.CellIndex[:len(r.Scanner.CellIndex)-1] },
+		"scanner-owner": func(r *Renderer) { r.Raster.Filler.Scanner = scan.NewScannerWithRowTracking(r.ImgSpanner, 256, 64) },
+		"pending-area":  func(r *Renderer) { r.Scanner.Area = 1 },
+		"pending-pen":   func(r *Renderer) { r.Raster.Filler.A.X = 1 },
+		"clip":          func(r *Renderer) { r.Scanner.SetClip(image.Rect(10, 20, 256, 64)) },
+		"empty-clip":    func(r *Renderer) { r.Scanner.SetClip(image.Rectangle{}) },
+		"spanner-owner": func(r *Renderer) { r.Scanner.Spanner = &sceneSpanner{builder: sceneplan.New(r.image.Bounds())} },
+	}
+	for name, change := range changes {
+		t.Run(name, func(t *testing.T) {
+			r, key, _ := placementUnit(t)
+			change(r)
+			before := bytes.Clone(r.image.Pix)
+			hits := r.glyphCoverage.hits
+			if r.drawPlacedGlyphCoverage(image.NewUniform(color.White), key) || hits != r.glyphCoverage.hits || !bytes.Equal(before, r.image.Pix) {
+				t.Fatal("changed guard bypassed")
+			}
+		})
+	}
+	r, key, _ := placementUnit(t)
+	calls := 0
+	if r.drawPlacedGlyphCoverage(image.NewUniform(coveredDrawColor{&calls}), key) || calls != 0 {
+		t.Fatal("custom fill called/reused")
+	}
+	// A successful fast draw follows the original scanner cleanup and recoloring.
+	original := New(math32.Vec2(256, 64)).(*Renderer)
+	defer original.Release()
+	original.Scanner.SetClip(original.image.Bounds())
+	coverageSeed(r)
+	coverageSeed(original)
+	fill := image.NewUniform(color.NRGBA{71, 11, 39, 91})
+	if !r.drawPlacedGlyphCoverage(fill, key) {
+		t.Fatal("valid fast draw missed")
+	}
+	coverageReference(original, coverageGlyphPath(coverageSmallItem(), math32.Vec2(8, 24)), fill)
+	if !bytes.Equal(r.image.Pix, original.image.Pix) || r.Scanner.Area != 0 || r.Scanner.Cover != 0 || len(r.Scanner.Cell) != 0 {
+		t.Fatal("fast pixels/state differ")
+	}
+}

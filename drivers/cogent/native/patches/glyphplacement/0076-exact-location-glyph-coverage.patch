+	for _, matrix := range []math32.Matrix2{math32.Translate2D(.25, .5), math32.Scale2D(1.1, .9), math32.Rotate2D(.01), math32.Identity2()} {
+		item.Context.Cumulative = matrix
+		placementCompare(t, r, original, render.Render{item})
+	}
+	item.Context.Cumulative = math32.Identity2()
+	for _, clip := range []math32.Box2{math32.B2(10, 0, 8192, 64), math32.B2(0, 20, 8192, 64), math32.B2(0, 0, 8192, 64)} {
+		item.Context.Bounds.Rect = clip
+		item.Text.Color = color.NRGBA{R: 91, G: 17, B: 39, A: 71}
+		placementCompare(t, r, original, render.Render{item})
+	}
+	old := r.glyphCoverage
+	r.SetSize(units.UnitDot, math32.Vec2(256, 64))
+	original.SetSize(units.UnitDot, math32.Vec2(256, 64))
+	if r.glyphCoverage != nil {
+		t.Fatal("resize retained placement owner")
+	}
+	item.Context.Bounds.Rect = math32.B2(0, 0, 256, 64)
+	item.Position = math32.Vec2(8, 24)
+	placementCompare(t, r, original, render.Render{item})
+	if r.glyphCoverage == old {
+		t.Fatal("resize reused prior owner")
+	}
+	r.Release()
+	r.Release()
+	if r.glyphCoverage != nil || r.outlineCache != nil {
+		t.Fatal("release retained owner")
+	}
+}

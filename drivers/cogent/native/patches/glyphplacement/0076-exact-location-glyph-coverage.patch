+func TestVellumGlyphPlacementBoundedProbeCooldown(t *testing.T) {
+	p := &glyphPlacementCache{count: glyphPlacementEntries}
+	for range glyphPlacementProbeWindow {
+		p.observe(false)
+	}
+	if p.skip != glyphPlacementCooldown || p.probes != 0 || p.wins != 0 {
+		t.Fatal("cold probes not bounded")
+	}
+	r := &Renderer{glyphCoverage: &glyphCoverageCache{placements: p}}
+	for range glyphPlacementCooldown {
+		if r.glyphPlacementActive() {
+			t.Fatal("cooldown returned early")
+		}
+	}
+	if !r.glyphPlacementActive() {
+		t.Fatal("bounded cooldown never resumed")
+	}
+	for range glyphPlacementProbeWindow {
+		p.observe(true)
+	}
+	if p.skip != 0 || p.probes != 0 || p.wins != 0 {
+		t.Fatal("useful probes disabled")
+	}
+	p.count = glyphPlacementEntries - 1
+	for range glyphPlacementProbeWindow {
+		p.observe(false)
+	}
+	if p.skip != 0 || p.probes != 0 {
+		t.Fatal("cold fill disabled before index was populated")
+	}
+}

+func TestVellumGlyphPlacementBoundedFIFOAndStaleCoverage(t *testing.T) {
+	r, key, e := placementUnit(t)
+	c := r.glyphCoverage
+	p := c.placements
+	v := p.entries[key]
+	for i := 0; i < glyphPlacementEntries+17; i++ {
+		k := key
+		k.x = uint32(i + 100)
+		c.rememberPlacement(k, e, v.origin, v.hull)
+		if len(p.entries) > glyphPlacementEntries || p.count != len(p.entries) {
+			t.Fatal("unbounded placements")
+		}
+	}
+	if _, ok := p.entries[key]; ok {
+		t.Fatal("oldest placement not evicted")
+	}
+	for _, k := range p.queue {
+		if _, ok := p.entries[k]; !ok {
+			t.Fatal("FIFO orphan")
+		}
+	}
+	c.rememberPlacement(key, e, v.origin, v.hull)
+	count := p.count
+	c.rememberPlacement(key, e, v.origin, v.hull)
+	if p.count != count {
+		t.Fatal("duplicate key consumes FIFO")
+	}
+	fill := image.NewUniform(color.NRGBA{31, 77, 119, 193})
+	// A different entry can reuse a colliding hash; its token must invalidate the
+	// old placement without retaining the old path/spans through this metadata.
+	replacement := *e
+	replacement.identity = &glyphCoverageIdentity{1}
+	c.entries[e.hash] = &replacement
+	before := bytes.Clone(r.image.Pix)
+	if r.drawPlacedGlyphCoverage(fill, key) || !bytes.Equal(before, r.image.Pix) {
+		t.Fatal("stale hash placement reused")
+	}
+	c.entries[e.hash] = e
+	c.evict()
+	if r.drawPlacedGlyphCoverage(fill, key) {
+		t.Fatal("evicted coverage reused")
+	}
+}

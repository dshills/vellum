+func TestVellumGlyphPlacementLiveOutlineIdentity(t *testing.T) {
+	face := vellumOutlineFace(t)
+	gid, _ := face.NominalGlyph('0')
+	c := &staticOutlineCache{}
+	own, ok := c.ordinary(face, gid)
+	if !ok {
+		t.Fatal("outline")
+	}
+	first, firstID := c.placementIdentity(face.Font, gid, own)
+	if first == nil || firstID == 0 {
+		t.Fatal("no owned identity")
+	}
+	cloned := font.GlyphOutline{Segments: append([]font.Segment(nil), own.Segments...)}
+	if id, generation := c.placementIdentity(face.Font, gid, cloned); id != nil || generation != 0 {
+		t.Fatal("caller outline trusted")
+	}
+	c.mu.Lock()
+	c.evict()
+	c.mu.Unlock()
+	if id, generation := c.placementIdentity(face.Font, gid, own); id != nil || generation != 0 {
+		t.Fatal("evicted outline trusted")
+	}
+	replacement, ok := c.ordinary(face, gid)
+	if !ok {
+		t.Fatal("replacement outline")
+	}
+	second, secondID := c.placementIdentity(face.Font, gid, replacement)
+	if second == nil || secondID == 0 || first != second || firstID == secondID {
+		t.Fatal("outline identity reused after replacement")
+	}
+	if id, generation := c.placementIdentity(face.Font, gid, own); id != nil || generation != 0 {
+		t.Fatal("old slice trusted under new key")
+	}
+}
+
+func placementCompare(t *testing.T, r, original *Renderer, commands render.Render) {
+	t.Helper()
+	a, b := r.ScenePacket(commands), original.vellumFreshScenePacket(commands)
+	if (a == nil) != (b == nil) {
+		t.Fatal("packet admission differs")
+	}
+	if a == nil {
+		return
+	}
+	for _, gpu := range []bool{false, true} {
+		var x, y *sceneplan.Encoded
+		var ok, accepted bool
+		if gpu {
+			x, ok = a.EncodeGPU()
+			y, accepted = b.EncodeGPU()
+		} else {
+			x, ok = a.Encode()
+			y, accepted = b.Encode()
+		}
+		if ok != accepted || !reflect.DeepEqual(x, y) {
+			t.Fatal("packet bytes differ", gpu)
+		}
+	}
+	x, y := image.NewRGBA(a.Bounds()), image.NewRGBA(b.Bounds())
+	for i := range x.Pix {
+		x.Pix[i] = byte(i*17 + 3)
+		y.Pix[i] = x.Pix[i]
+	}
+	if !a.Replay(x) || !b.Replay(y) || !bytes.Equal(x.Pix, y.Pix) {
+		t.Fatal("replay pixels differ")
+	}
+}
+
+func TestVellumGlyphPlacementExactInputsAndPackets(t *testing.T) {

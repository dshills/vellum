+// Copyright (c) 2026, Davin Hills.
+// SPDX-License-Identifier: MIT
+package sceneplan
+
+import (
+	"image"
+	"image/color"
+	"image/draw"
+	"math/rand"
+	"reflect"
+	"slices"
+	"sort"
+	"testing"
+	"unsafe"
+)
+
+// Deep copies keep a falsely declining implementation from mutating the same
+// row/header backing used by the expected snapshot.
+func packedState(b *Builder) any {
+	clone := func(rows [][]span) [][]span {
+		out := slices.Clone(rows)
+		for i := range out {
+			out[i] = slices.Clone(out[i])
+		}
+		return out
+	}
+	state := struct {
+		bytes, count, rowMin, scratchCount, scratchBytes int
+		failed, packed                                   bool
+		stream                                           *operation
+		value                                            operation
+		headers                                          [9][][]span
+		scratch                                          [32][]span
+	}{bytes: b.packet.bytes, count: b.count, rowMin: b.streamRowMin, scratchCount: b.spanScratchCount, scratchBytes: b.spanScratchBytes, failed: b.failed, packed: b.streamPacked, stream: b.stream, value: b.streamValue}
+	state.value.rows = clone(b.streamValue.rows)
+	for i, rows := range b.spanHeaders {
+		state.headers[i] = clone(rows)
+	}
+	for i, row := range b.spanScratch {
+		state.scratch[i] = slices.Clone(row)
+	}
+	return state
+}
+
+func packedReference(t *testing.T, b *Builder, w *spanScratchReferenceBuilder, samples []SpanSample, origin image.Point) bool {
+	t.Helper()
+	before := packedState(b)
+	fast := b.PackedSpans(samples, origin)
+	if !fast {
+		if !reflect.DeepEqual(packedState(b), before) {
+			t.Fatal("declined packed admission mutated builder")
+		}
+		for _, s := range samples {
+			b.Span(int(s.Y)+origin.Y, int(s.X0)+origin.X, int(s.X1)+origin.X, s.Alpha)
+		}
+	}
+	for _, s := range samples {
+		w.Span(int(s.Y)+origin.Y, int(s.X0)+origin.X, int(s.X1)+origin.X, s.Alpha)
+	}
+	assertSpanScratchReference(t, b, w)
+	return fast
+}
+
+func TestVellumPackedSpansOriginalAdmissionEncoding(t *testing.T) {
+	rng := rand.New(rand.NewSource(67066))
+	fastCount := 0
+	for _, height := range []int{1, 3, 127, 128, 255, 257, 300, 1024} {
+		for trial := 0; trial < 40; trial++ {
+			bounds := image.Rect(0, 0, 67, height)
+			b, w := New(bounds), newSpanScratchReference(bounds)
+			for stream := 0; stream < 4; stream++ {
+				op := draw.Op(stream % 2)
+				c := color.RGBA{13, 29, 61, 128}
+				b.BeginSpans(c, op)
+				w.BeginSpans(c, op)
+				samples := make([]SpanSample, 1+rng.Intn(256))
+				for i := range samples {
+					x := rng.Intn(30)
+					samples[i] = SpanSample{int32(rng.Intn(height)), int32(x), int32(x + 1 + rng.Intn(30)), uint32(rng.Intn(65536))}
+					if i%9 == 0 {
+						samples[i].Alpha = 0
+					}
+				}
+				sort.SliceStable(samples, func(i, j int) bool { return samples[i].Y < samples[j].Y })
+				if packedReference(t, b, w, samples, image.Point{}) {
+					fastCount++
+				}
+				if stream == 2 {
+					empty := b.stream.rect.Empty()
+					if packedReference(t, b, w, []SpanSample{{0, 1, 3, 1}}, image.Point{}) != empty {
+						t.Fatal("packed admission disagrees with active stream state")
+					}
+				}
+				// Ascending/descending, clipped and translucent ordinary spans must still
+				// append to the same operation and retain independent scratch ownership.
+				if stream%2 == 1 {
+					for _, y := range []int{height - 1, 0, height / 2, -1, height} {
+						b.Span(y, -3, 29, 32769)
+						w.Span(y, -3, 29, 32769)
+						assertSpanScratchReference(t, b, w)
+					}
+				}
+				b.flush()
+				w.flush()
+				assertSpanScratchReference(t, b, w)
+				checkHeaderScratch(t, b)
+			}
+			got, want := b.Seal(trial%2 == 0), w.Seal(trial%2 == 0)
+			if got == nil || want == nil || got.Bytes() != want.Bytes() || !reflect.DeepEqual(got.ops, want.ops) {
+				t.Fatal("packed packet or admission differs", height, trial)
+			}
+			for _, gpu := range []bool{false, true} {
+				ge, gok := got.Encode()
+				we, wok := want.Encode()
+				if gpu {
+					ge, gok = got.EncodeGPU()
+					we, wok = want.EncodeGPU()
+				}
+				if !gok || !wok || !reflect.DeepEqual(ge, we) {
+					t.Fatal("packed encoding differs", height, trial, gpu)
+				}
+			}
+			if b.streamPacked || b.stream != nil || !reflect.DeepEqual(b.streamValue, operation{}) {
+				t.Fatal("retired packed references")
+			}
+		}
+	}
+	if fastCount != 1280 {
+		t.Fatal("fixture lost fast path", fastCount)
+	}
+}
+
+func TestVellumPackedSpansPeakBudgetAndOperationRefusal(t *testing.T) {
+	samples := []SpanSample{{0, 1, 3, 1}, {1, 1, 3, 2}, {2, 1, 3, 3}, {3, 1, 3, 4}, {4, 1, 3, 5}, {5, 1, 3, 6}}
+	// Six rows occupy eight construction headers. Peak admission, spare-header
+	// refund and subsequent operation admission remain distinct boundaries.
+	construction := 6*int(unsafe.Sizeof(span{})) + 8*int(unsafe.Sizeof([]span{}))
+	retained := construction - 2*int(unsafe.Sizeof([]span{})) + int(unsafe.Sizeof(operation{}))
+	for _, remaining := range []int{construction - 1, construction, retained - 1, retained} {
+		b, w := New(image.Rect(0, 0, 32, 32)), newSpanScratchReference(image.Rect(0, 0, 32, 32))
+		b.BeginSpans(color.RGBA{}, draw.Src)
+		w.BeginSpans(color.RGBA{}, draw.Src)
+		b.spanHeaders[3] = make([][]span, 8)
+		b.packet.bytes, w.packet.bytes = MaxBytes-remaining, MaxBytes-remaining
+		fast := packedReference(t, b, w, samples, image.Point{})
+		if fast != (remaining >= construction) {
+			t.Fatal("packed peak admission boundary changed", remaining, fast)
+		}
+		got, want := b.Seal(true), w.Seal(true)
+		if (got == nil) != (want == nil) || (got != nil) != (remaining >= max(construction, retained)) {
+			t.Fatal("operation admission boundary changed", remaining)
+		}
+		if got != nil && (got.Bytes() != want.Bytes() || !reflect.DeepEqual(got.ops, want.ops)) {
+			t.Fatal("exact retained charge changed")
+		}
+	}
+	b, w := New(image.Rect(0, 0, 32, 32)), newSpanScratchReference(image.Rect(0, 0, 32, 32))
+	b.BeginSpans(color.RGBA{}, draw.Over)
+	w.BeginSpans(color.RGBA{}, draw.Over)
+	if !packedReference(t, b, w, []SpanSample{{0, 0, 1, 0}}, image.Point{}) || b.streamPacked {
+		t.Fatal("empty Over stream acquired storage")
+	}
+	if !packedReference(t, b, w, samples, image.Point{}) {
+		t.Fatal("fixture")
+	}
+	b.count, w.count = MaxOps, MaxOps
+	if b.Seal(false) != nil || w.Seal(false) != nil || b.streamPacked || b.spanScratchCount != 0 {
+		t.Fatal("operation refusal leaked packed state")
+	}
+}
+
+func TestVellumPackedSpansAtomicDeclineAndBudget(t *testing.T) {
+	samples := []SpanSample{{0, 1, 3, 0}, {2, 2, 8, 32769}, {2, 1, 9, 65535}, {5, 3, 7, 1}}
+	for _, op := range []draw.Op{draw.Src, draw.Over} {
+		for _, remaining := range []int{0, 1, 23, 24, 47, 48, 99, 100, 263, 264, 265, 511, 512, 1024} {
+			b, w := New(image.Rect(0, 0, 32, 7)), newSpanScratchReference(image.Rect(0, 0, 32, 7))
+			b.BeginSpans(color.RGBA{}, op)
+			w.BeginSpans(color.RGBA{}, op)
+			b.packet.bytes = MaxBytes - remaining
+			w.packet.bytes = b.packet.bytes
+			packedReference(t, b, w, samples, image.Point{})
+			got, want := b.Seal(true), w.Seal(true)
+			if (got == nil) != (want == nil) || got != nil && (got.Bytes() != want.Bytes() || !reflect.DeepEqual(got.ops, want.ops)) {
+				t.Fatal("budget refusal differs", op, remaining)
+			}
+			if b.streamPacked || b.stream != nil {
+				t.Fatal("refused retirement retained packed stream")
+			}
+		}
+	}
+	cases := [][]SpanSample{nil, make([]SpanSample, 257), {{3, 0, 1, 1}, {2, 0, 1, 1}}, {{-1, 0, 1, 1}}, {{32, 0, 1, 1}}, {{0, -1, 1, 1}}, {{0, 0, 33, 1}}, {{0, 2, 1, 1}}, {{0, 0, 1, 65536}}}
+	for _, samples := range cases {
+		b, w := New(image.Rect(0, 0, 32, 32)), newSpanScratchReference(image.Rect(0, 0, 32, 32))
+		b.BeginSpans(color.RGBA{}, draw.Over)
+		w.BeginSpans(color.RGBA{}, draw.Over)
+		if packedReference(t, b, w, samples, image.Point{}) {
+			t.Fatal("unsupported input entered fast path", samples)
+		}
+	}
+	b := New(image.Rect(0, 0, 32, 32))
+	b.BeginSpans(color.RGBA{}, draw.Src)
+	for _, origin := range []image.Point{{-1, 0}, {0, -1}, {MaxDimension + 1, 0}, {int(^uint(0) >> 1), int(^uint(0) >> 1)}} {
+		before := packedState(b)
+		if b.PackedSpans(samples, origin) || !reflect.DeepEqual(before, packedState(b)) {
+			t.Fatal("unsafe translation admitted/mutated")
+		}
+	}
+}

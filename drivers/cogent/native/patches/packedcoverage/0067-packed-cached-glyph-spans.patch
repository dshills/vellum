+func TestVellumPackedSpansOwnershipAndOrdinaryNoops(t *testing.T) {
+	samples := []SpanSample{{0, 1, 3, 32769}, {2, 2, 8, 65535}}
+	b, w := New(image.Rect(0, 0, 32, 32)), newSpanScratchReference(image.Rect(0, 0, 32, 32))
+	b.BeginSpans(color.RGBA{11, 13, 17, 128}, draw.Over)
+	w.BeginSpans(color.RGBA{11, 13, 17, 128}, draw.Over)
+	if !packedReference(t, b, w, samples, image.Pt(3, 7)) {
+		t.Fatal("translated coverage not packed")
+	}
+	held := b.stream.rows
+	packedRow := held[0]
+	samples[0] = SpanSample{1, 9, 12, 1}
+	for _, v := range []struct {
+		y, x0, x1 int
+		a         uint32
+	}{{-1, 0, 1, 1}, {32, 0, 1, 1}, {7, 0, 0, 1}, {7, 0, 1, 0}} {
+		before := packedState(b)
+		b.Span(v.y, v.x0, v.x1, v.a)
+		if !reflect.DeepEqual(before, packedState(b)) || !b.streamPacked {
+			t.Fatal("ordinary no-op detached packed rows")
+		}
+	}
+	b.packet.bytes = MaxBytes
+	w.packet.bytes = MaxBytes
+	b.Span(7, 0, 1, 1)
+	w.Span(7, 0, 1, 1)
+	if !b.failed || !b.streamPacked || &b.stream.rows[0][0] != &packedRow[0] {
+		t.Fatal("refused append detached before reservation")
+	}
+	b.Seal(false)
+	if b.streamPacked || b.stream != nil {
+		t.Fatal("refused packed backing retained")
+	}
+
+	b, w = New(image.Rect(0, 0, 32, 32)), newSpanScratchReference(image.Rect(0, 0, 32, 32))
+	b.BeginSpans(color.RGBA{}, draw.Src)
+	w.BeginSpans(color.RGBA{}, draw.Src)
+	samples = []SpanSample{{0, 1, 3, 32769}, {2, 2, 8, 65535}}
+	if !packedReference(t, b, w, samples, image.Pt(3, 7)) {
+		t.Fatal("fixture")
+	}
+	held = b.stream.rows
+	packedRow = held[0]
+	b.Span(7, 0, 1, 1)
+	w.Span(7, 0, 1, 1)
+	if b.streamPacked || &b.stream.rows[0][0] == &packedRow[0] {
+		t.Fatal("ordinary append failed to detach backing")
+	}
+	packedRow[0] = span{25, 31, 123}
+	assertSpanScratchReference(t, b, w)
+	b.flush()
+	w.flush()
+	assertSpanScratchReference(t, b, w)
+	for _, row := range b.head.ops[0].rows {
+		if cap(row) != len(row) {
+			t.Fatal("surplus retained row capacity")
+		}
+	}
+	if b.spanScratchBytes != 3*int(unsafe.Sizeof(span{})) {
+		t.Fatal("unexpected detached scratch charge", b.spanScratchBytes)
+	}
+	if !reflect.DeepEqual(b.Seal(false).ops, w.Seal(false).ops) {
+		t.Fatal("detached packet changed")
+	}
+
+	b = New(image.Rect(0, 0, 32, 32))
+	b.BeginSpans(color.RGBA{}, draw.Src)
+	samples[1].Y = 1 // a power-of-two header band participates in scratch reuse
+	if !b.PackedSpans(samples, image.Pt(3, 7)) {
+		t.Fatal("fixture")
+	}
+	held = b.stream.rows
+	b.flush()
+	if b.spanScratchCount != 0 || b.spanScratchBytes != 0 {
+		t.Fatal("packed subrows entered scratch")
+	}
+	for _, row := range held {
+		if row != nil {
+			t.Fatal("flushed header retained packed backing")
+		}
+	}
+	packet := b.Seal(false)
+	if cap(packet.ops[0].rows) != len(packet.ops[0].rows) {
+		t.Fatal("surplus packed row-header capacity")
+	}
+	for _, row := range packet.ops[0].rows {
+		if cap(row) != len(row) {
+			t.Fatal("surplus packed span capacity")
+		}
+	}
+	before, _ := packet.EncodeGPU()
+	for i := range held {
+		held[i] = []span{{0, 32, 65535}}
+	}
+	samples[0] = SpanSample{}
+	after, _ := packet.EncodeGPU()
+	if !reflect.DeepEqual(before, after) {
+		t.Fatal("caller or header alias changed packet")
+	}
+}

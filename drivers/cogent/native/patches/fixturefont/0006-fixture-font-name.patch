+// Copyright (c) 2026 Davin Hills. SPDX-License-Identifier: MIT.
+package font
+
+import (
+	"os"
+	"strings"
+	"testing"
+
+	ot "github.com/go-text/typesetting/font/opentype"
+	"github.com/go-text/typesetting/font/opentype/tables"
+)
+
+func TestVellumFixturePrimaryNamesAndDeclarations(t *testing.T) {
+	f, err := os.Open("testdata/Selawik-VF-Subset.ttf")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	loader, err := ot.NewLoader(f)
+	if err != nil {
+		t.Fatal(err)
+	}
+	raw, err := loader.RawTable(ot.MustNewTag("name"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	names, _, err := tables.ParseName(raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for id, want := range map[tables.NameID]string{
+		1: "Vellum Invalid Variation Fixture",
+		3: "Vellum Invalid Variation Fixture; revision 1",
+		4: "Vellum Invalid Variation Fixture",
+		6: "VellumInvalidVariationFixture-Regular",
+	} {
+		if got := names.Name(id); got != want {
+			t.Errorf("primary name %d = %q, want %q", id, got, want)
+		}
+	}
+	if got := names.Name(0); !strings.Contains(got, "2015 Microsoft Corporation") || !strings.Contains(got, "Reserved Font Name Selawik") {
+		t.Errorf("original copyright/RFN declaration lost: %q", got)
+	}
+	if got := names.Name(13); got != "This Font Software is licensed under the SIL Open Font License, Version 1.1." {
+		t.Errorf("original font license lost: %q", got)
+	}
+	if got := names.Name(2); got != "Regular" {
+		t.Errorf("original style changed: %q", got)
+	}
+}

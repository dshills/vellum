+func TestVellumHeadlessDeviceAdmissionAndPartialRetirement(t *testing.T) {
+	failure := errors.New("controlled device refusal")
+	for _, stage := range []string{"no_gpu", "device_error", "partial_device", "nil_device", "success"} {
+		t.Run(stage, func(t *testing.T) {
+			var events []string
+			gpu := &textureRef{name: "gpu", valid: true, events: &events}
+			device := &textureRef{name: "device", valid: true, events: &events}
+			calls := 0
+			g, d, err := createHeadlessPair(func() *textureRef {
+				if stage == "no_gpu" {
+					return nil
+				}
+				return gpu
+			}, func(g *textureRef) (*textureRef, error) {
+				calls++
+				if g != gpu {
+					t.Fatal("wrong adapter")
+				}
+				switch stage {
+				case "device_error":
+					return nil, failure
+				case "partial_device":
+					return device, failure
+				case "nil_device":
+					return nil, nil
+				}
+				return device, nil
+			})
+			if stage == "success" {
+				if err != nil || g != gpu || d != device || len(events) != 0 {
+					t.Fatal("complete device pair not retained", err, events)
+				}
+				device.Release()
+				gpu.Release()
+				return
+			}
+			if err == nil || g != nil || d != nil {
+				t.Fatal("incomplete admission published", err, g, d)
+			}
+			if stage == "no_gpu" {
+				if calls != 0 || len(events) != 0 {
+					t.Fatal("nil adapter reached device factory")
+				}
+				return
+			}
+			if calls != 1 || gpu.releases != 1 {
+				t.Fatal("adapter admission leaked/retried", calls, events)
+			}
+			want := []string{"gpu"}
+			if stage == "partial_device" {
+				want = []string{"device", "gpu"}
+			}
+			if !reflect.DeepEqual(events, want) {
+				t.Fatal("admission cleanup order differs", events)
+			}
+			if (stage == "device_error" || stage == "partial_device") && err != failure {
+				t.Fatal("device error identity lost")
+			}
+		})
+	}

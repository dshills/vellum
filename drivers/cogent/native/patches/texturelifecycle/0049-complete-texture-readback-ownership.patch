+func TestVellumReadBufferThousandResizesHaveExplicitRetirement(t *testing.T) {
+	var current *textureRef
+	var dims TextureBufferDims
+	var events []string
+	var refs []*textureRef
+	live, peak := 0, 0
+	for i := 0; i < 1000; i++ {
+		want := *NewTextureBufferDims(image.Pt(64+i%3, i+1))
+		err := replaceReadBuffer(&current, &dims, want, func() (*textureRef, error) {
+			for _, r := range refs {
+				if r.releases > 1 {
+					t.Fatal("staging released twice")
+				}
+			}
+			live = 0
+			for _, r := range refs {
+				if r.releases == 0 {
+					live++
+				}
+			}
+			live++
+			if live > peak {
+				peak = live
+			}
+			r := &textureRef{name: "retire", valid: true, events: &events}
+			refs = append(refs, r)
+			return r, nil
+		})
+		if err != nil || current != refs[len(refs)-1] || dims != want {
+			t.Fatal("resize not committed", i, err)
+		}
+		if len(events) != i {
+			t.Fatal("old staging waiting for GC", i, len(events))
+		}
+	}
+	current.Release()
+	for _, r := range refs {
+		if r.releases != 1 {
+			t.Fatal("staging ownership retained", r.releases)
+		}
+	}
+	if peak != 2 || len(events) != 1000 {
+		t.Fatal("replacement exceeds old-plus-new ownership", peak, len(events))
+	}
+}

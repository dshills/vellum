+)
+
+type textureRef struct {
+	name     string
+	valid    bool
+	releases int
+	events   *[]string
+}
+
+func (r *textureRef) IsValid() bool { return r != nil && r.valid && r.releases == 0 }
+func (r *textureRef) Release()      { r.releases++; *r.events = append(*r.events, r.name) }
+
+func TestVellumTexturePairPublishesOnlyCompleteCreation(t *testing.T) {
+	failure := errors.New("controlled texture factory refusal")
+	for _, stage := range []string{"texture_error", "partial_texture", "nil_texture", "invalid_texture", "view_error", "partial_view", "nil_view", "invalid_view", "success"} {
+		t.Run(stage, func(t *testing.T) {
+			var events []string
+			texture := &textureRef{name: "texture.release", valid: true, events: &events}
+			view := &textureRef{name: "view.release", valid: true, events: &events}
+			viewCalls := 0
+			x, y, err := createTexturePair(func() (*textureRef, error) {
+				switch stage {
+				case "texture_error":
+					return nil, failure
+				case "partial_texture":
+					return texture, failure
+				case "nil_texture":
+					return nil, nil
+				case "invalid_texture":
+					texture.valid = false
+				}
+				return texture, nil
+			}, func(got *textureRef) (*textureRef, error) {
+				viewCalls++
+				if got != texture {
+					t.Fatal("view used another texture")
+				}
+				switch stage {
+				case "view_error":
+					return nil, failure
+				case "partial_view":
+					return view, failure
+				case "nil_view":
+					return nil, nil
+				case "invalid_view":
+					view.valid = false
+				}
+				return view, nil
+			})
+			if stage == "success" {
+				if err != nil || x != texture || y != view || len(events) != 0 {
+					t.Fatal("complete pair not retained", err, events)
+				}
+				view.Release()
+				texture.Release()
+				return
+			}
+			if err == nil || x != nil || y != nil {
+				t.Fatal("incomplete creation published", stage, x, y, err)
+			}
+			if stage == "texture_error" || stage == "partial_texture" || stage == "view_error" || stage == "partial_view" {
+				if err != failure {
+					t.Fatal("factory error identity lost", err)
+				}
+			}
+			var want []string
+			switch stage {
+			case "partial_texture", "invalid_texture", "view_error", "nil_view":
+				want = []string{"texture.release"}
+			case "partial_view", "invalid_view":
+				want = []string{"view.release", "texture.release"}
+			}
+			if !reflect.DeepEqual(events, want) {
+				t.Fatal("partial ownership differs", events, want)
+			}
+			if (stage == "texture_error" || stage == "partial_texture" || stage == "nil_texture" || stage == "invalid_texture") && viewCalls != 0 {
+				t.Fatal("view factory called for refused texture")
+			}
+		})
+	}
+}
+
+func TestVellumReadBufferRefusalPreservesOldAllocation(t *testing.T) {
+	failure := errors.New("controlled staging refusal")
+	for _, stage := range []string{"error", "partial", "nil", "invalid", "success", "hit"} {
+		t.Run(stage, func(t *testing.T) {
+			var events []string
+			old := &textureRef{name: "old", valid: true, events: &events}
+			next := &textureRef{name: "new", valid: true, events: &events}
+			current := old
+			have := *NewTextureBufferDims(image.Pt(64, 2))
+			original := have
+			want := *NewTextureBufferDims(image.Pt(65, 2))
+			if stage == "hit" {
+				want = have
+			}
+			calls := 0
+			err := replaceReadBuffer(&current, &have, want, func() (*textureRef, error) {
+				calls++
+				switch stage {
+				case "error":
+					return nil, failure
+				case "partial":
+					return next, failure
+				case "nil":
+					return nil, nil
+				case "invalid":
+					next.valid = false
+				}
+				return next, nil
+			})
+			if stage == "hit" {
+				if err != nil || calls != 0 || current != old || have != original || len(events) != 0 {
+					t.Fatal("matching buffer replaced")
+				}
+				return
+			}
+			if calls != 1 {
+				t.Fatal("allocation retry", calls)
+			}
+			if stage == "success" {
+				if err != nil || current != next || have != want || !reflect.DeepEqual(events, []string{"old"}) {
+					t.Fatal("replacement ownership differs", err, events)
+				}
+				return
+			}
+			if err == nil || current != old || have != original || old.releases != 0 {
+				t.Fatal("refusal retired/reconfigured old buffer", err, events)
+			}
+			if (stage == "error" || stage == "partial") && err != failure {
+				t.Fatal("allocation error identity lost")
+			}
+			wantReleases := 0
+			if stage == "partial" || stage == "invalid" {
+				wantReleases = 1
+			}
+			if next.releases != wantReleases {
+				t.Fatal("partial staging not retired", events)
+			}
+		})
+	}
+}

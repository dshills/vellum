+func TestVellumReadbackRefusesInvalidNativeInputsWithoutMutation(t *testing.T) {
+	format := TextureFormat{Size: image.Pt(65, 3), Layers: 1, Samples: 1, Format: wgpu.TextureFormatRGBA8UnormSrgb}
+	tx := &Texture{Format: format, readBuffer: &wgpu.Buffer{}, ReadBufferDims: *NewTextureBufferDims(image.Pt(1, 1))}
+	buffer, dims := tx.readBuffer, tx.ReadBufferDims
+	if err := tx.ConfigReadBuffer(); err == nil {
+		t.Fatal("missing device accepted")
+	}
+	if err := tx.CopyToReadBuffer(&wgpu.CommandEncoder{}); err == nil {
+		t.Fatal("stale layout accepted")
+	}
+	if data, err := tx.ReadDataMapped(); err == nil || data != nil {
+		t.Fatal("stale read configured/mapped a new empty buffer")
+	}
+	if tx.readBuffer != buffer || tx.ReadBufferDims != dims {
+		t.Fatal("refusal changed staging")
+	}
+	tx.ReadBufferDims = *NewTextureBufferDims(format.Size)
+	if err := tx.CopyToReadBuffer(&wgpu.CommandEncoder{}); err == nil {
+		t.Fatal("invalid native staging accepted")
+	}
+	if data, err := tx.ReadDataMapped(); err == nil || data != nil {
+		t.Fatal("invalid native staging mapped")
+	}
+	tx.Release()
+	if tx.readBuffer != nil || tx.ReadBufferDims != (TextureBufferDims{}) {
+		t.Fatal("release retained staging metadata")
+	}
+}

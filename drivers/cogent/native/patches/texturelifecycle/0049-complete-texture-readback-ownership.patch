+func TestVellumReadLayoutAdmissionAndExactPadding(t *testing.T) {
+	format := TextureFormat{Size: image.Pt(65, 3), Layers: 1, Samples: 1, Format: wgpu.TextureFormatRGBA8UnormSrgb}
+	nativeMax := uint64(math.MaxUint32)
+	dims, err := textureReadLayout(format)
+	if err != nil || dims != (TextureBufferDims{Width: 65, Height: 3, UnpaddedRowSize: 260, PaddedRowSize: 512}) || dims.PaddedSize() != 1536 {
+		t.Fatal("padding changed", dims, err)
+	}
+	for _, mutation := range []func(*TextureFormat){
+		func(f *TextureFormat) { f.Size.X = 0 }, func(f *TextureFormat) { f.Size.Y = -1 }, func(f *TextureFormat) { f.Layers = 2 }, func(f *TextureFormat) { f.Samples = 4 }, func(f *TextureFormat) { f.Format = wgpu.TextureFormatRGBA16Float },
+		func(f *TextureFormat) { f.Size.X = int(math.MaxUint32/4) + 1 }, func(f *TextureFormat) { f.Size.X = int((math.MaxUint32/256)*256/4) + 1 },
+		func(f *TextureFormat) { f.Size.Y = int(nativeMax) + 1 }, func(f *TextureFormat) { f.Size = image.Pt(int((math.MaxUint32/256)*256/4), int(nativeMax)) },
+	} {
+		f := format
+		mutation(&f)
+		if got, err := textureReadLayout(f); err == nil || got != (TextureBufferDims{}) {
+			t.Fatal("invalid/overflow layout admitted", f, got, err)
+		}
+	}
+	for _, f := range []wgpu.TextureFormat{wgpu.TextureFormatRGBA8Unorm, wgpu.TextureFormatRGBA8UnormSrgb, wgpu.TextureFormatBGRA8Unorm, wgpu.TextureFormatBGRA8UnormSrgb} {
+		format.Format = f
+		if _, err := textureReadLayout(format); err != nil {
+			t.Fatal("four-byte resolve refused", f, err)
+		}
+	}
+}

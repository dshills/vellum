+// Explicit test readback with nonblocking polls and an actual wall deadline.
+func sceneReadTexture(t *testing.T, dev *gpu.Device, tex *gpu.Texture) *image.RGBA {
+	t.Helper()
+	stride := uint32((tex.Format.Size.X*4 + 255) &^ 255)
+	n := uint64(stride) * uint64(tex.Format.Size.Y)
+	buffer, err := dev.Device.TryCreateBuffer(&wgpu.BufferDescriptor{Size: n, Usage: wgpu.BufferUsageCopyDst | wgpu.BufferUsageMapRead})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer buffer.Release()
+	cmd, err := dev.Device.TryCreateCommandEncoder(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer cmd.Release()
+	if err := tex.CopyToBuffer(cmd, buffer, stride); err != nil {
+		t.Fatal(err)
+	}
+	commands, err := cmd.TryFinish(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer commands.Release()
+	dev.Queue.Submit(commands)
+	status := make(chan wgpu.MapAsyncStatus, 1)
+	if err := buffer.TryMapAsync(wgpu.MapModeRead, 0, n, func(s wgpu.MapAsyncStatus) { status <- s }); err != nil {
+		t.Fatal(err)
+	}
+	deadline := time.NewTimer(5 * time.Second)
+	defer deadline.Stop()
+	for {
+		dev.Device.Poll(false, nil)
+		select {
+		case s := <-status:
+			if s != wgpu.MapAsyncStatusSuccess {
+				t.Fatal("native readback map failed", s)
+			}
+			raw := buffer.GetMappedRange(0, uint(n))
+			pixels := image.NewRGBA(image.Rectangle{Max: tex.Format.Size})
+			for y := 0; y < pixels.Rect.Dy(); y++ {
+				copy(pixels.Pix[y*pixels.Stride:], raw[uint32(y)*stride:][:pixels.Stride])
+			}
+			if err := buffer.TryUnmap(); err != nil {
+				t.Fatal(err)
+			}
+			return pixels
+		case <-deadline.C:
+			t.Fatal("bounded native readback timeout")
+		default:
+			time.Sleep(time.Millisecond)
+		}
+	}
+}

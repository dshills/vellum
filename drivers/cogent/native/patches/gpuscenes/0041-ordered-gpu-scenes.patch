+func TestVellumScenePacketMissingSpanSourceRefuses(t *testing.T) {
+	for _, source := range []image.Image{nil, (*image.Uniform)(nil), image.NewRGBA(image.Rect(0, 0, 2, 2))} {
+		b := sceneplan.New(image.Rect(0, 0, 8, 8))
+		s := &sceneSpanner{builder: b, source: source, op: int(draw.Over)}
+		s.GetSpanFunc()(0, 0, 8, 65535)
+		if !b.Failed() || b.Seal(false) != nil {
+			t.Fatal("missing or nonuniform scanner source admitted", source)
+		}
+	}
+}

+func TestVellumSceneSourceNonblockingRequestDuringOwnedScope(t *testing.T) {
+	dw := &Drawer{}
+	called := 0
+	s, err := dw.newSceneSourceOwned(func() {
+		called++
+		if _, err := dw.NewSceneSource(func() {}); !errors.Is(err, ErrSceneSourceBusy) {
+			t.Error("cleanup reentrancy admitted", err)

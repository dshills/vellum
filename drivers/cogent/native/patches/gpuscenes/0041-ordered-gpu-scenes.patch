+	alias := rs.image.SubImage(image.Rect(3, 3, 9, 9))
+	if rs.ScenePacket(render.Render{pimage.NewDraw(image.Rect(4, 4, 10, 10), alias, nil, image.Pt(3, 3), draw.Src)}) != nil {
+		t.Fatal("destination subimage self-blit admitted")

+// CopyFromBuffer encodes a checked upload from a packed RGBA/BGRA buffer on
+// this texture's device. It performs no mapping, polling or queue submission.
+func (tx *Texture) CopyFromBuffer(cmd *wgpu.CommandEncoder, buffer *wgpu.Buffer, stride uint32) error {
+	if tx == nil || !tx.texture.IsValid() || !cmd.IsValid() || !buffer.IsValid() {
+		return fmt.Errorf("gpu.Texture.CopyFromBuffer: texture, encoder and buffer required")
+	}
+	if tx.shared || tx.Format.Size.X < 1 || tx.Format.Size.Y < 1 || tx.Format.Layers != 1 || tx.Format.Samples != 1 {

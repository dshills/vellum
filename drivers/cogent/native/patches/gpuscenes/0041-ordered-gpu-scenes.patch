+	}
+	if tx.Format.Size.X > math.MaxUint32 || tx.Format.Size.Y > math.MaxUint32 || stride == 0 || stride%256 != 0 || uint64(stride) < uint64(tx.Format.Size.X)*4 || uint64(tx.Format.Size.Y) > math.MaxUint64/uint64(stride) || uint64(stride)*uint64(tx.Format.Size.Y) > buffer.GetSize() || buffer.GetUsage()&wgpu.BufferUsageCopySrc == 0 || tx.texture.GetUsage()&wgpu.TextureUsageCopyDst == 0 {

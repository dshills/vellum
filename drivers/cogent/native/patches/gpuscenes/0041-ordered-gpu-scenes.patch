+// This opt-in fixture creates an owned headless render target, not a native
+// window or a production compute device. Actual device execution/readback is
+// explicit test work; the ordinary scene callback never waits or reads back.
+func TestVellumSceneSourceNativeThreeBatchSharedToOwned(t *testing.T) {
+	if os.Getenv("VELLUM_GPU_SCENE_TEST") != "1" {
+		t.Skip("explicit real GPU fixture required: VELLUM_GPU_SCENE_TEST=1")
+	}
+	gp, dev, err := gpu.NoDisplayGPU()
+	if err != nil || gp == nil || dev == nil {
+		t.Fatal("headless device unavailable", err)
+	}
+	defer gp.Release()
+	defer dev.Release()
+	size := image.Pt(8, 8)
+	target := gpu.NewRenderTexture(gp, dev, size, 1, gpu.UndefinedType)
+	defer target.Release()
+	dw := NewDrawer(gp, target)
+	defer dw.Release()
+	owner := gpu.NewTexture(dev)
+	red := image.NewRGBA(image.Rectangle{Max: size})
+	wantRed := color.RGBA{R: 197, G: 29, B: 47, A: 255}
+	draw.Draw(red, red.Bounds(), image.NewUniform(wantRed), image.Point{}, draw.Src)
+	owner.ConfigGoImage(size, 1)
+	if err := owner.CreateTexture(wgpu.TextureUsageTextureBinding | wgpu.TextureUsageCopyDst | wgpu.TextureUsageCopySrc); err != nil {
+		t.Fatal(err)
+	}
+	if err := owner.SetFromGoImage(red, 0); err != nil {
+		t.Fatal(err)
+	}
+	if changed, err := owner.BindSharedChecked(owner, dev); err == nil || changed || !owner.LiveFor(dev) {
+		t.Fatal("live native self binding released owner", changed, err)
+	}
+	source, err := dw.NewSceneSource(owner.Release)
+	if err != nil {
+		t.Fatal(err)
+	}
+	dw.Start()
+	var escaped *SceneGPUContext
+	if err := source.Draw(SceneDraw{Size: size, Op: draw.Src}, func(c *SceneGPUContext) (*gpu.Texture, error) {
+		escaped = c
+		if c.Device.Device != dev.Device {
+			t.Error("scene callback borrowed another device")
+		}
+		if err := source.Close(); !errors.Is(err, ErrSceneSourceBusy) {
+			t.Error("reentrant source close", err)
+		}
+		if err := c.SetBudget(4 * uint64(size.X) * uint64(size.Y)); err != nil {
+			return nil, err
+		}
+		return owner, nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if escaped.Device != nil {
+		t.Fatal("callback retained device pointer")
+	}
+	if err := escaped.SetBudget(0); !errors.Is(err, ErrSceneSourceRetired) {
+		t.Fatal("expired callback changed budget", err)
+	}
+	if len(dw.opList) != 1 || len(dw.images.used) != 1 || dw.CanRedraw() {
+		t.Fatal("checked append/order or borrowed redraw guard")
+	}
+	old := dw.images.used[0].index
+	dw.End()
+	dev.WaitDone()
+	// A uniform-only batch uses no image slot. On batch three the original
+	// source key is absent from the previous batch and its slot is recycled.
+	dw.Start()
+	dw.Fill(color.RGBA{R: 11, G: 21, B: 31, A: 255}, image.Rectangle{Max: size}, draw.Src)
+	if len(dw.images.used) != 0 {
+		t.Fatal("uniform-only batch retained an image use")
+	}
+	dw.End()
+	dev.WaitDone()
+	blue := image.NewRGBA(image.Rectangle{Max: size})
+	wantBlue := color.RGBA{R: 23, G: 31, B: 199, A: 255}
+	draw.Draw(blue, blue.Bounds(), image.NewUniform(wantBlue), image.Point{}, draw.Src)
+	dw.Start()
+	dw.Copy(image.Point{}, blue, blue.Bounds(), draw.Src, false)
+	if dw.images.used[0].index != old {
+		t.Fatal("fixture did not reuse original shared slot")
+	}
+	dw.End()
+	dev.WaitDone()
+	if got := sceneReadTexture(t, dev, owner).RGBAAt(4, 4); got != wantRed {
+		t.Fatal("recycled upload modified original GPU source", got, wantRed)
+	}
+	if got := sceneReadTexture(t, dev, target.CurrentFrame()).RGBAAt(4, 4); got != wantBlue {
+		t.Fatal("recycled upload missed actual GPU target", got, wantBlue)
+	}
+	tvr, err := dw.System.Vars().VarByName(1, "TexSampler")
+	if err != nil {
+		t.Fatal(err)
+	}
+	reused := tvr.Values.Values[old].Texture
+	if !reused.LiveFor(dev) {
+		t.Fatal("replacement texture is not live")
+	}
+	if err := source.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if owner.LiveFor(dev) || !reused.LiveFor(dev) {
+		t.Fatal("source retirement released reused upload storage")
+	}
+	// Cached unchanged image reuse must also work after original retirement.
+	dw.Start()
+	dw.Copy(image.Point{}, blue, blue.Bounds(), draw.Src, true)
+	dw.End()
+	dev.WaitDone()
+	if got := sceneReadTexture(t, dev, target.CurrentFrame()).RGBAAt(4, 4); got != wantBlue {
+		t.Fatal("retired source broke unchanged owned image", got, wantBlue)
+	}
+	if !dw.CanRedraw() {
+		t.Fatal("owned replacement retained obsolete borrowed redraw restriction")
+	}
+}

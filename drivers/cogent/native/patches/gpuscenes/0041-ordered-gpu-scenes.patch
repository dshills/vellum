+func TestVellumImageSlotsExhaustionAndThreeBatchRecycling(t *testing.T) {
+	var im images
+	im.init()
+	seen := map[int]bool{}
+	for i := 0; i < 3*AllocChunk; i++ {
+		index, exists := im.use(image.NewRGBA(image.Rect(0, 0, 2, 3)))
+		if exists || seen[index] || index != i {
+			t.Fatal("overlapping image slots after exhaustion", i, index, exists)
+		}
+		seen[index] = true
+	}
+	var batches images
+	batches.init()
+	borrowed := &struct{}{}
+	old, _ := batches.use(borrowed)
+	batches.start()
+	second, _ := batches.use(image.NewRGBA(image.Rect(0, 0, 2, 3)))
+	if old == second {
+		t.Fatal("previous batch slot recycled too early")
+	}
+	batches.start()
+	third, _ := batches.use(image.NewRGBA(image.Rect(0, 0, 2, 3)))
+	if third != old {
+		t.Fatal("three-batch test failed to recycle old source slot", old, third)
+	}
+}

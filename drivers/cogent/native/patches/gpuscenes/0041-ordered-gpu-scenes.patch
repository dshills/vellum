+func TestVellumSceneSourceBudgetLimitsCopiesAndRetirement(t *testing.T) {
+	dw := &Drawer{}
+	retired := 0
+	sources := make([]*SceneSourceLease, sceneSourceLimit)
+	for i := range sources {
+		s, err := dw.newSceneSourceOwned(func() { retired++ })
+		if err != nil {
+			t.Fatal(err)
+		}
+		sources[i] = s
+	}
+	if _, err := dw.newSceneSourceOwned(func() {}); !errors.Is(err, ErrSceneSourceCapacity) {
+		t.Fatal("unbounded source registry", err)
+	}
+	var copiedDrawer Drawer
+	reflect.ValueOf(&copiedDrawer).Elem().Set(reflect.ValueOf(dw).Elem())
+	if _, err := copiedDrawer.SceneSourceBudget(); !errors.Is(err, ErrSceneSourceInvalid) {
+		t.Fatal("copied drawer inspected shared registry under a new lock", err)
+	}
+	if copiedDrawer.sceneBusy.Load() || !copiedDrawer.TryLock() {
+		t.Fatal("copied drawer refusal retained the admission token or mutex")
+	}
+	copiedDrawer.Unlock()
+	c := sources[0].context(nil)
+	if err := c.SetBudget(sceneSourceBytes); err != nil {
+		t.Fatal(err)
+	}
+	c2 := sources[1].context(nil)
+	if err := c2.SetBudget(sceneSourceBytes); err != nil {
+		t.Fatal(err)
+	}
+	c3 := sources[2].context(nil)
+	if err := c3.SetBudget(1); !errors.Is(err, ErrSceneSourceCapacity) {
+		t.Fatal("aggregate over-capacity accepted", err)
+	}
+	if err := c.SetBudget(sceneSourceBytes + 1); !errors.Is(err, ErrSceneSourceCapacity) {
+		t.Fatal("source over-capacity accepted", err)
+	}
+	if dw.sceneSources.bytes != sceneAggregateBytes {
+		t.Fatal("refusal changed reservation")
+	}
+	var copied SceneSourceLease
+	reflect.ValueOf(&copied).Elem().Set(reflect.ValueOf(sources[0]).Elem())
+	if err := copied.Close(); !errors.Is(err, ErrSceneSourceInvalid) {
+		t.Fatal("copied source retired original", err)
+	}
+	var cc SceneGPUContext
+	reflect.ValueOf(&cc).Elem().Set(reflect.ValueOf(c).Elem())
+	if err := cc.SetBudget(0); !errors.Is(err, ErrSceneSourceInvalid) {
+		t.Fatal("copied context changed reservation", err)
+	}
+	c.finish()
+	c2.finish()
+	c3.finish()
+	if err := c.SetBudget(0); !errors.Is(err, ErrSceneSourceRetired) {
+		t.Fatal("expired context changed reservation", err)
+	}
+	if err := sources[0].Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := sources[0].Close(); err != nil {
+		t.Fatal(err)
+	}
+	if retired != 1 || dw.sceneSources.bytes != sceneSourceBytes {
+		t.Fatal("source retirement credit/once", retired, dw.sceneSources.bytes)
+	}
+	dw.Release()
+	if retired != sceneSourceLimit || len(dw.sceneSources.entries) != 0 || dw.sceneSources.bytes != 0 {
+		t.Fatal("drawer retirement leaked registered sources", retired)
+	}
+}

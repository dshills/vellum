+func TestVellumScenePlanOwnedImageMaskAndPartialReplay(t *testing.T) {
+	random := rand.New(rand.NewSource(41))
+	for trial := 0; trial < 1000; trial++ {
+		bounds := image.Rect(0, 0, 19, 17)
+		want := image.NewRGBA(bounds)
+		random.Read(want.Pix)
+		got := image.NewRGBA(bounds)
+		copy(got.Pix, want.Pix)
+		source := image.NewRGBA(image.Rect(-3, 2, 15, 20))
+		random.Read(source.Pix)
+		mask := image.NewAlpha(image.Rect(4, -6, 27, 14))
+		random.Read(mask.Pix)
+		builder := New(bounds)
+		for step := 0; step < 8; step++ {
+			rect := image.Rect(random.Intn(15)-4, random.Intn(15)-4, random.Intn(10)+12, random.Intn(10)+12)
+			sp := image.Pt(random.Intn(8)-4, random.Intn(8))
+			mp := image.Pt(random.Intn(8)+2, random.Intn(10)-6)
+			op := draw.Op(step % 2)
+			var src image.Image = source
+			if step%2 == 0 {
+				src = image.NewUniform(color.NRGBA64{uint16(random.Uint32()), uint16(random.Uint32()), uint16(random.Uint32()), uint16(random.Uint32())})
+			}
+			var m image.Image
+			if step%3 != 0 {
+				m = mask
+			}
+			builder.Draw(rect, src, sp, m, mp, op)
+			draw.DrawMask(want, rect, src, sp, m, mp, op)
+		}
+		packet := builder.Seal(false)
+		if packet == nil {
+			t.Fatal("admitted image batch refused", trial)
+		}
+		// Mutating borrowed buffers cannot change any previously sealed operation.
+		clear(source.Pix)
+		clear(mask.Pix)
+		if !packet.Replay(got) || !bytes.Equal(got.Pix, want.Pix) {
+			t.Fatal("owned clipped partial image/mask replay differs", trial)
+		}
+		encoded, ok := packet.Encode()
+		if !ok || len(encoded.Rows) != encoded.Tiles.X*encoded.Tiles.Y*8 {
+			t.Fatal("tile encoding failed", trial)
+		}
+	}
+}
+func TestVellumScenePlanExactScannerCoverage(t *testing.T) {
+	for _, alpha := range []uint32{0, 1, 2, 127, 255, 256, 257, 32767, 32768, 65534, 65535} {
+		for _, op := range []draw.Op{draw.Src, draw.Over} {
+			for _, c := range []color.RGBA{{1, 2, 3, 4}, {33, 75, 112, 127}, {19, 107, 211, 255}} {
+				initial := color.RGBA{63, 109, 201, 211}
+				want := image.NewRGBA(image.Rect(0, 0, 5, 3))
+				draw.Draw(want, want.Rect, image.NewUniform(initial), image.Point{}, draw.Src)
+				got := image.NewRGBA(want.Rect)
+				copy(got.Pix, want.Pix)
+				spanner := scan.NewImgSpanner(want)
+				spanner.Op = op
+				spanner.SetColor(image.NewUniform(c))
+				spanner.GetSpanFunc()(1, 1, 4, alpha)
+				builder := New(want.Rect)
+				builder.BeginSpans(c, op)
+				builder.Span(1, 1, 4, alpha)
+				packet := builder.Seal(true)
+				if packet == nil || !packet.Replay(got) || !bytes.Equal(got.Pix, want.Pix) {
+					t.Fatalf("coverage differs alpha=%d op=%d color=%v", alpha, op, c)
+				}
+			}
+		}
+	}
+}
+func TestVellumScenePlanUnknownSpanOperatorRefusesWholeBatch(t *testing.T) {
+	for _, op := range []draw.Op{-1, 2, 255} {
+		b := New(image.Rect(0, 0, 8, 8))
+		b.Draw(image.Rect(0, 0, 8, 8), image.White, image.Point{}, nil, image.Point{}, draw.Src)
+		b.BeginSpans(color.RGBA{1, 2, 3, 255}, op)
+		b.Span(0, 0, 8, 65535)
+		if !b.Failed() || b.Seal(false) != nil {
+			t.Fatal("unknown span operator admitted a partial batch", op)
+		}
+	}
+}
+
+func TestVellumScenePlanMaskSnapshotsAndBounds(t *testing.T) {
+	builder := New(image.Rect(0, 0, 32, 32))
+	mask := image.NewAlpha(image.Rect(0, 0, 4, 4))
+	for i := range mask.Pix {
+		mask.Pix[i] = 33
+	}
+	builder.Draw(image.Rect(1, 1, 5, 5), image.NewUniform(color.RGBA{255, 255, 255, 255}), image.Point{}, mask, image.Point{}, draw.Over)
+	mask.Pix[0] = 219
+	builder.Draw(image.Rect(7, 7, 11, 11), image.NewUniform(color.RGBA{255, 255, 255, 255}), image.Point{}, mask, image.Point{}, draw.Over)
+	packet := builder.Seal(false)
+	if packet == nil || packet.ops[0].mask == packet.ops[1].mask || packet.ops[0].mask.Pix[0] != 33 || packet.ops[1].mask.Pix[0] != 219 {
+		t.Fatal("A/B mask capture lost owned bytes")
+	}
+	for _, bounds := range []image.Rectangle{image.Rect(1, 1, 8, 8), image.Rect(0, 0, MaxDimension+1, 2), image.Rect(0, 0, 8192, 8192)} {
+		if !New(bounds).Failed() {
+			t.Fatal("oversized/nonzero-origin target admitted", bounds)
+		}
+	}
+	alias := image.NewRGBA(image.Rect(0, 0, 32, 32))
+	sub := alias.SubImage(image.Rect(5, 5, 12, 12))
+	if !Aliases(sub, alias) {
+		t.Fatal("distinct destination subimage alias missed")
+	}
+	malformed := &image.RGBA{Pix: make([]byte, 4), Stride: int(^uint(0) >> 1), Rect: image.Rect(0, 0, 1, 3)}
+	if Known(malformed) {
+		t.Fatal("overflowing stride admitted")
+	}
+}

+func vellumSceneText(t *testing.T) *render.Text {
+	t.Helper()
+	shaper := shapedgt.NewShaperWithFonts([]fs.FS{fonts.Default})
+	uc := units.Context{}
+	uc.Defaults()
+	ts := text.NewStyle()
+	ts.FontSize = units.Dot(24)
+	ts.WhiteSpace = text.WrapNever
+	ts.ToDots(&uc)
+	src := rich.NewText(rich.NewStyle(), []rune("Ag é שלום"))
+	runs := shaper.Shape(src, ts)
+	if len(runs) == 0 {
+		t.Fatal("no real shaped text")
+	}
+	lns := &shaped.Lines{Source: src, Color: color.NRGBA{20, 40, 100, 230}, Lines: []shaped.Line{{Runs: runs, Offset: math32.Vec2(0, 30), Selections: []textpos.Range{{Start: 1, End: 5}}}}, SelectionColor: colors.Uniform(color.NRGBA{30, 80, 20, 100})}
+	c := &render.Context{}
+	c.Init(styles.NewPaint(), &render.Bounds{Rect: math32.B2FromRect(image.Rect(0, 0, 240, 80))}, nil)
+	return render.NewText(lns, styles.NewPaint(), c, math32.Vec2(7.25, 2.5))
+}

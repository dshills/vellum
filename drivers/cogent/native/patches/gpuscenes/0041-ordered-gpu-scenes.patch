+
+	"cogentcore.org/core/math32"
+	"cogentcore.org/core/paint/pimage"
+	"cogentcore.org/core/paint/render"
+	"cogentcore.org/core/paint/renderers/sceneplan"
+	"cogentcore.org/core/styles/units"
+	"cogentcore.org/core/system/composer"
+)
+
+type cpuDrawer struct{ composer.DrawerBase }
+
+func (*cpuDrawer) End()    {}
+func (*cpuDrawer) Redraw() {}
+
+func TestVellumGPUScenePartialJournalAndSnapshot(t *testing.T) {
+	bounds := image.Rect(0, 0, 23, 19)
+	r := New(math32.FromPoint(bounds.Size())).(*Renderer)
+	want := image.NewRGBA(bounds)
+	for i := 0; i < maxJournalPackets*3+7; i++ {
+		rect := image.Rect(i%21, i%17, i%21+2, i%17+2)
+		c := image.NewUniform(color.NRGBA{uint8(i), uint8(i * 3), uint8(i * 5), 123})
+		builder := sceneplan.New(bounds)
+		builder.Draw(rect, c, image.Point{}, nil, image.Point{}, draw.Over)
+		packet := builder.Seal(i%2 == 0)
+		if packet == nil {
+			t.Fatal("partial capture failed")
+		}
+		r.remember(packet)
+		draw.Draw(want, rect, c, image.Point{}, draw.Over)
+		if len(r.journal) > maxJournalPackets || r.journalBytes > sceneplan.MaxBytes {
+			t.Fatal("journal exceeded bound")
+		}
+	}
+	if r.stats.Materializations < 2 {
+		t.Fatal("bounded journal did not materialize")
+	}
+	got := r.Image().(*image.RGBA)
+	if !bytes.Equal(got.Pix, want.Pix) || len(r.journal) != 0 || r.journalBytes != 0 {
+		t.Fatal("partial reconstruction/snapshot differs")
+	}
+	// A mutable Image is the base for later accepted partial paint.
+	got.SetRGBA(0, 0, color.RGBA{7, 11, 13, 255})
+	want.SetRGBA(0, 0, color.RGBA{7, 11, 13, 255})
+	builder := sceneplan.New(bounds)
+	builder.Draw(image.Rect(0, 0, 3, 3), image.NewUniform(color.RGBA{3, 5, 7, 9}), image.Point{}, nil, image.Point{}, draw.Over)
+	r.remember(builder.Seal(false))
+	draw.Draw(want, image.Rect(0, 0, 3, 3), image.NewUniform(color.RGBA{3, 5, 7, 9}), image.Point{}, draw.Over)
+	if !bytes.Equal(r.Image().(*image.RGBA).Pix, want.Pix) {
+		t.Fatal("mutable CPU base lost")
+	}
+}
+func TestVellumGPUSceneIndependentResetFallbackResize(t *testing.T) {
+	r := New(math32.Vec2(17, 13)).(*Renderer)
+	bounds := image.Rect(0, 0, 17, 13)
+	partial := sceneplan.New(bounds)
+	partial.Draw(image.Rect(2, 2, 7, 7), image.White, image.Point{}, nil, image.Point{}, draw.Src)
+	r.remember(partial.Seal(true))
+	independent := sceneplan.New(bounds)
+	independent.Draw(bounds, image.NewUniform(color.RGBA{19, 37, 61, 255}), image.Point{}, nil, image.Point{}, draw.Src)
+	r.remember(independent.Seal(false))
+	if len(r.journal) != 1 {
+		t.Fatal("full clear retained stale history")
+	}
+	dw := &cpuDrawer{composer.DrawerBase{Image: image.NewRGBA(bounds)}}
+	commands := render.Render{&pimage.Params{Cmd: pimage.Draw, Rect: image.Rect(3, 1, 9, 8), Source: image.NewUniform(color.RGBA{3, 7, 11, 13}), Op: draw.Over}}
+	timing := r.DrawScene(dw, commands, image.Point{}, draw.Src, true)
+	want := image.NewRGBA(bounds)
+	draw.Draw(want, bounds, image.NewUniform(color.RGBA{19, 37, 61, 255}), image.Point{}, draw.Src)
+	draw.Draw(want, image.Rect(3, 1, 9, 8), commands[0].(*pimage.Params).Source, image.Point{}, draw.Over)
+	if !bytes.Equal(dw.Image.Pix, want.Pix) || len(r.journal) != 0 || !timing.RasterAvailable || !timing.CopyAvailable || timing.ImageWidth != 17 {
+		t.Fatal("ordered CPU fallback differs")
+	}
+	r.SetSize(units.UnitDot, math32.Vec2(11, 9))
+	if r.Image().Bounds() != image.Rect(0, 0, 11, 9) || r.journalBytes != 0 {
+		t.Fatal("resize retained old state")
+	}
+	r.Release()
+	r.Release()
+	r.DrawScene(&cpuDrawer{composer.DrawerBase{Image: image.NewRGBA(image.Rect(0, 0, 11, 9))}}, nil, image.Point{}, draw.Src, false)
+}
+func TestVellumGPUSceneOutputBounds(t *testing.T) {
+	for _, size := range []image.Point{{0, 2}, {2, 0}, {-1, 2}, {8193, 2}, {8192, 8192}} {
+		if _, _, ok := outputLayout(size); ok {
+			t.Fatal("unsafe output size accepted", size)
+		}
+	}
+	stride, size, ok := outputLayout(image.Pt(257, 3))
+	if !ok || stride != 1280 || size != 3840 {
+		t.Fatal("padded output layout differs", stride, size, ok)
+	}
+}

+	cases["malformed-path"] = render.Render{&malformed}
+	huge := *item
+	huge.Context.Cumulative = math32.Scale2D(1<<16, 1<<16)
+	cases["transformed-path"] = render.Render{&huge}
+	tinyDash := *item
+	tinyDash.Context.Style = *styles.NewPaint()
+	tinyDash.Context.Style.Stroke.Dashes = []float32{1e-8, 1e-8}
+	cases["unbounded-dash"] = render.Render{&tinyDash}
+	scaledDash := *item
+	scaledDash.Context.Cumulative = math32.Scale2D(1e-6, 1e-6)
+	scaledDash.Context.Style.Stroke.Dashes = []float32{2, 2}
+	cases["transformed-tiny-dash"] = render.Render{&scaledDash}
+	miter := *item
+	miter.Context.Style.Stroke.Width.Dots = 100
+	miter.Context.Style.Stroke.MiterLimit = 1 << 20
+	cases["miter-product"] = render.Render{&miter}
+	txt := vellumSceneText(t)
+	txt.Position.X = float32(math.Inf(1))
+	cases["position"] = render.Render{txt}
+	txt = vellumSceneText(t)
+	txt.Text.Lines[0].Offset.Y = float32(math.NaN())
+	cases["line-offset"] = render.Render{txt}
+	txt = vellumSceneText(t)
+	r := *txt.Text.Lines[0].Runs[0].(*shapedgt.Run)
+	r.Math.Path = make(ppath.Path, sceneMaxItems+1)
+	txt.Text.Lines[0].Runs = []shaped.Run{&r}
+	cases["math-path"] = render.Render{txt}
+	txt = vellumSceneText(t)

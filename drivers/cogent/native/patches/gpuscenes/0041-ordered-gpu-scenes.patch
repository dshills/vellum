+// Copyright (c) 2026, Davin Hills.
+// SPDX-License-Identifier: MIT
+package gpuscene
+
+import (
+	"fmt"
+	"image"
+	"image/draw"
+	"time"
+
+	"cogentcore.org/core/gpu"
+	"cogentcore.org/core/gpu/gpudraw"
+	"cogentcore.org/core/math32"
+	"cogentcore.org/core/paint/render"
+	"cogentcore.org/core/paint/renderers/rasterx"
+	"cogentcore.org/core/paint/renderers/sceneplan"
+	"cogentcore.org/core/styles/units"
+	"cogentcore.org/core/system/composer"
+)
+
+const maxJournalPackets = 256
+
+// Stats contains host-side routing counts only. A submitted packet is not a
+// GPU-completion timestamp or proof that a presentation succeeded.
+type Stats struct {
+	Submitted, Reused, CPUFallbacks, Materializations uint64
+	JournalBytes, JournalPackets                      int
+	LastFallback                                      string
+}
+
+// Renderer is owned and serialized by the same Scene RC as rasterx.Renderer.
+// Its CPU base plus bounded immutable journal reconstruct every accepted paint
+// batch without readback. Only resources (GPU handles) are registered with the
+// drawer; its retirement callback holds no widget, font or application state.
+type Renderer struct {
+	cpu          *rasterx.Renderer
+	journal      []*sceneplan.Packet
+	journalBytes int
+	resources    *resources
+	drawer       *gpudraw.Drawer
+	lease        *gpudraw.SceneSourceLease
+	closed       bool
+	imageExposed bool
+	stats        Stats
+}
+
+func New(size math32.Vector2) render.Renderer {
+	return &Renderer{cpu: rasterx.New(size).(*rasterx.Renderer)}
+}
+func (r *Renderer) Size() (units.Units, math32.Vector2) { return r.cpu.Size() }
+func (r *Renderer) Source() []byte                      { return nil }
+func (r *Renderer) Stats() Stats {
+	s := r.stats
+	s.JournalBytes = r.journalBytes
+	s.JournalPackets = len(r.journal)
+	return s
+}
+func (r *Renderer) materialize() {
+	if len(r.journal) == 0 {
+		return
+	}
+	dst := r.cpu.Image().(*image.RGBA)
+	for _, p := range r.journal {
+		p.Replay(dst)
+		r.cpu.Scanner.SetWinding(p.Winding())
+	}
+	clear(r.journal)
+	r.journal = r.journal[:0]
+	r.journalBytes = 0
+	r.stats.Materializations++
+}
+func (r *Renderer) invalidate() {
+	if r.lease != nil {
+		if err := r.lease.WithResources(func(*gpudraw.SceneGPUContext) error { r.resources.ready = false; return nil }); err != nil {
+			r.closeLease()
+		}
+	}
+}
+
+// Image returns the usual mutable CPU image. Conservatively invalidate GPU
+// reuse because a caller may modify those bytes after this explicit snapshot.
+func (r *Renderer) Image() image.Image {
+	r.materialize()
+	r.imageExposed = true
+	r.invalidate()
+	return r.cpu.Image()
+}
+func (r *Renderer) Render(commands render.Render) render.Renderer {
+	r.materialize()
+	r.invalidate()
+	r.cpu.Render(commands)
+	return r
+}
+func (r *Renderer) SetSize(un units.Units, size math32.Vector2) {
+	_, old := r.cpu.Size()
+	if old == size {
+		return
+	}
+	r.closeLease()
+	clear(r.journal)
+	r.journal = nil
+	r.journalBytes = 0
+	r.imageExposed = false
+	r.cpu.SetSize(un, size)
+}
+func (r *Renderer) closeLease() error {
+	if r.lease != nil {
+		if err := r.lease.Close(); err != nil {
+			// A pending composition or another admitted resource scope keeps
+			// registry ownership until its safe drain point. The callback
+			// retains private resources only, so the Scene can retire now.
+			if requestErr := r.lease.RequestClose(); requestErr != nil {
+				return requestErr
+			}
+		}
+	}
+	r.lease, r.drawer, r.resources = nil, nil, nil
+	return nil
+}
+func (r *Renderer) Release() {
+	if r.closed {
+		return
+	}
+	r.closed = true
+	r.closeLease()
+	// Preserve the usual explicit CPU snapshot semantics after destruction.
+	r.materialize()
+}
+func (r *Renderer) ensureLease(dw *gpudraw.Drawer) error {
+	if r.closed {
+		return fmt.Errorf("gpuscene: renderer retired")
+	}
+	if r.drawer == dw && r.lease != nil {
+		return nil
+	}
+	// A new window/device cannot inherit a texture from the previous drawer.
+	r.materialize()
+	if err := r.closeLease(); err != nil {
+		return err
+	}
+	res := &resources{}
+	lease, err := dw.NewSceneSource(res.release)
+	if err != nil {
+		return err
+	}
+	r.drawer, r.lease, r.resources = dw, lease, res
+	return nil
+}
+func (r *Renderer) remember(p *sceneplan.Packet) {
+	if p.Independent() {
+		clear(r.journal)
+		r.journal = r.journal[:0]
+		r.journalBytes = 0
+	} else if len(r.journal) == maxJournalPackets || r.journalBytes+p.Bytes() > sceneplan.MaxBytes {
+		r.materialize()
+	}
+	if p.Operations() != 0 {
+		r.journal = append(r.journal, p)
+		r.journalBytes += p.Bytes()
+	}
+	r.cpu.Scanner.SetWinding(p.Winding())
+	// A retained mutable Image pointer has the original rasterx semantics:
+	// subsequent accepted paint updates it, and later partial GPU paint must
+	// conservatively seed any caller modifications from this same CPU base.
+	if r.imageExposed {
+		r.materialize()
+	}
+}
+func (r *Renderer) fallback(dw composer.Drawer, commands render.Render, dp image.Point, op draw.Op, measured bool, reason error) composer.SourceTiming {
+	r.materialize()
+	// Keep an admitted pool across unsupported paint. Mark its bytes stale so
+	// the next partial accepted batch seeds the reconstructed CPU base once.
+	r.invalidate()
+	r.stats.CPUFallbacks++
+	if reason != nil {
+		message := reason.Error()
+		if len(message) > 256 {
+			message = message[:256]
+		}
+		r.stats.LastFallback = message
+	}
+	changed := len(commands) != 0
+	record := composer.SourceTiming{RasterAvailable: true, CopyAvailable: true, ImageChanged: changed}
+	if changed {
+		if measured {
+			start := time.Now()
+			r.cpu.Render(commands)
+			record.RasterNS = time.Since(start).Nanoseconds()
+		} else {
+			r.cpu.Render(commands)
+		}
+	}
+	img := r.cpu.Image()
+	record.ImageWidth, record.ImageHeight = img.Bounds().Dx(), img.Bounds().Dy()
+	// A fallback's owned Go texture may occupy a former borrowed GPU slot.
+	// Force upload; checked slot conversion establishes independent ownership.
+	if measured {
+		start := time.Now()
+		dw.Copy(dp, img, img.Bounds(), op, false)
+		record.CopyNS = time.Since(start).Nanoseconds()
+	} else {
+		dw.Copy(dp, img, img.Bounds(), op, false)
+	}
+	return record
+}
+
+// DrawScene executes at the original paintSource ordinal, using the originating
+// drawer's device. Both ordinary and diagnostic Core paths call this method.
+// GPU host work remains inside outer Draw timing; CPU Raster/Copy timings are
+// available only on fallback, without pretending Submit measures GPU execution.
+func (r *Renderer) DrawScene(dw composer.Drawer, commands render.Render, dp image.Point, op draw.Op, measured bool) composer.SourceTiming {
+	as, ok := dw.(gpudraw.AsGPUDrawer)
+	if !ok || as.AsGPUDrawer() == nil {
+		return r.fallback(dw, commands, dp, op, measured, fmt.Errorf("gpuscene: drawer has no GPU scene support"))
+	}
+	gpuDrawer := as.AsGPUDrawer()
+	if err := r.ensureLease(gpuDrawer); err != nil {
+		return r.fallback(dw, commands, dp, op, measured, err)
+	}
+	_, size := r.cpu.Size()
+	bounds := image.Rectangle{Max: size.ToPointCeil()}
+	if len(commands) == 0 && r.imageExposed {
+		return r.fallback(dw, commands, dp, op, measured, fmt.Errorf("gpuscene: mutable CPU image exposure requires current copy"))
+	}
+	var packet *sceneplan.Packet
+	var encoded *sceneplan.Encoded
+	if len(commands) != 0 {
+		packet = r.cpu.ScenePacket(commands)
+		if packet == nil {
+			return r.fallback(dw, commands, dp, op, measured, fmt.Errorf("gpuscene: unsupported or over-budget paint batch"))
+		}
+		encoded, ok = packet.Encode()
+		if !ok {
+			return r.fallback(dw, commands, dp, op, measured, fmt.Errorf("gpuscene: encoded paint exceeds limits"))
+		}
+	}
+	err := r.lease.Draw(gpudraw.SceneDraw{Size: bounds.Size(), DP: dp, SR: bounds, Op: op}, func(ctx *gpudraw.SceneGPUContext) (*gpu.Texture, error) {
+		res := r.resources
+		if res.device.Device != ctx.Device.Device || res.size != bounds.Size() || res.texture == nil {
+			res.release()
+			if err := ctx.SetBudget(0); err != nil {
+				return nil, err
+			}
+			if err := res.initialize(ctx.Device, bounds.Size(), ctx.SetBudget); err != nil {
+				return nil, err
+			}
+		}
+		if packet == nil {
+			if !res.ready {
+				return nil, fmt.Errorf("gpuscene: empty batch has no current GPU source")
+			}
+			return res.texture, nil
+		}
+		if (!res.ready || r.imageExposed) && !packet.Independent() {
+			r.materialize()
+			if err := res.seed(r.cpu.Image().(*image.RGBA)); err != nil {
+				return nil, err
+			}
+		}
+		if err := res.render(encoded, ctx.SetBudget); err != nil {
+			return nil, err
+		}
+		return res.texture, nil
+	})
+	if err != nil {
+		return r.fallback(dw, commands, dp, op, measured, err)
+	}
+	if packet != nil {
+		r.remember(packet)
+		r.stats.Submitted++
+	} else {
+		r.stats.Reused++
+	}
+	return composer.SourceTiming{ImageWidth: bounds.Dx(), ImageHeight: bounds.Dy(), ImageChanged: len(commands) != 0}
+}

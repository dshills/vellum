+	rs.Scanner.SetClip(image.Rect(2, 3, 41, 42))
+	before := append([]byte(nil), rs.image.Pix...)
+	commands := append(render.Render(nil), vellumOwnedPathScenes(64)[0].items...)
+	commands = append(commands, &pimage.Params{Cmd: pimage.Draw, Rect: image.Rect(0, 0, 20, 20), Source: sceneHookImage{&calls}})
+	if rs.ScenePacket(commands) != nil || calls != 0 || rs.Scanner.UseNonZeroWinding || !bytes.Equal(before, rs.image.Pix) {
+		t.Fatal("refused source changed caller state or invoked custom hook")

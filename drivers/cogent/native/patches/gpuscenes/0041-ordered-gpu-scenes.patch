+	}
+	size := tx.Format.Extent3D()
+	return cmd.TryCopyBufferToTexture(&wgpu.TexelCopyBufferInfo{Buffer: buffer, Layout: wgpu.TexelCopyBufferLayout{BytesPerRow: stride, RowsPerImage: uint32(tx.Format.Size.Y)}}, tx.texture.AsImageCopy(), &size)
+}
+
+// LiveFor checks a sampled texture's originating device and live handles.
+// Caller must serialize device and texture retirement with their owning drawer.
+func (tx *Texture) LiveFor(dev *Device) bool {
+	return tx != nil && dev != nil && dev.Device.IsValid() && dev.Queue.IsValid() && dev.LossError() == nil && tx.device.Device == dev.Device && tx.device.Queue == dev.Queue && tx.texture.IsValid() && tx.view.IsValid()
+}
+
+// BindSharedChecked validates device/lifetime and sampler before replacing a
+// drawer value's borrowed binding. Neither method releases the source's handles.
+func (tx *Texture) BindSharedChecked(source *Texture, dev *Device) (bool, error) {
+	if tx == nil || source == nil || tx.sharedBindingAliasesOwner(source) {
+		return false, fmt.Errorf("gpu.Texture.BindSharedChecked: distinct non-owning destination required")
+	}
+	if !source.LiveFor(dev) || tx.device.Device != dev.Device || tx.device.Queue != dev.Queue || source.texture.GetUsage()&wgpu.TextureUsageTextureBinding == 0 {
+		return false, fmt.Errorf("gpu.Texture.BindSharedChecked: live same-device sampled texture required")
+	}
+	if err := tx.Sampler.Config(dev); err != nil {
+		return false, err
+	}
+	changed := !tx.shared || tx.texture != source.texture || tx.view != source.view
+	if changed {
+		tx.SetShared(source)
+	}
+	return changed, nil
+}
+
+func (tx *Texture) sharedBindingAliasesOwner(source *Texture) bool {
+	return tx == source || !tx.shared && tx.texture != nil && tx.texture == source.texture
+}

+func TestVellumTextureSharedUploadDetachesBeforeRefusedAllocation(t *testing.T) {
+	// Empty native wrappers deliberately refuse allocation. The ownership
+	// transition must precede that refusal without releasing borrowed handles.
+	owner := &Texture{texture: &wgpu.Texture{}, view: &wgpu.TextureView{}, Format: TextureFormat{Size: image.Pt(2, 3), Layers: 1, Samples: 1, Format: wgpu.TextureFormatRGBA8UnormSrgb}}
+	tex, view := owner.texture, owner.view
+	value := NewTexture(&Device{})
+	value.SetShared(owner)
+	if err := value.SetFromGoImage(image.NewRGBA(image.Rect(0, 0, 2, 3)), 0); err == nil {
+		t.Fatal("missing upload device accepted")
+	}
+	if value.shared || value.texture != nil || value.view != nil || owner.texture != tex || owner.view != view {
+		t.Fatal("same-format upload retained or released borrowed ownership")
+	}
+}
+
+func TestVellumTextureUploadCopyRejectsMissingAndReleasedInputs(t *testing.T) {
+	for _, tex := range []*Texture{nil, {}} {
+		if tex.CopyFromBuffer(nil, nil, 256) == nil {
+			t.Fatal("missing upload inputs accepted")
+		}
+	}
+	tex := &Texture{texture: &wgpu.Texture{}, Format: TextureFormat{Size: image.Pt(2, 3), Layers: 1, Samples: 1, Format: wgpu.TextureFormatRGBA8UnormSrgb}}
+	buffer, encoder := &wgpu.Buffer{}, &wgpu.CommandEncoder{}
+	buffer.Release()
+	encoder.Release()
+	tex.texture.Release()
+	if tex.CopyFromBuffer(encoder, buffer, 256) == nil {
+		t.Fatal("released upload wrappers accepted")
+	}
+	if tex.LiveFor(&Device{}) {
+		t.Fatal("released texture/device eligible for source append")
+	}
+	if _, err := NewTexture(&Device{}).BindSharedChecked(tex, &Device{}); err == nil {
+		t.Fatal("invalid shared binding accepted")
+	}
+}
+
+func TestVellumTextureSharedBindingRejectsSelfAndOwnedAlias(t *testing.T) {
+	handle := &wgpu.Texture{}
+	source := &Texture{texture: handle}
+	if !source.sharedBindingAliasesOwner(source) {
+		t.Fatal("self alias not classified before native admission")
+	}
+	if changed, err := source.BindSharedChecked(source, &Device{}); err == nil || changed {
+		t.Fatal("self alias accepted", changed, err)
+	}
+	alias := &Texture{texture: handle}
+	if !alias.sharedBindingAliasesOwner(source) {
+		t.Fatal("duplicate owned handle not classified")
+	}
+	if changed, err := alias.BindSharedChecked(source, &Device{}); err == nil || changed {
+		t.Fatal("owned handle alias accepted", changed, err)
+	}
+	if source.texture != handle || alias.texture != handle {
+		t.Fatal("refused alias changed handles")
+	}
+	alias.shared = true
+	if alias.sharedBindingAliasesOwner(source) {
+		t.Fatal("ordinary borrowed rebind misclassified as owning alias")
+	}
+}

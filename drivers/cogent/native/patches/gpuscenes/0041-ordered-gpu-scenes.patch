+// Native checks require explicit admission. Ordinary offscreen tests never open
+// a GPU device, change desktop settings, or silently skip an admitted failure.
+func nativeDevice(t *testing.T) (*gpu.GPU, *gpu.Device) {
+	t.Helper()
+	if os.Getenv("VELLUM_GPU_SCENE_TEST") != "1" {
+		t.Skip("explicit native GPU admission required")
+	}
+	gp, dev, err := gpu.NoDisplayGPU()
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { dev.Release(); gp.Release() })
+	return gp, dev
+}
+func readTexture(t *testing.T, dev *gpu.Device, tx *gpu.Texture) *image.RGBA {
+	t.Helper()
+	stride, n, ok := outputLayout(tx.Format.Size)
+	if !ok {
+		t.Fatal("invalid readback layout")
+	}
+	buffer, err := dev.Device.TryCreateBuffer(&wgpu.BufferDescriptor{Size: n, Usage: wgpu.BufferUsageCopyDst | wgpu.BufferUsageMapRead})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer buffer.Release()
+	encoder, err := dev.Device.TryCreateCommandEncoder(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer encoder.Release()
+	if err = tx.CopyToBuffer(encoder, buffer, stride); err != nil {
+		t.Fatal(err)
+	}
+	command, err := encoder.TryFinish(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer command.Release()
+	dev.Queue.Submit(command)
+	status := make(chan wgpu.MapAsyncStatus, 1)
+	if err = buffer.TryMapAsync(wgpu.MapModeRead, 0, n, func(s wgpu.MapAsyncStatus) { status <- s }); err != nil {
+		t.Fatal(err)
+	}
+	dev.Device.Poll(true, nil)
+	select {
+	case s := <-status:
+		if s != wgpu.MapAsyncStatusSuccess {
+			t.Fatal("native map failed", s)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("native readback timed out")
+	}
+	raw := buffer.GetMappedRange(0, uint(n))
+	out := image.NewRGBA(image.Rectangle{Max: tx.Format.Size})
+	for y := 0; y < out.Rect.Dy(); y++ {
+		copy(out.Pix[y*out.Stride:], raw[uint32(y)*stride:][:out.Stride])
+	}
+	if err = buffer.TryUnmap(); err != nil {
+		t.Fatal(err)
+	}
+	return out
+}
+func TestVellumGPUSceneNativeIntegerCompositor(t *testing.T) {
+	_, dev := nativeDevice(t)
+	random := rand.New(rand.NewSource(481))
+	for _, size := range []image.Point{{23, 19}, {257, 3}, {64, 32}} {
+		t.Run(fmt.Sprint(size), func(t *testing.T) {
+			res := &resources{}
+			defer res.release()
+			reserve := func(n uint64) error {
+				if n > 128<<20 {
+					return fmt.Errorf("test source budget exceeded")
+				}
+				return nil
+			}
+			if err := res.initialize(dev, size, reserve); err != nil {
+				t.Fatal(err)
+			}
+			expected := image.NewRGBA(image.Rectangle{Max: size})
+			random.Read(expected.Pix)
+			if err := res.seed(expected); err != nil {
+				t.Fatal(err)
+			}
+			for batch := 0; batch < 32; batch++ {
+				b := sceneplan.New(expected.Rect)
+				if batch%8 == 0 {
+					b.Draw(expected.Rect, image.NewUniform(color.RGBA{13, 31, 59, 255}), image.Point{}, nil, image.Point{}, draw.Src)
+				}
+				for step := 0; step < 9; step++ {
+					rect := image.Rect(random.Intn(size.X+4)-2, random.Intn(size.Y+4)-2, random.Intn(size.X+3)+1, random.Intn(size.Y+3)+1)
+					if rect.Empty() {
+						rect = expected.Rect
+					}
+					op := draw.Op(step % 2)
+					c := image.NewUniform(color.NRGBA64{uint16(random.Uint32()), uint16(random.Uint32()), uint16(random.Uint32()), uint16(random.Uint32())})
+					mask := image.NewAlpha(image.Rect(-1, -2, size.X+3, size.Y+4))
+					random.Read(mask.Pix)
+					pixels := image.NewRGBA(image.Rect(-2, -1, size.X+4, size.Y+3))
+					random.Read(pixels.Pix)
+					switch step % 3 {
+					case 0:
+						b.Draw(rect, c, image.Point{}, nil, image.Point{}, op)
+					case 1:
+						b.Draw(rect, c, image.Point{}, mask, image.Pt(-1, -1), op)
+					case 2:
+						b.Draw(rect, pixels, image.Pt(-1, -1), mask, image.Pt(0, -1), op)
+					}
+					b.BeginSpans(color.RGBA{13, 29, 51, 77}, op)
+					y := random.Intn(size.Y)
+					// Cover overlapping span order and 16-bit edge values.
+					for j, a := range []uint32{0, 1, 257, 32768, 65534, 65535} {
+						b.Span(y, j, min(size.X, j+7), a)
+					}
+				}
+				packet := b.Seal(false)
+				if packet == nil {
+					t.Fatal("native fixture refused", batch)
+				}
+				encoded, ok := packet.Encode()
+				if !ok {
+					t.Fatal("native fixture encoding refused")
+				}
+				if err := res.render(encoded, reserve); err != nil {
+					t.Fatal(err)
+				}
+				packet.Replay(expected)
+				got := readTexture(t, dev, res.texture)
+				if !bytes.Equal(got.Pix, expected.Pix) {
+					for i, v := range expected.Pix {
+						if got.Pix[i] != v {
+							t.Fatalf("exact integer mismatch batch=%d byte=%d GPU=%d CPU=%d", batch, i, got.Pix[i], v)
+						}
+					}
+				}
+			}
+		})
+	}
+}

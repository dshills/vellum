+	// also the retirement boundary when acquisition or composition was empty.
+	dw.End()
+	if called != 1 || !s.retired.Load() || dw.sceneSources.bytes != 0 || len(dw.sceneSources.entries) != 0 {
+		t.Fatal("batch terminal did not retire requested source")

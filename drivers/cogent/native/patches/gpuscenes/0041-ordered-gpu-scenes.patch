+func TestVellumSceneSourceRetirementUnwindAttemptsAllHooks(t *testing.T) {
+	for _, mode := range []string{"panic", "goexit"} {
+		t.Run(mode, func(t *testing.T) {
+			// The real System.Release control flow is observable without native
+			// device creation: it clears this nonnil empty pipeline registry.
+			system := &gpu.GraphicsSystem{GraphicsPipelines: make(map[string]*gpu.GraphicsPipeline)}
+			dw := &Drawer{System: system}
+			calls := 0
+			for i := 0; i < 3; i++ {
+				i := i
+				_, err := dw.newSceneSourceOwned(func() {
+					calls++
+					if i == 0 {
+						if mode == "panic" {
+							panic("source-retirement")
+						}
+						runtime.Goexit()
+					}
+				})
+				if err != nil {
+					t.Fatal(err)
+				}
+			}
+			done := make(chan struct{})
+			var payload any
+			returned := false
+			go func() { defer close(done); defer func() { payload = recover() }(); dw.Release(); returned = true }()
+			<-done
+			if returned || calls != 3 || len(dw.sceneSources.entries) != 0 || dw.sceneSources.bytes != 0 {
+				t.Fatal("retirement unwind skipped source", returned, calls)
+			}
+			if dw.System != nil || system.GraphicsPipelines != nil {
+				t.Fatal("source abnormal return skipped actual system cleanup")
+			}
+			if mode == "panic" && payload != "source-retirement" || mode == "goexit" && payload != nil {
+				t.Fatal("retirement abnormal return altered", payload)
+			}
+			// Both admission and mutex ownership must be terminal/unwound.
+			if _, err := dw.NewSceneSource(func() {}); !errors.Is(err, ErrSceneSourceRetired) {
+				t.Fatal("retired drawer accepted source", err)
+			}
+			dw.Lock()
+			dw.Unlock()
+		})
+	}
+}

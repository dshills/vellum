+	clear := &pimage.Params{Cmd: pimage.Draw, Source: image.NewUniform(color.RGBA{13, 22, 31, 255}), Op: draw.Src}
+	packet := rs.ScenePacket(render.Render{clear})
+	if packet == nil || !packet.Independent() || clear.Rect != (image.Rectangle{}) {

+func TestVellumSceneSourceCloseWaitsForPendingBatch(t *testing.T) {
+	dw := &Drawer{}
+	called := 0
+	s, err := dw.newSceneSourceOwned(func() { called++ })
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := s.setBudgetOwned(99); err != nil {
+		t.Fatal(err)

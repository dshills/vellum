+func TestVellumScenePlanSealRetiresBuilder(t *testing.T) {
+	b := New(image.Rect(0, 0, 8, 8))
+	b.Draw(image.Rect(0, 0, 8, 8), image.NewUniform(color.RGBA{1, 2, 3, 255}), image.Point{}, nil, image.Point{}, draw.Src)
+	p := b.Seal(false)
+	if p == nil {
+		t.Fatal("first seal failed")
+	}
+	b.Draw(image.Rect(0, 0, 8, 8), image.White, image.Point{}, nil, image.Point{}, draw.Src)
+	if b.Seal(false) != nil || p.Operations() != 1 {
+		t.Fatal("builder reuse changed sealed packet")
+	}
+	dst := image.NewRGBA(p.Bounds())
+	p.Replay(dst)
+	if dst.RGBAAt(0, 0) != (color.RGBA{1, 2, 3, 255}) {
+		t.Fatal("sealed data changed")
+	}
+}

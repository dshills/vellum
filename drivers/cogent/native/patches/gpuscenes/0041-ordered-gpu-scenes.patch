+// Copyright (c) 2026, Davin Hills. SPDX-License-Identifier: MIT
+// Packed premultiplied RGBA bytes use the reference rasterizer's u32 math.
+// No floating point blend, sRGB conversion, or lossy 8-bit span coverage.
+struct Config { width: u32, height: u32, stride: u32, tiles_x: u32 }
+@group(0) @binding(0) var<uniform> cfg: Config;
+@group(0) @binding(1) var<storage, read> ops: array<u32>;
+@group(0) @binding(2) var<storage, read> rows: array<u32>;
+@group(0) @binding(3) var<storage, read> refs: array<u32>;
+@group(0) @binding(4) var<storage, read> data: array<u32>;
+@group(0) @binding(5) var<storage, read_write> output: array<u32>;
+fn unpack(v: u32) -> vec4<u32> {
+    return vec4<u32>(v & 255u, (v >> 8u) & 255u, (v >> 16u) & 255u, v >> 24u);
+}
+fn pack(v: vec4<u32>) -> u32 {
+    let p = v & vec4<u32>(255u);
+    return p.x | (p.y << 8u) | (p.z << 16u) | (p.w << 24u);
+}
+fn covered(dst: vec4<u32>, src: vec4<u32>, coverage: u32, over: bool) -> vec4<u32> {
+    if !over { return (src * coverage) / 16776960u; }
+    let a = (65535u - src.w * coverage / 65535u) * 257u;
+    return (dst * a + src * coverage) / 16776960u;
+}
+@compute @workgroup_size(8, 8)
+fn main(@builtin(global_invocation_id) id: vec3<u32>) {
+    let x = id.x;
+    let y = id.y;
+    if x >= cfg.width || y >= cfg.height { return; }
+    let at = y * cfg.stride + x;
+    var pixel = unpack(output[at]);
+    let tile = (y / 16u) * cfg.tiles_x + x / 16u;
+    let start = rows[tile * 2u];
+    let end = start + rows[tile * 2u + 1u];
+    for (var ri = start; ri < end; ri++) {
+        let oi = refs[ri] * 16u;
+        let min_x = ops[oi];
+        let min_y = ops[oi + 1u];
+        if x < min_x || y < min_y || x >= ops[oi + 2u] || y >= ops[oi + 3u] { continue; }
+        let kind = ops[oi + 8u];
+        let over = ops[oi + 9u] == 0u;
+        var src = vec4<u32>(ops[oi + 4u], ops[oi + 5u], ops[oi + 6u], ops[oi + 7u]);
+        if kind == 3u {
+            let row = ops[oi + 10u] + (y - min_y) * 2u;
+            let spans_start = data[row];
+            let spans_end = spans_start + data[row + 1u] * 3u;
+            for (var si = spans_start; si < spans_end; si += 3u) {
+                if x >= data[si] && x < data[si + 1u] {
+                    pixel = covered(pixel, src, data[si + 2u], over) & vec4<u32>(255u);
+                }
+            }
+            continue;
+        }
+        if kind == 2u {
+            let index = ops[oi + 10u] + (y - min_y) * ops[oi + 11u] + x - min_x;
+            src = unpack(data[index]) * 257u;
+        }
+        let mask_offset = ops[oi + 12u];
+        if mask_offset != 0xffffffffu {
+            let mx = x - min_x + ops[oi + 14u];
+            let my = y - min_y + ops[oi + 15u];
+            let byte_at = my * ops[oi + 13u] + mx;
+            let alpha = ((data[mask_offset + byte_at / 4u] >> ((byte_at % 4u) * 8u)) & 255u) * 257u;
+            pixel = covered(pixel, src, alpha, over) & vec4<u32>(255u);
+        } else if over {
+            let a = (65535u - src.w) * 257u;
+            pixel = ((pixel * a / 65535u + src) >> vec4<u32>(8u)) & vec4<u32>(255u);
+        } else {
+            pixel = src >> vec4<u32>(8u);
+        }
+    }
+    output[at] = pack(pixel);
+}

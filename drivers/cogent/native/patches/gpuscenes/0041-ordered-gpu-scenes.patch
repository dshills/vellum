+// Copyright (c) 2026, Davin Hills.
+// SPDX-License-Identifier: MIT
+
+package gpudraw
+
+import (
+	"errors"
+	"fmt"
+	"image"
+	"image/draw"
+	"math"
+	"sort"
+	"sync"
+	"sync/atomic"
+
+	"cogentcore.org/core/gpu"
+	"cogentcore.org/core/gpu/drawmatrix"
+	"cogentcore.org/core/math32"
+	"github.com/oliverbestmann/webgpu/wgpu"
+)
+
+const (
+	sceneSourceLimit    = 64
+	sceneSourceBytes    = uint64(128 << 20)
+	sceneAggregateBytes = uint64(256 << 20)
+	sceneDrawSlots      = 4096
+	sceneDrawCoordinate = 1 << 24
+)
+
+var (
+	ErrSceneSourceInvalid  = errors.New("gpudraw: invalid scene source")
+	ErrSceneSourceBusy     = errors.New("gpudraw: scene source callback busy")
+	ErrSceneSourceRetired  = errors.New("gpudraw: scene source retired")
+	ErrSceneSourceCapacity = errors.New("gpudraw: scene source capacity exceeded")
+)
+
+// SceneDraw describes one source's exact position in the current composition.
+// Size is the expected single-layer sampled texture size. Zero SR means all of
+// it; OP is Src or Over. The source callback must not call legacy Drawer APIs.
+type SceneDraw struct {
+	Size image.Point
+	DP   image.Point
+	SR   image.Rectangle
+	Op   draw.Op
+}
+
+type sceneSourceRegistry struct {
+	owner   *Drawer
+	next    uint64
+	bytes   uint64
+	closed  bool
+	entries map[uint64]*SceneSourceLease
+}
+
+// SceneSourceLease is an originating drawer-owned source resource lifetime.
+// Use the returned pointer; copies are refused. Callbacks are serialized with
+// ordinary composition and drawer teardown. Retirement callbacks must release
+// only private GPU handles, never acquire a render context or call application
+// code. They may drain the borrowed queue before releasing handles; GPU loss
+// and completion callbacks must remain nonblocking and never enter these locks.
+// Retirement callbacks must not invoke any Drawer method.
+type SceneSourceLease struct {
+	self           *SceneSourceLease
+	drawer         *Drawer
+	id             uint64
+	bytes          uint64
+	retired        atomic.Bool
+	closeRequested atomic.Bool
+	retire         func()
+}
+
+// SceneGPUContext is valid only within the admitted callback. Device is
+// borrowed: never release or retain the context's Device pointer. Resource-owned
+// handle wrappers may copy the borrowed Device value like gpu.Texture, using it
+// only inside subsequent lease callbacks or the retirement hook. GPU resources
+// created from it remain lease-owned and must be retired through the lease.
+// Context methods are checked; copying the context or using it later refuses.
+type SceneGPUContext struct {
+	Device *gpu.Device
+	self   *SceneGPUContext
+	lease  *SceneSourceLease
+	active bool
+	mu     sync.Mutex
+}
+
+// SetBudget reserves the actual total retained + transient replacement bytes
+// BEFORE allocating. Refusals do not change credits. Failed prepare callbacks
+// do not auto-refund: release their handles and then reduce the reservation.
+func (c *SceneGPUContext) SetBudget(bytes uint64) error {
+	if c == nil || c.self != c {
+		return ErrSceneSourceInvalid
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if !c.active || c.lease == nil || c.lease.retired.Load() {
+		return ErrSceneSourceRetired
+	}
+	if c.lease.closeRequested.Load() && bytes > c.lease.bytes {
+		return ErrSceneSourceRetired
+	}
+	return c.lease.setBudgetOwned(bytes)
+}
+
+// Budget returns the reservation held by this source in the admitted scope.
+func (c *SceneGPUContext) Budget() (uint64, error) {
+	if c == nil || c.self != c {
+		return 0, ErrSceneSourceInvalid
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if !c.active || c.lease == nil || c.lease.retired.Load() {
+		return 0, ErrSceneSourceRetired
+	}
+	return c.lease.bytes, nil
+}
+
+func (s *SceneSourceLease) setBudgetOwned(bytes uint64) error {
+	r := &s.drawer.sceneSources
+	if bytes > sceneSourceBytes || r.bytes > sceneAggregateBytes || r.bytes < s.bytes || bytes > sceneAggregateBytes-(r.bytes-s.bytes) {
+		return ErrSceneSourceCapacity
+	}
+	r.bytes = r.bytes - s.bytes + bytes
+	s.bytes = bytes
+	return nil
+}
+
+func (dw *Drawer) sceneDeviceOwned() (*gpu.Device, error) {
+	if dw.sceneSources.owner != dw || dw.sceneSources.closed || dw.System == nil || dw.System.Renderer == nil {
+		return nil, ErrSceneSourceRetired
+	}
+	d := dw.System.Device()
+	if d == nil || !d.Device.IsValid() || !d.Queue.IsValid() {
+		return nil, ErrSceneSourceRetired
+	}
+	if err := d.LossError(); err != nil {
+		return nil, fmt.Errorf("%w: %v", ErrSceneSourceRetired, err)
+	}
+	return d, nil
+}
+
+func (dw *Drawer) enterScene() error {
+	if dw == nil {
+		return ErrSceneSourceInvalid
+	}
+	if dw.sceneClosing.Load() {
+		return ErrSceneSourceRetired
+	}
+	if dw.sceneRetiring.Load() {
+		return ErrSceneSourceBusy
+	}
+	if !dw.sceneBusy.CompareAndSwap(false, true) {
+		return ErrSceneSourceBusy
+	}
+	dw.Lock()
+	if dw.sceneSources.owner != nil && dw.sceneSources.owner != dw {
+		dw.Unlock()
+		dw.sceneBusy.Store(false)
+		return ErrSceneSourceInvalid
+	}
+	return nil
+}
+
+func (dw *Drawer) leaveScene() {
+	defer dw.Unlock()
+	defer dw.sceneBusy.Store(false)
+	if !dw.sceneBatch {
+		dw.drainRequestedSceneSourcesOwned()
+	}
+}
+
+// NewSceneSource registers a bounded source lifetime on the existing window
+// device. It creates no device and no GPU allocation.
+func (dw *Drawer) NewSceneSource(retire func()) (*SceneSourceLease, error) {
+	if retire == nil {
+		return nil, ErrSceneSourceInvalid
+	}
+	if err := dw.enterScene(); err != nil {
+		return nil, err
+	}
+	defer dw.leaveScene()
+	if _, err := dw.sceneDeviceOwned(); err != nil {
+		return nil, err
+	}
+	return dw.newSceneSourceOwned(retire)
+}
+
+func (dw *Drawer) newSceneSourceOwned(retire func()) (*SceneSourceLease, error) {
+	r := &dw.sceneSources
+	if r.owner == nil {
+		r.owner = dw
+	}
+	if r.owner != dw {
+		return nil, ErrSceneSourceInvalid
+	}
+	if r.closed {
+		return nil, ErrSceneSourceRetired
+	}
+	if len(r.entries) == sceneSourceLimit || r.next == math.MaxUint64 {
+		return nil, ErrSceneSourceCapacity
+	}
+	if r.entries == nil {
+		r.entries = make(map[uint64]*SceneSourceLease)
+	}
+	r.next++
+	s := &SceneSourceLease{drawer: dw, id: r.next, retire: retire}
+	s.self = s
+	r.entries[s.id] = s
+	return s, nil
+}
+
+func (s *SceneSourceLease) enter() error {
+	if s == nil || s.self != s || s.drawer == nil {
+		return ErrSceneSourceInvalid
+	}
+	if s.retired.Load() || s.closeRequested.Load() {
+		return ErrSceneSourceRetired
+	}
+	if err := s.drawer.enterScene(); err != nil {
+		return err
+	}
+	if s.drawer.sceneSources.closed || s.drawer.sceneSources.entries[s.id] != s || s.retired.Load() || s.closeRequested.Load() {
+		s.drawer.leaveScene()
+		return ErrSceneSourceRetired
+	}
+	return nil
+}
+
+func (s *SceneSourceLease) context(dev *gpu.Device) *SceneGPUContext {
+	c := &SceneGPUContext{Device: dev, lease: s, active: true}
+	c.self = c
+	return c
+}
+
+func (c *SceneGPUContext) finish() {
+	c.mu.Lock()
+	c.active = false
+	c.Device = nil
+	c.mu.Unlock()
+}
+
+// WithResources owns allocation/submission or explicit source resource cleanup.
+// A callback panic/Goexit is preserved while context/lock admission is unwound.
+func (s *SceneSourceLease) WithResources(fn func(*SceneGPUContext) error) error {
+	if fn == nil {
+		return ErrSceneSourceInvalid
+	}
+	if err := s.enter(); err != nil {
+		return err
+	}
+	defer s.drawer.leaveScene()
+	dev, err := s.drawer.sceneDeviceOwned()
+	if err != nil {
+		return err
+	}
+	c := s.context(dev)
+	defer c.finish()
+	return fn(c)
+}
+
+func sceneDrawValid(desc SceneDraw, target image.Point, limit uint32) bool {
+	if desc.Op != draw.Src && desc.Op != draw.Over || desc.Size.X <= 0 || desc.Size.Y <= 0 || uint64(desc.Size.X) > uint64(limit) || uint64(desc.Size.Y) > uint64(limit) || target.X <= 0 || target.Y <= 0 {
+		return false
+	}
+	sr := desc.SR
+	if sr == (image.Rectangle{}) {
+		sr = image.Rectangle{Max: desc.Size}
+	}
+	if sr.Empty() || !sr.In(image.Rectangle{Max: desc.Size}) {
+		return false
+	}
+	// Matrix coordinates are float32. Refuse overflow/rounded giant integers
+	// before subtraction, addition, staging or any source callback.
+	for _, v := range []int{desc.DP.X, desc.DP.Y, sr.Min.X, sr.Min.Y, sr.Max.X, sr.Max.Y, target.X, target.Y} {
+		if v < -sceneDrawCoordinate || v > sceneDrawCoordinate {
+			return false
+		}
+	}
+	for _, v := range []int64{int64(desc.DP.X) - int64(sr.Min.X), int64(desc.DP.Y) - int64(sr.Min.Y), int64(desc.DP.X) + int64(sr.Dx()), int64(desc.DP.Y) + int64(sr.Dy())} {
+		if v < -sceneDrawCoordinate || v > sceneDrawCoordinate {
+			return false
+		}
+	}
+	return true
+}
+
+// Draw preflights destination, staging/texture binding capacity and samplers,
+// then lends the device to prepare. The callback may encode+submit only within
+// that scope, returning one live same-device texture. Only successful validation
+// appends the image and operation; error/panic/Goexit appends nothing. Budget
+// reservations remain until released explicitly or retired.
+func (s *SceneSourceLease) Draw(desc SceneDraw, prepare func(*SceneGPUContext) (*gpu.Texture, error)) error {
+	if prepare == nil {
+		return ErrSceneSourceInvalid
+	}
+	if err := s.enter(); err != nil {
+		return err
+	}
+	defer s.drawer.leaveScene()
+	dw := s.drawer
+	dev, err := dw.sceneDeviceOwned()
+	if err != nil {
+		return err
+	}
+	if !dw.sceneBatch {
+		return ErrSceneSourceInvalid
+	}
+	limits := dev.Device.GetLimits()
+	if !sceneDrawValid(desc, dw.DestSize(), limits.MaxTextureDimension2D) {
+		return ErrSceneSourceInvalid
+	}
+	if len(dw.opList) >= sceneDrawSlots || dw.images.capacity >= sceneDrawSlots && len(dw.images.free) == 0 {
+		return ErrSceneSourceCapacity
+	}
+	tvr, err := dw.System.Vars().VarByName(1, "TexSampler")
+	if err != nil {
+		return err
+	}
+	// Returned texture may reuse an old key or need one new slot. Prepare
+	// every possible destination sampler before the callback can submit.
+	n := dw.images.capacity
+	if len(dw.images.free) == 0 {
+		n += AllocChunk
+	}
+	if n <= 0 || n > sceneDrawSlots {
+		return ErrSceneSourceCapacity
+	}
+	if len(tvr.Values.Values) < n {
+		tvr.SetNValues(dev, n)
+	}
+	for _, v := range tvr.Values.Values {
+		if v == nil || v.Texture == nil {
+			return ErrSceneSourceInvalid
+		}
+		if err := v.Texture.Sampler.Config(dev); err != nil {
+			return err
+		}
+	}
+	mvl, err := dw.System.Vars().ValueByIndex(0, "Matrix", 0)
+	if err != nil {
+		return err
+	}
+	i := len(dw.opList)
+	if i >= mvl.DynamicN() {
+		mvl.SetDynamicN(min(sceneDrawSlots, i+AllocChunk))
+	}
+	sr := desc.SR
+	if sr == (image.Rectangle{}) {
+		sr = image.Rectangle{Max: desc.Size}
+	}
+	mat := math32.Matrix3{1, 0, 0, 0, 1, 0, float32(desc.DP.X - sr.Min.X), float32(desc.DP.Y - sr.Min.Y), 1}
+	matrix := drawmatrix.Config(dw.DestSize(), mat, desc.Size, sr, false)
+	if err := gpu.SetDynamicValueFrom(mvl, i, []drawmatrix.Matrix{*matrix}); err != nil {
+		return err
+	}
+	c := s.context(dev)
+	defer c.finish()
+	tx, err := prepare(c)
+	if err != nil {
+		return err
+	}
+	if s.closeRequested.Load() {
+		return ErrSceneSourceRetired
+	}
+	if !tx.LiveFor(dev) || tx.Format.Size != desc.Size || tx.Format.Layers != 1 || tx.Format.Samples != 1 || tx.Format.Format != wgpu.TextureFormatRGBA8UnormSrgb {
+		return ErrSceneSourceInvalid
+	}
+	if s.bytes < uint64(desc.Size.X)*uint64(desc.Size.Y)*4 {
+		return ErrSceneSourceCapacity
+	}
+	// No image.use or operation is visible before all descriptor/device/view
+	// checks. SetShared only borrows; sampler construction already succeeded.
+	index := 0
+	if record, ok := dw.images.all[tx]; ok {
+		index = record.index
+	} else if len(dw.images.free) > 0 {
+		index = dw.images.free[len(dw.images.free)-1]
+	} else {
+		index = dw.images.capacity
+	}
+	if index < 0 || index >= len(tvr.Values.Values) {
+		return ErrSceneSourceCapacity
+	}
+	changed, err := tvr.Values.Values[index].Texture.BindSharedChecked(tx, dev)
+	if err != nil {
+		return err
+	}
+	if changed {
+		tvr.VarGroup.ValuesUpdated()
+	}
+	actual, _ := dw.images.use(tx)
+	if actual != index {
+		panic("gpudraw: scene texture slot changed while drawer owned")
+	}
+	dw.curImageSize = desc.Size
+	dw.opList = append(dw.opList, desc.Op)
+	return nil
+}
+
+// Close retires one source exactly once. Reentrant/concurrent callback attempts
+// refuse rather than waiting behind the lock they already own.
+func (s *SceneSourceLease) Close() error {
+	if s == nil || s.self != s || s.drawer == nil {
+		return ErrSceneSourceInvalid
+	}
+	if s.retired.Load() {
+		return nil
+	}
+	if err := s.drawer.enterScene(); err != nil {
+		if errors.Is(err, ErrSceneSourceRetired) {
+			return nil
+		}
+		return err
+	}
+	defer s.drawer.leaveScene()
+	if s.drawer.sceneSources.entries[s.id] != s || s.retired.Load() {
+		return nil
+	}
+	if s.drawer.sceneBatch {
+		s.closeRequested.Store(true)
+		return ErrSceneSourceBusy
+	}
+	s.retireOwned()
+	return nil
+}
+
+// RequestClose is a checked nonblocking retirement request. It never invokes a
+// callback or takes the drawer lock, including inside an admitted scope. The
+// registry keeps ownership after the caller drops its wrapper. Retirement runs
+// after the pending batch submits, after a non-batch scope ends, or at Release.
+func (s *SceneSourceLease) RequestClose() error {
+	if s == nil || s.self != s || s.drawer == nil {
+		return ErrSceneSourceInvalid
+	}
+	if !s.retired.Load() {
+		s.closeRequested.Store(true)
+	}
+	return nil
+}
+
+func (s *SceneSourceLease) retireOwned() {
+	if s.retired.Swap(true) {
+		return
+	}
+	dw := s.drawer
+	delete(dw.sceneSources.entries, s.id)
+	dw.sceneSources.bytes -= s.bytes
+	s.bytes = 0
+	f := s.retire
+	s.retire = nil
+	if f != nil {
+		f()
+	}
+}
+
+// retireSceneSourcesOwned cannot enter render-context ownership. The deferred
+// tail attempts remaining hooks even during a panic/Goexit; unwinding survives.
+func (dw *Drawer) retireSceneSourcesOwned() {
+	dw.sceneSources.closed = true
+	dw.retireSelectedSceneSourcesOwned(true)
+}
+
+func (dw *Drawer) drainRequestedSceneSourcesOwned() {
+	if dw.sceneBatch {
+		return
+	}
+	dw.retireSelectedSceneSourcesOwned(false)
+}
+
+func (dw *Drawer) retireSelectedSceneSourcesOwned(all bool) {
+	if len(dw.sceneSources.entries) == 0 {
+		return
+	}
+	if !all {
+		requested := false
+		for _, source := range dw.sceneSources.entries {
+			if source.closeRequested.Load() {
+				requested = true
+				break
+			}
+		}
+		if !requested {
+			return
+		}
+	}
+	dw.sceneRetiring.Store(true)
+	defer dw.sceneRetiring.Store(false)
+	ids := make([]uint64, 0, len(dw.sceneSources.entries))
+	for id, source := range dw.sceneSources.entries {
+		if all || source.closeRequested.Load() {
+			ids = append(ids, id)
+		}
+	}
+	sort.Slice(ids, func(i, j int) bool { return ids[i] < ids[j] })
+	var retire func(int)
+	retire = func(i int) {
+		if i == len(ids) {
+			return
+		}
+		defer retire(i + 1)
+		if s := dw.sceneSources.entries[ids[i]]; s != nil {
+			s.retireOwned()
+		}
+	}
+	retire(0)
+}
+
+// SceneSourceBudgetSnapshot observes only registered source reservations, not
+// all memory owned by the legacy drawer or GPU driver.
+type SceneSourceBudgetSnapshot struct {
+	Sources int
+	Bytes   uint64
+	Closed  bool
+}
+
+func (dw *Drawer) SceneSourceBudget() (SceneSourceBudgetSnapshot, error) {
+	if err := dw.enterScene(); err != nil {
+		return SceneSourceBudgetSnapshot{}, err
+	}
+	defer dw.leaveScene()
+	return SceneSourceBudgetSnapshot{len(dw.sceneSources.entries), dw.sceneSources.bytes, dw.sceneSources.closed}, nil
+}

+func TestVellumScenePacketActualPathCoverageParity(t *testing.T) {
+	for _, height := range []int{64, 1152} {
+		for _, scene := range vellumOwnedPathScenes(height) {
+			rs := New(math32.Vec2(96, float32(height))).(*Renderer)
+			got := image.NewRGBA(rs.image.Rect)
+			draw.Draw(got, got.Rect, image.NewUniform(color.RGBA{13, 22, 31, 91}), image.Point{}, draw.Src)
+			copy(rs.image.Pix, got.Pix)
+			packet := rs.ScenePacket(scene.items)
+			if packet == nil {
+				t.Fatal("standard path scene refused", scene.name, height)
+			}
+			if _, ok := packet.Encode(); !ok {
+				t.Fatal("standard path packet encoding refused", scene.name, height)
+			}
+			if !packet.Replay(got) {
+				t.Fatal("replay refused")
+			}
+			rs.Render(scene.items)
+			if !bytes.Equal(got.Pix, rs.image.Pix) {
+				t.Fatal("exact original path/stroke/clip pixels differ", scene.name, height)
+			}
+		}
+	}
+}

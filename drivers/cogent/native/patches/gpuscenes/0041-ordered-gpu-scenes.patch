+	for i := range txt.Text.Lines[0].Selections {
+		txt.Text.Lines[0].Selections[i] = textpos.Range{Start: 0, End: 1}
+	}
+	txt.Geometry = &shaped.Interaction{Cells: make([]shaped.Cell, 4096)}
+	for i := range txt.Geometry.Cells {
+		txt.Geometry.Cells[i] = shaped.Cell{Range: textpos.Range{Start: 0, End: 1}, Line: 0}
+	}
+	cases["selection-product"] = render.Render{txt}
+	txt = vellumSceneText(t)
+	txt.Text.Lines = make([]shaped.Line, sceneMaxItems+1)
+	cases["line-count"] = render.Render{txt}
+	txt = vellumSceneText(t)
+	r = *txt.Text.Lines[0].Runs[0].(*shapedgt.Run)
+	r.Glyphs = make([]shaping.Glyph, sceneMaxItems+1)
+	txt.Text.Lines[0].Runs = []shaped.Run{&r}
+	cases["glyph-count"] = render.Render{txt}
+	for name, commands := range cases {
+		t.Run(name, func(t *testing.T) {
+			if rs.ScenePacket(commands) != nil {
+				t.Fatal("unsafe aggregate/source admitted")
+			}
+		})
+	}
+	calls := 0
+	txt = vellumSceneText(t)
+	txt.Text.SelectionColor = sceneHookImage{&calls}
+	if rs.ScenePacket(render.Render{item, txt}) != nil || calls != 0 {
+		t.Fatal("selection callback invoked before complete preflight")
+	}
+}
+func TestVellumScenePacketFailureStopsTextResources(t *testing.T) {
+	b := sceneplan.New(image.Rect(0, 0, 64, 64))
+	rs := &Renderer{sceneRecord: b, sceneWork: &sceneWorkBudget{remaining: sceneMaxWork, outlines: font.NewGlyphOutlineBudget(1024, 1024)}}
+	sp := &sceneSpanner{builder: b, op: int(draw.Over)}
+	rs.Scanner = scan.NewScannerWithRowTracking(sp, 64, 64)
+	rs.Raster = NewDasher(64, 64, rs.Scanner)
+	ctx := &render.Context{}
+	ctx.Init(styles.NewPaint(), &render.Bounds{Rect: math32.B2FromRect(image.Rect(0, 0, 64, 64))}, nil)
+	calls := 0
+	run := &shapedgt.Run{}
+	run.Background = sceneHookImage{&calls}
+	run.MaxBounds = math32.Box2{Max: math32.Vec2(20, 20)}
+	lns := &shaped.Lines{Lines: []shaped.Line{{Runs: []shaped.Run{run, (*shapedgt.Run)(nil)}}}, Color: color.Black}
+	rs.TextLinesWithGeometry(ctx, lns, math32.Vector2{}, nil)
+	if !b.Failed() || calls != 0 {
+		t.Fatal("failed background did not stop next nil run or called source hook")
+	}
+	// Already-failed entry points must not touch invalid downstream arguments.
+	rs.TextLines(nil, nil, math32.Vector2{})
+	rs.TextRun(nil, nil, nil, nil, nil, math32.Vector2{}, false)
+	beforeBitmap, beforeSVG := len(bitmapGlyphCache), len(svgGlyphCache)
+	b2 := sceneplan.New(image.Rect(0, 0, 64, 64))
+	rs.sceneRecord = b2
+	rs.GlyphBitmap(nil, nil, nil, font.GlyphBitmap{}, nil, nil, math32.Box2{}, math32.Vector2{}, false)
+	if !b2.Failed() || len(bitmapGlyphCache) != beforeBitmap {
+		t.Fatal("bitmap capture allocated before refusal")
+	}
+	b3 := sceneplan.New(image.Rect(0, 0, 64, 64))
+	rs.sceneRecord = b3
+	rs.GlyphSVG(nil, nil, nil, []byte("invalid"), math32.Box2{}, math32.Vector2{}, false)
+	if !b3.Failed() || len(svgGlyphCache) != beforeSVG {

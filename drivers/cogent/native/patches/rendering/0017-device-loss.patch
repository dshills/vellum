+package gpu
+
+import (
+	"errors"
+	"github.com/oliverbestmann/webgpu/wgpu"
+	"sync"
+	"sync/atomic"
+	"testing"
+)
+
+func TestDeviceLossBorrowedCopiesAndObservers(t *testing.T) {
+	h := &deviceHealth{}
+	original := &Device{health: h}
+	borrowed := *original
+	var delivered atomic.Int32
+	cancel := original.ObserveLoss(func(error) { delivered.Add(100) })
+	cancel()
+	borrowed.ObserveLoss(func(error) { delivered.Add(1); original.ObserveLoss(func(error) { delivered.Add(1) }) })
+	h.callback(wgpu.DeviceLostReasonDestroyed, "expected teardown")
+	if original.LossError() != nil {
+		t.Fatal("normal teardown marked lost")
+	}
+	h.fail(errors.New("lost"))
+	h.fail(errors.New("duplicate"))
+	if delivered.Load() != 2 || borrowed.LossError() == nil {
+		t.Fatal("loss delivery", delivered.Load())
+	}
+}
+func TestDeviceLossConcurrentSubscribeCancel(t *testing.T) {
+	h := &deviceHealth{}
+	d := &Device{health: h}
+	var wg sync.WaitGroup
+	for i := 0; i < 100; i++ {
+		wg.Go(func() { cancel := d.ObserveLoss(func(error) {}); cancel(); _ = d.LossError() })
+	}
+	wg.Go(func() { h.fail(errors.New("fault")) })
+	wg.Wait()
+	if d.LossError() == nil {
+		t.Fatal("lost fault")
+	}
+}

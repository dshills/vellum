+// deviceHealth transfers spontaneous device loss without entering native locks.
+type deviceHealth struct {
+	mu        sync.Mutex
+	lost      error
+	next      uint64
+	observers map[uint64]func(error)
+}
+
+func (h *deviceHealth) callback(reason wgpu.DeviceLostReason, message string) {
+	if reason == wgpu.DeviceLostReasonDestroyed {
+		return
+	}
+	h.fail(fmt.Errorf("WebGPU device lost (%s): %s", reason, message))
+}
+func (h *deviceHealth) fail(err error) {
+	h.mu.Lock()
+	if h.lost != nil {
+		h.mu.Unlock()
+		return
+	}
+	h.lost = err
+	callbacks := make([]func(error), 0, len(h.observers))
+	for _, f := range h.observers {
+		callbacks = append(callbacks, f)
+	}
+	h.observers = nil
+	h.mu.Unlock()
+	for _, f := range callbacks {
+		f(err)
+	}
+}
+
+// LossError returns the first unexpected loss, including through borrowed copies.
+func (dv *Device) LossError() error {
+	if dv == nil || dv.health == nil {
+		return nil
+	}
+	dv.health.mu.Lock()
+	defer dv.health.mu.Unlock()
+	return dv.health.lost
+}
+
+// ObserveLoss registers a nonblocking callback. It may run on a foreign GPU
+// thread, including before this function returns. Cancel unregisters future
+// notifications but cannot recall a callback already copied for delivery.
+func (dv *Device) ObserveLoss(f func(error)) func() {
+	if dv == nil || dv.health == nil || f == nil {
+		return func() {}
+	}
+	h := dv.health
+	h.mu.Lock()
+	if h.lost != nil {
+		err := h.lost
+		h.mu.Unlock()
+		f(err)
+		return func() {}
+	}
+	h.next++
+	id := h.next
+	if h.observers == nil {
+		h.observers = map[uint64]func(error){}
+	}
+	h.observers[id] = f
+	h.mu.Unlock()
+	return func() { h.mu.Lock(); delete(h.observers, id); h.mu.Unlock() }
+}

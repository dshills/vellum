+package gpu
+
+import (
+	"github.com/oliverbestmann/webgpu/wgpu"
+	"testing"
+)
+
+func TestSurfaceAcquisitionYieldsAndBoundedRecovery(t *testing.T) {
+	for _, status := range []wgpu.SurfaceGetCurrentTextureStatus{wgpu.SurfaceGetCurrentTextureStatusOccluded, wgpu.SurfaceGetCurrentTextureStatusTimeout} {
+		calls := 0
+		configs := 0
+		f, e := acquireSurfaceFrame(func() (wgpu.SurfaceTexture, error) { calls++; return wgpu.SurfaceTexture{Status: status}, nil }, func() { configs++ })
+		if e != nil || f.Status != status || calls != 1 || configs != 0 {
+			t.Fatal("unavailable surface did not yield", calls, configs, e)
+		}
+	}
+	calls := 0
+	configs := 0
+	frame, e := acquireSurfaceFrame(func() (wgpu.SurfaceTexture, error) {
+		calls++
+		status := wgpu.SurfaceGetCurrentTextureStatusOutdated
+		if calls == 2 {
+			status = wgpu.SurfaceGetCurrentTextureStatusSuccessOptimal
+		}
+		return wgpu.SurfaceTexture{Status: status}, nil
+	}, func() { configs++ })
+	if e != nil || !frame.IsStatusSuccess() || calls != 2 || configs != 1 {
+		t.Fatal("surface not recovered")
+	}
+	calls = 0
+	configs = 0
+	_, e = acquireSurfaceFrame(func() (wgpu.SurfaceTexture, error) {
+		calls++
+		return wgpu.SurfaceTexture{Status: wgpu.SurfaceGetCurrentTextureStatusLost}, nil
+	}, func() { configs++ })
+	if e != nil || calls != 2 || configs != 1 {
+		t.Fatal("unbounded recovery")
+	}
+}

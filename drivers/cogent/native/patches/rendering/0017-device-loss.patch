+package core
+
+import (
+	"cogentcore.org/core/events"
+	"cogentcore.org/core/system"
+	"cogentcore.org/core/system/composer"
+	"sync"
+	"testing"
+	"time"
+)
+
+type contextTestWindow struct {
+	system.Window
+	mu sync.Mutex
+}
+
+func (w *contextTestWindow) Lock() bool { w.mu.Lock(); return true }
+func (w *contextTestWindow) Unlock()    { w.mu.Unlock() }
+
+type contextTestComposer struct {
+	composer.Composer
+	composed chan struct{}
+}
+
+func (c *contextTestComposer) Compose() { close(c.composed) }
+func TestCompositionWaitsForResizeAndDestroyContext(t *testing.T) {
+	w := &renderWindow{SystemWindow: &contextTestWindow{}}
+	w.mains.renderContext = &renderContext{}
+	w.renderContext().Lock()
+	c := &contextTestComposer{composed: make(chan struct{})}
+	done := make(chan struct{})
+	go func() { w.renderAsync(c); close(done) }()
+	select {
+	case <-c.composed:
+		t.Fatal("composition bypassed resize context")
+	case <-time.After(20 * time.Millisecond):
+	}
+	w.renderContext().Unlock()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("composition stuck")
+	}
+}
+func TestInlineCompositionUsesAlreadyOwnedContext(t *testing.T) {
+	w := &renderWindow{SystemWindow: &contextTestWindow{}}
+	w.mains.renderContext = &renderContext{}
+	w.renderContext().Lock()
+	defer w.renderContext().Unlock()
+	c := &contextTestComposer{composed: make(chan struct{})}
+	w.renderAsyncOwned(c)
+	<-c.composed
+}
+
+func TestIdleBarrierPublicationAndRetirement(t *testing.T) {
+	w := &renderWindow{}
+	d := &events.Deque{}
+	var wg sync.WaitGroup
+	wg.Add(2)
+	go func() {
+		defer wg.Done()
+		for range 1000 {
+			done := make(chan struct{}, 1)
+			w.noEventsChan.Store(&done)
+			w.noEventsChan.CompareAndSwap(&done, nil)
+		}
+	}()
+	go func() {
+		defer wg.Done()
+		for range 1000 {
+			w.notifyNoEvents(d)
+		}
+	}()
+	wg.Wait()
+	done := make(chan struct{}, 1)
+	w.noEventsChan.Store(&done)
+	done <- struct{}{}
+	w.notifyNoEvents(d) // a previously signaled/retired consumer cannot block it
+}

+// Unavailable/occluded surfaces yield without polling under a render lock.
+// Lost/outdated surface configuration gets one bounded retry on the same device.
+func acquireSurfaceFrame(acquire func() (wgpu.SurfaceTexture, error), configure func()) (wgpu.SurfaceTexture, error) {
+	for attempt := 0; attempt < 2; attempt++ {
+		frame, err := acquire()
+		if err != nil {
+			return frame, err
+		}
+		if frame.IsStatusSuccess() {
+			return frame, nil
+		}
+		if frame.Texture != nil {
+			frame.Texture.Release()
+			frame.Texture = nil
+		}
+		if (frame.Status == wgpu.SurfaceGetCurrentTextureStatusOutdated || frame.Status == wgpu.SurfaceGetCurrentTextureStatusLost) && attempt == 0 {
+			configure()
+			continue
+		}
+		return frame, nil
+	}
+	panic("unreachable surface acquisition")
+}

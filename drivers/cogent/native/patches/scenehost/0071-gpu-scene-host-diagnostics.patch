+
+type nativeHostTimingSource struct {
+	renderer           *gpuscene.Renderer
+	drawer             *gpudraw.Drawer
+	commands           render.Render
+	ordinary, measured int
+}
+
+func (s *nativeHostTimingSource) Draw(composer.Composer) {
+	s.ordinary++
+	s.renderer.DrawScene(s.drawer, s.commands, image.Point{}, draw.Src, false)
+}
+func (s *nativeHostTimingSource) DrawMeasured(composer.Composer) composer.SourceTiming {
+	s.measured++
+	result := s.renderer.DrawScene(s.drawer, s.commands, image.Point{}, draw.Src, true)
+	result.Kind = composer.SourceScene
+	return result
+}
+
+func TestVellumSceneHostNativeComposerTicketNestingAndNoDoubleCount(t *testing.T) {
+	if os.Getenv("VELLUM_GPU_SCENE_TEST") != "1" {
+		t.Skip("explicit native GPU admission required")
+	}
+	gp, dev, err := gpu.NoDisplayGPU()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer gp.Release()
+	defer dev.Release()
+	size := image.Pt(23, 19)
+	target := gpu.NewRenderTexture(gp, dev, size, 1, gpu.UndefinedType)
+	defer target.Release()
+	dw := gpudraw.NewDrawer(gp, target)
+	defer dw.Release()
+	renderer := gpuscene.New(math32.FromPoint(size)).(*gpuscene.Renderer)
+	defer renderer.Release()
+	source := &nativeHostTimingSource{renderer: renderer, drawer: dw, commands: render.Render{&pimage.Params{Cmd: pimage.Draw, Source: image.NewUniform(color.RGBA{13, 31, 59, 255}), Op: draw.Src}}}
+	cd := &composer.ComposerDrawer{Drawer: dw, Sources: []composer.Source{source}}
+	ordinary := cd.ComposeMeasured()
+	if !ordinary.Supported || !ordinary.Submitted || ordinary.Failure != "" || ordinary.SourceDetails != nil || source.ordinary != 1 || source.measured != 0 {
+		t.Fatal("ordinary draw acquired diagnostics or failed", ordinary)
+	}
+	trace := NewFrameTraceWithSourceDetails()
+	event := traceScroll()
+	if err := trace.Begin(91, event); err != nil {
+		t.Fatal(err)
+	}
+	tag, start := trace.startEvent(event)
+	trace.ExpectOwner(tag)
+	trace.endEvent(tag, start)
+	trace.Transition(tag, 1)
+	trace.OwnerWork(tag, 7)
+	trace.Reconciled(tag, 11)
+	if trace.startFrame() != tag {
+		t.Fatal("missing frame claim")
+	}
+	composed := cd.ComposeMeasuredWithSourceDetails()
+	if !composed.Supported || !composed.Submitted || composed.Failure != "" || composed.SourceDetails == nil || len(composed.SourceDetails.Records) != 1 {
+		t.Fatal("native detailed composition failed", composed)
+	}
+	record := composed.SourceDetails.Records[0]
+	host := record.SceneHost
+	if !host.Available || !host.DrawAccepted || host.Fallback || !host.CaptureAttempted || !host.EncodeAttempted || !host.LeaseAttempted || !host.ResourcesEntered || !host.InputAttempted || host.InputWriteAttempts != 5 || host.QueueSubmitAttempts != 1 {
+		t.Fatal("native GPU host observation missing", record)
+	}
+	if host.CaptureNS < 0 || host.EncodeNS < 0 || host.LeaseNS < 0 || host.ResourcesNS < 0 || host.InputNS < 0 || host.CaptureNS+host.EncodeNS+host.LeaseNS > record.DrawNS || host.InputNS > host.ResourcesNS || host.ResourcesNS > host.LeaseNS || record.DrawNS > composed.RasterUploadNS {
+		t.Fatal("native host intervals exceed parent elapsed work", record, composed)
+	}
+	trace.finishFrame(tag, composed)
+	sample, ok := trace.Take()
+	if !ok || !sample.Completed || sample.Failure != "" || sample.SourceDetails == nil || len(sample.SourceDetails.Records) != 1 || source.ordinary != 1 || source.measured != 1 {
+		t.Fatal("ticket failed or drew a source twice", sample)
+	}
+	got := sample.SourceDetails.Records[0]
+	if got.SceneHost != host || got.DrawNS != record.DrawNS || sample.RasterUploadNS != composed.RasterUploadNS || sample.EncodeSubmitNS != composed.EncodeSubmitNS {
+		t.Fatal("ticket changed host values or counted nested work twice", sample)
+	}
+	counted := sample.InputNS + sample.OwnerNS + sample.ReconcileNS + sample.LayoutPaintNS + sample.GatherNS + sample.RasterUploadNS + sample.EncodeSubmitNS
+	if sample.TotalUIWorkNS != counted {
+		t.Fatal("nested diagnostics changed exact UI-work accounting", sample)
+	}
+	composed.SourceDetails.Records[0].SceneHost = composer.SceneHostTiming{}
+	if sample.SourceDetails.Records[0].SceneHost != host {
+		t.Fatal("native ticket aliases completed composer record")
+	}
+}

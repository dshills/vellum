+package core
+
+import (
+	"cogentcore.org/core/system/composer"
+	"math"
+	"testing"
+)
+
+func TestVellumSceneHostCountersRefuseTicketOverflowWithoutAppending(t *testing.T) {
+	for _, field := range []string{"attempts", "errors", "bytes", "submits"} {
+		t.Run(field, func(t *testing.T) {
+			dst, src := sourceTraceComposition(1).SourceDetails, sourceTraceComposition(1).SourceDetails
+			set := func(h *composer.SceneHostTiming, n uint64) {
+				h.Available = true
+				switch field {
+				case "attempts":
+					h.InputWriteAttempts = n
+				case "errors":
+					h.InputWriteErrors = n
+				case "bytes":
+					h.LogicalInputBytes = n
+				case "submits":
+					h.QueueSubmitAttempts = n
+				}
+			}
+			set(&dst.Records[0].SceneHost, math.MaxUint64)
+			set(&src.Records[0].SceneHost, 1)
+			if appendFrameSourceDetails(dst, src) == "" || len(dst.Records) != 1 {
+				t.Fatal("accepted GPU host counter overflow or appended refused record")
+			}
+		})
+	}
+}
+
+func TestVellumSceneHostScalarCopyRemainsDetached(t *testing.T) {
+	dst := &composer.SourceDetails{}
+	src := sourceTraceComposition(1).SourceDetails
+	src.Records[0].SceneHost = composer.SceneHostTiming{Available: true, LeaseAttempted: true, ResourcesEntered: true, LeaseNS: 70, ResourcesNS: 50, DrawAccepted: true, Reused: true}
+	if err := appendFrameSourceDetails(dst, src); err != "" {
+		t.Fatal(err)
+	}
+	src.Records[0].SceneHost.ResourcesNS = 999
+	if dst.Records[0].SceneHost.ResourcesNS != 50 || dst.Records[0].SceneHost.InputWriteAttempts != 0 {
+		t.Fatal("scene observation aliases source or invents writes")
+	}
+}

+package gpuscene
+
+import (
+	"cogentcore.org/core/system/composer"
+	"errors"
+	"testing"
+)
+
+func TestVellumGPUInputTimingPreservesAdmissionRefusal(t *testing.T) {
+	res := &resources{}
+	sentinel := errors.New("refused before any native device access")
+	host := &composer.SceneHostTiming{Available: true}
+	err := res.uploadInput(nil, func(uint64) error { return sentinel }, host)
+	if !errors.Is(err, sentinel) || !host.InputAttempted || host.InputNS < 0 || host.InputWriteAttempts != 0 || host.InputWriteErrors != 0 || host.LogicalInputBytes != 0 || host.QueueSubmitAttempts != 0 {
+		t.Fatal("admission refusal invented native writes", host, err)
+	}
+	err = res.uploadInput(nil, func(uint64) error { return sentinel }, nil)
+	if !errors.Is(err, sentinel) {
+		t.Fatal("ordinary admission outcome changed", err)
+	}
+}

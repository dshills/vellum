+// This must be run only with the existing explicit native GPU admission. A
+// validation-error write exercises the real checked API, not a synthetic count.
+func TestVellumGPUSceneNativeInputAttemptBytesFailureAndRecovery(t *testing.T) {
+	_, dev := nativeDevice(t)
+	size := image.Pt(23, 19)
+	res := &resources{}
+	defer res.release()
+	reserve := func(n uint64) error {
+		if n > 1<<20 {
+			return fmt.Errorf("tiny native fixture budget exceeded")
+		}
+		return nil
+	}
+	if err := res.initialize(dev, size, reserve); err != nil {
+		t.Fatal(err)
+	}
+	expected := image.NewRGBA(image.Rectangle{Max: size})
+	b := sceneplan.New(expected.Rect)
+	b.Draw(expected.Rect, image.NewUniform(color.RGBA{13, 31, 59, 255}), image.Point{}, nil, image.Point{}, draw.Src)
+	packet := b.Seal(false)
+	if packet == nil {
+		t.Fatal("fixture capture refused")
+	}
+	encoded, ok := packet.EncodeGPU()
+	if !ok {
+		t.Fatal("fixture encoding refused")
+	}
+	inputBytes := uint64(len(encoded.Ops) + len(encoded.Rows) + len(encoded.Refs) + len(encoded.Data) + 16)
+	successful := func() {
+		t.Helper()
+		host := &composer.SceneHostTiming{Available: true}
+		if err := res.renderWithTiming(encoded, reserve, host); err != nil {
+			t.Fatal(err)
+		}
+		if !host.InputAttempted || host.InputNS < 0 || host.InputWriteAttempts != 5 || host.InputWriteErrors != 0 || host.LogicalInputBytes != inputBytes || host.QueueSubmitAttempts != 1 {
+			t.Fatal("actual successful writes differ from encoded byte ledger", host, inputBytes)
+		}
+	}
+	successful()
+	headroom := false
+	for i, input := range [][]byte{encoded.Ops, encoded.Rows, encoded.Refs, encoded.Data} {
+		if res.buffers[i+1].GetSize() > uint64(len(input)) {
+			headroom = true
+		}
+	}
+	if !headroom {
+		t.Fatal("fixture needs a capacity larger than encoded length to distinguish attempted bytes")
+	}
+	// Preserve both owned references. Wait for earlier submissions before swapping
+	// this test-owned slot; the rejected buffer deliberately lacks CopyDst usage.
+	dev.WaitDone()
+	original := res.buffers[2]
+	refused, err := dev.Device.TryCreateBuffer(&wgpu.BufferDescriptor{Label: "Vellum diagnostic checked-write refusal", Size: original.GetSize(), Usage: wgpu.BufferUsageStorage})
+	if err != nil {
+		t.Fatal(err)
+	}
+	res.buffers[2] = refused
+	restored := false
+	restore := func() {
+		if restored {
+			return
+		}
+		res.buffers[2] = original
+		refused.Release()
+		restored = true
+	}
+	defer restore()
+	host := &composer.SceneHostTiming{Available: true}
+	err = res.renderWithTiming(encoded, reserve, host)
+	if err == nil {
+		t.Fatal("native write unexpectedly accepted storage buffer without CopyDst")
+	}
+	t.Logf("checked input write refusal: %v", err)
+	if refused.GetUsage()&wgpu.BufferUsageCopyDst != 0 {
+		t.Fatal("refusal fixture unexpectedly permits CopyDst")
+	}
+	if loss := dev.LossError(); loss != nil {
+		t.Fatal("checked usage refusal contaminated device lifetime", loss)
+	}
+	partialBytes := uint64(len(encoded.Ops) + len(encoded.Rows))
+	if !host.InputAttempted || host.InputNS < 0 || host.InputWriteAttempts != 2 || host.InputWriteErrors != 1 || host.LogicalInputBytes != partialBytes || host.QueueSubmitAttempts != 0 {
+		t.Fatal("checked refusal lost attempted bytes, error or early return", host, partialBytes)
+	}
+	restore()
+	successful()
+	packet.Replay(expected)
+	got := readTexture(t, dev, res.texture)
+	if !bytes.Equal(got.Pix, expected.Pix) {
+		t.Fatal("restored native input path changed compositor pixels")
+	}
+}

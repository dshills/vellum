+func TestVellumPointerFailedReadbackForcesNextBaseline(t *testing.T) {
+	for _, kind := range []string{"mode", "unknown-mode", "warp"} {
+		t.Run(kind, func(t *testing.T) {
+			a, c, f, q := pointerHarness(t)
+			w := c.window
+			if kind == "warp" {
+				runPointer(t, a, q, func() { w.SetCursorEnabled(false, false) })
+			}
+			w.Event.Last.MousePos = image.Pt(10, 20)
+			w.acknowledgePointer(w.cursorScale.Load(), w.pointerFocus.Load())
+			used := w.pointerFocusUsed
+			oldPosition := c.pointer.backend.position
+			c.pointer.backend.position = func() (float64, float64) { return math.Inf(1), 0 }
+			oldMode := c.pointer.backend.mode
+			if kind == "unknown-mode" {
+				c.pointer.backend.mode = func() int {
+					if f.mode == glfw.CursorNormal {
+						return f.mode
+					}
+					return -123
+				}
+			}
+			err := cursorRun(t, a, q, func() error {
+				if kind == "warp" {
+					return w.setMousePos(100, 200)
+				}
+				return c.modeRequest(func(c *Cursor) { c.Vis = false })
+			})
+			if err == nil || w.Event.Last.MousePos != image.Pt(10, 20) || w.pointerFocus.Load() == used || w.pointerFocusUsed != used {
+				t.Fatal("failed readback acknowledged stale baseline", err)
+			}
+			if kind == "unknown-mode" && (f.mode != glfw.CursorHidden || !c.pointer.modeWritten || c.modeKnown) {
+				t.Fatal("unknown readback did not follow native setter")
+			}
+			if kind == "mode" && (!c.modeKnown || c.mode != glfw.CursorHidden || !w.IsCursorEnabled() || c.IsVisible()) {
+				t.Fatal("partial mode status lost")
+			}
+			c.pointer.backend.position = oldPosition
+			c.pointer.backend.mode = oldMode
+			w.CursorPosEvent(nil, 51, 102)
+			m := takePointerEvent(t, w)
+			if m.Where != image.Pt(102, 204) || m.Prev != m.Where {
+				t.Fatal("stale pre-operation delta after failed readback", m)
+			}
+		})
+	}

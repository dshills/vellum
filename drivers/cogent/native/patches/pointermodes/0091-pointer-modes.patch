+// Copyright 2026 Vellum contributors. SPDX-License-Identifier: MIT.
+package desktop
+
+import (
+	"fmt"
+	"image"
+	"math"
+	"strconv"
+
+	"cogentcore.org/core/base/fileinfo/mimedata"
+	"cogentcore.org/core/events"

+	usedDPR, usedFocus := w.pointerDPRUsed, w.pointerFocusUsed
+	c.retireStatus()
+	if w.admitPointerDrop(image.Pt(2, 3), nil, scale, 0) || w.admitPointerScroll(image.Pt(2, 3), 1, 1, scale) || w.Event.Last != saved || w.pointerDPRUsed != usedDPR || w.pointerFocusUsed != usedFocus {
+		t.Fatal("retired source mutated")
+	}
+	if _, ok := w.Event.Deque.PollEvent(); ok {
+		t.Fatal("retired event queued")

+type fakePointerBackend struct {
+	mode                                            int
+	raw, supported, eligible, refuseMode, refuseRaw bool
+	x, y                                            float64
+	calls                                           []string
+	writes                                          int
+	inspect                                         func()
+	panicRaw                                        bool
+}
+
+func fakePointer() (*nativePointerOwner, *fakePointerBackend) {
+	f := &fakePointerBackend{mode: glfw.CursorNormal, eligible: true}
+	check := func() {
+		if f.inspect != nil {
+			f.inspect()
+		}
+	}
+	return newNativePointerOwner(nativePointerBackend{
+		rawSupported: func() bool { check(); f.calls = append(f.calls, "cap"); return f.supported },
+		mode:         func() int { check(); return f.mode }, raw: func() bool { check(); return f.raw },
+		setMode: func(m int) {
+			check()
+			f.calls = append(f.calls, "mode:"+strconv.Itoa(m))
+			if !f.refuseMode {
+				f.mode = m
+			}
+		},
+		setRaw: func(v bool) {
+			check()
+			f.calls = append(f.calls, "raw:"+strconv.FormatBool(v))
+			if f.panicRaw {
+				panic("raw restore")
+			}
+			if !f.refuseRaw {
+				f.raw = v
+			}
+		},
+		canPosition: func() bool { check(); return f.eligible }, position: func() (float64, float64) { check(); return f.x, f.y },
+		setPosition: func(x, y float64) { check(); f.calls = append(f.calls, "warp"); f.writes++; f.x, f.y = x, y },
+	}), f
+}

+			dpr := float64(math.Float32frombits(uint32(packed)))
+			if !finite(dpr) || dpr <= 0 {
+				err = fmt.Errorf("desktop: invalid pointer scale")
+				return
+			}
+			nx /= dpr
+			ny /= dpr
+		}
+		if !pointComponent(nx) || !pointComponent(ny) {
+			err = fmt.Errorf("desktop: invalid native position")
+			return
+		}
+		o := cu.pointer
+		if !o.begin() {
+			err = fmt.Errorf("desktop: pointer busy or retired")
+			return
+		}
+		defer func() { o.busy = false }()
+		eligible := false
+		if !o.call(func() { eligible = o.backend.canPosition() }) || !eligible {
+			err = fmt.Errorf("desktop: pointer window not eligible")
+			return
+		}
+		m, _, known := cu.pointer.read()
+		if !known {
+			cu.mu.Lock()
+			cu.modeKnown = false
+			cu.mu.Unlock()
+			err = fmt.Errorf("desktop: unknown pointer mode")
+			return
+		}
+		if m == glfw.CursorDisabled {
+			p, ok := w.pointerPointAt(nx, ny, packed)
+			if !ok || !w.pointerDeltasFit(p, true) {
+				err = fmt.Errorf("desktop: virtual position delta overflow")
+				return
+			}
+		}
+		if !o.call(func() { o.backend.setPosition(nx, ny) }) {
+			err = fmt.Errorf("desktop: pointer retired")
+			return
+		}
+		var rx, ry float64
+		if !o.call(func() { rx, ry = o.backend.position() }) {
+			err = fmt.Errorf("desktop: pointer retired")
+			return
+		}
+		if _, ok := w.pointerPointAt(rx, ry, packed); !ok {
+			if m == glfw.CursorDisabled && w.pointerLive() {
+				w.pointerFocus.Add(1)
+			}
+			err = fmt.Errorf("desktop: invalid pointer readback")
+			return
+		}
+		if m == glfw.CursorDisabled {
+			if !w.rebasePointerAt(rx, ry, packed, focus) {
+				if w.pointerLive() {
+					w.pointerFocus.Add(1)
+				}
+				err = fmt.Errorf("desktop: virtual position rebase refused")
+				return
+			}
+		}
+		err = nil
+	})
+	return err
+}
+
+func (w *Window) acknowledgePointer(packed, focus uint64) {
+	w.pointerDPRUsed = uint32(packed)
+	w.pointerFocusUsed = focus
+}
+func (w *Window) admitPointerButton(typ events.Types, but events.Buttons, p image.Point, mods key.Modifiers, packed, focus uint64) bool {
+	if !w.pointerLive() {
+		return false
+	}
+	rebase := w.pointerDPRUsed != uint32(packed) || w.pointerFocusUsed != focus
+	if typ != events.MouseDown && w.Event.Last.MouseButtonType == events.MouseDown {
+		if !w.pointerDeltasFit(p, rebase) {
+			return false
+		}
+		if rebase {
+			w.Event.Last.MousePos = p
+		}
+	}
+	w.acknowledgePointer(packed, focus)
+	w.Event.MouseButton(typ, but, p, mods)
+	return true
+}
+func (w *Window) admitPointerDrop(p image.Point, md mimedata.Mimes, packed, focus uint64) bool {
+	if !w.pointerLive() {
+		return false
+	}
+	w.acknowledgePointer(packed, focus)
+	w.Event.DropExternal(p, md)
+	return true
+}
+func (w *Window) admitPointerScroll(p image.Point, x, y float64, packed uint64) bool {
+	if !w.pointerLive() {
+		return false
+	}
+	d, ok := w.pointerScrollDeltaAt(x, y, packed)
+	if !ok {
+		return false
+	}
+	w.Event.Scroll(p, d)
+	return true
+}
+func (w *Window) pointerScrollDelta(xoff, yoff float64) (math32.Vector2, bool) {
+	return w.pointerScrollDeltaAt(xoff, yoff, w.cursorScale.Load())
+}
+func (w *Window) pointerScrollDeltaAt(xoff, yoff float64, packed uint64) (math32.Vector2, bool) {
+	scale := -40.0
+	if w.App.Platform() == system.MacOS {
+		dpr := float64(math.Float32frombits(uint32(packed)))
+		if !finite(dpr) || dpr <= 0 {
+			return math32.Vector2{}, false
+		}
+		scale = -10 * dpr
+	}
+	dx, dy := xoff*scale, yoff*scale
+	if !finite(dx) || !finite(dy) || math.Abs(dx) > math.MaxFloat32 || math.Abs(dy) > math.MaxFloat32 {
+		return math32.Vector2{}, false
+	}
+	return math32.Vec2(float32(dx), float32(dy)), true
+}

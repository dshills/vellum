+)
+
+// All backend functions and nativePointerOwner contents belong to native main.
+// GLFW readback is logical driver state, not physical/compositor verification.
+type nativePointerBackend struct {
+	rawSupported func() bool
+	mode         func() int
+	setMode      func(int)
+	raw          func() bool
+	setRaw       func(bool)
+	canPosition  func() bool
+	position     func() (float64, float64)
+	setPosition  func(float64, float64)
+}
+type nativePointerOwner struct {
+	backend                                        nativePointerBackend
+	capabilityKnown, rawSupported, touched, closed bool
+	busy                                           bool
+	callbackDepth                                  int
+	cleanup                                        func()
+	live                                           func() bool
+	modeWritten                                    bool
+}
+
+func newNativePointerOwner(b nativePointerBackend) *nativePointerOwner {
+	return &nativePointerOwner{backend: b}
+}
+func glfwPointerBackend(w *Window) nativePointerBackend {
+	return nativePointerBackend{
+		rawSupported: glfw.RawMouseMotionSupported,
+		mode:         func() int { return w.Glw.GetInputMode(glfw.CursorMode) },
+		setMode:      func(m int) { w.Glw.SetInputMode(glfw.CursorMode, m) },
+		raw:          func() bool { return w.Glw.GetInputMode(glfw.RawMouseMotion) == glfw.True },
+		setRaw: func(v bool) {
+			n := glfw.False
+			if v {
+				n = glfw.True
+			}
+			w.Glw.SetInputMode(glfw.RawMouseMotion, n)
+		},
+		canPosition: func() bool {
+			return w.Glw.GetAttrib(glfw.Focused) == glfw.True && w.Glw.GetAttrib(glfw.Visible) == glfw.True && w.Glw.GetAttrib(glfw.Iconified) != glfw.True
+		},
+		position:    func() (float64, float64) { return w.Glw.GetCursorPos() },
+		setPosition: func(x, y float64) { w.Glw.SetCursorPos(x, y) },
+	}
+}
+func pointerModeKnown(m int) bool {
+	return m == glfw.CursorNormal || m == glfw.CursorHidden || m == glfw.CursorDisabled
+}
+
+// Backend calls may reenter status/close. Refuse nested mutations and check the
+// exact target lifetime both before and after every callback, without a mutex.
+func (o *nativePointerOwner) valid() bool {
+	return o != nil && !o.closed && (o.live == nil || o.live())
+}
+func (o *nativePointerOwner) call(f func()) bool {
+	if !o.valid() {
+		return false
+	}
+	o.callbackDepth++
+	// Full retirement can reenter a setter before it finishes changing state.
+	// Restore after that callback unwinds, even if it panics; preserve first panic.
+	drainAll(f, func() {
+		o.callbackDepth--
+		if o.callbackDepth == 0 && o.cleanup != nil {
+			cleanup := o.cleanup
+			o.cleanup = nil
+			cleanup()
+		}
+	})
+	return o.valid()
+}
+func (o *nativePointerOwner) begin() bool {
+	if !o.valid() || o.busy {
+		return false
+	}
+	o.busy = true
+	return true
+}
+func (o *nativePointerOwner) read() (m int, r, known bool) {
+	if !o.call(func() { m = o.backend.mode() }) {
+		return 0, false, false
+	}
+	if !o.call(func() { r = o.backend.raw() }) {
+		return 0, false, false
+	}
+	return m, r, pointerModeKnown(m) && (!r || m == glfw.CursorDisabled)
+}
+func (o *nativePointerOwner) position() (x, y float64, ok bool) {
+	if !o.begin() {
+		return 0, 0, false
+	}
+	defer func() { o.busy = false }()
+	ok = o.call(func() { x, y = o.backend.position() })
+	return
+}
+
+// apply gates each dependent setter on observed state. Unsupported raw motion
+// is a supported fallback; the Cocoa backend must not receive even setRaw(false).
+func (o *nativePointerOwner) apply(m int, r bool) (mode int, raw, known bool, err error) {
+	if !o.begin() {
+		return 0, false, false, fmt.Errorf("desktop: pointer owner closed")
+	}
+	defer func() { o.busy = false }()
+	o.modeWritten = false
+	if !o.capabilityKnown {
+		if !o.call(func() { o.rawSupported = o.backend.rawSupported() }) {
+			return 0, false, false, fmt.Errorf("desktop: pointer retired")
+		}
+		o.capabilityKnown = true
+	}
+	r = r && m == glfw.CursorDisabled && o.rawSupported
+	mode, raw, known = o.read()
+	refuse := func() (int, bool, bool, error) { return mode, raw, known, fmt.Errorf("desktop: pointer mode refused") }
+	if !known {
+		return refuse()
+	}
+	if raw && (!r || m != glfw.CursorDisabled) {
+		if !o.rawSupported {
+			return refuse()
+		}
+		o.touched = true
+		if !o.call(func() { o.backend.setRaw(false) }) {
+			return 0, false, false, fmt.Errorf("desktop: pointer retired")
+		}
+		mode, raw, known = o.read()
+		if !known || raw {
+			return refuse()
+		}
+	}
+	if mode != m {
+		o.touched = true
+		o.modeWritten = true
+		if !o.call(func() { o.backend.setMode(m) }) {
+			return 0, false, false, fmt.Errorf("desktop: pointer retired")
+		}
+		mode, raw, known = o.read()
+		if !known || mode != m {
+			return refuse()
+		}
+	}
+	if r && !raw {
+		if mode != glfw.CursorDisabled {
+			return refuse()
+		}
+		o.touched = true
+		if !o.call(func() { o.backend.setRaw(true) }) {
+			return 0, false, false, fmt.Errorf("desktop: pointer retired")
+		}
+		mode, raw, known = o.read()
+	}
+	if !known || mode != m || raw != r {
+		return refuse()
+	}
+	return mode, raw, known, nil
+}
+func (o *nativePointerOwner) close() {
+	if o == nil || o.closed {
+		return
+	}
+	o.closed = true
+	b, touched, supported := o.backend, o.touched, o.rawSupported
+	o.backend = nativePointerBackend{}
+	o.live = nil
+	if !touched {
+		return
+	}
+	// References clear immediately; one bounded restoration closure survives only
+	// until an active backend callback returns. Never restore before its final write.
+	cleanup := func() {
+		drainAll(func() {
+			if supported {
+				b.setRaw(false)
+			}
+		}, func() { b.setMode(glfw.CursorNormal) })
+	}
+	if o.callbackDepth > 0 {
+		o.cleanup = cleanup
+		return
+	}
+	cleanup()
+}
+
+func (cu *Cursor) modeRequest(change func(*Cursor)) error {
+	target := cu.facadeTarget()
+	if target == nil {
+		return fmt.Errorf("desktop: no pointer window")
+	}
+	cu = target
+	cu.mu.Lock()
+	if cu.closed || cu.modeSequence == ^uint64(0) {
+		cu.mu.Unlock()
+		return fmt.Errorf("desktop: pointer retired")
+	}
+	change(cu)
+	cu.modeSequence++
+	seq := cu.modeSequence
+	m := glfw.CursorNormal
+	if !cu.wantEnabled {
+		m = glfw.CursorDisabled
+	} else if !cu.Vis {
+		m = glfw.CursorHidden
+	}
+	raw := cu.wantRaw
+	w, a := cu.window, cu.app
+	cu.mu.Unlock()
+	if w == nil || a == nil {
+		return fmt.Errorf("desktop: no pointer window")
+	}
+	err := base.ErrMainStopped
+	a.nativeOnMain(func() {
+		cu.mu.Lock()
+		valid := !cu.closed && cu.window == w && cu.modeSequence == seq
+		cu.mu.Unlock()
+		if !valid || w.Glw == nil {
+			err = fmt.Errorf("desktop: pointer request retired")
+			return
+		}
+		if cu.pointer.busy {
+			err = fmt.Errorf("desktop: pointer mutation is reentrant")
+			return
+		}
+		mode, _, known, e := cu.pointer.apply(m, raw)
+		err = e
+		cu.mu.Lock()
+		if !cu.closed {
+			cu.mode, cu.modeKnown = mode, known
+			w.CursorEnabled = known && mode != glfw.CursorDisabled
+		}
+		cu.mu.Unlock()
+		// Mode changes alter GLFW virtual coordinates; only producer position is
+		// rebased. Drag anchor and event/down timestamps retain their original values.
+		if w.pointerLive() {
+			if !known {
+				w.pointerFocus.Add(1)
+			} else if cu.pointer.modeWritten {
+				packed, focus := w.cursorScale.Load(), w.pointerFocus.Load()
+				x, y, ok := cu.pointer.position()
+				if !ok || !w.rebasePointerAt(x, y, packed, focus) {
+					if w.pointerLive() {
+						w.pointerFocus.Add(1)
+					}
+					err = fmt.Errorf("desktop: pointer mode baseline unavailable")
+				}
+			}
+		}
+	})
+	return err
+}
+func finite(v float64) bool { return !math.IsNaN(v) && !math.IsInf(v, 0) }
+func pointComponent(v float64) bool {
+	bound := math.Ldexp(1, strconv.IntSize-1)
+	return finite(v) && v >= -bound && v < bound
+}
+func (w *Window) pointerDPR() float64 {
+	return float64(math.Float32frombits(uint32(w.cursorScale.Load())))
+}
+func (w *Window) pointerPoint(x, y float64) (image.Point, bool) {
+	return w.pointerPointAt(x, y, w.cursorScale.Load())
+}
+func (w *Window) pointerPointAt(x, y float64, packed uint64) (image.Point, bool) {
+	if w.App.Platform() == system.MacOS {
+		dpr := float64(math.Float32frombits(uint32(packed)))
+		if !finite(dpr) || dpr <= 0 {
+			return image.Point{}, false
+		}
+		x *= dpr
+		y *= dpr
+	}
+	if !pointComponent(x) || !pointComponent(y) {
+		return image.Point{}, false
+	}
+	return image.Pt(int(math.Floor(x)), int(math.Floor(y))), true
+}
+func (w *Window) pointerLive() bool {
+	cu := w.cursor
+	if cu == nil {
+		return false
+	}
+	cu.mu.Lock()
+	defer cu.mu.Unlock()
+	return !cu.closed
+}
+func subtractFits(a, b int) bool {
+	max := int(^uint(0) >> 1)
+	min := -max - 1
+	return !(b > 0 && a < min+b || b < 0 && a > max+b)
+}
+func pointSubtractFits(a, b image.Point) bool {
+	return subtractFits(a.X, b.X) && subtractFits(a.Y, b.Y)
+}
+func (w *Window) pointerDeltasFit(p image.Point, rebase bool) bool {
+	if !rebase && !pointSubtractFits(p, w.Event.Last.MousePos) {
+		return false
+	}
+	return w.Event.Last.MouseButtonType != events.MouseDown || pointSubtractFits(p, w.Event.Last.MouseDownPos)
+}
+
+// Producer acknowledgements record only the snapshot used for conversion.
+// A concurrent DPR/focus publication stays distinguishable on the next event.
+func (w *Window) rebasePointerAt(x, y float64, packed, focus uint64) bool {
+	p, ok := w.pointerPointAt(x, y, packed)
+	if ok && w.pointerLive() && w.pointerDeltasFit(p, true) {
+		w.Event.Last.MousePos = p
+		w.pointerDPRUsed = uint32(packed)
+		w.pointerFocusUsed = focus
+		return true
+	}
+	return false
+}
+func (w *Window) admitPointerMove(where image.Point, packed, focus uint64) bool {
+	if !w.pointerLive() {
+		return false
+	}
+	rebase := w.pointerDPRUsed != uint32(packed) || w.pointerFocusUsed != focus
+	if !w.pointerDeltasFit(where, rebase) {
+		return false
+	}
+	if rebase {
+		w.Event.Last.MousePos = where
+	}
+	w.pointerDPRUsed = uint32(packed)
+	w.pointerFocusUsed = focus
+	w.Event.MouseMove(where)
+	return true
+}

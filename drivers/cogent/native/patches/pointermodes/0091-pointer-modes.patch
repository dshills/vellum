+func TestVellumPointerRetirementAtEveryBackendStep(t *testing.T) {
+	// Every getter and setter is adversarially reentrant; after its retirement
+	// callback no later native callback or producer mutation may occur.
+	for _, full := range []bool{false, true} {
+		for _, kind := range []string{"mode", "position"} {
+			for step := 1; step <= map[string]int{"mode": 10, "position": 5}[kind]; step++ {
+				t.Run(strconv.FormatBool(full)+kind+strconv.Itoa(step), func(t *testing.T) {
+					a, c, f, q := pointerHarness(t)
+					w := c.window
+					f.supported = true
+					count, retired, late := 0, false, 0
+					f.inspect = func() {
+						if retired {
+							late++
+							return
+						}
+						count++
+						if count == step {
+							retired = true
+							f.inspect = nil
+							if full {
+								a.retireCursor(c)
+							} else {
+								c.retireStatus()
+							}
+							f.inspect = func() { late++ }
+						}
+					}
+					saved := w.Event.Last
+					err := cursorRun(t, a, q, func() error {
+						if kind == "mode" {
+							return c.modeRequest(func(c *Cursor) { c.wantEnabled = false; c.wantRaw = true })
+						}
+						return w.setMousePos(20, 40)
+					})
+					f.inspect = nil
+					if !retired {
+						t.Fatal("retirement point not reached", step, count)
+					}
+					if full && (f.mode != glfw.CursorNormal || f.raw) {
+						t.Fatal("inflight setter overwrote final restoration", f.mode, f.raw)
+					}
+					allowedLate := 0
+					if full && c.pointer.touched {
+						allowedLate = 2
+					} // deferred rawfalse+normal restoration only
+					if retired && (err == nil || late != allowedLate || w.Event.Last != saved) {
+						t.Fatal("continued after retirement", err, late, count, w.Event.Last)
+					}
+				})
+			}
+		}
+	}
+}

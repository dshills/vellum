+// Copyright (c) 2026, Davin Hills. SPDX-License-Identifier: MIT
+package lines
+
+import (
+	"cogentcore.org/core/text/rich"
+	"cogentcore.org/core/text/textpos"
+)
+
+// SetProseWrap installs immutable shaping inputs for a single plain-text view.
+// The callback receives source runes under the buffer lock; it must not enter
+// Lines or any widget. It returns strictly increasing grapheme-safe offsets.
+// The key changes with the measured pixel width and font metrics.
+func (ls *Lines) SetProseWrap(vid int, key string, wrap func([]rune) []int) bool {
+	ls.Lock()
+	defer ls.Unlock()
+	vw := ls.view(vid)
+	if vw == nil || vw.proseWrapKey == key {
+		return false
+	}
+	vw.proseWrapKey = key
+	vw.proseWrap = wrap
+	ls.layoutViewLines(vw)
+	return true
+}
+func (ls *Lines) layoutProseViewLine(ln int, txt []rune, wrap func([]rune) []int) ([]rich.Text, []textpos.Pos) {
+	starts := []int{0}
+	for _, p := range wrap(txt) {
+		if p > starts[len(starts)-1] && p < len(txt) {
+			starts = append(starts, p)
+		}
+	}
+	markup := make([]rich.Text, len(starts))
+	positions := make([]textpos.Pos, len(starts))
+	for i, start := range starts {
+		end := len(txt)
+		if i+1 < len(starts) {
+			end = starts[i+1]
+		}
+		markup[i] = rich.NewText(ls.fontStyle, txt[start:end])
+		positions[i] = textpos.Pos{Line: ln, Char: start}
+	}
+	return markup, positions
+}

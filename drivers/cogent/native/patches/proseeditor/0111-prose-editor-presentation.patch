+// Copyright (c) 2026, Davin Hills. SPDX-License-Identifier: MIT
+package textcore
+
+import (
+	"cogentcore.org/core/math32"
+	"cogentcore.org/core/text/rich"
+	"cogentcore.org/core/text/text"
+	"fmt"
+)
+
+// SetProse switches only presentation; it never replaces text, selection,
+// composition or the document buffer. Code-editor behavior is the default.
+func (ed *Base) SetProse(prose bool) {
+	if ed.prose == prose {
+		return
+	}
+	ed.prose = prose
+	ed.nativeLayoutRevision = 0
+	ed.visualState.interaction = nil
+	ed.visualState.offset = -1
+	ed.visualState.vertical = false
+	ed.NeedsLayout()
+}
+func (ed *Base) configureProseWrap() {
+	if ed.Lines == nil {
+		return
+	}
+	if !ed.prose {
+		ed.Lines.SetProseWrap(ed.viewId, "", nil)
+		return
+	}
+	if ed.Scene == nil || ed.Scene.TextShaper() == nil {
+		return
+	}
+	sty, tsty := ed.bodyRichText()
+	// Capture detached metrics, not ed or its scene, in the buffer callback.
+	sh := ed.Scene.TextShaper()
+	width := max(float32(1), ed.visSizeAlloc.X)
+	key := fmt.Sprintf("%v/%v/%v/%v/%v/%v/%v", sty.Family, sty.Size, sty.Weight, sty.Slant, tsty.CustomFont, tsty.FontSize.Dots, width)
+	tsty.WhiteSpace = text.WhiteSpacePreWrap
+	changed := ed.Lines.SetProseWrap(ed.viewId, key, func(txt []rune) []int {
+		if len(txt) == 0 {
+			return nil
+		}
+		style := *tsty // WrapLines may populate font metrics; never share mutable inputs.
+		shaped := sh.WrapLines(rich.NewText(sty, txt), sty, &style, math32.Vec2(width, float32(len(txt)+1)*max(float32(16), style.LineHeightDots(sty))))
+		starts := make([]int, 0, len(shaped.Lines))
+		for i, line := range shaped.Lines {
+			if i == 0 {
+				continue
+			}
+			start := len(txt)
+			for _, run := range line.Runs {
+				start = min(start, run.Runes().Start)
+			}
+			starts = append(starts, start)
+		}
+		return starts
+	})
+	if changed {
+		ed.visualState.offset = -1
+		ed.visualState.vertical = false
+		ed.nativeLayoutRevision = 0
+	}
+}

+)
+
+func TestVellumProseMeasuredWrapAndRetainedGeometry(t *testing.T) {
+	for _, dpi := range []float32{160, 200} {
+		t.Run(fmt.Sprintf("%g dpi", dpi), func(t *testing.T) {
+			clock := &ownedFixtureClock{now: time.Unix(1730000000, 0).UTC()}
+			body := core.NewBody("prose presentation")
+			ed := NewEditor(body)
+			old := ed.Lines
+			source := "iiii WWWW " + strings.Repeat("a wide word WWW and thin iii ", 10) + "\nEmoji 😀 é אבג\n" + strings.Repeat("é", 80) + "\n"
+			ed.SetLines(lines.NewLinesExact().SetString(source))
+			old.Close()
+			prose := false
+			width := float32(320)
+			ed.Styler(func(s *styles.Style) {
+				ed.SetProse(prose)
+				s.Font.Family = rich.Custom
+				s.Font.CustomFont = "Noto Sans"
+				s.Font.Size = units.Dp(14)
+				s.Grow.Set(1, 1)
+				s.Max.X.Dp(width)
+			})
+			m, err := body.NewWindow().RunManual(context.Background(), core.ManualWindowConfig{Size: image.Pt(360, 240), LogicalDPI: dpi, EventCapacity: 64, Now: func() time.Time { return clock.now }, AfterFunc: clock.After, NewShaper: func() (shaped.Shaper, error) { return shapedgt.NewShaperWithFonts([]fs.FS{fonts.Default}), nil }})
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer func() {
+				if err := m.Close(context.Background()); err != nil && !errors.Is(err, core.ErrManualCallback) && !errors.Is(err, lines.ErrManualViews) {
+					t.Error(err)
+				}
+			}()
+			ownedDrain(t, m)
+			buffer := ed.Lines
+			if !ed.SetEditingSelection(2, 7) {
+				t.Fatal("selection")
+			}
+			ed.NeedsRender()
+			ownedDrain(t, m)
+			accepted := ed.EditingState()
+			for _, mode := range []bool{true, false, true} {
+				prose = mode
+				ed.Update()
+				ownedDrain(t, m)
+				state := ed.EditingState()
+				if ed.Lines != buffer || state.Text != accepted.Text || state.Anchor != accepted.Anchor || state.Focus != accepted.Focus {
+					t.Fatal("presentation changed document/selection", state, accepted)
+				}
+				if (ed.LineNumberPixels() == 0) != mode {
+					t.Fatal("gutter did not follow presentation", mode, ed.LineNumberPixels())
+				}
+				font, _ := ed.lineRenders[0].lns.Source.Span(0)
+				if (font.Family == rich.Custom) != mode {
+					t.Fatal("document family", mode, font)
+				}
+				if !mode {
+					continue
+				}
+				geometry := ed.NativeTextGeometry()
+				if len(geometry.Carets) < 10 {
+					t.Fatal("missing rendered geometry")
+				}
+				caret := func(offset int) shaped.Caret {
+					t.Helper()
+					for _, c := range geometry.Carets {
+						if c.Rune == offset && c.Line == 0 {
+							return c
+						}
+					}
+					t.Fatal("missing caret", offset)
+					return shaped.Caret{}
+				}
+				narrow := caret(1).Pos.X - caret(0).Pos.X
+				wide := caret(6).Pos.X - caret(5).Pos.X
+				if wide <= narrow*1.5 {
+					t.Fatal("glyph advances are still fixed", narrow, wide)
+				}
+				for _, c := range geometry.Carets {
+					if c.Pos.X > geometry.Viewport.Max.X+1 {
+						t.Fatal("pixel wrapping overflow", c, geometry.Viewport)
+					}
+				}
+				// Every view fragment maps back to exactly the original source runes.
+				var fragments strings.Builder
+				previous := -1
+				for row := 0; row < buffer.ViewLines(ed.viewId); row++ {
+					pos := buffer.PosFromView(ed.viewId, textpos.Pos{Line: row})
+					raw := []rune(strings.Split(source, "\n")[pos.Line])
+					if !slices.Contains(textpos.GraphemeBounds(raw), pos.Char) {
+						t.Fatal("wrap split a grapheme", pos)
+					}
+					if previous != -1 && pos.Line != previous {
+						fragments.WriteByte('\n')
+					}
+					fragments.WriteString(string(buffer.ViewMarkupLine(ed.viewId, row).Join()))
+					previous = pos.Line
+				}
+				if fragments.String() != strings.TrimSuffix(source, "\n")+"\n" {
+					t.Fatal("wrapping altered/skipped source", fragments.String())
+				}
+				c := caret(2)
+				point := c.Pos.Sub(math32.FromPoint(ed.Scene.SceneGeom.Pos)).Sub(math32.FromPoint(ed.Geom.ContentBBox.Min))
+				point.Y += c.Height / 2
+				got := ed.PixelToCursor(image.Pt(int(point.X), int(point.Y)))
+				if ed.nativeOffset(got) != 2 {
+					t.Fatal("pointer/caret mapping", got, ed.nativeOffset(got))
+				}
+				if !ed.SetEditingSelection(0, 0) || !ed.cursorVisual(1, false) || ed.EditingState().Cursor != 1 {
+					t.Fatal("visual arrow did not use proportional geometry")
+				}
+				ed.SetEditingSelection(accepted.Anchor, accepted.Focus)
+			}
+			if !ed.SetEditingSelection(40, 40) || !ed.cursorVisual(1, false) {
+				t.Fatal("wrapped affinity setup")
+			}
+			cursor := ed.EditingState().Cursor
+			originalRows := buffer.ViewLines(ed.viewId)
+			width = 180
+			ed.Update()
+			ownedDrain(t, m)
+			if rows := buffer.ViewLines(ed.viewId); rows <= originalRows {
+				t.Fatal("pixel width did not reflow source", originalRows, rows)
+			}
+			wantLine := buffer.PosToView(ed.viewId, ed.nativePos(cursor)).Line
+			if ed.EditingState().VisualLine != wantLine {
+				t.Fatal("retained stale visual affinity after reflow", ed.EditingState(), wantLine)
+			}
+			width = 320
+			ed.Update()
+			ownedDrain(t, m)
+			if buffer.ViewLines(ed.viewId) != originalRows || ed.EditingState().Text != source {
+				t.Fatal("restored width changed document or retained stale wraps")
+			}
+
+		})
+	}
+}

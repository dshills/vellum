+	panic("detailed renderer silently fell back")
+}
+func (r *unavailableMeasuredRenderer) GetCurrentTextureMeasuredWithOutcome() (*wgpu.TextureView, int64, gpu.AcquisitionOutcome, error) {
+	r.calls++
+	return nil, 23, r.outcome, r.failure
+}

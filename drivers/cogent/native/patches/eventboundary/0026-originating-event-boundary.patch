+package core
+
+import (
+	"reflect"
+	"testing"
+
+	"cogentcore.org/core/events"
+	"cogentcore.org/core/events/key"
+)
+
+func TestVellumEventBoundaryOrdersConsumedCommands(t *testing.T) {
+	body := NewBody("event boundaries")
+	scene := body.Scene
+	scene.Stage = &Stage{Mains: &stages{}}
+	em := &Events{scene: scene}
+	var calls []string
+	text := ""
+	scene.OnFirst(events.KeyChord, func(e events.Event) {
+		if e.(*events.Key).Rune == 'x' {
+			text = "x"
+		} else {
+			text = ""
+		}
+		calls = append(calls, "handled:"+text)
+		e.SetHandled()
+	})
+	scene.OnFinal(events.KeyChord, func(e events.Event) { t.Fatal("consumed command reached final listeners") })
+	scene.EventBoundary = func(e events.Event) {
+		if !e.IsHandled() {
+			t.Fatal("boundary ran before the consuming handler")
+		}
+		calls = append(calls, "published:"+text)
+	}
+	em.handleEvent(events.NewKey(events.KeyChord, 'x', key.CodeX, 0))
+	em.handleEvent(events.NewKey(events.KeyChord, 'z', key.CodeZ, 0))
+	want := []string{"handled:x", "published:x", "handled:", "published:"}
+	if !reflect.DeepEqual(calls, want) {
+		t.Fatalf("originating boundaries crossed consecutive commands: %v", calls)
+	}
+	prior := events.NewKey(events.KeyChord, 'x', key.CodeX, 0)
+	prior.SetHandled()
+	em.handleEvent(prior)
+	if !reflect.DeepEqual(calls, want) {
+		t.Fatal("already handled event was dispatched again")
+	}
+}
+
+func TestVellumEventBoundaryPublishesUnhandledEventOnce(t *testing.T) {
+	body := NewBody("unhandled boundary")
+	scene := body.Scene
+	scene.Stage = &Stage{Mains: &stages{}}
+	em := &Events{scene: scene}
+	calls := 0
+	scene.EventBoundary = func(e events.Event) {
+		calls++
+		if e.IsHandled() {
+			t.Fatal("boundary consumed an unregistered command")
+		}
+	}
+	em.handleEvent(events.NewKey(events.KeyChord, 'q', key.CodeQ, 0))
+	if calls != 1 {
+		t.Fatal("missing or duplicate unhandled boundary", calls)
+	}
+	scene.EventBoundary = nil
+	em.handleEvent(events.NewKey(events.KeyChord, 'q', key.CodeQ, 0))
+	if calls != 1 {
+		t.Fatal("retired callback ran")
+	}
+}

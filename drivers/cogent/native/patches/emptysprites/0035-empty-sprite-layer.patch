+func TestVellumSpriteSourceManualCursorBlinkStillClearsOffPass(t *testing.T) {
+	old := TimingSettings.CursorBlinkTime
+	TimingSettings.CursorBlinkTime = 250 * time.Millisecond
+	t.Cleanup(func() { TimingSettings.CursorBlinkTime = old })
+	sc, st := reviewCursorScene()
+	sc.SceneGeom.Size = image.Pt(120, 120)
+	now := time.Date(2035, 1, 2, 3, 4, 5, 0, time.UTC)
+	manual := &ManualWindow{config: ManualWindowConfig{Now: func() time.Time { return now }}}
+	st.Mains = &stages{renderContext: &renderContext{manual: manual}}
+	field := reviewCursorField(sc)
+	reviewCursorOn(field, nil, "sprite-source-cursor", image.Pt(10, 11))
+	sp := reviewCursorSprite(t, st, "sprite-source-cursor")
+	cp, d := spriteTestComposer(sc.SceneGeom.Size)
+	spriteTestCompose(cp, st, sc, SpritesSource)
+	on := slices.Clone(d.Image.Pix)
+	if d.copies != 2 || !sp.Properties["on"].(bool) {
+		t.Fatal("cursor on source missing")
+	}
+	now = now.Add(TimingSettings.CursorBlinkTime)
+	spriteTestCompose(cp, st, sc, SpritesSource)
+	off := slices.Clone(d.Image.Pix)
+	if d.copies != 2 || sp.Properties["on"].(bool) || bytes.Equal(on, off) {
+		t.Fatal("active blink-off callback skipped or did not clear prior cursor pixels")
+	}
+	now = now.Add(TimingSettings.CursorBlinkTime)
+	spriteTestCompose(cp, st, sc, SpritesSource)
+	if d.copies != 2 || !bytes.Equal(d.Image.Pix, on) {
+		t.Fatal("manual blink-on failed to restore cursor pixels")
+	}
+	TextCursor(false, &field.WidgetBase, nil, "sprite-source-cursor", 2, 10, nil, nil)
+	spriteTestCompose(cp, st, sc, SpritesSource)
+	if d.copies != 1 || !bytes.Equal(d.Image.Pix, off) || st.Sprites.HasActive() {
+		t.Fatal("deactivated cursor source was retained")
+	}
+}

+func TestVellumSpriteSourceActiveTierOrderAndEveryPass(t *testing.T) {
+	st := &Stage{}
+	sc := &Scene{}
+	sc.SceneGeom.Size = image.Pt(32, 24)
+	cp, d := spriteTestComposer(sc.SceneGeom.Size)
+	var order []string
+	for _, item := range []struct {
+		name string
+		list *SpriteList
+		clr  color.RGBA
+	}{
+		{"first", &st.Sprites.First, color.RGBA{R: 255, A: 255}},
+		{"normal", &st.Sprites.Normal, color.RGBA{G: 255, A: 255}},
+		{"final", &st.Sprites.Final, color.RGBA{B: 255, A: 255}},
+	} {
+		item := item
+		item.list.Set(item.name, &Sprite{Name: item.name, Active: true, Draw: func(pc *paint.Painter) {
+			order = append(order, item.name)
+			pc.FillBox(math32.Vec2(3, 4), math32.Vec2(8, 8), image.NewUniform(item.clr))
+		}})
+	}
+	for pass := range 3 {
+		spriteTestCompose(cp, st, sc, SpritesSource)
+		if st.Sprites.IsModified() || d.copies != 2 || d.Image.RGBAAt(5, 6) != (color.RGBA{B: 255, A: 255}) {
+			t.Fatalf("active tier composition changed on pass%d", pass)
+		}
+	}
+	if !slices.Equal(order, []string{"first", "normal", "final", "first", "normal", "final", "first", "normal", "final"}) {
+		t.Fatalf("active callbacks skipped or reordered: %v", order)
+	}
+}

+func TestVellumSpriteSourceEmptyTiersDoNotAllocate(t *testing.T) {
+	for _, tier := range []string{"First", "Normal", "Final"} {
+		for _, kind := range []string{"empty", "nil", "inactive", "event-only"} {
+			t.Run(tier+"/"+kind, func(t *testing.T) {
+				st := &Stage{}
+				sc := &Scene{}
+				sc.SceneGeom.Size = image.Pt(32, 24)
+				lists := map[string]*SpriteList{"First": &st.Sprites.First, "Normal": &st.Sprites.Normal, "Final": &st.Sprites.Final}
+				calls := 0
+				switch kind {
+				case "nil":
+					lists[tier].Set("nil", nil)
+				case "inactive":
+					lists[tier].Set("inactive", &Sprite{Name: "inactive", Draw: func(*paint.Painter) { calls++ }})
+				case "event-only":
+					lists[tier].Set("event-only", &Sprite{Name: "event-only", Active: true})
+				}
+				st.Sprites.SetModified()
+				for range 3 {
+					if source := SpritesSource(st, sc); source != nil {
+						t.Error("empty sprite layer produced a composition source")
+					}
+					if st.spritePainter != nil || st.spriteRenderer != nil {
+						t.Error("empty sprite layer allocated scene-sized rendering resources")
+					}
+					if st.Sprites.IsModified() || calls != 0 {
+						t.Error("empty layer failed to settle its modification or called an inactive draw")
+					}
+				}
+				if st.Sprites.HasActive() != (kind == "event-only") {
+					t.Error("active event-only sprite deadline semantics changed")
+				}
+			})
+		}
+	}
+}

+func TestVellumSpriteSourceRemovalResizeMatchesOriginalPixels(t *testing.T) {
+	for _, dpi := range []float32{96, 120, 144, 192} {
+		t.Run(fmt.Sprint(dpi), func(t *testing.T) {
+			current, reference := &Stage{}, &Stage{}
+			sc := &Scene{}
+			sc.SceneGeom.Size = image.Pt(int(64*dpi/96), int(48*dpi/96))
+			sc.Styles.UnitContext.DPI = dpi
+			cp, d := spriteTestComposer(sc.SceneGeom.Size)
+			rp, rd := spriteTestComposer(sc.SceneGeom.Size)
+			pos := image.Pt(4, 5)
+			makeSprite := func() *Sprite {
+				return &Sprite{Name: "moving", Active: true, Draw: func(pc *paint.Painter) {
+					pc.FillBox(math32.FromPoint(pos), math32.Vec2(8, 8), image.NewUniform(color.NRGBA{R: 230, G: 80, B: 20, A: 128}))
+				}}
+			}
+			var retained *paint.Painter
+			for _, phase := range []string{"empty", "active", "unmodified", "move", "inactive", "reactivate", "delete", "event-only", "reset", "empty-resize", "resize-reactivate"} {
+				for _, st := range []*Stage{current, reference} {
+					switch phase {
+					case "active", "reactivate", "resize-reactivate":
+						st.Sprites.Add(makeSprite())
+					case "inactive":
+						st.Sprites.InactivateSprite("moving")
+					case "delete":
+						st.Sprites.Delete("moving")
+					case "event-only":
+						st.Sprites.Add(&Sprite{Name: "event-only", Active: true})
+					case "reset":
+						st.Sprites.reset()
+					}
+				}
+				if phase == "move" {
+					pos = image.Pt(19, 17)
+				}
+				if phase == "empty-resize" {
+					sc.SceneGeom.Size = sc.SceneGeom.Size.Add(image.Pt(17, 11))
+					d.Image = image.NewRGBA(image.Rectangle{Max: sc.SceneGeom.Size})
+					rd.Image = image.NewRGBA(image.Rectangle{Max: sc.SceneGeom.Size})
+				}
+				spriteTestCompose(cp, current, sc, SpritesSource)
+				spriteTestCompose(rp, reference, sc, spriteSourceOriginal)
+				if !bytes.Equal(d.Image.Pix, rd.Image.Pix) {
+					t.Fatalf("%s pixels differ from original transparent-clear composition", phase)
+				}
+				drawable := phase == "active" || phase == "unmodified" || phase == "move" || phase == "reactivate" || phase == "resize-reactivate"
+				expected := 1
+				if drawable {
+					expected = 2
+				}
+				if d.copies != expected || rd.copies != 2 {
+					t.Fatalf("%s copy requests candidate%d/reference%d expected%d/2", phase, d.copies, rd.copies, expected)
+				}
+				if drawable && d.Image.RGBAAt(pos.X+2, pos.Y+2) == (color.RGBA{R: 21, G: 39, B: 57, A: 255}) {
+					t.Fatal("active sprite never changed actual pixels")
+				}
+				if phase == "active" {
+					retained = current.spritePainter
+				}
+				if phase == "empty-resize" && current.spritePainter != retained {
+					t.Fatal("empty resize recreated inactive sprite resources")
+				}
+				if phase == "resize-reactivate" && (current.spritePainter == retained || current.spriteRenderer.Image().Bounds().Size() != sc.SceneGeom.Size || current.spritePainter.Paint.UnitContext.DPI != dpi) {
+					t.Fatal("reactivation did not install size-correct sprite resources and unit context")
+				}
+				// Spoil the target then replay only the actual last composition
+				// operations; an omitted colored sprite must stay omitted.
+				draw.Draw(d.Image, d.Image.Bounds(), image.NewUniform(color.RGBA{R: 255, B: 255, A: 255}), image.Point{}, draw.Src)
+				cp.Redraw()
+				if !bytes.Equal(d.Image.Pix, rd.Image.Pix) {
+					t.Fatalf("%s cached composition resurrected old sprite pixels", phase)
+				}
+			}
+		})
+	}
+}

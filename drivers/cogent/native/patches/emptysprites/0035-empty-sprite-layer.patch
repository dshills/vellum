+type spriteCopyRecord struct {
+	pos    image.Point
+	image  image.Image
+	bounds image.Rectangle
+	op     draw.Op
+}
+type spriteSourceDrawer struct {
+	composer.DrawerBase
+	copies          int
+	current, cached []spriteCopyRecord
+}
+
+func (d *spriteSourceDrawer) Start() { d.copies = 0; d.current = nil }
+func (d *spriteSourceDrawer) Copy(pos image.Point, src image.Image, bounds image.Rectangle, op draw.Op, unchanged bool) {
+	d.copies++
+	// Store the actual composition operations using detached image bytes,
+	// as an owned texture replay would. No GPU transfer is measured here.
+	copy := image.NewRGBA(src.Bounds())
+	draw.Draw(copy, copy.Bounds(), src, src.Bounds().Min, draw.Src)
+	d.current = append(d.current, spriteCopyRecord{pos, copy, bounds, op})
+	d.DrawerBase.Copy(pos, src, bounds, op, unchanged)
+}
+func (d *spriteSourceDrawer) End() { d.cached = slices.Clone(d.current) }
+func (d *spriteSourceDrawer) Redraw() {
+	for _, op := range d.cached {
+		d.DrawerBase.Copy(op.pos, op.image, op.bounds, op.op, composer.Unchanged)
+	}
+}
+
+type spriteBackgroundSource struct{ image *image.RGBA }
+
+func (s spriteBackgroundSource) Draw(cp composer.Composer) {
+	cp.(*composer.ComposerDrawer).Drawer.Copy(image.Point{}, s.image, s.image.Bounds(), draw.Src, composer.Unchanged)
+}
+func spriteTestComposer(size image.Point) (*composer.ComposerDrawer, *spriteSourceDrawer) {
+	d := &spriteSourceDrawer{DrawerBase: composer.DrawerBase{Image: image.NewRGBA(image.Rectangle{Max: size})}}
+	return &composer.ComposerDrawer{Drawer: d}, d
+}
+func spriteTestCompose(cp *composer.ComposerDrawer, st *Stage, sc *Scene, source func(*Stage, *Scene) composer.Source) {
+	base := image.NewRGBA(image.Rectangle{Max: sc.SceneGeom.Size})
+	draw.Draw(base, base.Bounds(), image.NewUniform(color.RGBA{R: 21, G: 39, B: 57, A: 255}), image.Point{}, draw.Src)
+	cp.Start()
+	cp.Add(spriteBackgroundSource{base}, sc)
+	cp.Add(source(st, sc), &st.Sprites)
+	cp.Compose()
+}

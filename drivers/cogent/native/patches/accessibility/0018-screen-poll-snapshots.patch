+package desktop
+
+import (
+	"cogentcore.org/core/system"
+	"cogentcore.org/core/system/driver/base"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestVellumScreenPollAdmission(t *testing.T) {
+	a := &App{AppMulti: base.NewAppMulti[*Window]()}
+	now := time.Now()
+	var admitted atomic.Int32
+	var wg sync.WaitGroup
+	for range 64 {
+		wg.Go(func() {
+			if a.beginScreenPoll(now) {
+				admitted.Add(1)
+			}
+		})
+	}
+	wg.Wait()
+	if got := admitted.Load(); got != 1 {
+		t.Fatalf("admitted %d simultaneous polls", got)
+	}
+	if !a.beginScreenPoll(now.Add(ScreenPollInterval)) {
+		t.Fatal("next interval was not admitted")
+	}
+}
+
+func TestVellumScreenPollSnapshot(t *testing.T) {
+	a := &App{AppMulti: base.NewAppMulti[*Window]()}
+	first, second := &Window{}, &Window{}
+	a.Screens = []*system.Screen{{Name: "first"}}
+	a.Windows = []*Window{first}
+	screens, windows := a.screenPollSnapshot()
+	var wg sync.WaitGroup
+	wg.Go(func() {
+		for range 1000 {
+			a.Mu.Lock()
+			a.Screens[0].Name = "changed"
+			a.Windows[0] = second
+			a.Mu.Unlock()
+		}
+	})
+	for range 1000 {
+		a.screenPollSnapshot()
+		if screens[0].Name != "first" || windows[0] != first {
+			t.Fatal("snapshot aliases mutable cache")
+		}
+	}
+	wg.Wait()
+}
+
+func TestVellumScreenAccessorsDuringCacheRebuild(t *testing.T) {
+	a := &App{AppMulti: base.NewAppMulti[*Window]()}
+	a.Screens = []*system.Screen{{Name: "screen", LogicalDPI: 160}}
+	first := a.Screen(0)
+	named := a.ScreenByName("screen")
+	var wg sync.WaitGroup
+	wg.Go(func() {
+		for range 1000 {
+			a.Mu.Lock()
+			a.Screens = []*system.Screen{{Name: "screen", LogicalDPI: 192}}
+			a.Mu.Unlock()
+		}
+	})
+	for range 1000 {
+		if a.NScreens() != 1 || a.Screen(0) == nil || a.ScreenByName("screen") == nil {
+			t.Fatal("invalid detached cache accessor")
+		}
+		if first.LogicalDPI != 160 || named.LogicalDPI != 160 {
+			t.Fatal("published screen alias changed")
+		}
+	}
+	wg.Wait()
+	a.UpdateScreenLogicalDPI(func(screens []*system.Screen) { screens[0].LogicalDPI = 200 })
+	if got := a.Screen(0).LogicalDPI; got != 200 {
+		t.Fatalf("locked DPI update was not published: %v", got)
+	}
+	a.Mu.Lock()
+	a.Screens = nil
+	a.Mu.Unlock()
+	if a.NScreens() != 0 || a.Screen(0) != nil || a.ScreenByName("screen") != nil {
+		t.Fatal("empty screen cache fallback")
+	}
+}

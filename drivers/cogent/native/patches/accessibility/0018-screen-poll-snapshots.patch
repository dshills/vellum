@@ -0,0 +1,40 @@
+package core
+
+import (
+	"cogentcore.org/core/system"
+	"sync"
+	"testing"
+)
+
+type snapshotScreenWindow struct {
+	system.Window
+	screen *system.Screen
+}
+
+func (w *snapshotScreenWindow) Screen() *system.Screen { return w.screen }
+
+func TestVellumCurrentWindowSnapshotDuringPublication(t *testing.T) {
+	previous := currentRenderWindowSnapshot()
+	defer setCurrentRenderWindow(previous)
+	a := &renderWindow{SystemWindow: &snapshotScreenWindow{screen: &system.Screen{Name: "A"}}}
+	b := &renderWindow{SystemWindow: &snapshotScreenWindow{screen: &system.Screen{Name: "B"}}}
+	setCurrentRenderWindow(a)
+	var writers sync.WaitGroup
+	writers.Go(func() {
+		for range 2000 {
+			setCurrentRenderWindow(b)
+			setCurrentRenderWindow(a)
+		}
+	})
+	stage := &Stage{Screen: -1}
+	for range 2000 {
+		screen := stage.targetScreen()
+		if screen == nil || (screen.Name != "A" && screen.Name != "B") {
+			t.Fatal("invalid current native screen")
+		}
+		if current := currentRenderWindowSnapshot(); current != a && current != b {
+			t.Fatal("invalid current window")
+		}
+	}
+	writers.Wait()
+}

+	}
+	coalescingTake(t, &q, a, c)
+}
+func TestVellumCoalescingScrollNonfiniteSamplesRemainBarriers(t *testing.T) {
+	for _, v := range []float32{float32(math.NaN()), float32(math.Inf(1)), float32(math.Inf(-1))} {
+		for _, firstInvalid := range []bool{false, true} {
+			var q Deque
+			a := NewScroll(image.Point{}, math32.Vec2(v, 1), 0)
+			b := NewScroll(image.Point{}, math32.Vec2(2, 3), 0)
+			if !firstInvalid {
+				a, b = b, a
+			}
+			ax, ay, bx, by := math.Float32bits(a.Delta.X), math.Float32bits(a.Delta.Y), math.Float32bits(b.Delta.X), math.Float32bits(b.Delta.Y)
+			q.Send(a)
+			q.Send(b)
+			if math.Float32bits(a.Delta.X) != ax || math.Float32bits(a.Delta.Y) != ay || math.Float32bits(b.Delta.X) != bx || math.Float32bits(b.Delta.Y) != by {
+				t.Fatal("nonfinite input was transformed")
+			}
+			coalescingTake(t, &q, a, b)
+		}
+	}
+}
+func TestVellumCoalescingSourceOriginOverflowPreservesBoth(t *testing.T) {
+	max := int(^uint(0) >> 1)
+	min := -max - 1
+	for _, triple := range [][4]int{{min, -1, 1, max}, {max, 0, -2, -max}} {
+		for _, drag := range []bool{false, true} {
+			for _, yaxis := range []bool{false, true} {
+				var s Source
+				point := func(x int) image.Point {
+					if yaxis {
+						return image.Pt(0, x)
+					}
+					return image.Pt(x, 0)
+				}
+				now := time.Unix(1700000000, 0)
+				s.Now = func() time.Time { return now }
+				s.Last.MousePos = point(triple[0])
+				if drag {
+					s.Last.MouseButtonType = MouseDown
+					s.Last.MouseDownPos = point(triple[1])
+					s.Last.MouseButton = Left
+				}
+				s.MouseMove(point(triple[1]))
+				first := s.Deque.Back[0].(*Mouse)
+				saved := first.Base
+				now = now.Add(time.Millisecond)
+				s.MouseMove(point(triple[2]))
+				second := s.Deque.Back[len(s.Deque.Back)-1].(*Mouse)
+				if len(s.Deque.Back) != 2 || !reflect.DeepEqual(first.Base, saved) || second.Prev != point(triple[1]) || second.PrevDelta() != point(triple[2]-triple[1]) {
+					t.Fatal("origin overflow compressed or modified sample", triple, drag, yaxis, first, second)
+				}
+				if first.PrevDelta() != point(triple[3]) {
+					t.Fatal("original representable step changed", first.PrevDelta())
+				}
+				coalescingTake(t, &s.Deque, first, second)
+			}
+		}
+	}
+}
+func TestVellumCoalescingRawLocalOriginsAndTimesAgree(t *testing.T) {
+	for _, typ := range []Types{MouseMove, MouseDrag} {
+		var q Deque
+		first := coalescingMove(typ, image.Pt(12, 24), image.Pt(10, 20), image.Pt(8, 16), image.Pt(1, 2))
+		second := coalescingMove(typ, image.Pt(15, 29), image.Pt(12, 24), image.Pt(8, 16), image.Pt(4, 5))
+		anchor := time.Unix(1700000000, 0)
+		first.PrvTime.SetTime(anchor)
+		first.GenTime.SetTime(anchor.Add(time.Millisecond))
+		first.StTime.SetTime(anchor.Add(-time.Millisecond))
+		second.PrvTime = first.GenTime
+		second.GenTime.SetTime(anchor.Add(2 * time.Millisecond))
+		second.StTime = first.StTime
+		newerTime, newerStartTime, old := second.GenTime, second.StTime, first.Base
+		newerStart := second.Start
+		q.Send(first)
+		q.Send(second)
+		if second.Prev != image.Pt(10, 20) || second.PrevLocal != image.Pt(6, 15) || second.PrevDelta() != image.Pt(5, 9) || second.Where.Sub(second.Prev) != second.PrevDelta() || second.PrvTime != first.PrvTime || second.GenTime != newerTime || second.StTime != newerStartTime || second.Start != newerStart || second.LocalOffset != image.Pt(4, 5) || second.SincePrev() != 2*time.Millisecond || second.SinceStart() != 3*time.Millisecond {
+			t.Fatal("local/raw or virtual timing origins diverged", typ, second.Base)
+		}
+		if !reflect.DeepEqual(first.Base, old) {
+			t.Fatal("queued older event mutated")
+		}
+		coalescingTake(t, &q, second)
+	}
+}

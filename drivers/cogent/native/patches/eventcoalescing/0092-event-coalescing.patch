+func TestVellumCoalescingDifferenceMatchesBigIntegerOracle(t *testing.T) {
+	max := int(^uint(0) >> 1)
+	min := -max - 1
+	edge := []int{min, min + 1, -100, -1, 0, 1, 100, max - 1, max}
+	lo, hi := big.NewInt(int64(min)), big.NewInt(int64(max))
+	check := func(a, b int) {
+		t.Helper()
+		exact := new(big.Int).Sub(big.NewInt(int64(a)), big.NewInt(int64(b)))
+		wantOK := exact.Cmp(lo) >= 0 && exact.Cmp(hi) <= 0
+		got, ok := coalescedSubtract(a, b)
+		if ok != wantOK || ok && int64(got) != exact.Int64() {
+			t.Fatalf("%v-%v: %v,%v want %s,%v", a, b, got, ok, exact, wantOK)
+		}
+	}
+	for _, a := range edge {
+		for _, b := range edge {
+			check(a, b)
+		}
+	}
+	r := rand.New(rand.NewSource(1701))
+	for range 1000 {
+		check(int(r.Uint64()), int(r.Uint64()))
+	}
+}
+func TestVellumCoalescingUniqueBarriersBackAndFront(t *testing.T) {
+	for _, front := range []bool{false, true} {
+		for _, oldUnique := range []bool{false, true} {
+			var q Deque
+			a, b := NewWindowPaint(), NewWindowPaint()
+			if oldUnique {
+				a.SetUnique()
+			} else {
+				b.SetUnique()
+			}
+			send := q.Send
+			if front {
+				send = q.SendFirst
+			}
+			send(a)
+			send(b)
+			if front {
+				coalescingTake(t, &q, b, a)
+			} else {
+				coalescingTake(t, &q, a, b)
+			}
+		}
+	}
+}
+
+type coalescingDeferred struct {
+	CustomEvent
+	readyCalls int
+}
+
+func (e *coalescingDeferred) Ready() bool              { e.readyCalls++; return true }
+func (e *coalescingDeferred) Merge(DeferredEvent) bool { return false }
+func TestVellumCoalescingDeferredBarriersBothSidesAndQueues(t *testing.T) {
+	for _, front := range []bool{false, true} {
+		for _, oldDeferred := range []bool{false, true} {
+			var q Deque
+			d := &coalescingDeferred{}
+			d.Typ = Custom
+			o := &CustomEvent{}
+			o.Typ = Custom
+			var a, b Event = d, o
+			if !oldDeferred {
+				a, b = b, a
+			}
+			send := q.Send
+			if front {
+				send = q.SendFirst
+			}
+			send(a)
+			send(b)
+			if d.readyCalls != 0 {
+				t.Fatal("admission invoked deferred readiness")
+			}
+			if front {
+				coalescingTake(t, &q, b, a)
+			} else {
+				coalescingTake(t, &q, a, b)
+			}
+		}
+	}
+}

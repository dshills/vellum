+	bMove := coalescingMove(MouseMove, image.Pt(3, 4), image.Pt(2, 3), image.Point{}, image.Point{})
+	q.SendFirst(aMove)
+	q.SendFirst(bMove)
+	if bMove.Prev != image.Pt(2, 3) || bMove.PrevDelta() != image.Pt(1, 1) {
+		t.Fatal("Front changed latest sample")
+	}
+	coalescingTake(t, &q, bMove)

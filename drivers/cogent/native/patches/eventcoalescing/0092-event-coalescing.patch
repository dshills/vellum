+// ordinaryReplacement protects either side of a unique/deferred boundary.
+// Only nextBack's Ready/Merge protocol may combine deferred FIFO positions.
+func ordinaryReplacement(newer, older Event) bool {
+	if newer.IsUnique() || older.IsUnique() {
+		return false
+	}
+	if _, ok := newer.(DeferredEvent); ok {
+		return false
+	}
+	if _, ok := older.(DeferredEvent); ok {
+		return false
+	}
+	return newer.IsSame(older)
+}
+
+// aggregateBack validates every proposed field before publishing or mutating.
+// Refusal leaves both samples intact for separate FIFO delivery. Front retains
+// its existing latest-notification policy and does not aggregate pointer data.
+func aggregateBack(newer, older Event) bool {
+	switch newer.Type() {
+	case MouseMove, MouseDrag:
+		n, nok := newer.(*Mouse)
+		o, ook := older.(*Mouse)
+		if !nok || !ook || n == nil || o == nil {
+			return false
+		}
+		if _, ok := coalescedDifference(n.Where, o.Prev); !ok {
+			return false
+		}
+		local, ok := coalescedDifference(o.Prev, n.LocalOffset)
+		if !ok {
+			return false
+		}
+		if _, ok := coalescedDifference(n.WhereLocal, local); !ok {
+			return false
+		}
+		n.Prev, n.PrevLocal, n.PrvTime = o.Prev, local, o.PrvTime
+	case Scroll:
+		n, nok := newer.(*MouseScroll)
+		o, ook := older.(*MouseScroll)
+		if !nok || !ook || n == nil || o == nil {
+			return false
+		}
+		if !coalescedFinite(n.Delta.X) || !coalescedFinite(n.Delta.Y) || !coalescedFinite(o.Delta.X) || !coalescedFinite(o.Delta.Y) {
+			return false
+		}
+		sum := n.Delta.Add(o.Delta)
+		if !coalescedFinite(sum.X) || !coalescedFinite(sum.Y) {
+			return false
+		}
+		n.Delta = sum
+	}
+	return true
+}
+func coalescedFinite(v float32) bool { return !math.IsNaN(float64(v)) && !math.IsInf(float64(v), 0) }
+func coalescedSubtract(a, b int) (int, bool) {
+	max := int(^uint(0) >> 1)
+	min := -max - 1
+	if b > 0 && a < min+b || b < 0 && a > max+b {
+		return 0, false
+	}
+	return a - b, true
+}
+func coalescedDifference(a, b image.Point) (image.Point, bool) {
+	x, xok := coalescedSubtract(a.X, b.X)
+	y, yok := coalescedSubtract(a.Y, b.Y)
+	return image.Pt(x, y), xok && yok
 }
 

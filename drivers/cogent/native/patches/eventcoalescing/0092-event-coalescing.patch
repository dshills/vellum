+func TestVellumCoalescingNormalBurstRetainsOneAccurateSample(t *testing.T) {
+	var s Source
+	for i := 1; i <= 10000; i++ {
+		s.MouseMove(image.Pt(i, 2*i))
+	}
+	if len(s.Deque.Back) != 1 {
+		t.Fatal("normal movement no longer compresses")
+	}
+	ev, ok := s.Deque.PollEvent()
+	if !ok {
+		t.Fatal("missing burst")
+	}
+	m := ev.(*Mouse)
+	if m.Where != image.Pt(10000, 20000) || m.Prev != (image.Point{}) || m.PrevDelta() != image.Pt(10000, 20000) {
+		t.Fatal("burst displacement lost", m.Base)
+	}
+	for range 1000 {
+		s.Scroll(image.Point{}, math32.Vec2(1, -2))
+	}
+	ev, ok = s.Deque.PollEvent()
+	if !ok || ev.(*MouseScroll).Delta != math32.Vec2(1000, -2000) {
+		t.Fatal("normal scroll burst changed", ev)
+	}
+	if _, ok := s.Deque.PollEvent(); ok {
+		t.Fatal("extra burst")
+	}
+}
+func TestVellumCoalescingConcurrentTransferPreservesDisplacement(t *testing.T) {
+	var q Deque
+	done := make(chan struct{})
+	const count = 1000
+	go func() {
+		defer close(done)
+		for i := 1; i <= count; i++ {
+			m := coalescingMove(MouseMove, image.Pt(i, -i), image.Pt(i-1, 1-i), image.Point{}, image.Point{})
+			q.Send(m)
+		}
+		end := NewWindow(WinClose)
+		q.Send(end)
+	}()
+	t.Cleanup(func() { <-done })
+	prev, total := image.Point{}, image.Point{}
+	for {
+		ev := q.NextEvent()
+		if ev.Type() == Window {
+			break
+		}
+		m := ev.(*Mouse)
+		if m.Prev != prev {
+			t.Fatalf("discontinuous ownership transfer %v after %v", m.Prev, prev)
+		}
+		total = total.Add(m.PrevDelta())
+		prev = m.Where
+		m.SetLocalOff(image.Pt(1, 2))
+	}
+	<-done
+	if prev != image.Pt(count, -count) || total != prev {
+		t.Fatal("concurrent burst lost displacement", prev, total)
+	}
+}

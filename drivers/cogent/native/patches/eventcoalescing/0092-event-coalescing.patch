+func coalescingTake(t *testing.T, q *Deque, want ...Event) {
+	t.Helper()
+	for _, w := range want {
+		got, ok := q.PollEvent()
+		if !ok || got != w {
+			t.Fatalf("queue order/identity: got %T %p (%v),want %T %p", got, got, ok, w, w)
+		}
+	}
+	if _, ok := q.PollEvent(); ok {
+		t.Fatal("extra queued sample")
+	}
+}
+func coalescingMove(typ Types, where, prev, start, offset image.Point) *Mouse {
+	var m *Mouse
+	if typ == MouseDrag {
+		m = NewMouseDrag(Left, where, prev, start, 0)
+	} else {
+		m = NewMouseMove(NoButton, where, prev, 0)
+	}
+	m.Init()
+	m.SetLocalOff(offset)
+	return m
+}
+func TestVellumCoalescingFiniteScrollOverflowKeepsSamples(t *testing.T) {
+	for _, axis := range []int{0, 1} {
+		t.Run(strconv.Itoa(axis), func(t *testing.T) {
+			var q Deque
+			a, b := math32.Vec2(3, 5), math32.Vec2(7, 11)
+			if axis == 0 {
+				a.X, b.X = math.MaxFloat32, math.MaxFloat32
+			} else {
+				a.Y, b.Y = -math.MaxFloat32, -math.MaxFloat32
+			}
+			first, second := NewScroll(image.Pt(1, 2), a, 0), NewScroll(image.Pt(3, 4), b, 0)
+			first.Init()
+			second.Init()
+			before1, before2 := *first, *second
+			q.Send(first)
+			q.Send(second)
+			if !reflect.DeepEqual(*first, before1) || !reflect.DeepEqual(*second, before2) {
+				t.Fatal("refusal changed a sample or partially added the safe axis")
+			}
+			coalescingTake(t, &q, first, second)
+		})
+	}
+}

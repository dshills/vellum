+// Copyright 2026 Vellum contributors. All rights reserved.
+// Use of this source code is governed by the MIT license in the Vellum repository.
+
+package desktop
+
+import (
+	"cogentcore.org/core/system/driver/base"
+	"errors"
+	"reflect"
+	"sync"
+	"testing"
+)
+
+func TestMainCleanupOrderRemovalAndTerminalOwnership(t *testing.T) {
+	var a App
+	var order []int
+	remove, err := a.AddMainCleanup(func() { order = append(order, 1) })
+	if err != nil {
+		t.Fatal(err)
+	}
+	remove()
+	remove()
+	for _, i := range []int{2, 3} {
+		v := i
+		if _, err := a.AddMainCleanup(func() {
+			if !a.MainStopped() {
+				t.Error("queue still open")
+			}
+			order = append(order, v)
+		}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	a.StopMain()
+	a.mainCleanup.finish(func() { order = append(order, 4) })
+	a.mainCleanup.run()
+	if !reflect.DeepEqual(order, []int{3, 2, 4}) {
+		t.Fatal(order)
+	}
+	if _, err := a.AddMainCleanup(func() {}); !errors.Is(err, base.ErrMainStopped) {
+		t.Fatal(err)
+	}
+}
+func TestMainCleanupPanicStillRunsAllHooksAndTermination(t *testing.T) {
+	var c mainCleanups
+	var order []int
+	c.add(func() { order = append(order, 1) })
+	c.add(func() { order = append(order, 2); panic("first") })
+	c.add(func() { order = append(order, 3); panic("latest") })
+	var recovered any
+	func() { defer func() { recovered = recover() }(); c.finish(func() { order = append(order, 4) }) }()
+	if recovered != "latest" || !reflect.DeepEqual(order, []int{3, 2, 1, 4}) {
+		t.Fatal(recovered, order)
+	}
+	c.run()
+}
+func TestMainCleanupConcurrentRetirementAndCapacity(t *testing.T) {
+	var c mainCleanups
+	if _, err := c.add(nil); err == nil {
+		t.Fatal("nil accepted")
+	}
+	var removes []func()
+	for i := 0; i < 16; i++ {
+		r, err := c.add(func() {})
+		if err != nil {
+			t.Fatal(err)
+		}
+		removes = append(removes, r)
+	}
+	if _, err := c.add(func() {}); err == nil {
+		t.Fatal("over capacity")
+	}
+	var wg sync.WaitGroup
+	for _, r := range removes {
+		wg.Add(1)
+		go func(remove func()) { defer wg.Done(); remove(); remove() }(r)
+	}
+	wg.Wait()
+	if len(c.entries) != 0 {
+		t.Fatal("retained callbacks")
+	}
+	if _, err := c.add(func() {}); err != nil {
+		t.Fatal(err)
+	}
+	c.run()
+}
+
+func TestMainCleanupLegacyNilPanicIsNotSwallowed(t *testing.T) {
+	t.Setenv("GODEBUG", "panicnil=1")
+	var c mainCleanups
+	ran, terminated, returned := false, false, false
+	c.add(func() { ran = true })
+	c.add(func() { panic(nil) })
+	func() { defer func() { recover() }(); c.finish(func() { terminated = true }); returned = true }()
+	if returned || !ran || !terminated {
+		t.Fatal("nil panic swallowed or cleanup skipped", returned, ran, terminated)
+	}
+}

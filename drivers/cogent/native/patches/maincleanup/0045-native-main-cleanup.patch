+// Copyright 2026 Vellum contributors. All rights reserved.
+// Use of this source code is governed by the MIT license in the Vellum repository.
+
+package desktop
+
+import (
+	"cogentcore.org/core/system/driver/base"
+	"fmt"
+	"sync"
+)
+
+type mainCleanupEntry struct {
+	id uint64
+	fn func()
+}
+type mainCleanups struct {
+	mu      sync.Mutex
+	next    uint64
+	done    bool
+	entries []mainCleanupEntry
+}
+
+// AddMainCleanup registers an adapter cleanup before native termination. It is
+// worker-safe, bounded to 16 live hooks, and returns an idempotent removal function.
+// Terminal ownership detaches the list; removal after that point cannot revoke a
+// captured hook. Hooks run once, in reverse registration order, on the main thread
+// after queue closure and before GLFW termination. Never enter a UI owner,
+// redispatch to the main thread or block in a hook. Callback time is caller-owned.
+func (a *App) AddMainCleanup(fn func()) (func(), error) { return a.mainCleanup.add(fn) }
+func (c *mainCleanups) add(fn func()) (func(), error) {
+	if fn == nil {
+		return nil, fmt.Errorf("desktop: cleanup required")
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.done {
+		return nil, base.ErrMainStopped
+	}
+	if len(c.entries) >= 16 || c.next == ^uint64(0) {
+		return nil, fmt.Errorf("desktop: cleanup capacity exhausted")
+	}
+	c.next++
+	id := c.next
+	c.entries = append(c.entries, mainCleanupEntry{id, fn})
+	return func() {
+		c.mu.Lock()
+		defer c.mu.Unlock()
+		for i, e := range c.entries {
+			if e.id == id {
+				copy(c.entries[i:], c.entries[i+1:])
+				c.entries[len(c.entries)-1] = mainCleanupEntry{}
+				c.entries = c.entries[:len(c.entries)-1]
+				return
+			}
+		}
+	}, nil
+}
+func (c *mainCleanups) run() {
+	c.mu.Lock()
+	if c.done {
+		c.mu.Unlock()
+		return
+	}
+	c.done = true
+	entries := c.entries
+	c.entries = nil
+	c.mu.Unlock()
+	var first any
+	panicked := false
+	for i := len(entries) - 1; i >= 0; i-- {
+		func() {
+			returned := false
+			defer func() {
+				if !returned {
+					p := recover()
+					if !panicked {
+						first = p
+						panicked = true
+					}
+				}
+			}()
+			entries[i].fn()
+			returned = true
+		}()
+		entries[i] = mainCleanupEntry{}
+	}
+	if panicked {
+		panic(first)
+	}
+}
+
+// Always terminate after running all hooks, even when a hook panics. No lifecycle
+// barrier is held across callbacks. The caller owns termination idempotence.
+func (c *mainCleanups) finish(terminate func()) { defer terminate(); c.run() }

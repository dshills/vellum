 }
+
+// PassiveTextSurfaceAllowed reports whether a managed passive text surface can
+// replace native leaf traversal without losing renderer or Inspector behavior.
+func (sc *Scene) PassiveTextSurfaceAllowed() bool {
+	if sc == nil || sc.WidgetInit != nil || DebugSettings.RenderTrace || sc.renderBBoxes || sc.selectedWidget != nil {
+		return false
+	}
+	capability, ok := sc.Renderer.(render.TextBatchRenderer)
+	return ok && capability.SupportsTextBatch()
+}

+}
+
+func (*presentationRegistryFixture) Receipt(uint64, float64) {}
+func (f *presentationRegistryFixture) Acquired(PresentationFrame, float64) uint64 {
+	if f.closed.Load() {
+		return 0
+	}
+	return f.acquires.Add(1)
+}
+func (f *presentationRegistryFixture) Unavailable(PresentationFrame, float64) {
+	if !f.closed.Load() {
+		f.unavailable.Add(1)
+	}
+}
+func (f *presentationRegistryFixture) Presented(uint64, uint64, float64) {
+	if !f.closed.Load() {
+		f.completions.Add(1)
+	}
+}
+func (f *presentationRegistryFixture) Closed() { f.closed.Store(true); f.registry.lookup(f.token) }
+func TestVellumPresentationRegistryLimitsAndNoTokenReuse(t *testing.T) {
+	var registry nativePresentationRegistry
+	if _, err := registry.register(nil); err == nil {
+		t.Fatal("nil observer")
+	}
+	for i := uint64(1); i <= 64; i++ {
+		f := &presentationRegistryFixture{registry: &registry}
+		token, err := registry.register(f)
+		if err != nil || token != i {
+			t.Fatal(token, err)
+		}
+		f.token = token
+	}
+	if _, err := registry.register(&presentationRegistryFixture{}); err == nil {
+		t.Fatal("observer budget")
+	}
+	first := registry.lookup(1)
+	registry.close(1)
+	registry.close(1)
+	if !first.closed.Load() {
+		t.Fatal("retirement")
+	}
+	f := &presentationRegistryFixture{registry: &registry}
+	token, err := registry.register(f)
+	f.token = token
+	if err != nil || token != 65 {
+		t.Fatal("token reused", token, err)
+	}
+	registry.close(1)
+	if registry.lookup(token) == nil {
+		t.Fatal("old close retired replacement")
+	}
+	for i := uint64(2); i <= 65; i++ {
+		registry.close(i)
+	}
+	registry.next = ^uint64(0)
+	if _, err := registry.register(f); err == nil {
+		t.Fatal("token overflow")
+	}
+}
+func TestVellumPresentationRegistryConcurrentAcquireAndRetirement(t *testing.T) {
+	for cycle := 0; cycle < 32; cycle++ {
+		var registry nativePresentationRegistry
+		f := &presentationRegistryFixture{registry: &registry}
+		token, err := registry.register(f)
+		if err != nil {
+			t.Fatal(err)
+		}
+		f.token = token
+		var workers sync.WaitGroup
+		workers.Add(2)
+		go func() {
+			defer workers.Done()
+			for i := 0; i < 64; i++ {
+				if seq := registry.acquire(token, PresentationFrame{}, 1); seq != 0 {
+					registry.presented(token, seq, 0, 2)
+				}
+				registry.unavailable(token, PresentationFrame{}, 3)
+			}
+		}()
+		go func() { defer workers.Done(); registry.close(token) }()
+		workers.Wait()
+		if !f.closed.Load() || registry.lookup(token) != nil || registry.acquire(token, PresentationFrame{}, 4) != 0 {
+			t.Fatal("callback authority survived close")
+		}
+	}
+}

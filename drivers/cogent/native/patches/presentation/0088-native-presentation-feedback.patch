+// Copyright (c) 2026, Davin Hills. SPDX-License-Identifier: MIT
+package desktop
+
+import (
+	"errors"
+	"sync"
+	"sync/atomic"
+)
+
+// PresentationFrame identifies the composition at drawable acquisition. Armed
+// and Generation belong to that composition, not to a later owner transition.
+type PresentationFrame struct {
+	Tag, Generation, Composition uint64
+	Armed                        bool
+}
+
+// PresentationObserver is an internal backend sink. Methods must be concurrent,
+// nonblocking and safe after Closed; they must not call window/main-thread APIs.
+// A callback admitted immediately before retirement may enter after Closed.
+// A sink must revoke its recording authority atomically, as Recorder.Close does.
+type PresentationObserver interface {
+	Receipt(tag uint64, hostTime float64)
+	Acquired(frame PresentationFrame, hostTime float64) uint64
+	Unavailable(frame PresentationFrame, hostTime float64)
+	Presented(sequence, drawable uint64, hostTime float64)
+	Closed()
+}
+type nativeSubscription struct {
+	observer PresentationObserver
+	closed   atomic.Bool
+}
+type nativePresentationRegistry struct {
+	mu      sync.Mutex
+	next    uint64
+	entries map[uint64]*nativeSubscription
+}
+
+var errNativePresentationBudget = errors.New("desktop: native presentation observer budget exhausted")
+
+func (r *nativePresentationRegistry) register(observer PresentationObserver) (uint64, error) {
+	if observer == nil {
+		return 0, errors.New("desktop: nil presentation observer")
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if len(r.entries) >= 64 || r.next == ^uint64(0) {
+		return 0, errNativePresentationBudget
+	}
+	r.next++
+	if r.entries == nil {
+		r.entries = make(map[uint64]*nativeSubscription)
+	}
+	r.entries[r.next] = &nativeSubscription{observer: observer}
+	return r.next, nil
+}
+func (r *nativePresentationRegistry) lookup(token uint64) *nativeSubscription {
+	r.mu.Lock()
+	s := r.entries[token]
+	r.mu.Unlock()
+	return s
+}
+func (r *nativePresentationRegistry) receipt(token, tag uint64, at float64) {
+	if s := r.lookup(token); s != nil && !s.closed.Load() {
+		s.observer.Receipt(tag, at)
+	}
+}
+func (r *nativePresentationRegistry) acquire(token uint64, frame PresentationFrame, at float64) uint64 {
+	if s := r.lookup(token); s != nil && !s.closed.Load() {
+		return s.observer.Acquired(frame, at)
+	}
+	return 0
+}
+func (r *nativePresentationRegistry) unavailable(token uint64, frame PresentationFrame, at float64) {
+	if s := r.lookup(token); s != nil && !s.closed.Load() {
+		s.observer.Unavailable(frame, at)
+	}
+}
+func (r *nativePresentationRegistry) presented(token, sequence, drawable uint64, at float64) {
+	if s := r.lookup(token); s != nil && !s.closed.Load() {
+		s.observer.Presented(sequence, drawable, at)
+	}
+}
+func (r *nativePresentationRegistry) close(token uint64) {
+	r.mu.Lock()
+	s := r.entries[token]
+	delete(r.entries, token)
+	if s != nil {
+		s.closed.Store(true)
+	}
+	r.mu.Unlock()
+	if s != nil {
+		s.observer.Closed()
+	}
+}

+func TestVellumScenePlanStagingIndependentTileOracle(t *testing.T) {
+	p := stagingFixture(129, true)
+	e, ok := p.Encode()
+	if !ok {
+		t.Fatal("encode refused")
+	}
+	// Tile-outer traversal is independent of the encoder's operation-outer bin fill.
+	ref := 0
+	for y := 0; y < e.Tiles.Y; y++ {
+		for x := 0; x < e.Tiles.X; x++ {
+			tile := image.Rect(x*TileSize, y*TileSize, (x+1)*TileSize, (y+1)*TileSize)
+			var want []uint32
+			for i, op := range p.ops {
+				if op.rect.Overlaps(tile) {
+					want = append(want, uint32(i))
+				}
+			}
+			at := (y*e.Tiles.X + x) * 8
+			if binary.LittleEndian.Uint32(e.Rows[at:]) != uint32(ref) || binary.LittleEndian.Uint32(e.Rows[at+4:]) != uint32(len(want)) {
+				t.Fatal("tile row differs", x, y)
+			}
+			for _, index := range want {
+				if binary.LittleEndian.Uint32(e.Refs[ref*4:]) != index {
+					t.Fatal("painter order differs", x, y, ref)
+				}
+				ref++
+			}
+		}
+	}
+	if len(e.Refs) != ref*4 {
+		t.Fatal("unused reference bytes")
+	}
+	first := stagingDigest(p)
+	for _, part := range [][]byte{e.Ops, e.Rows, e.Refs, e.Data} {
+		clear(part)
+	}
+	if stagingDigest(p) != first {
+		t.Fatal("encoded outputs alias packet")
+	}
+	got, want := image.NewRGBA(p.Bounds()), image.NewRGBA(p.Bounds())
+	if !p.Replay(want) || !p.Replay(got) || !bytes.Equal(got.Pix, want.Pix) {
+		t.Fatal("replay changed after output mutation")
+	}
+}

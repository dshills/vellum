+func stagingFixture(n int, mixed bool) *Packet {
+	b := New(image.Rect(0, 0, 35, 33))
+	source := image.NewRGBA(image.Rect(2, 3, 7, 8))
+	mask := image.NewAlpha(source.Rect)
+	for i := range source.Pix {
+		source.Pix[i] = byte(i*37 + 11)
+	}
+	for i := range mask.Pix {
+		mask.Pix[i] = byte(i*19 + 7)
+	}
+	for i := 0; i < n; i++ {
+		c := color.RGBA{byte(i * 3), byte(i * 5), byte(i * 7), 255}
+		x, y := i%31, (i*11)%29
+		r := image.Rect(x, y, x+5, y+5)
+		if i == 0 {
+			b.Draw(b.packet.bounds, image.NewUniform(c), image.Point{}, nil, image.Point{}, draw.Src)
+			continue
+		}
+		if !mixed {
+			b.Draw(r, image.NewUniform(c), image.Point{}, nil, image.Point{}, draw.Op(i%2))
+			continue
+		}
+		switch i % 4 {
+		case 0:
+			b.Draw(r, image.NewUniform(c), image.Point{}, nil, image.Point{}, draw.Over)
+		case 1:
+			b.Draw(r, image.NewUniform(c), image.Point{}, mask, mask.Rect.Min, draw.Over)
+		case 2:
+			b.Draw(r, source, source.Rect.Min, mask, mask.Rect.Min, draw.Src)
+		default:
+			b.BeginSpans(c, draw.Over)
+			b.Span(y+4, x+1, x+5, 32767)
+			b.Span(y, x, x+3, 65535)
+			b.Span(y+4, x, x+2, 12345)
+		}
+		// Existing operations must keep their previous source/mask snapshots.
+		mask.Pix[0]++
+		source.Pix[0]++
+	}
+	p := b.Seal(true)
+	clear(source.Pix)
+	clear(mask.Pix)
+	return p
+}
+
+func stagingDigest(p *Packet) string {
+	e, ok := p.Encode()
+	if !ok {
+		panic("fixture encode refused")
+	}
+	h := sha256.New()
+	for _, value := range []int{e.Tiles.X, e.Tiles.Y} {
+		var b [8]byte
+		binary.LittleEndian.PutUint64(b[:], uint64(value))
+		h.Write(b[:])
+	}
+	for _, part := range [][]byte{e.Ops, e.Rows, e.Refs, e.Data} {
+		var b [8]byte
+		binary.LittleEndian.PutUint64(b[:], uint64(len(part)))
+		h.Write(b[:])
+		h.Write(part)
+	}
+	return fmt.Sprintf("%x", h.Sum(nil))
+}

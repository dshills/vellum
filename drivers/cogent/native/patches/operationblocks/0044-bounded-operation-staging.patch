+func TestVellumScenePlanStagingBoundsOrderAndRetirement(t *testing.T) {
+	for _, n := range []int{0, 1, 63, 64, 65, 127, 128, 129, 1024, MaxOps} {
+		t.Run(fmt.Sprint(n), func(t *testing.T) {
+			b := New(image.Rect(0, 0, 4, 4))
+			baseBytes := b.packet.bytes
+			b.Draw(image.Rect(10, 10, 11, 11), image.White, image.Point{}, nil, image.Point{}, draw.Src)
+			if b.head != nil || b.count != 0 {
+				t.Fatal("clipped operation reserves staging")
+			}
+			for i := 0; i < n; i++ {
+				b.Draw(b.packet.bounds, image.NewUniform(color.RGBA{byte(i), 0, 0, 255}), image.Point{}, nil, image.Point{}, draw.Src)
+			}
+			blocks := 0
+			for block := b.head; block != nil; block = block.next {
+				blocks++
+			}
+			if b.count != n || blocks != (n+63)/64 || blocks*64-n > 63 || blocks > 1024 {
+				t.Fatal("staging bound", n, blocks, b.count)
+			}
+			p := b.Seal(true)
+			if p == nil || len(p.ops) != n || cap(p.ops) != n || p.Bytes() != baseBytes+n*int(unsafe.Sizeof(operation{})) || p.Independent() != (n > 0) || !p.Winding() {
+				t.Fatal("sealed capacity/charge/reset changed", n)
+			}
+			for i, o := range p.ops {
+				if o.color[0] != uint32(byte(i))*257 {
+					t.Fatal("operation order changed", i)
+				}
+			}
+			assertStagingRetired(t, b)
+			before := stagingDigest(p)
+			b.BeginSpans(color.RGBA{}, draw.Src)
+			b.Span(0, 0, 1, 65535)
+			b.Draw(p.Bounds(), image.White, image.Point{}, nil, image.Point{}, draw.Src)
+			if b.Seal(false) != nil || stagingDigest(p) != before {
+				t.Fatal("retired callback changed sealed packet")
+			}
+			assertStagingRetired(t, b)
+		})
+	}
+}

+func TestVellumScenePlanStagingRefusedStreamDoesNotCompact(t *testing.T) {
+	for _, mode := range []string{"failed", "ops", "bytes"} {
+		t.Run(mode, func(t *testing.T) {
+			b := New(image.Rect(0, 0, 4, 4))
+			op := operation{kind: Spans, op: draw.Src, rect: image.Rect(0, 0, 1, 1), rows: [][]span{{{0, 1, 65535}}}}
+			allocs := testing.AllocsPerRun(10, func() {
+				b.failed = mode == "failed"
+				b.count = 0
+				b.packet.bytes = 0
+				if mode == "ops" {
+					b.count = MaxOps
+				}
+				if mode == "bytes" {
+					b.packet.bytes = MaxBytes
+				}
+				b.stream = &op
+				b.flush()
+			})
+			if allocs != 0 || !b.Failed() || b.stream != nil {
+				t.Fatal("refused flush allocates compact rows", allocs)
+			}
+			if b.Seal(false) != nil {
+				t.Fatal("refused stream retained partial packet")
+			}
+			assertStagingRetired(t, b)
+		})
+	}
+	// Admission happens after spare construction row headers are refunded.
+	b := New(image.Rect(0, 0, 4, 16))
+	b.BeginSpans(color.RGBA{1, 2, 3, 255}, draw.Src)
+	for y := 0; y < 5; y++ {
+		b.Span(y, 0, 1, 65535)
+	}
+	spare := (len(b.stream.rows) - b.stream.rect.Dy()) * int(unsafe.Sizeof([]span{}))
+	if spare == 0 {
+		t.Fatal("fixture has no spare headers")
+	}
+	b.packet.bytes = MaxBytes - int(unsafe.Sizeof(operation{})) + spare
+	p := b.Seal(false)
+	if p == nil || p.Bytes() != MaxBytes || p.Operations() != 1 {
+		t.Fatal("refunded budget boundary changed")
+	}
+	assertStagingRetired(t, b)
+}

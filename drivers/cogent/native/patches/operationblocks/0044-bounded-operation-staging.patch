+func TestVellumScenePlanStagingAdmissionBeforeAllocation(t *testing.T) {
+	b := New(image.Rect(0, 0, 1, 1))
+	for i := 0; i < MaxOps; i++ {
+		b.Draw(b.packet.bounds, image.White, image.Point{}, nil, image.Point{}, draw.Src)
+	}
+	head, tail, charge := b.head, b.tail, b.packet.bytes
+	b.Draw(b.packet.bounds, image.White, image.Point{}, nil, image.Point{}, draw.Src)
+	if !b.Failed() || b.count != MaxOps || b.head != head || b.tail != tail || tail.next != nil || b.packet.bytes != charge {
+		t.Fatal("operation limit allocated/charged one more operation")
+	}
+	if b.Seal(false) != nil {
+		t.Fatal("operation overflow accepted a partial batch")
+	}
+	assertStagingRetired(t, b)
+	for _, short := range []int{0, 1} {
+		b = New(image.Rect(0, 0, 1, 1))
+		b.packet.bytes = MaxBytes - int(unsafe.Sizeof(operation{})) + short
+		b.Draw(b.packet.bounds, image.White, image.Point{}, nil, image.Point{}, draw.Src)
+		if short == 0 {
+			if b.count != 1 || b.packet.bytes != MaxBytes {
+				t.Fatal("exact operation budget refused")
+			}
+			p := b.Seal(false)
+			if p == nil || p.Bytes() != MaxBytes {
+				t.Fatal("exact sealed budget changed")
+			}
+		} else {
+			if !b.Failed() || b.head != nil || b.count != 0 {
+				t.Fatal("byte limit allocated staging before refusal")
+			}
+			if b.Seal(false) != nil {
+				t.Fatal("byte limit retained packet")
+			}
+		}
+		assertStagingRetired(t, b)
+	}
+}

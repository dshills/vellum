+func assertStagingRetired(t *testing.T, b *Builder) {
+	t.Helper()
+	if !b.Failed() || b.head != nil || b.tail != nil || b.count != 0 || b.masks != nil || b.stream != nil || b.streamRowMin != 0 || b.packet.ops != nil || b.packet.bounds != (image.Rectangle{}) || b.packet.bytes != 0 || b.packet.winding || b.packet.independent {
+		t.Fatal("sealed/refused builder retains construction references")
+	}
+}

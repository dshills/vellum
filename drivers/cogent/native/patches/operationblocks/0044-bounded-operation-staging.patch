+func TestVellumScenePlanStagingOriginalEncoding(t *testing.T) {
+	for _, n := range []int{0, 1, 63, 64, 65, 127, 128, 129, 1024, MaxOps} {
+		p := stagingFixture(n, false)
+		if p == nil || p.Operations() != n {
+			t.Fatalf("fixture %d refused", n)
+		}
+		if stagingDigest(p) != originalStagingDigests[fmt.Sprint("uniform-", n)] {
+			t.Fatal("original encoded bytes changed", n)
+		}
+	}
+	p := stagingFixture(129, true)
+	if p == nil {
+		t.Fatal("mixed fixture refused")
+	}
+	if stagingDigest(p) != originalStagingDigests["mixed-129"] {
+		t.Fatal("original mixed encoded bytes changed")
+	}
+}

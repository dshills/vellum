+// IsUnavailable identifies a coherent known surface-acquisition yield. It does
+// not promise that a later attempt will succeed or authorize automatic retry.
+// Unknown, backend/view errors, missing textures and offscreen/legacy outcomes
+// are not classified as unavailable. The existing bounded retry is unchanged.
+func (o AcquisitionOutcome) IsUnavailable() bool {
+	if o.Source != AcquisitionSurface || o.Stage != AcquisitionUnavailable {
+		return false
+	}
+	switch o.Attempts {
+	case 1:
+		return o.FirstStatus == o.LastStatus && (o.LastStatus == wgpu.SurfaceGetCurrentTextureStatusOccluded || o.LastStatus == wgpu.SurfaceGetCurrentTextureStatusTimeout)
+	case 2:
+		if o.FirstStatus != wgpu.SurfaceGetCurrentTextureStatusLost && o.FirstStatus != wgpu.SurfaceGetCurrentTextureStatusOutdated {
+			return false
+		}
+		switch o.LastStatus {
+		case wgpu.SurfaceGetCurrentTextureStatusOccluded, wgpu.SurfaceGetCurrentTextureStatusTimeout, wgpu.SurfaceGetCurrentTextureStatusLost, wgpu.SurfaceGetCurrentTextureStatusOutdated:
+			return true
+		}
+	}
+	return false
+}

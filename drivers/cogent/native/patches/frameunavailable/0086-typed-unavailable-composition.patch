+func vellumUnavailableTrace(t *testing.T, armed bool) (*FrameTrace, uint64) {
+	t.Helper()
+	trace := &FrameTrace{}
+	event := traceScroll()
+	if err := trace.Begin(91, event); err != nil {
+		t.Fatal(err)
+	}
+	tag, start := trace.startEvent(event)
+	trace.ExpectOwner(tag)
+	trace.endEvent(tag, start)
+	trace.Transition(tag, 17)
+	trace.OwnerWork(tag, 3)
+	if armed {
+		trace.Reconciled(tag, 5)
+	}
+	if trace.startFrame() != tag {
+		t.Fatal("trace segment not started")
+	}
+	return trace, tag
+}
+func TestVellumFrameTraceUnavailableStrictContradictionsAndLegacy(t *testing.T) {
+	cases := []struct {
+		name                  string
+		timing                composer.ComposeTiming
+		complete, unavailable bool
+	}{
+		{"checked-yield", composer.ComposeTiming{Supported: true, Unavailable: true, Failure: "yield"}, false, true},
+		{"legacy-identical-text", composer.ComposeTiming{Supported: true, Failure: "yield"}, false, false},
+		{"submitted-with-yield", composer.ComposeTiming{Supported: true, Submitted: true, Unavailable: true, Failure: "yield"}, false, false},
+		{"contradictory-success", composer.ComposeTiming{Supported: true, Submitted: true, Unavailable: true}, false, false},
+		{"unsupported-yield", composer.ComposeTiming{Unavailable: true, Failure: "yield"}, false, false},
+		{"missing-failure", composer.ComposeTiming{Supported: true, Unavailable: true}, false, false},
+		{"healthy", composer.ComposeTiming{Supported: true, Submitted: true}, true, false},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			trace, tag := vellumUnavailableTrace(t, true)
+			trace.finishFrame(tag, c.timing)
+			sample, ok := trace.Take()
+			if !ok || sample.Completed != c.complete || sample.Unavailable != c.unavailable || !sample.Completed && sample.Failure == "" {
+				t.Fatal("wrong terminal", sample, ok)
+			}
+			if _, again := trace.Take(); again || trace.Pending() {
+				t.Fatal("terminal retained")
+			}
+		})
+	}

+func TestVellumFrameTraceUnavailableIntermediateAndFatalRetirement(t *testing.T) {
+	yield := composer.ComposeTiming{Supported: true, Unavailable: true, Failure: "yield"}
+	trace, tag := vellumUnavailableTrace(t, false)
+	trace.finishFrame(tag, yield)
+	sample, ok := trace.Take()
+	if !ok || sample.Completed || !sample.Unavailable {
+		t.Fatal("pre-armed failure contract changed", sample, ok)
+	}
+	// A new ticket starts with zero classification and independently qualifies.
+	event := traceScroll()
+	if err := trace.Begin(92, event); err != nil {
+		t.Fatal(err)
+	}
+	next, start := trace.startEvent(event)
+	trace.ExpectOwner(next)
+	trace.endEvent(next, start)
+	trace.Transition(next, 18)
+	trace.OwnerWork(next, 0)
+	trace.Reconciled(next, 0)
+	trace.finishFrame(trace.startFrame(), composer.ComposeTiming{Supported: true, Submitted: true})
+	sample, ok = trace.Take()
+	if !ok || !sample.Completed || sample.Unavailable {
+		t.Fatal("classification leaked across tickets", sample, ok)
+	}
+	for _, retire := range []bool{false, true} {
+		trace, tag = vellumUnavailableTrace(t, true)
+		if retire {
+			trace.Retire(tag, "closed")
+		} else {
+			trace.Fail(tag, "canceled")
+		}
+		trace.finishFrame(tag, yield) // late acquisition result must not replace terminal
+		sample, ok = trace.Take()
+		if !ok || sample.Completed || sample.Unavailable || sample.Failure == "yield" {
+			t.Fatal("late availability replaced fatal/cancel/retire", sample, ok)
+		}
+	}
+}

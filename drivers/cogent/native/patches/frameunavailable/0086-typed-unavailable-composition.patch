+		{"recovery-exhausted", gpu.AcquisitionOutcome{Source: gpu.AcquisitionSurface, Stage: gpu.AcquisitionUnavailable, Attempts: 2, FirstStatus: wgpu.SurfaceGetCurrentTextureStatusLost, LastStatus: wgpu.SurfaceGetCurrentTextureStatusOutdated}, false, true},
+		{"backend-error", gpu.AcquisitionOutcome{Source: gpu.AcquisitionSurface, Stage: gpu.AcquisitionUnavailable, Attempts: 1, FirstStatus: occluded, LastStatus: occluded}, true, false},
+		{"view-error", gpu.AcquisitionOutcome{Source: gpu.AcquisitionSurface, Stage: gpu.AcquisitionViewError, Attempts: 1, FirstStatus: wgpu.SurfaceGetCurrentTextureStatusSuccessOptimal, LastStatus: wgpu.SurfaceGetCurrentTextureStatusSuccessOptimal}, true, false},
+		{"missing-texture", gpu.AcquisitionOutcome{Source: gpu.AcquisitionSurface, Stage: gpu.AcquisitionMissingTexture, Attempts: 1}, false, false},
+		{"unknown", gpu.AcquisitionOutcome{Source: gpu.AcquisitionSurface, Stage: gpu.AcquisitionUnavailable, Attempts: 1, FirstStatus: wgpu.SurfaceGetCurrentTextureStatus(0xffffffff), LastStatus: wgpu.SurfaceGetCurrentTextureStatus(0xffffffff)}, false, false},
+		{"offscreen", gpu.AcquisitionOutcome{Source: gpu.AcquisitionRenderTexture, Stage: gpu.AcquisitionUnavailable}, false, false},
+		{"legacy", gpu.AcquisitionOutcome{}, false, false},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			sentinel := errors.New("injected view/backend error")
+			r := &unavailableMeasuredRenderer{outcome: c.out}
+			if c.failure {
+				r.failure = sentinel
+			}
+			timing := composer.ComposeTiming{Supported: true, Unavailable: true}
+			pass, err := beginMeasuredPass(&gpu.GraphicsSystem{Renderer: r}, &timing)
+			if pass != nil || r.calls != 1 || timing.Submitted || timing.Unavailable != c.want {
+				t.Fatal("incorrect checked classification/calls", timing, err, r.calls)
+			}
+			if c.failure {
+				if !errors.Is(err, sentinel) {
+					t.Fatal("underlying failure lost", err)
+				}
+			} else if err != nil || timing.Failure == "" {
+				t.Fatal("yield qualified or lost diagnostic", timing, err)
+			}
+		})
+	}

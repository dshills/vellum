+// snapshot detaches collection membership from concurrent adds/removals. It
+// does not acquire the individual windows' render contexts or extend their
+// native lifetimes. Callers retain each window's normal ownership checks.
+func (wl *renderWindowList) snapshot() renderWindowList {
+	renderWindowGlobalMu.Lock()
+	defer renderWindowGlobalMu.Unlock()
+	return slices.Clone(*wl)
+}
+
+// last reads the focus-restoration candidate under the collection mutex.
+// Native methods on the returned window must run after releasing that mutex.
+func (wl *renderWindowList) last() *renderWindow {
+	renderWindowGlobalMu.Lock()
+	defer renderWindowGlobalMu.Unlock()
+	if len(*wl) == 0 {
+		return nil
+	}
+	return (*wl)[len(*wl)-1]
+}
+
+// promoteExisting moves a registered window to the end in one transaction.
+// A delayed focus event for a removed window cannot reinsert it. No native
+// methods or render-context locks are acquired while holding the registry lock.
+func (wl *renderWindowList) promoteExisting(w *renderWindow) bool {
+	renderWindowGlobalMu.Lock()
+	defer renderWindowGlobalMu.Unlock()
+	i := slices.Index(*wl, w)
+	if i < 0 {
+		return false
+	}
+	copy((*wl)[i:], (*wl)[i+1:])
+	(*wl)[len(*wl)-1] = w
+	return true
+}

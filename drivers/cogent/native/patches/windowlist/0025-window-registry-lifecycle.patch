+package core
+
+import (
+	"slices"
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	"cogentcore.org/core/events"
+	"cogentcore.org/core/system"
+)
+
+type vellumWindowListNative struct {
+	system.Window
+	is    func(system.WindowFlags) bool
+	raise func()
+}
+
+func (w *vellumWindowListNative) Is(flag system.WindowFlags) bool {
+	if w.is != nil {
+		return w.is(flag)
+	}
+	return false
+}
+func (w *vellumWindowListNative) Raise() {
+	if w.raise != nil {
+		w.raise()
+	}
+}
+func (*vellumWindowListNative) Lock() bool { return false }
+func (*vellumWindowListNative) Unlock()    { panic("closed window unlock") }
+
+func TestVellumWindowListPromotionAndDetachedSnapshot(t *testing.T) {
+	a, b, c := &renderWindow{}, &renderWindow{}, &renderWindow{}
+	list := make(renderWindowList, 3, 32)
+	copy(list, renderWindowList{a, b, c})
+	before := list.snapshot()
+	if !list.promoteExisting(b) || !slices.Equal(list.snapshot(), renderWindowList{a, c, b}) {
+		t.Fatal("focus promotion changed membership or order")
+	}
+	if !list.promoteExisting(b) || !slices.Equal(list.snapshot(), renderWindowList{a, c, b}) {
+		t.Fatal("last-window promotion was not idempotent")
+	}
+	list.delete(b)
+	if list.promoteExisting(b) || list.last() != c {
+		t.Fatal("late focus resurrected a removed window")
+	}
+	if !slices.Equal(before, renderWindowList{a, b, c}) {
+		t.Fatal("membership mutation changed an existing snapshot")
+	}
+	before[0] = nil
+	if !slices.Equal(list.snapshot(), renderWindowList{a, c}) {
+		t.Fatal("caller modified registry through snapshot backing storage")
+	}
+	list.delete(a)
+	list.delete(c)
+	if list.last() != nil || list.promoteExisting(a) || len(list.snapshot()) != 0 {
+		t.Fatal("empty registry retained or resurrected a window")
+	}
+}
+
+func TestVellumWindowListConcurrentDeletePromotion(t *testing.T) {
+	for round := 0; round < 32; round++ {
+		a, closing, b := &renderWindow{}, &renderWindow{}, &renderWindow{}
+		list := renderWindowList{a, closing, b}
+		start := make(chan struct{})
+		var workers sync.WaitGroup
+		workers.Add(3)
+		go func() {
+			defer workers.Done()
+			<-start
+			for i := 0; i < 512; i++ {
+				list.promoteExisting(closing)
+				list.promoteExisting(a)
+			}
+		}()
+		go func() {
+			defer workers.Done()
+			<-start
+			list.delete(closing)
+			for i := 0; i < 512; i++ {
+				list.promoteExisting(b)
+			}
+		}()
+		go func() {
+			defer workers.Done()
+			<-start
+			for i := 0; i < 512; i++ {
+				snapshot := list.snapshot()
+				if len(snapshot) > 0 {
+					snapshot[0] = nil
+				}
+				_ = list.last()
+			}
+		}()
+		close(start)
+		workers.Wait()
+		got := list.snapshot()
+		if len(got) != 2 || slices.Contains(got, closing) || slices.Contains(got, nil) || !slices.Contains(got, a) || !slices.Contains(got, b) {
+			t.Fatal("concurrent focus/delete changed membership", got)
+		}
+	}
+}
+
+func TestVellumWindowListFocusNextCalloutsAndRemoval(t *testing.T) {
+	focused, minimized, target := &renderWindow{}, &renderWindow{}, &renderWindow{}
+	focused.flags.SetFlag(true, winGotFocus)
+	list := renderWindowList{focused, minimized, target}
+	var held, raises atomic.Int32
+	minimized.SystemWindow = &vellumWindowListNative{is: func(flag system.WindowFlags) bool {
+		if !renderWindowGlobalMu.TryLock() {
+			held.Add(1)
+			return true
+		}
+		// Removal during a native callout must not change the candidate indices
+		// in the caller's detached snapshot, even when the focused one disappears.
+		list = slices.DeleteFunc(list, func(w *renderWindow) bool { return w == focused || w == minimized })
+		renderWindowGlobalMu.Unlock()
+		return flag == system.Minimized
+	}}
+	target.SystemWindow = &vellumWindowListNative{raise: func() {
+		if !renderWindowGlobalMu.TryLock() {
+			held.Add(1)
+			return
+		}
+		renderWindowGlobalMu.Unlock()
+		raises.Add(1)
+	}}
+	got, index := list.focusNext()
+	if got != target || index != 2 || raises.Load() != 1 || held.Load() != 0 || !slices.Equal(list.snapshot(), renderWindowList{target}) {
+		t.Fatal("focus selection lost snapshot order or held registry across native methods", got, index, raises.Load(), held.Load())
+	}
+	list = renderWindowList{focused, minimized}
+	minimized.SystemWindow = &vellumWindowListNative{is: func(system.WindowFlags) bool { return true }}
+	if got, index := list.focusNext(); got != nil || index != -1 {
+		t.Fatal("all minimized candidates must not become focus targets")
+	}
+}
+
+func TestVellumWindowListConcurrentFocusNextDelete(t *testing.T) {
+	for round := 0; round < 128; round++ {
+		native := &vellumWindowListNative{}
+		a, b, focused := &renderWindow{SystemWindow: native}, &renderWindow{SystemWindow: native}, &renderWindow{SystemWindow: native}
+		focused.flags.SetFlag(true, winGotFocus)
+		list := renderWindowList{a, b, focused}
+		start := make(chan struct{})
+		var workers sync.WaitGroup
+		workers.Add(2)
+		go func() {
+			defer workers.Done()
+			<-start
+			for i := 0; i < 64; i++ {
+				list.focusNext()
+			}
+		}()
+		go func() {
+			defer workers.Done()
+			<-start
+			list.delete(a)
+			list.delete(b)
+			list.delete(focused)
+		}()
+		close(start)
+		workers.Wait()
+		if len(list.snapshot()) != 0 {
+			t.Fatal("focus traversal resurrected a deleted window")
+		}
+	}
+}
+
+func TestVellumWindowListNativeFocusCloseEvents(t *testing.T) {
+	renderWindowGlobalMu.Lock()
+	previousAll, previousMain, previousDialogs, previousCurrent := AllRenderWindows, mainRenderWindows, dialogRenderWindows, currentRenderWindow
+	renderWindowGlobalMu.Unlock()
+	t.Cleanup(func() {
+		renderWindowGlobalMu.Lock()
+		AllRenderWindows, mainRenderWindows, dialogRenderWindows, currentRenderWindow = previousAll, previousMain, previousDialogs, previousCurrent
+		renderWindowGlobalMu.Unlock()
+	})
+	focused := &renderWindow{SystemWindow: &vellumWindowListNative{}}
+	closing := &renderWindow{SystemWindow: &vellumWindowListNative{}}
+	renderWindowGlobalMu.Lock()
+	AllRenderWindows = renderWindowList{focused, closing}
+	mainRenderWindows = slices.Clone(AllRenderWindows)
+	dialogRenderWindows = nil
+	renderWindowGlobalMu.Unlock()
+	start := make(chan struct{})
+	var workers sync.WaitGroup
+	workers.Add(2)
+	go func() {
+		defer workers.Done()
+		<-start
+		for i := 0; i < 1024; i++ {
+			focused.handleWindowEvents(events.NewWindow(events.WinFocus))
+		}
+	}()
+	go func() {
+		defer workers.Done()
+		<-start
+		closing.handleWindowEvents(events.NewWindow(events.WinClose))
+	}()
+	close(start)
+	workers.Wait()
+	if !slices.Equal(AllRenderWindows.snapshot(), renderWindowList{focused}) || !slices.Equal(mainRenderWindows.snapshot(), renderWindowList{focused}) || !closing.flags.HasFlag(winStopEventLoop) {
+		t.Fatal("actual focus/close hooks corrupted registration")
+	}
+	AllRenderWindows.delete(focused)
+	focused.flags.SetFlag(false, winGotFocus)
+	setCurrentRenderWindow(closing)
+	focused.handleWindowEvents(events.NewWindow(events.WinFocus))
+	if len(AllRenderWindows.snapshot()) != 0 || focused.flags.HasFlag(winGotFocus) || currentRenderWindowSnapshot() != closing {
+		t.Fatal("late native focus reactivated a removed window")
+	}
+}

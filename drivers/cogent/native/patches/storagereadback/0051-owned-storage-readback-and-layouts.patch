+// Original-compatible tiny native API checks. No surfaces/windows/input, shader
+// performance, physical memory or actual device-fault injection is qualified.
+func TestVellumStorageNativeReadback(t *testing.T) {
+	if os.Getenv("VELLUM_STORAGE_GPU_TEST") != "1" {
+		t.Skip("explicit tiny headless fixture required")
+	}
+	var gp *GPU
+	var dev *Device
+	defer func() {
+		if dev != nil {
+			dev.Release()
+		}
+		if gp != nil {
+			gp.Release()
+		}
+		ReleaseInstance()
+	}()
+	var err error
+	gp, dev, err = NoDisplayGPU()
+	if err != nil || gp == nil || dev == nil {
+		t.Fatal("headless admission", err)
+	}
+	record := func(fields map[string]any) {
+		fields["windows_created"] = 0
+		fields["surfaces_created"] = 0
+		b, e := json.Marshal(fields)
+		if e != nil {
+			t.Fatal(e)
+		}
+		fmt.Printf("VELLUM_STORAGE_NATIVE %s\n", b)
+	}
+	makeValue := func(t *testing.T, device *Device) *Value {
+		group := &VarGroup{Role: Storage, alignBytes: 1}
+		variable := NewVar(group, "words", Uint32, 1, ComputeShader)
+		value := NewValue(variable, device, 0)
+		t.Cleanup(func() {
+			// The original baseline can panic after admitting a first map. The fixture
+			// owns this exact buffer, so cancel it without relying on new state fields.
+			if value.readBuffer.IsValid() {
+				_ = value.readBuffer.TryUnmap()
+			}
+			value.Release()
+		})
+		if e := SetValueFrom(value, []uint32{7, 13, 23, 41}); e != nil {
+			t.Fatal(e)
+		}
+		return value
+	}
+	copyValue := func(t *testing.T, value *Value) {
+		command, e := value.device.Device.TryCreateCommandEncoder(nil)
+		if e != nil {
+			t.Fatal(e)
+		}
+		defer command.Release()
+		if e := value.GPUToRead(command); e != nil {
+			t.Fatal(e)
+		}
+		buffer, e := command.TryFinish(nil)
+		if e != nil {
+			t.Fatal(e)

+// Copyright (c) 2026, Davin Hills.
+// SPDX-License-Identifier: MIT
+
+package composer
+
+import (
+	"reflect"
+	"runtime"
+	"testing"
+)
+
+type sourceTimingDrawer struct {
+	measuredTimingDrawer
+	active bool
+	stats  ImageTiming
+}
+
+func (d *sourceTimingDrawer) BeginSourceImageTiming() bool {
+	if d.active {
+		return false
+	}
+	d.active = true
+	d.stats = ImageTiming{}
+	return true
+}
+func (d *sourceTimingDrawer) ReadSourceImageTiming() ImageTiming { return d.stats }
+func (d *sourceTimingDrawer) EndSourceImageTiming()              { d.active = false }
+
+type measuredSource struct {
+	draw, measured int
+	action         func()
+}
+
+type unwindingSourceDrawer struct {
+	*sourceTimingDrawer
+	action func()
+}
+
+func (d *unwindingSourceDrawer) EndMeasured() ComposeTiming {
+	d.action()
+	return d.sourceTimingDrawer.EndMeasured()
+}
+
+func TestVellumSourceTimingDrawerUnwindClearsCounters(t *testing.T) {
+	for _, goexit := range []bool{false, true} {
+		var order []string
+		d := &unwindingSourceDrawer{sourceTimingDrawer: newSourceTimingDrawer(&order), action: func() {
+			if goexit {
+				runtime.Goexit()
+			}
+			panic("drawer panic")
+		}}
+		done := make(chan bool, 1)
+		go func() {
+			returned := false
+			defer func() { p := recover(); done <- !returned && (goexit && p == nil || !goexit && p == "drawer panic") }()
+			(&ComposerDrawer{Drawer: d, Sources: []Source{timingSource{"draw", &order}}}).ComposeMeasuredWithSourceDetails()
+			returned = true
+		}()
+		if !<-done || d.active {
+			t.Fatal("drawer unwind retained timing or hid abnormal exit")
+		}
+	}
+}
+
+func (s *measuredSource) Draw(Composer) {
+	s.draw++
+	if s.action != nil {
+		s.action()
+	}
+}
+func (s *measuredSource) DrawMeasured(Composer) SourceTiming {
+	s.measured++
+	if s.action != nil {
+		s.action()
+	}
+	return SourceTiming{Kind: SourceScene}
+}
+
+func newSourceTimingDrawer(order *[]string) *sourceTimingDrawer {
+	return &sourceTimingDrawer{measuredTimingDrawer: measuredTimingDrawer{timingDrawer: timingDrawer{order: order}, result: ComposeTiming{Supported: true, Submitted: true, EncodeSubmitNS: 19}}}
+}
+
+func TestVellumSourceTimingOptInOrderBoundsAndNoDoubleCounting(t *testing.T) {
+	for _, detailed := range []bool{false, true} {
+		var order []string
+		d := newSourceTimingDrawer(&order)
+		s := &measuredSource{action: func() { order = append(order, "known") }}
+		cd := &ComposerDrawer{Drawer: d, Sources: []Source{s, timingSource{"unknown", &order}}}
+		var result ComposeTiming
+		if detailed {
+			result = cd.ComposeMeasuredWithSourceDetails()
+		} else {
+			result = cd.ComposeMeasured()
+		}
+		if !reflect.DeepEqual(order, []string{"start", "known", "unknown", "measured-end"}) || d.active || result.EncodeSubmitNS != 19 || !result.Submitted {
+			t.Fatalf("rendering changed: %+v %v", result, order)
+		}
+		if !detailed {
+			if result.SourceDetails != nil || s.draw != 1 || s.measured != 0 {
+				t.Fatal("ordinary path acquired details")
+			}
+			continue
+		}
+		if s.draw != 0 || s.measured != 1 || result.Failure != "" || len(result.SourceDetails.Records) != 2 {
+			t.Fatal("diagnostic drew source twice or lost records")
+		}
+		var draws int64
+		for i, r := range result.SourceDetails.Records {
+			if r.Composition != 1 || r.Source != uint32(i) || !r.ImageUploadTimingAvailable {
+				t.Fatalf("order/timing: %+v", r)
+			}
+			draws += r.DrawNS
+		}
+		if draws > result.RasterUploadNS || result.SourceDetails.Records[1].RasterAvailable || result.SourceDetails.Records[1].CopyAvailable {
+			t.Fatal("nested/unknown timing fabricated")
+		}
+	}
+	var order []string
+	d := newSourceTimingDrawer(&order)
+	s := &measuredSource{}
+	cd := &ComposerDrawer{Drawer: d}
+	for i := 0; i < 33; i++ {
+		cd.Sources = append(cd.Sources, s)
+	}
+	r := cd.ComposeMeasuredWithSourceDetails()
+	if s.measured != 33 || len(r.SourceDetails.Records) != 32 || r.Failure == "" || !r.Submitted || d.active || order[len(order)-1] != "measured-end" {
+		t.Fatal("overflow altered full draw/submit")
+	}
+}
+
+func TestVellumSourceTimingUnknownDrawerAndCounterOverflow(t *testing.T) {
+	var order []string
+	d := &measuredTimingDrawer{timingDrawer: timingDrawer{order: &order}, result: ComposeTiming{Supported: true, Submitted: true}}
+	r := (&ComposerDrawer{Drawer: d, Sources: []Source{timingSource{"draw", &order}}}).ComposeMeasuredWithSourceDetails()
+	if r.Failure != "" || r.SourceDetails.Records[0].ImageUploadTimingAvailable {
+		t.Fatal("unknown drawer fabricated image counters")
+	}
+	timer := newSourceTimingDrawer(&order)
+	s := &measuredSource{action: func() { timer.stats.Invalid = true }}
+	r = (&ComposerDrawer{Drawer: timer, Sources: []Source{s}}).ComposeMeasuredWithSourceDetails()
+	if r.Failure == "" || !r.Submitted || timer.active {
+		t.Fatal("masked overflow or altered submission")
+	}
+}
+
+func TestVellumSourceTimingUnwindClearsCounters(t *testing.T) {
+	for _, goexit := range []bool{false, true} {
+		var order []string
+		d := newSourceTimingDrawer(&order)
+		done := make(chan bool, 1)
+		go func() {
+			returned := false
+			defer func() { p := recover(); done <- !returned && (goexit && p == nil || !goexit && p == "source panic") }()
+			s := &measuredSource{action: func() {
+				if goexit {
+					runtime.Goexit()
+				}
+				panic("source panic")
+			}}
+			(&ComposerDrawer{Drawer: d, Sources: []Source{s}}).ComposeMeasuredWithSourceDetails()
+			returned = true
+		}()
+		if !<-done || d.active {
+			t.Fatal("abnormal unwind masked or measurement retained")
+		}
+		r := (&ComposerDrawer{Drawer: d, Sources: []Source{timingSource{"next", &order}}}).ComposeMeasuredWithSourceDetails()
+		if r.Failure != "" || d.active {
+			t.Fatal("next batch inherited stale measurement")
+		}
+	}
+}

+// Copyright (c) 2026, Davin Hills.
+// SPDX-License-Identifier: MIT
+
+//go:build !js
+
+package core
+
+import (
+	"cogentcore.org/core/colors"
+	"cogentcore.org/core/paint/renderers/rasterx"
+	"cogentcore.org/core/system/composer"
+	"golang.org/x/image/draw"
+	"image"
+	"time"
+)
+
+// The explicit diagnostic path executes the same Render/Copy calls as Draw.
+// Raster, Copy, and image API durations remain nested in the outer DrawNS.
+func (ps *paintSource) DrawMeasured(c composer.Composer) composer.SourceTiming {
+	cd := c.(*composer.ComposerDrawer)
+	rd := ps.renderer.(*rasterx.Renderer)
+	unchanged := len(ps.render) == 0
+	record := composer.SourceTiming{Kind: ps.kind, RasterAvailable: true, CopyAvailable: true, ImageChanged: !unchanged}
+	if !unchanged {
+		start := time.Now()
+		rd.Render(ps.render)
+		record.RasterNS = time.Since(start).Nanoseconds()
+	}
+	img := rd.Image()
+	bounds := img.Bounds()
+	record.ImageWidth, record.ImageHeight = bounds.Dx(), bounds.Dy()
+	start := time.Now()
+	cd.Drawer.Copy(ps.drawPos, img, bounds, ps.drawOp, unchanged)
+	record.CopyNS = time.Since(start).Nanoseconds()
+	return record
+}
+
+func (ss *scrimSource) DrawMeasured(c composer.Composer) composer.SourceTiming {
+	cd := c.(*composer.ComposerDrawer)
+	clr := colors.Uniform(colors.ApplyOpacity(colors.ToUniform(colors.Scheme.Scrim), 0.5))
+	start := time.Now()
+	cd.Drawer.Copy(image.Point{}, clr, ss.bbox, draw.Over, composer.Unchanged)
+	return composer.SourceTiming{Kind: composer.SourceScrim, CopyAvailable: true, CopyNS: time.Since(start).Nanoseconds()}
+}
+
+func (ss *fillInsetsSource) DrawMeasured(c composer.Composer) composer.SourceTiming {
+	cd := c.(*composer.ComposerDrawer)
+	clr := colors.Scheme.Surface
+	record := composer.SourceTiming{Kind: composer.SourceInsets, CopyAvailable: true}
+	fill := func(x0, y0, x1, y1 int) {
+		r := image.Rect(x0, y0, x1, y1)
+		if r.Dx() == 0 || r.Dy() == 0 {
+			return
+		}
+		start := time.Now()
+		cd.Drawer.Copy(image.Point{}, clr, r, draw.Src, composer.Unchanged)
+		record.CopyNS += time.Since(start).Nanoseconds()
+	}
+	rb, wb := ss.rbb, ss.wbb
+	fill(0, 0, wb.Max.X, rb.Min.Y)
+	fill(0, rb.Max.Y, wb.Max.X, wb.Max.Y)
+	fill(rb.Max.X, 0, wb.Max.X, wb.Max.Y)
+	fill(0, 0, rb.Min.X, wb.Max.Y)
+	return record
+}

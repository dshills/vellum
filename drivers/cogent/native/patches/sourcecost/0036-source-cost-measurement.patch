+
+func sourceTraceComposition(n int) composer.ComposeTiming {
+	d := &composer.SourceDetails{Compositions: 1}
+	for i := 0; i < n; i++ {
+		d.Records = append(d.Records, composer.SourceTiming{Composition: 1, Source: uint32(i), Kind: composer.SourceScene, DrawNS: 2, RasterNS: 1, RasterAvailable: true})
+	}
+	return composer.ComposeTiming{Supported: true, Submitted: true, RasterUploadNS: 100, EncodeSubmitNS: 20, SourceDetails: d}
+}
+
+func TestVellumSourceTimingTraceRejectsUnavailableOrderAndCounterOverflow(t *testing.T) {
+	for _, src := range []*composer.SourceDetails{nil, {Compositions: 1}, {Compositions: 1, Records: []composer.SourceTiming{{Composition: 1, Source: 1}}}} {
+		if appendFrameSourceDetails(&composer.SourceDetails{}, src) == "" {
+			t.Fatal("accepted incomplete diagnostic")
+		}
+	}
+	dst := sourceTraceComposition(1).SourceDetails
+	dst.Records[0].LogicalUploadRGBABytes = math.MaxUint64 - 3
+	src := sourceTraceComposition(1).SourceDetails
+	src.Records[0].LogicalUploadRGBABytes = 4
+	if appendFrameSourceDetails(dst, src) == "" || len(dst.Records) != 1 {
+		t.Fatal("accepted ticket byte overflow")
+	}
+}
+
+func TestVellumSourceTimingTracePrefixSharedCapAndDetach(t *testing.T) {
+	for _, overflow := range []bool{false, true} {
+		trace := NewFrameTraceWithSourceDetails()
+		e := traceScroll()
+		if err := trace.Begin(9, e); err != nil {
+			t.Fatal(err)
+		}
+		tag, start := trace.startEvent(e)
+		trace.ExpectOwner(tag)
+		trace.endEvent(tag, start)
+		if trace.startFrame() != 9 {
+			t.Fatal("prefix missing")
+		}
+		prefix := sourceTraceComposition(20)
+		// Arm while prefix is in progress. It must not finalize this ticket.
+		trace.Transition(9, 3)
+		trace.OwnerWork(9, 7)
+		trace.Reconciled(9, 11)
+		trace.finishFrame(9, prefix)
+		prefix.SourceDetails.Records[0].DrawNS = 999999
+		if _, ok := trace.Take(); ok {
+			t.Fatal("prefix finalized late arm")
+		}
+		if trace.startFrame() != 9 {
+			t.Fatal("final missing")
+		}
+		n := 12
+		if overflow {
+			n = 13
+		}
+		trace.finishFrame(9, sourceTraceComposition(n))
+		s, ok := trace.Take()
+		if !ok || s.SourceDetails == nil || s.SourceDetails.Compositions != 2 || s.SourceDetails.Records[0].DrawNS != 2 || s.TotalUIWorkNS != s.InputNS+7+11+200+40 {
+			t.Fatalf("wrong detached/nested totals: %+v", s)
+		}
+		if overflow {
+			if s.Completed || s.Failure == "" || len(s.SourceDetails.Records) > 32 {
+				t.Fatal("qualified overflowing ticket")
+			}
+		} else {
+			if !s.Completed || s.Failure != "" || len(s.SourceDetails.Records) != 32 || s.SourceDetails.Records[20].Composition != 2 || s.SourceDetails.Records[20].Source != 0 {
+				t.Fatal("lost composition order")
+			}
+		}
+	}
+}
+
+func TestVellumSourceTimingTraceCancellationAndFailureSticky(t *testing.T) {
+	trace := NewFrameTraceWithSourceDetails()
+	e := traceScroll()
+	trace.Begin(1, e)
+	tag, start := trace.startEvent(e)
+	trace.ExpectOwner(tag)
+	trace.endEvent(tag, start)
+	trace.Transition(1, 1)
+	trace.OwnerWork(1, 1)
+	trace.Reconciled(1, 1)
+	trace.startFrame()
+	trace.Fail(1, "cancelled")
+	if _, ok := trace.Take(); ok {
+		t.Fatal("released live native claim")
+	}
+	trace.finishFrame(1, sourceTraceComposition(1))
+	s, ok := trace.Take()
+	if !ok || s.Completed || s.Failure != "cancelled" || len(s.SourceDetails.Records) != 0 {
+		t.Fatal("late result overwrote cancellation")
+	}
+	if err := trace.Begin(2, traceScroll()); err != nil {
+		t.Fatal(err)
+	}
+	trace.Retire(2, "retired")
+	s, ok = trace.Take()
+	if !ok || s.SourceDetails == nil || s.Tag != 2 {
+		t.Fatal("detailed retirement lost")
+	}
+}

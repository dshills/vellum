+type sourceCopyObservation struct {
+	Pos       image.Point
+	Bounds    image.Rectangle
+	Op        draw.Op
+	Unchanged bool
+}
+type sourcePixelsDrawer struct {
+	composer.DrawerBase
+	copies []sourceCopyObservation
+	ends   int
+}
+
+func (d *sourcePixelsDrawer) End()    { d.ends++ }
+func (d *sourcePixelsDrawer) Redraw() {}
+func (d *sourcePixelsDrawer) EndMeasured() composer.ComposeTiming {
+	d.End()
+	return composer.ComposeTiming{Supported: true, Submitted: true}
+}
+func (d *sourcePixelsDrawer) Copy(pos image.Point, img image.Image, bounds image.Rectangle, op draw.Op, unchanged bool) {
+	d.copies = append(d.copies, sourceCopyObservation{pos, bounds, op, unchanged})
+	draw.Draw(d.Image, image.Rectangle{Min: pos, Max: pos.Add(bounds.Size())}, img, bounds.Min, op)
+}
+
+func TestVellumSourceTimingRealPaintAndUniformPixels(t *testing.T) {
+	for _, kind := range []uint8{composer.SourceScene, composer.SourceSprites} {
+		makeScene := func() *Scene {
+			sc := &Scene{}
+			size := math32.Vec2(32, 24)
+			sc.Painter = *paint.NewPainter(size)
+			sc.Renderer = paint.NewSourceRenderer(size)
+			sc.Painter.FillBox(math32.Vec2(3, 4), math32.Vec2(10, 11), image.NewUniform(color.NRGBA{R: 200, G: 40, B: 70, A: 128}))
+			return sc
+		}
+		reference, candidate := makeScene(), makeScene()
+		if SceneSource(makeScene(), draw.Src).(*paintSource).kind != composer.SourceScene {
+			t.Fatal("scene kind not captured at gathering")
+		}
+		st := &Stage{}
+		st.Sprites.Add(&Sprite{Name: "kind", Active: true, Draw: func(*paint.Painter) {}})
+		sc := &Scene{}
+		sc.SceneGeom.Size = image.Pt(32, 24)
+		if SpritesSource(st, sc).(*paintSource).kind != composer.SourceSprites {
+			t.Fatal("sprite kind inferred incorrectly")
+		}
+		rd := &sourcePixelsDrawer{DrawerBase: composer.DrawerBase{Image: image.NewRGBA(image.Rect(0, 0, 40, 32))}}
+		cd := &sourcePixelsDrawer{DrawerBase: composer.DrawerBase{Image: image.NewRGBA(image.Rect(0, 0, 40, 32))}}
+		rc, cc := &composer.ComposerDrawer{Drawer: rd}, &composer.ComposerDrawer{Drawer: cd}
+		for _, changed := range []bool{true, false} {
+			ref := SceneSource(reference, draw.Over).(*paintSource)
+			ref.kind = kind
+			ref.drawPos = image.Pt(2, 1)
+			cand := SceneSource(candidate, draw.Over).(*paintSource)
+			cand.kind = kind
+			cand.drawPos = image.Pt(2, 1)
+			rc.Sources = []composer.Source{ref}
+			cc.Sources = []composer.Source{cand}
+			rc.ComposeMeasured()
+			result := cc.ComposeMeasuredWithSourceDetails()
+			r := result.SourceDetails.Records[0]
+			if !bytes.Equal(rd.Image.Pix, cd.Image.Pix) || !reflect.DeepEqual(rd.copies, cd.copies) || rd.ends != cd.ends {
+				t.Fatal("diagnostic changed actual paint/copy/pixels")
+			}
+			if result.Failure != "" || r.Kind != kind || !r.RasterAvailable || !r.CopyAvailable || r.ImageChanged != changed || r.ImageWidth != 32 || r.ImageHeight != 24 || r.ImageUploadTimingAvailable || r.RasterNS+r.CopyNS > r.DrawNS || !changed && r.RasterNS != 0 {

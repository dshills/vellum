+// Copyright (c) 2026, Davin Hills.
+// SPDX-License-Identifier: MIT
+
+package gpudraw
+
+import (
+	"cogentcore.org/core/system/composer"
+	"image"
+	"math"
+)
+
+// Begin/Read/End acquire separate drawer locks. Composition ownership must
+// serialize the complete draw batch; holding this lock across Draw deadlocks.
+func (dw *Drawer) BeginSourceImageTiming() bool {
+	dw.Lock()
+	defer dw.Unlock()
+	if dw.sourceImageTiming != nil {
+		return false
+	}
+	dw.sourceImageTiming = &composer.ImageTiming{}
+	return true
+}
+
+func (dw *Drawer) ReadSourceImageTiming() composer.ImageTiming {
+	dw.Lock()
+	defer dw.Unlock()
+	if dw.sourceImageTiming == nil {
+		return composer.ImageTiming{Invalid: true}
+	}
+	return *dw.sourceImageTiming
+}
+
+func (dw *Drawer) EndSourceImageTiming() {
+	dw.Lock()
+	defer dw.Unlock()
+	dw.sourceImageTiming = nil
+}
+
+func logicalRGBABytes(size image.Point) (uint64, bool) {
+	if size.X < 0 || size.Y < 0 {
+		return 0, false
+	}
+	w, h := uint64(size.X), uint64(size.Y)
+	if h != 0 && w > math.MaxUint64/4/h {
+		return 0, false
+	}
+	return w * h * 4, true
+}
+
+func addImageCacheHit(t *composer.ImageTiming) {
+	if t.ImageCacheHits == math.MaxUint64 {
+		t.Invalid = true
+		return
+	}
+	t.ImageCacheHits++
+}
+
+func addImageAttempt(t *composer.ImageTiming, size image.Point, duration int64) {
+	bytes, ok := logicalRGBABytes(size)
+	if !ok || duration < 0 || t.SetFromGoImageNS > math.MaxInt64-duration ||
+		t.SetFromGoImageAttempts == math.MaxUint64 || t.LogicalUploadRGBABytes > math.MaxUint64-bytes {
+		t.Invalid = true
+		return
+	}
+	t.SetFromGoImageNS += duration
+	t.SetFromGoImageAttempts++
+	t.LogicalUploadRGBABytes += bytes
+}

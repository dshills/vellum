+// Copyright (c) 2026, Davin Hills.
+// SPDX-License-Identifier: MIT
+
+package core
+
+import (
+	"cogentcore.org/core/system/composer"
+	"math"
+)
+
+// Copy scalar observations into ticket-owned storage. Prefix and final frames
+// share one cap; ordinal assignment is based on the claimed ticket, never a
+// currently active scene or an arm state observed at completion.
+func appendFrameSourceDetails(dst, src *composer.SourceDetails) string {
+	if dst == nil || src == nil || src.Compositions != 1 || len(src.Records) == 0 {
+		return "source diagnostic composition details unavailable"
+	}
+	if dst.Compositions == math.MaxUint32 {
+		return "source diagnostic composition ordinal overflow"
+	}
+	dst.Compositions++
+	if len(dst.Records)+len(src.Records) > composer.MaxSourceTimingRecords {
+		return "source diagnostic ticket record capacity exceeded"
+	}
+	for i, record := range src.Records {
+		if record.Composition != 1 || record.Source != uint32(i) || record.Kind > composer.SourceInsets {
+			return "source diagnostic composition order invalid"
+		}
+	}
+	// The public observations have uint64 counts. Refuse a ticket whose sums
+	// cannot be represented, even when each composition's counters fit.
+	var attempts, hits, bytes uint64
+	for _, records := range [][]composer.SourceTiming{dst.Records, src.Records} {
+		for _, record := range records {
+			if attempts > math.MaxUint64-record.SetFromGoImageAttempts || hits > math.MaxUint64-record.ImageCacheHits || bytes > math.MaxUint64-record.LogicalUploadRGBABytes {
+				return "source diagnostic ticket counter overflow"
+			}
+			attempts += record.SetFromGoImageAttempts
+			hits += record.ImageCacheHits
+			bytes += record.LogicalUploadRGBABytes
+		}
+	}
+	for _, record := range src.Records {
+		record.Composition = dst.Compositions
+		dst.Records = append(dst.Records, record)
+	}
+	return ""
+}

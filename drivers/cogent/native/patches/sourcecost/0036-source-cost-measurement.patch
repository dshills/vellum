+			if r.Kind != composer.SourceScrim+uint8(i) || !r.CopyAvailable || r.RasterAvailable || r.ImageUploadTimingAvailable || r.CopyNS > r.DrawNS {
+				t.Fatal("uniform availability/timing wrong")
+			}
+		}
+	}

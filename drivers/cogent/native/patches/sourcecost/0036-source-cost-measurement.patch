+// Copyright (c) 2026, Davin Hills.
+// SPDX-License-Identifier: MIT
+
+package gpudraw
+
+import (
+	"cogentcore.org/core/system/composer"
+	"image"
+	"math"
+	"testing"
+)
+
+func TestVellumSourceTimingActualCacheBranchAndLifecycle(t *testing.T) {
+	dw := &Drawer{}
+	dw.images.init()
+	img := image.NewRGBA(image.Rect(0, 0, 8, 9))
+	dw.images.use(img)
+	// A real existing/unchanged image returns before System access. A nil
+	// System makes accidental upload routing fail, instead of using a fake GPU.
+	dw.UseGoImage(img, true)
+	if dw.sourceImageTiming != nil {
+		t.Fatal("ordinary branch allocated timing")
+	}
+	if !dw.BeginSourceImageTiming() || dw.BeginSourceImageTiming() {
+		t.Fatal("nested measurement admitted")
+	}
+	dw.UseGoImage(img, true)
+	stats := dw.ReadSourceImageTiming()
+	if stats.Invalid || stats.ImageCacheHits != 1 || stats.SetFromGoImageAttempts != 0 || stats.LogicalUploadRGBABytes != 0 {
+		t.Fatalf("actual cache hit: %+v", stats)
+	}
+	stats.ImageCacheHits = 77
+	if dw.ReadSourceImageTiming().ImageCacheHits != 1 {
+		t.Fatal("snapshot aliases state")
+	}
+	dw.EndSourceImageTiming()
+	dw.EndSourceImageTiming()
+	if dw.sourceImageTiming != nil || !dw.ReadSourceImageTiming().Invalid || !dw.BeginSourceImageTiming() || dw.ReadSourceImageTiming().ImageCacheHits != 0 {
+		t.Fatal("stale measurement")
+	}
+	dw.EndSourceImageTiming()
+}
+
+func TestVellumSourceTimingCheckedFullImageBytes(t *testing.T) {
+	for _, v := range []struct {
+		size  image.Point
+		bytes uint64
+		valid bool
+	}{
+		{image.Pt(8, 9), 288, true}, {image.Pt(0, 9), 0, true}, {image.Pt(-1, 9), 0, false}, {image.Pt(math.MaxInt, 2), 0, false},
+	} {
+		b, ok := logicalRGBABytes(v.size)
+		if ok != v.valid || ok && b != v.bytes {
+			t.Fatalf("%v: %d %v", v.size, b, ok)
+		}
+	}
+	var stats composer.ImageTiming
+	addImageAttempt(&stats, image.Pt(8, 9), 11)
+	addImageAttempt(&stats, image.Pt(8, 9), 13)
+	if stats.Invalid || stats.SetFromGoImageNS != 24 || stats.SetFromGoImageAttempts != 2 || stats.LogicalUploadRGBABytes != 576 {
+		t.Fatal("wrong attempted input accounting")
+	}
+	stats.LogicalUploadRGBABytes = math.MaxUint64 - 1
+	addImageAttempt(&stats, image.Pt(1, 1), 1)
+	if !stats.Invalid {
+		t.Fatal("byte overflow accepted")
+	}
+	stats = composer.ImageTiming{ImageCacheHits: math.MaxUint64}
+	addImageCacheHit(&stats)
+	if !stats.Invalid {
+		t.Fatal("hit overflow accepted")
+	}
+	stats = composer.ImageTiming{SetFromGoImageNS: math.MaxInt64}
+	addImageAttempt(&stats, image.Pt(1, 1), 1)
+	if !stats.Invalid {
+		t.Fatal("time overflow accepted")
+	}
+}

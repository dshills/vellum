+// SetNativeFocusLostHandler lets a native adapter defer editDone until previously
+// admitted input has reached this field and the old native client is inactive.
+// The handler runs on the field's event/render context. Returning true stops the
+// cursor and defers the Change boundary; the adapter must eventually call
+// FinishNativeFocusLost on that context after native quiescence. It must not
+// reenter dispatch.
+// A nil handler retains the default immediate focus-loss behavior.
+func (tf *TextField) SetNativeFocusLostHandler(handler func() bool) *TextField {
+	tf.nativeFocusLost = handler
+	return tf
+}
+
+// FinishNativeFocusLost completes one deferred focus-loss Change boundary after
+// the outgoing native client is inactive and its admitted edits are applied.
+// If the field has regained focus, preserve its fresh directional selection and
+// caret and resume the cursor. Call on the field's event/render context.
+func (tf *TextField) FinishNativeFocusLost() string {
+	state := tf.EditingState()
+	focused := tf.StateIs(states.Focused)
+	tf.editDone()
+	if focused && tf.This != nil && tf.StateIs(states.Focused) && !tf.IsReadOnly() {
+		if string(tf.editText) == state.Text {
+			tf.SetEditingSelection(state.Anchor, state.Focus)
+		}
+		tf.startCursor()
+	}
+	return tf.text
+}
+
 // Text returns the current text of the text field. It applies any unapplied changes
 // first, and sends an [events.Change] event if applicable. This is the main end-user
 // method to get the current value of the text field.

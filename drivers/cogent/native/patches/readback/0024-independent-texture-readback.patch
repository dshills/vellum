+package gpu
+
+import (
+	"github.com/oliverbestmann/webgpu/wgpu"
+	"image"
+	"testing"
+)
+
+func TestVellumTextureCopyRejectsMissingNativeInputs(t *testing.T) {
+	for _, texture := range []*Texture{nil, {}} {
+		if texture.CopyToBuffer(nil, nil, 256) == nil {
+			t.Fatal("missing native inputs accepted")
+		}
+	}
+	// Fake borrowed handles must not reach native code when descriptor admission fails.
+	texture := &Texture{texture: &wgpu.Texture{}, Format: TextureFormat{Size: image.Pt(10, 10), Layers: 1, Samples: 4, Format: wgpu.TextureFormatRGBA8UnormSrgb}}
+	if texture.CopyToBuffer(&wgpu.CommandEncoder{}, &wgpu.Buffer{}, 256) == nil {
+		t.Fatal("multisampled copy accepted")
+	}
+	texture.Format.Samples = 1
+	texture.Format.Format = wgpu.TextureFormatRGBA16Float
+	if texture.CopyToBuffer(&wgpu.CommandEncoder{}, &wgpu.Buffer{}, 256) == nil {
+		t.Fatal("unsupported staging format accepted")
+	}
+}
+
+func TestVellumTextureCopyRejectsReleasedWrappers(t *testing.T) {
+	tex, encoder, buffer := &wgpu.Texture{}, &wgpu.CommandEncoder{}, &wgpu.Buffer{}
+	tex.Release()
+	encoder.Release()
+	buffer.Release()
+	texture := &Texture{texture: tex, Format: TextureFormat{Size: image.Pt(10, 10), Layers: 1, Samples: 1, Format: wgpu.TextureFormatRGBA8UnormSrgb}}
+	if err := texture.CopyToBuffer(encoder, buffer, 256); err == nil {
+		t.Fatal("released native handles accepted")
+	}
+}

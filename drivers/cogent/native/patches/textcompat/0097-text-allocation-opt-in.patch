+// Native labels inherit center/end paragraph alignment for many existing
+// controls. That must not opt them into a second block-to-allocation offset.
+func TestVellumDefaultTextKeepsLegacyOrigin(t *testing.T) {
+	for _, alignment := range []text.Aligns{text.Center, text.End} {
+		t.Run(alignment.String(), func(t *testing.T) {
+			var tx *Text
+			m, body, _ := manualFixture(t, func(b *Body) {
+				tx = NewText(b).SetText(`<a href="https://example.com">12345</a>`)
+				tx.Styler(func(s *styles.Style) {
+					s.Min.Set(units.Dp(240), units.Dp(40))
+					s.Max.Set(units.Dp(240), units.Dp(40))
+					s.Grow.Set(0, 0)
+					s.Text.Align = alignment
+				})
+			})
+			drainManual(t, m)
+			rc := body.Scene.renderContext()
+			rc.Lock()
+			defer rc.Unlock()
+			if spare := tx.Geom.Size.Actual.Content.X - tx.paintText.Bounds.Size().X; spare < 100 {
+				t.Fatal("missing oversized allocation", spare)
+			}
+			if got := tx.paintTextOrigin(); got != tx.Geom.Pos.Content {
+				t.Fatal("default text shifted", got, tx.Geom.Pos.Content)
+			}
+			for ri := 0; ri < 5; ri++ {
+				point := tx.paintText.RuneBounds(ri).Translate(tx.Geom.Pos.Content).Center().ToPoint()
+				if got := tx.pixelToRune(point); got != ri {
+					t.Fatal("legacy selection shifted", ri, got)
+				}
+				if link, hit := tx.findLink(point); link == nil || !point.In(hit) {
+					t.Fatal("legacy link shifted", ri, hit)
+				}
+			}
+		})
+	}
+}

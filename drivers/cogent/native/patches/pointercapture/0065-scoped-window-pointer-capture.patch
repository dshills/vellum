+func TestVellumPointerCaptureReleaseBeforeOrdinaryRouting(t *testing.T) {
+	var source, target *Button
+	var token uint64
+	var moves, ups, unrelated, clicks, loss, boundaries int
+	m, b, _ := manualFixture(t, func(b *Body) {
+		source = NewButton(b).SetText("Palette")
+		target = NewButton(b).SetText("Canvas")
+		target.On(events.MouseUp, func(events.Event) { unrelated++ })
+		target.OnClick(func(events.Event) { clicks++ })
+		source.OnClick(func(events.Event) { clicks++ })
+		source.OnFirst(events.MouseDown, func(e events.Event) {
+			var err error
+			token, err = b.Scene.Events.CapturePointer(source, e, func(e events.Event) {
+				if e.Type() == events.MouseDrag || e.Type() == events.MouseMove {
+					moves++
+				}
+				if e.Type() == events.MouseUp {
+					ups++
+				}
+			}, func() { loss++ })
+			if err != nil {
+				t.Fatal(err)
+			}
+			e.SetHandled()
+		})
+	})
+	if _, err := m.Frame(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	drainManual(t, m)
+	b.Scene.EventBoundary = func(events.Event) { boundaries++ }
+	inputManual(t, m, ManualInput{Type: events.MouseDown, Button: events.Left, Position: center(source)})
+	drainManual(t, m)
+	rc := b.Scene.renderContext()
+	capture := rc.pointerCapture
+	if token == 0 || !b.Scene.Events.PointerCaptured(token) || b.Scene.Events.press != nil || b.Scene.Events.slidePress != nil || b.Scene.Events.repeatClick != nil {
+		t.Fatal("default MouseDown tail rearmed capture", token)
+	}
+	inputManual(t, m, ManualInput{Type: events.MouseMove, Position: center(target)})
+	drainManual(t, m)
+	inputManual(t, m, ManualInput{Type: events.MouseUp, Button: events.Left, Position: center(target)})
+	drainManual(t, m)
+	if moves != 1 || ups != 1 || unrelated != 0 || clicks != 0 || loss != 0 || boundaries != 3 || rc.pointerCapture != nil || rc.pointerSwallowUp || capture.owner != nil || capture.scene != nil || capture.handle != nil || capture.lost != nil {
+		t.Fatal("capture release leaked or propagated", moves, ups, unrelated, clicks, loss, boundaries)
+	}
+}
+func TestVellumPointerCaptureCancellationSwallowsUpAcrossModal(t *testing.T) {
+	for _, variant := range []string{"escape", "explicit", "focus-loss", "owner-removed", "modal"} {
+		t.Run(variant, func(t *testing.T) {
+			var source, target *Button
+			token := uint64(0)
+			ups, loss, ordinary := 0, 0, 0
+			m, b, _ := manualFixture(t, func(b *Body) {
+				source = NewButton(b).SetText("Palette")
+				target = NewButton(b).SetText("Other")
+				target.On(events.MouseUp, func(events.Event) { ordinary++ })
+				target.OnClick(func(events.Event) { ordinary++ })
+				source.OnFirst(events.MouseDown, func(e events.Event) {
+					var err error
+					token, err = b.Scene.Events.CapturePointer(source, e, func(e events.Event) {
+						if e.Type() == events.MouseUp {
+							ups++
+						}
+					}, func() { loss++ })
+					if err != nil {
+						t.Fatal(err)
+					}
+					e.SetHandled()
+				})
+			})
+			if _, err := m.Frame(context.Background()); err != nil {
+				t.Fatal(err)
+			}
+			drainManual(t, m)
+			inputManual(t, m, ManualInput{Type: events.MouseDown, Button: events.Left, Position: center(source)})
+			drainManual(t, m)
+			rc := b.Scene.renderContext()
+			capture := rc.pointerCapture
+			var modal *Body
+			switch variant {
+			case "escape":
+				inputManual(t, m, ManualInput{Type: events.KeyChord, Code: key.CodeEscape})
+				drainManual(t, m)
+			case "explicit":
+				b.Scene.Events.CancelPointerCapture()
+			case "focus-loss":
+				rc.Lock()
+				b.Scene.RenderWindow().handleWindowEvents(events.NewWindow(events.WinFocusLost))
+				rc.Unlock()
+			case "owner-removed":
+				source.Delete()
+			case "modal":
+				modal = NewBody("blocking")
+				NewButton(modal).SetText("Modal").On(events.MouseUp, func(events.Event) { ordinary++ })
+				modal.NewDialog(b).Run()
+			}
+			pos := center(target)
+			if modal != nil {
+				if _, err := m.Frame(context.Background()); err != nil {
+					t.Fatal(err)
+				}
+				drainManual(t, m)
+				pos = modal.Scene.SceneGeom.Pos.Add(image.Pt(20, 20))
+			}
+			inputManual(t, m, ManualInput{Type: events.MouseUp, Button: events.Left, Position: pos})
+			drainManual(t, m)
+			if loss != 1 || ups != 0 || ordinary != 0 || rc.pointerCapture != nil || rc.pointerSwallowUp || b.Scene.Events.PointerCaptured(token) || capture.owner != nil || capture.handle != nil || capture.lost != nil {
+				t.Fatal("cancel missed release or retained capture", loss, ups, ordinary)
+			}
+		})
+	}
+}
+func TestVellumPointerCaptureStageRetirement(t *testing.T) {
+	var source *Button
+	loss := 0
+	m, b, _ := manualFixture(t, func(b *Body) {
+		source = NewButton(b).SetText("Palette")
+		source.OnFirst(events.MouseDown, func(e events.Event) {
+			if _, err := b.Scene.Events.CapturePointer(source, e, func(events.Event) {}, func() { loss++ }); err != nil {
+				t.Fatal(err)
+			}
+			e.SetHandled()
+		})
+	})
+	if _, err := m.Frame(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	drainManual(t, m)
+	inputManual(t, m, ManualInput{Type: events.MouseDown, Button: events.Left, Position: center(source)})
+	drainManual(t, m)
+	capture := b.Scene.renderContext().pointerCapture
+	if err := m.Close(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	if loss != 1 || capture.owner != nil || capture.handle != nil || capture.scene != nil || capture.lost != nil {
+		t.Fatal("native closure retained pointer capture", loss)
+	}
+}
+func TestVellumPointerCaptureTombstoneSuppressesWholeSecondarySequence(t *testing.T) {
+	var source, target *Button
+	ordinary := 0
+	m, b, _ := manualFixture(t, func(b *Body) {
+		source = NewButton(b).SetText("Palette")
+		target = NewButton(b).SetText("Other")
+		target.On(events.MouseDown, func(events.Event) { ordinary++ })
+		target.On(events.MouseUp, func(events.Event) { ordinary++ })
+		source.OnFirst(events.MouseDown, func(e events.Event) {
+			if _, err := b.Scene.Events.CapturePointer(source, e, func(events.Event) {}, nil); err != nil {
+				t.Fatal(err)
+			}
+			e.SetHandled()
+		})
+	})
+	if _, err := m.Frame(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	drainManual(t, m)
+	inputManual(t, m, ManualInput{Type: events.MouseDown, Button: events.Left, Position: center(source)})
+	drainManual(t, m)
+	b.Scene.Events.CancelPointerCapture()
+	for _, typ := range []events.Types{events.MouseDown, events.MouseUp} {
+		inputManual(t, m, ManualInput{Type: typ, Button: events.Right, Position: center(target)})
+		drainManual(t, m)
+	}
+	if ordinary != 0 || b.Scene.Events.press != nil || !b.Scene.renderContext().pointerSwallowUp {
+		t.Fatal("secondary sequence partially routed", ordinary)
+	}
+	inputManual(t, m, ManualInput{Type: events.MouseUp, Button: events.Left, Position: center(target)})
+	drainManual(t, m)
+	if ordinary != 0 || b.Scene.renderContext().pointerSwallowUp {
+		t.Fatal("pending primary release propagated", ordinary)
+	}
+}
+func TestVellumPointerCapturePreservesDialogLocalCoordinates(t *testing.T) {
+	m, b, _ := manualFixture(t, nil)
+	if _, err := m.Frame(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	drainManual(t, m)
+	dialog := NewBody("offset")
+	source := NewButton(dialog).SetText("Palette")
+	var positions [][2]image.Point
+	var boundaries [][2]image.Point
+	source.OnFirst(events.MouseDown, func(e events.Event) {
+		positions = append(positions, [2]image.Point{e.Pos(), e.WindowPos()})
+		if _, err := dialog.Scene.Events.CapturePointer(source, e, func(e events.Event) { positions = append(positions, [2]image.Point{e.Pos(), e.WindowPos()}) }, nil); err != nil {
+			t.Fatal(err)
+		}
+		e.SetHandled()
+	})
+	dialog.NewDialog(b).Run()
+	if _, err := m.Frame(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	drainManual(t, m)
+	origin := dialog.Scene.SceneGeom.Pos
+	if origin == (image.Point{}) {
+		t.Fatal("fixture has no dialog offset")
+	}
+	dialog.Scene.EventBoundary = func(e events.Event) {
+		if e.HasPos() {
+			boundaries = append(boundaries, [2]image.Point{e.Pos(), e.WindowPos()})
+		}
+	}
+	pos := center(source).Add(origin)
+	inputManual(t, m, ManualInput{Type: events.MouseDown, Button: events.Left, Position: pos})
+	drainManual(t, m)
+	inputManual(t, m, ManualInput{Type: events.MouseMove, Position: pos.Add(image.Pt(10, 10))})
+	drainManual(t, m)
+	inputManual(t, m, ManualInput{Type: events.MouseUp, Button: events.Left, Position: pos.Add(image.Pt(20, 20))})
+	drainManual(t, m)
+	if len(positions) != 3 || len(boundaries) != 3 {
+		t.Fatal("missing capture delivery", positions, boundaries)
+	}
+	for _, list := range [][][2]image.Point{positions, boundaries} {
+		for _, p := range list {
+			if p[1].Sub(p[0]) != origin {
+				t.Fatal("captured scene offset changed", origin, p)
+			}
+		}
+	}
+}

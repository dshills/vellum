+func TestVellumPointerRefusedOrReleasedDuringDownConsumesSequence(t *testing.T) {
+	for _, refusal := range []bool{false, true} {
+		t.Run(map[bool]string{false: "released", true: "refused"}[refusal], func(t *testing.T) {
+			var source, target *Button
+			ordinary := 0
+			m, b, _ := manualFixture(t, func(b *Body) {
+				source = NewButton(b).SetText("Palette")
+				target = NewButton(b).SetText("Other")
+				target.On(events.MouseUp, func(events.Event) { ordinary++ })
+				source.OnFirst(events.MouseDown, func(e events.Event) {
+					if refusal {
+						b.Scene.renderContext().pointerSerial = ^uint64(0)
+					}
+					token, err := b.Scene.Events.CapturePointer(source, e, func(events.Event) {}, nil)
+					if refusal {
+						if err == nil {
+							t.Fatal("exhausted capture admitted")
+						}
+						b.Scene.Events.ConsumePointerRelease()
+					} else {
+						if err != nil {
+							t.Fatal(err)
+						}
+						b.Scene.Events.ReleasePointer(token)
+					}
+					e.SetHandled()
+				})
+			})
+			if _, err := m.Frame(context.Background()); err != nil {
+				t.Fatal(err)
+			}
+			drainManual(t, m)
+			inputManual(t, m, ManualInput{Type: events.MouseDown, Button: events.Left, Position: center(source)})
+			drainManual(t, m)
+			if b.Scene.Events.press != nil || b.Scene.Events.slidePress != nil || !b.Scene.renderContext().pointerSwallowUp {
+				t.Fatal("refused Down rearmed ordinary state")
+			}
+			inputManual(t, m, ManualInput{Type: events.MouseUp, Button: events.Left, Position: center(target)})
+			drainManual(t, m)
+			if ordinary != 0 || b.Scene.renderContext().pointerSwallowUp {
+				t.Fatal("refused release propagated", ordinary)
+			}
+		})
+	}
+}

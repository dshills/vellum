+// Copyright (c) 2026 Vellum contributors.
+// SPDX-License-Identifier: MIT
+package core
+
+import (
+	"errors"
+	"math"
+
+	"cogentcore.org/core/events"
+	"cogentcore.org/core/events/key"
+	"cogentcore.org/core/styles/states"
+	"cogentcore.org/core/tree"
+)
+
+var ErrPointerCapture = errors.New("core: invalid, busy or exhausted pointer capture")
+
+type pointerCapture struct {
+	scene  *Scene
+	owner  Widget
+	token  uint64
+	handle func(events.Event)
+	lost   func()
+}
+
+// CapturePointer borrows one primary-mouse sequence in this native window.
+// Call from the owner's MouseDown handler under originating render ownership.
+// Captured move/drag/up and keys precede all normal stage/popup routing. Escape,
+// focus loss, hidden/removed owners and stage retirement notify lost once after
+// revocation. ReleasePointer ends capture without a loss notification. Native
+// handlers must arrange application-owner execution for application callbacks.
+func (em *Events) CapturePointer(owner Widget, start events.Event, handle func(events.Event), lost func()) (uint64, error) {
+	if em == nil || em.scene == nil || tree.IsNil(owner) || owner.AsWidget().Scene != em.scene || !owner.AsWidget().IsDisplayable() || owner.AsWidget().StateIs(states.Disabled) || start == nil || start.Type() != events.MouseDown || start.MouseButton() != events.Left || handle == nil {
+		return 0, ErrPointerCapture
+	}
+	rc := em.scene.renderContext()
+	if rc == nil || rc.pointerCapture != nil || rc.pointerRouting || rc.pointerSwallowUp || rc.pointerSerial == math.MaxUint64 {
+		return 0, ErrPointerCapture
+	}
+	rc.pointerSerial++
+	em.resetOnMouseDown()
+	rc.pointerCapture = &pointerCapture{scene: em.scene, owner: owner, token: rc.pointerSerial, handle: handle, lost: lost}
+	return rc.pointerSerial, nil
+}
+func (em *Events) PointerCaptured(token uint64) bool {
+	if em == nil || em.scene == nil || token == 0 {
+		return false
+	}
+	rc := em.scene.renderContext()
+	return rc != nil && rc.pointerCapture != nil && rc.pointerCapture.scene == em.scene && rc.pointerCapture.token == token
+}
+
+// ReleasePointer revokes a matching token before clearing native press state.
+// Its pending primary release remains consumed even if a different stage opens.
+func (em *Events) ReleasePointer(token uint64) bool {
+	if !em.PointerCaptured(token) {
+		return false
+	}
+	em.scene.renderContext().detachPointer(false)
+	return true
+}
+
+// ConsumePointerRelease suppresses the rest of a refused primary sequence.
+// Call under originating render ownership from its MouseDown handler. It never
+// steals a different active capture and retains no widget or callback.
+func (em *Events) ConsumePointerRelease() {
+	if em == nil || em.scene == nil {
+		return
+	}
+	rc := em.scene.renderContext()
+	if rc != nil && rc.pointerCapture == nil {
+		em.resetOnMouseDown()
+		rc.pointerSwallowUp = true
+	}
+}
+
+func (em *Events) CancelPointerCapture() {
+	if em == nil || em.scene == nil {
+		return
+	}
+	rc := em.scene.renderContext()
+	if rc != nil && rc.pointerCapture != nil && rc.pointerCapture.scene == em.scene {
+		rc.detachPointer(true)
+	}
+}
+func (rc *renderContext) detachPointer(notify bool) {
+	capture := rc.pointerCapture
+	if capture == nil {
+		return
+	}
+	rc.pointerCapture = nil
+	rc.pointerSwallowUp = true
+	capture.scene.Events.resetOnMouseDown()
+	if notify && capture.lost != nil {
+		capture.lost()
+	}
+	capture.scene = nil
+	capture.owner = nil
+	capture.handle = nil
+	capture.lost = nil
+}
+func (p *pointerCapture) eligible() bool {
+	if p.scene == nil || tree.IsNil(p.owner) || p.owner.AsWidget().Scene != p.scene || !p.owner.AsWidget().IsDisplayable() || p.owner.AsWidget().StateIs(states.Disabled) {
+		return false
+	}
+	st := p.scene.Stage
+	if st == nil || st.Mains == nil {
+		return false
+	}
+	if st.Type.isMain() {
+		return st.Mains.top() == st && (st.popups == nil || st.popups.top() == nil)
+	}
+	return st.Main != nil && st.Mains.top() == st.Main && st.Main.popups != nil && st.Main.popups.top() == st
+}
+
+// routeCapturedPointer is invoked by renderWindow before main/popup dispatch.
+// A canceled sequence retains only a boolean tombstone, no scene/widget refs.
+func (rc *renderContext) routeCapturedPointer(e events.Event) bool {
+	typ := e.Type()
+	if rc.pointerCapture == nil {
+		if rc.pointerSwallowUp {
+			if typ == events.MouseDown && e.MouseButton() == events.Left {
+				rc.pointerSwallowUp = false
+				return false
+			}
+			if typ == events.MouseDown {
+				e.SetHandled()
+				return true
+			}
+			if typ == events.MouseUp {
+				if e.MouseButton() == events.Left {
+					rc.pointerSwallowUp = false
+				}
+				e.SetHandled()
+				return true
+			}
+		}
+		return false
+	}
+	switch typ {
+	case events.MouseMove, events.MouseDrag, events.MouseUp, events.MouseDown, events.Scroll, events.KeyDown, events.KeyUp, events.KeyChord:
+	default:
+		return false
+	}
+	capture := rc.pointerCapture
+	scene := capture.scene
+	e.SetLocalOff(scene.SceneGeom.Pos)
+	rc.pointerRouting = true
+	defer func() { rc.pointerRouting = false }()
+	e.SetHandled()
+	defer func() {
+		if boundary := scene.EventBoundary; boundary != nil {
+			boundary(e)
+		}
+	}()
+	if !capture.eligible() || typ == events.MouseDown || typ == events.KeyChord && e.KeyCode() == key.CodeEscape {
+		rc.detachPointer(true)
+		if typ == events.MouseUp && e.MouseButton() == events.Left {
+			rc.pointerSwallowUp = false
+		}
+		return true
+	}
+	// Detach before terminal delivery, making recursive/duplicate release inert.
+	handle := capture.handle
+	if typ == events.MouseUp && e.MouseButton() == events.Left {
+		rc.detachPointer(false)
+		rc.pointerSwallowUp = false
+	}
+	handle(e)
+	return true
+}

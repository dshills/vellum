+func TestVellumOutlineCacheRendererCapturesResizeAndRelease(t *testing.T) {
+	rs := New(math32.Vec2(240, 80)).(*Renderer)
+	txt := vellumSceneText(t)
+	commands := render.Render{txt}
+	packet := rs.ScenePacket(commands)
+	if packet == nil || rs.outlineCache == nil || len(rs.outlineCache.entries) == 0 {
+		t.Fatal("scene capture did not populate parent cache")
+	}
+	cache := rs.outlineCache
+	if rs.scrollPlan(commands) == nil || rs.outlineCache != cache {
+		t.Fatal("scroll capture changed cache owner")
+	}
+	rs.Render(commands)
+	before := bytes.Clone(rs.image.Pix)
+	warm := rs.ScenePacket(commands)
+	dst := image.NewRGBA(rs.image.Bounds())
+	if warm == nil || !warm.Replay(dst) || !bytes.Equal(dst.Pix, before) {
+		t.Fatal("warm packet/ordinary exact pixels differ")
+	}
+	rs.SetSize(units.UnitDot, math32.Vec2(260, 90))
+	if rs.outlineCache != cache {
+		t.Fatal("size change lost size-independent cache")
+	}
+	rs.Render(commands)
+	imageBefore := bytes.Clone(rs.image.Pix)
+	rs.Release()
+	rs.Release()
+	if rs.outlineCache != nil || !bytes.Equal(rs.image.Pix, imageBefore) {
+		t.Fatal("retirement retained font cache or dropped snapshot pixels")
+	}
+	rs.Render(commands)
+	if rs.outlineCache == nil || rs.outlineCache == cache {
+		t.Fatal("reused renderer did not create fresh cache")
+	}
+	other := New(math32.Vec2(240, 80)).(*Renderer)
+	other.Render(commands)
+	if other.outlineCache == rs.outlineCache {
+		t.Fatal("separate renderers shared cache ownership")
+	}
+}

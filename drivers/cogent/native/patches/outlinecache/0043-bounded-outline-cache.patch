+func TestVellumOutlineCacheAggregateColdWarmAdmission(t *testing.T) {
+	face := vellumOutlineFace(t)
+	for _, letter := range " AéÅ" {
+		gid, _ := face.NominalGlyph(letter)
+		cache := &staticOutlineCache{}
+		if _, ok := cache.ordinary(face, gid); !ok {
+			t.Fatal("warm fixture refused")
+		}
+		for _, limit := range []int{1, 10, 50, 100, 1000, 10000} {
+			coldBudget := font.NewGlyphOutlineBudget(limit, limit)
+			warmBudget := font.NewGlyphOutlineBudget(limit, limit)
+			for n := 0; n < 32; n++ {
+				want, coldOK := face.GlyphDataOutlineBounded(gid, coldBudget)
+				got, warmOK := cache.bounded(face, gid, warmBudget)
+				if coldOK != warmOK || !reflect.DeepEqual(want, got) {
+					t.Fatal("warmth changed aggregate admission", letter, limit, n)
+				}
+			}
+		}
+		if _, ok := cache.bounded(face, gid, nil); ok {
+			t.Fatal("nil shared budget admitted warm outline")
+		}
+	}
+}
+
+func TestVellumOutlineCacheEvictionAndRefusedRetrieval(t *testing.T) {
+	cache := &staticOutlineCache{}
+	face := vellumOutlineFace(t)
+	accepted := 0
+	for gid := font.GID(0); gid < 4096; gid++ {
+		if _, ok := cache.ordinary(face, gid); ok {
+			accepted++
+			vellumOutlineBounds(t, cache)
+		}
+	}
+	if accepted <= outlineCacheEntries || len(cache.entries) >= accepted {
+		t.Fatal("fixture did not exercise bounded eviction", accepted)
+	}
+	for n := 0; n < outlineCacheFonts+2; n++ {
+		face = vellumOutlineFace(t)
+		gid, _ := face.NominalGlyph('A')
+		if _, ok := cache.ordinary(face, gid); !ok {
+			t.Fatal("new font refused")
+		}
+		vellumOutlineBounds(t, cache)
+	}
+	entries, weight := len(cache.entries), cache.bytes
+	if _, ok := cache.bounded(face, font.EmptyGlyph, font.NewGlyphOutlineBudget(100, 100)); ok || len(cache.entries) != entries || cache.bytes != weight {
+		t.Fatal("failed retrieval retained an entry")
+	}
+}

+func TestVellumOutlineCachePayloadCapacityAndLargeRetentionRefusal(t *testing.T) {
+	face := vellumOutlineFace(t)
+	_, cost, ok := face.GlyphDataOutlineBoundedCost(0, font.NewGlyphOutlineBudget(1<<20, 1<<20))
+	if !ok {
+		t.Fatal("cost fixture refused")
+	}
+	cache := &staticOutlineCache{}
+	// Exercise retention independently of parser layout. The slice has a small
+	// length but a large backing capacity, which must be fully charged. These
+	// storage fixtures are never used as glyph geometry or admitted by rendering.
+	capacity := outlineCacheGlyph / outlineSegmentBytes
+	for i := 0; i < 80; i++ {
+		cache.retain(outlineKey{face.Font, font.GID(i)}, font.GlyphOutline{Segments: make([]font.Segment, 1, capacity)}, cost)
+		vellumOutlineBounds(t, cache)
+	}
+	if cache.bytes < outlineCacheBytes-outlineCacheGlyph || len(cache.entries) >= 80 {
+		t.Fatal("byte-capacity fixture did not evict before retaining")
+	}
+	entries, weight := len(cache.entries), cache.bytes
+	cache.retain(outlineKey{face.Font, font.GID(100)}, font.GlyphOutline{Segments: make([]font.Segment, 1, capacity+1)}, cost)
+	if len(cache.entries) != entries || cache.bytes != weight {
+		t.Fatal("oversized backing capacity was retained")
+	}
+}

+func TestVellumOutlineCacheOriginalRasterPixelsAcrossTransforms(t *testing.T) {
+	prior := UseGlyphCache
+	UseGlyphCache = false
+	defer func() { UseGlyphCache = prior }()
+	for _, size := range []float32{12, 24, 48, 96} {
+		for _, matrix := range []math32.Matrix2{math32.Identity2(), math32.Translate2D(2, 1).Scale(.9, .9)} {
+			for _, stroke := range []image.Image{nil, colors.Uniform(color.NRGBA{90, 40, 100, 180})} {
+				txt := vellumSceneText(t)
+				run := txt.Text.Lines[0].Runs[0].(*shapedgt.Run)
+				run.Size = math32.ToFixed(size)
+				glyph := &run.Glyphs[0]
+				want, ok := run.Face.GlyphDataOutline(glyph.GlyphID)
+				cache := &staticOutlineCache{}
+				_, _ = cache.ordinary(run.Face, glyph.GlyphID)
+				got, cached := cache.ordinary(run.Face, glyph.GlyphID)
+				if !ok || !cached {
+					t.Fatal("real glyph refused")
+				}
+				txt.Context.Cumulative = matrix
+				a, b := New(math32.Vec2(240, 180)).(*Renderer), New(math32.Vec2(240, 180)).(*Renderer)
+				pos := math32.Vec2(20.25, 130.5)
+				box := run.GlyphBoundsBox(glyph).Translate(pos)
+				fill := colors.Uniform(color.NRGBA{30, 90, 60, 210})
+				a.GlyphOutline(&txt.Context, run, glyph, want, fill, stroke, box, pos, matrix == math32.Identity2())
+				b.GlyphOutline(&txt.Context, run, glyph, got, fill, stroke, box, pos, matrix == math32.Identity2())
+				if !bytes.Equal(a.image.Pix, b.image.Pix) || vellumOwnedNonzero(a.image.Pix) == 0 {
+					t.Fatal("original/cached raster pixels differ", size, matrix, stroke)
+				}
+			}
+		}
+	}
+}

+func vellumOutlineFace(t testing.TB) *font.Face {
+	t.Helper()
+	file, err := os.Open("../../../../typesetting/font/testdata/UbuntuMono-R.ttf")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer file.Close()
+	face, err := font.ParseTTF(file)
+	if err != nil || !face.SupportsBoundedOutlines() {
+		t.Fatal("static fixture", err)
+	}
+	return face
+}
+
+func vellumOutlineBounds(t *testing.T, cache *staticOutlineCache) {
+	t.Helper()
+	if cache.bytes < 0 || cache.bytes > outlineCacheBytes || len(cache.entries) > outlineCacheEntries || len(cache.fonts) > outlineCacheFonts || cache.lru.Len() != len(cache.entries) {
+		t.Fatal("cache exceeded retained bounds")
+	}
+	weight := 0
+	fonts := map[*font.Font]int{}
+	for key, element := range cache.entries {
+		entry := element.Value.(outlineEntry)
+		if entry.key != key || entry.bytes != cap(entry.outline.Segments)*outlineSegmentBytes || entry.bytes > outlineCacheGlyph {
+			t.Fatal("capacity accounting differs")
+		}
+		weight += entry.bytes
+		fonts[key.font]++
+	}
+	if weight != cache.bytes || !reflect.DeepEqual(fonts, cache.fonts) {
+		t.Fatal("retained byte/font accounting differs")
+	}
+}
+
+func TestVellumOutlineCacheGeometryPublicOwnershipAndFontIdentity(t *testing.T) {
+	face := vellumOutlineFace(t)
+	cache := &staticOutlineCache{}
+	for _, letter := range " AgéÅfj" {
+		gid, _ := face.NominalGlyph(letter)
+		want, ok := face.GlyphDataOutline(gid)
+		cold, coldOK := cache.ordinary(face, gid)
+		warm, warmOK := cache.ordinary(face, gid)
+		if !ok || !coldOK || !warmOK || !reflect.DeepEqual(want, cold) || !reflect.DeepEqual(want, warm) {
+			t.Fatal("cold/warm simple/composite/empty geometry differs", letter)
+		}
+		if len(want.Segments) > 0 {
+			if &want.Segments[0] == &cold.Segments[0] || &cold.Segments[0] != &warm.Segments[0] {
+				t.Fatal("public ownership or private reuse violated")
+			}
+			want.Sideways(37)
+			after, _ := cache.ordinary(face, gid)
+			fresh, _ := face.GlyphDataOutline(gid)
+			if !reflect.DeepEqual(after, fresh) {
+				t.Fatal("public mutation reached cache")
+			}
+		}
+	}
+	gid, _ := face.NominalGlyph('A')
+	a, _ := cache.ordinary(face, gid)
+	otherFace := font.NewFace(face.Font)
+	otherFace.SetPpem(120, 240)
+	b, _ := cache.ordinary(otherFace, gid)
+	if &a.Segments[0] != &b.Segments[0] {
+		t.Fatal("same immutable Font did not reuse font-unit outline")
+	}
+	replacement := vellumOutlineFace(t)
+	otherFace.Font = replacement.Font
+	c, _ := cache.ordinary(otherFace, gid)
+	if &a.Segments[0] == &c.Segments[0] || len(cache.fonts) != 2 {
+		t.Fatal("replacement Font shared old identity")
+	}
+	vellumOutlineBounds(t, cache)
+}

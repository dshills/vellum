+// Original limits apply before compaction. Every fixture below is sealed by the
+// public Builder; no private operation mutation manufactures its size.
+func TestVellumTileBinningNearReferenceLimit(t *testing.T) {
+	bounds := image.Rect(0, 0, 8192, 2048)
+	columns, rows := bounds.Dx()/TileSize, bounds.Dy()/TileSize
+	perFull := columns * rows
+	for _, count := range []int{MaxTileReferences - 1, MaxTileReferences, MaxTileReferences + 1} {
+		b := New(bounds)
+		for i := 0; i < count/perFull; i++ {
+			b.Draw(bounds, image.White, image.Point{}, nil, image.Point{}, draw.Op(1-i%2))
+		}
+		remainder := count % perFull
+		fullRows, tail := remainder/columns, remainder%columns
+		if fullRows > 0 {
+			b.Draw(image.Rect(0, 0, bounds.Dx(), fullRows*TileSize), image.White, image.Point{}, nil, image.Point{}, draw.Src)
+		}
+		if tail > 0 {
+			b.Draw(image.Rect(0, fullRows*TileSize, tail*TileSize, (fullRows+1)*TileSize), image.White, image.Point{}, nil, image.Point{}, draw.Src)
+		}
+		p := b.Seal(false)
+		if p == nil {
+			t.Fatal("near-reference fixture refused by builder", count)
+		}
+		for _, compact := range []bool{false, true} {
+			got, ok := p.encode(compact)
+			want, accepted := p.originalBinningEncode(compact)
+			if ok != (count <= MaxTileReferences) || ok != accepted || !reflect.DeepEqual(got, want) {
+				t.Fatal("original near-reference boundary changed", count, compact)
+			}
+			if ok && !compact && len(got.Refs)/4 != count {
+				t.Fatal("fixture reference count differs", count)
+			}
+		}
+	}
+}

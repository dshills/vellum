+func TestVellumTileBinningExactEncodedByteLimit(t *testing.T) {
+	bounds := image.Rect(0, 0, 8192, 2048)
+	tileCount := (bounds.Dx() / TileSize) * (bounds.Dy() / TileSize)
+	// Encoded lengths are four-byte aligned. +4 is the first reachable refusal;
+	// a literal MaxBytes+1 cannot be represented by any accepted packet encoding.
+	for _, delta := range []int{-4, 0, 4} {
+		target := MaxBytes + delta
+		dataBytes := target - tileCount*8 - 2*opWords*4 - 2*4
+		bulk := dataBytes / MaxDimension * MaxDimension
+		rest := dataBytes - bulk
+		if rest <= 0 || rest > MaxDimension {
+			t.Fatal("bad byte-boundary fixture arithmetic")
+		}
+		masks := []*image.Alpha{image.NewAlpha(image.Rect(0, 0, MaxDimension, bulk/MaxDimension)), image.NewAlpha(image.Rect(0, 0, rest, 1))}
+		b := New(bounds)
+		for _, mask := range masks {
+			b.Draw(image.Rect(0, 0, 1, 1), image.White, image.Point{}, mask, image.Point{}, draw.Src)
+		}
+		p := b.Seal(false)
+		if p == nil || p.Bytes() > MaxBytes {
+			t.Fatal("encoded-byte fixture refused by builder", delta)
+		}
+		for _, compact := range []bool{false, true} {
+			got, ok := p.encode(compact)
+			want, accepted := p.originalBinningEncode(compact)
+			if ok != (delta <= 0) || ok != accepted || !reflect.DeepEqual(got, want) {
+				t.Fatal("exact encoded-byte boundary changed", delta, compact)
+			}
+			if ok && len(got.Ops)+len(got.Rows)+len(got.Refs)+len(got.Data) != target {
+				t.Fatal("encoded fixture total differs", delta)
+			}
+		}
+	}

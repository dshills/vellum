+func TestVellumTileBinningOriginalLimitsAndBranchEdges(t *testing.T) {
+	for _, n := range []int{1, 2, 3, 8, 9, MaxOps} {
+		bounds := image.Rect(0, 0, 32, 32)
+		if n == MaxOps {
+			bounds = image.Rect(0, 0, 1, 1)
+		}
+		b := New(bounds)
+		for i := 0; i < n; i++ {
+			b.Draw(bounds, image.White, image.Point{}, nil, image.Point{}, draw.Src)
+		}
+		p := b.Seal(false)
+		if p == nil {
+			t.Fatal("branch fixture refused", n)
+		}
+		for _, compact := range []bool{false, true} {
+			a, ok := p.encode(compact)
+			z, accepted := p.originalBinningEncode(compact)
+			if !ok || !accepted || !reflect.DeepEqual(a, z) {
+				t.Fatal("branch edge/high per-tile count changed", n, compact)
+			}
+		}
+	}
+	for _, n := range []int{32, 33} {
+		bounds := image.Rect(0, 0, 8192, 2048)
+		b := New(bounds)
+		for i := 0; i < n; i++ {
+			b.Draw(bounds, image.White, image.Point{}, nil, image.Point{}, draw.Op(1-i%2))
+		}
+		p := b.Seal(false)
+		if p == nil {
+			t.Fatal("reference-limit fixture refused")
+		}
+		for _, compact := range []bool{false, true} {
+			a, ok := p.encode(compact)
+			z, accepted := p.originalBinningEncode(compact)
+			if ok != (n == 32) || ok != accepted || !reflect.DeepEqual(a, z) {
+				t.Fatal("original reference limit changed", n, compact)
+			}
+		}
+	}
+}

+func TestVellumManualRequestFrameUnsupportedWindowRefuses(t *testing.T) {
+	m, _, _ := manualFixture(t, nil)
+	drainManual(t, m)
+	before, err := m.Snapshot(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	original := m.window.SystemWindow
+	m.window.SystemWindow = &noPaintManualWindow{Window: original}
+	defer func() { m.window.SystemWindow = original }()
+	if err := m.RequestFrame(context.Background()); !errors.Is(err, ErrManualUnsupported) {
+		t.Fatal("unsupported RequestFrame did not refuse", err)
+	}
+	if step, err := m.Frame(context.Background()); !errors.Is(err, ErrManualUnsupported) || step.Events != 0 || step.Frames != 0 {
+		t.Fatal("unsupported Frame dispatched work", step, err)
+	}
+	after, err := m.Snapshot(context.Background())
+	if err != nil || !reflect.DeepEqual(before, after) {
+		t.Fatal("unsupported frame admission mutated controller", before, after, err)
+	}
+}

+// Embedding the public Window interface hides the implementation-only
+// RequestPaint method while preserving the manual inspection/flush contract.
+type noPaintManualWindow struct{ system.Window }
+
+func (w *noPaintManualWindow) ManualExecution() bool {
+	return w.Window.(manualSystemWindow).ManualExecution()
+}
+func (w *noPaintManualWindow) ManualState() system.ManualWindowState {
+	return w.Window.(manualSystemWindow).ManualState()
+}
+func (w *noPaintManualWindow) FlushReadyPaint() bool {
+	return w.Window.(manualSystemWindow).FlushReadyPaint()
+}

+package textcore
+
+import (
+	"errors"
+	"strings"
+	"testing"
+	"time"
+
+	"cogentcore.org/core/text/lines"
+)
+
+type outputAdmissionReader struct{ reads int }
+
+func (r *outputAdmissionReader) Read([]byte) (int, error) {
+	r.reads++
+	return 0, errors.New("reader must not start")
+}
+
+func TestVellumOutputBufferNilLinesFailsBeforeRead(t *testing.T) {
+	reader := &outputAdmissionReader{}
+	buffer := &OutputBuffer{Output: reader}
+	var failure any
+	func() {
+		defer func() { failure = recover() }()
+		buffer.MonitorOutput()
+	}()
+	if failure != "textcore: OutputBuffer.MonitorOutput requires nonnil Lines" {
+		t.Fatal("invalid buffer was silently accepted", failure)
+	}
+	if reader.reads != 0 || buffer.afterTimer != nil || len(buffer.bufferedLines) != 0 || buffer.Batch != 0 {
+		t.Fatal("invalid monitoring allocated or consumed work", reader.reads)
+	}
+}
+
+func TestVellumOutputBufferManualRefusalStillChecked(t *testing.T) {
+	ls := lines.NewLinesExact()
+	defer ls.Close()
+	view := ls.NewView(80)
+	var failure error
+	execution := &lines.ManualExecution{
+		Now:       func() time.Time { return time.Unix(1700000000, 0) },
+		AfterFunc: func(time.Duration, func()) (lines.Timer, error) { return nil, errors.New("unexpected timer") },
+		Failure:   func(err error) { failure = err },
+	}
+	if err := ls.BindManualExecution(view, execution); err != nil {
+		t.Fatal(err)
+	}
+	reader := &outputAdmissionReader{}
+	buffer := &OutputBuffer{Lines: ls, Output: reader}
+	buffer.MonitorOutput()
+	if !errors.Is(failure, lines.ErrManualAmbient) || reader.reads != 0 || buffer.afterTimer != nil || len(buffer.bufferedLines) != 0 || buffer.Batch != 0 {
+		t.Fatal("manual ambient refusal changed", failure, reader.reads)
+	}
+}
+
+func TestVellumOutputBufferDefaultMonitoringStillWrites(t *testing.T) {
+	ls := lines.NewLinesExact()
+	defer ls.Close()
+	buffer := &OutputBuffer{Lines: ls, Output: strings.NewReader("one\ntwo\n"), Batch: time.Hour}
+	buffer.MonitorOutput()
+	if text := ls.String(); text != "one\ntwo\n" {
+		t.Fatal("default output was lost", text)
+	}
+	if buffer.afterTimer != nil || len(buffer.bufferedLines) != 0 {
+		t.Fatal("EOF retained worker timer or batch")
+	}
+}

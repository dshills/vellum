+func TestVellumDefaultRepeatClickOwnership(t *testing.T) {
+	for _, mode := range []string{"normal", "panic", "goexit"} {
+		t.Run(mode, func(t *testing.T) {
+			var button *Button
+			m, body, _ := manualFixture(t, func(b *Body) { button = NewButton(b).SetText("repeat") })
+			drainManual(t, m)
+			scene, rc := body.Scene, body.Scene.renderContext()
+			// The same production callback is exercised with default ownership.
+			// No real-time timer or background render/event loop is constructed.
+			rc.manual = nil
+			defer func() { rc.manual = m }()
+			em := &scene.Events
+			em.repeatClick = button
+			var clicks int
+			var updating, locked bool
+			button.OnClick(func(events.Event) {
+				clicks++
+				updating = scene.hasFlag(sceneUpdating)
+				locked = !rc.TryLock()
+				if !locked {
+					rc.Unlock()
+				}
+				em.cancelRepeatClick()
+				switch mode {
+				case "panic":
+					panic("expected repeat callback panic")
+				case "goexit":
+					runtime.Goexit()
+				}
+			})
+			done := make(chan struct{})
+			var panicValue any
+			go func() {
+				defer close(done)
+				defer func() { panicValue = recover() }()
+				em.repeatClickTimed(scene, rc, button)
+			}()
+			select {
+			case <-done:
+			case <-time.After(5 * time.Second):
+				t.Fatal("repeat ownership remained locked")
+			}
+			if clicks != 1 || !updating || !locked || scene.hasFlag(sceneUpdating) {
+				t.Fatal("default callout ownership changed", clicks, updating, locked, scene.hasFlag(sceneUpdating))
+			}
+			if !rc.TryLock() {
+				t.Fatal("default context not released after callout")
+			}
+			rc.Unlock()
+			if mode == "panic" && panicValue != "expected repeat callback panic" {
+				t.Fatal("panic was lost", panicValue)
+			}
+			if em.repeatClickTimer != nil {
+				t.Fatal("canceled repeat rearmed a wall timer")
+			}
+		})
+	}
+}
+
+func TestVellumDefaultRepeatClickRevalidatesCapturedWidget(t *testing.T) {
+	for _, mode := range []string{"deleted", "replaced", "moved"} {
+		t.Run(mode, func(t *testing.T) {
+			var old, replacement *Button
+			m, body, _ := manualFixture(t, func(b *Body) {
+				old = NewButton(b).SetText("old")
+				replacement = NewButton(b).SetText("new")
+			})
+			drainManual(t, m)
+			scene, rc := body.Scene, body.Scene.renderContext()
+			rc.manual = nil
+			defer func() { rc.manual = m }()
+			em := &scene.Events
+			em.repeatClick = old
+			clicks := 0
+			old.OnClick(func(events.Event) { clicks++; em.cancelRepeatClick() })
+			done := make(chan struct{})
+			rc.Lock()
+			go func() { defer close(done); em.repeatClickTimed(scene, rc, old) }()
+			// Mutation completes under the same context before a previously
+			// admitted callback can take ownership. No callback reads em/widget
+			// state outside that context.
+			switch mode {
+			case "deleted":
+				old.Delete()
+			case "moved":
+				old.SetScene(NewScene("other-owner"))
+			case "replaced":
+				em.repeatClick = replacement
+			}
+			rc.Unlock()
+			select {
+			case <-done:
+			case <-time.After(5 * time.Second):
+				t.Fatal("retired repeat callback blocked")
+			}
+			if mode == "moved" {
+				old.SetScene(scene)
+			}
+			if clicks != 0 || em.repeatClickTimer != nil || scene.hasFlag(sceneUpdating) {
+				t.Fatal("stale repeat target dispatched/rearmed", clicks, em.repeatClickTimer)
+			}
+		})
+	}
+}

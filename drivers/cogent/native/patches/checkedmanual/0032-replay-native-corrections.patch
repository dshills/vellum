+// repeatClickTimed uses the ownership captured at admission. Default timers
+// acquire that context before reading widget state; manual timers already run
+// under the originating event owner. Retired or replaced widgets cannot inherit
+// an earlier timer, and default callouts retain AsyncLock's updating flag.
+func (em *Events) repeatClickTimed(scene *Scene, rc *renderContext, widget Widget) {
+	if rc.manual == nil {
+		rc.Lock()
+		defer rc.Unlock()
+	}
+	if em.scene != scene || scene.This == nil || scene.renderContext() != rc || em.repeatClick != widget || tree.IsNil(widget) || widget.AsWidget().Scene != scene || !widget.AsWidget().IsVisible() {
+		return
+	}
+	if rc.manual == nil {
+		scene.setFlag(true, sceneUpdating)
+		defer scene.setFlag(false, sceneUpdating)
+	}
+	widget.AsWidget().Send(events.Click)
+	// A Click callback may close this scene. Never dereference its retired
+	// stage or rearm a deadline after the callout.
+	if scene.renderContext() == rc && scene.This != nil {
+		em.startRepeatClickTimer()
+	}
 }
 

+
+func cursorTestReset(t *testing.T) {
+	t.Helper()
+	oldDark := matcolor.SchemeIsDark
+	t.Cleanup(func() { colors.SetScheme(oldDark) })
+	Clear()
+	t.Cleanup(Clear)
+}
+func TestVellumCursorBoundsAndLRU(t *testing.T) {
+	cursorTestReset(t)
+	for _, n := range []int{math.MinInt, -1, 0, 257, math.MaxInt} {
+		if _, err := Get(cursors.Arrow, n); err == nil {
+			t.Fatal("size accepted", n)
+		}
+	}
+	for i := 0; i < 200; i++ {
+		if _, err := Get(vellumApplicationCursor{cursors.Cursor(-i - 100), "unknown"}, 32); err == nil {
+			t.Fatal("unknown admitted")
+		}
+	}
+	if len(Cursors) != 0 || len(cache.entries) != 0 {
+		t.Fatal("failed requests retained entries")
+	}
+	first, err := Get(cursors.Arrow, 16)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for size := 17; size < 90; size++ {
+		if _, err := Get(cursors.Arrow, size); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if len(cache.entries) > MaxEntries || len(Cursors[cursors.Arrow]) > MaxEntries || cache.bytes > MaxBytes {
+		t.Fatal("unbounded count")
+	}
+	next, err := Get(cursors.Arrow, 16)
+	if err != nil || next == first {
+		t.Fatal("LRU failed to evict", err)
+	}
+	// Distinct custom identities force max-size raster retention past byte budget.
+	for i := 0; i < 32; i++ {
+		if _, err := Get(vellumApplicationCursor{cursors.Cursor(-i - 1), "arrow"}, 256); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if cache.bytes > MaxBytes || len(cache.entries) > MaxEntries || cache.bytes == 0 {
+		t.Fatal("byte budget", cache.bytes)
+	}
+	if len(cache.entries) >= 32 {
+		t.Fatal("byte budget did not evict")
+	}
+}
+func TestVellumCursorGenerationsAndLegacyOwnedCopy(t *testing.T) {
+	cursorTestReset(t)
+	_, g, err := GetWithGeneration(cursors.Arrow, 32)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !IsCurrent(g) {
+		t.Fatal("fresh generation stale")
+	}
+	Clear()
+	if IsCurrent(g) {
+		t.Fatal("Clear did not revoke generation")
+	}
+	// Same-size subimage with large stride/storage must become a tiny owned copy.
+	backing := image.NewRGBA(image.Rect(0, 0, 2048, 2048))
+	backing.Set(0, 0, color.White)
+	custom := vellumApplicationCursor{cursors.Cursor(-40), "custom-no-svg"}
+	injected := &Cursor{backing.SubImage(image.Rect(0, 0, 1, 1)), 32, image.Point{}}
+	Cursors[custom] = map[int]*Cursor{32: injected}
+	owned, g, err := GetWithGeneration(custom, 32)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if owned == injected || len(owned.Image.(*image.RGBA).Pix) != 4 || cache.bytes != 4 {
+		t.Fatal("retained caller backing")
+	}
+	again, _, err := GetWithGeneration(custom, 32)
+	if err != nil || again != owned {
+		t.Fatal("adopted identity", err)
+	}
+	backing.Set(0, 0, color.Black)
+	if owned.Image.At(0, 0) != (color.RGBA{R: 255, G: 255, B: 255, A: 255}) {
+		t.Fatal("caller mutation changed copy")
+	}
+	clear(Cursors)
+	if IsCurrent(g) {
+		t.Fatal("legacy clear not detected")
+	}
+	_, g, err = GetWithGeneration(cursors.Arrow, 32)
+	if err != nil {
+		t.Fatal(err)
+	}
+	colors.SetScheme(true)
+	if IsCurrent(g) {
+		t.Fatal("theme did not revoke generation")
+	}
+	colors.SetScheme(false)
+}

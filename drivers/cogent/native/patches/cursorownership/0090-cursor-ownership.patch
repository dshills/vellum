+		return nil, fmt.Errorf("cursorimg: invalid raster geometry")
+	}
+	dst := image.NewRGBA(b)
+	// Avoid draw's implementation-specific fast paths: custom images may carry
+	// arbitrary backing storage or callbacks, neither is retained by this copy.
+	for y := 0; y < b.Max.Y; y++ {
+		for x := 0; x < b.Max.X; x++ {

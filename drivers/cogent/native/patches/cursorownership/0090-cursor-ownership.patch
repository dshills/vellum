+// Copy validates a raster before copying arbitrary caller pixels. No framework
+// locks are held while invoking Image.Bounds/At. The result owns exactly its
+// bounded RGBA storage, including when the input is a tiny view of a huge image.
+func Copy(c *Cursor, size int) (*Cursor, error) {
+	if c == nil || c.Image == nil || size < 1 || size > MaxSize || c.Size != size {
+		return nil, fmt.Errorf("cursorimg: invalid raster")
+	}
+	b := c.Image.Bounds()
+	limit := size + size/16

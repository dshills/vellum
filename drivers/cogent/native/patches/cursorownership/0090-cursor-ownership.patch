+// This backend never calls GLFW or creates a native window. Integers represent
+// owned handles and callbacks record the executing native-thread token.
+type fakeCursorBackend struct {
+	next         int
+	live         map[int]bool
+	destroyed    map[int]int
+	bound        int
+	threads      []uintptr
+	fail         bool
+	bindPanic    bool
+	destroyPanic bool
+}
+
+func fakeCursors() (*nativeCursorOwner, *fakeCursorBackend) {
+	f := &fakeCursorBackend{live: map[int]bool{}, destroyed: map[int]int{}}
+	o := newNativeCursorOwner(nativeCursorBackend{
+		create: func(*cursorimg.Cursor) (any, error) {
+			f.threads = append(f.threads, nativeCursorThread())
+			if f.fail {
+				return nil, errors.New("refused")
+			}
+			f.next++
+			f.live[f.next] = true
+			return f.next, nil
+		},
+		bind: func(h any) {
+			f.threads = append(f.threads, nativeCursorThread())
+			if f.bindPanic {
+				panic("bind")
+			}
+			if h == nil {
+				f.bound = 0
+			} else {
+				f.bound = h.(int)
+				if !f.live[f.bound] {
+					panic("dead handle bound")
+				}
+			}
+		},
+		destroy: func(h any) {
+			id := h.(int)
+			f.threads = append(f.threads, nativeCursorThread())
+			f.destroyed[id]++
+			if !f.live[id] || f.destroyed[id] != 1 {
+				panic("double destroy")
+			}
+			delete(f.live, id)
+			if f.destroyPanic {
+				panic("destroy")
+			}
+		},
+	})
+	return o, f
+}
+func fakeRaster(size int) *cursorimg.Cursor {
+	return &cursorimg.Cursor{Image: image.NewRGBA(image.Rect(0, 0, size+size/16, size+size/16)), Size: size}
+}
+func TestVellumCursorNativeBoundsPinningAndFailure(t *testing.T) {
+	o, f := fakeCursors()
+	var g cursorimg.Generation
+	var latest *cursorimg.Cursor
+	for i := 0; i < 100; i++ {
+		latest = fakeRaster(256)
+		if err := o.apply(nativeCursorKey{latest, g}, latest); err != nil {
+			t.Fatal(err)
+		}
+		if len(o.entries) > nativeCursorEntries || o.bytes > nativeCursorBytes || len(f.live) != len(o.entries) {
+			t.Fatal("native budget violated")
+		}
+		if !f.live[f.bound] {
+			t.Fatal("active handle evicted")
+		}
+	}
+	active := f.bound
+	f.fail = true
+	r := fakeRaster(256)
+	if err := o.apply(nativeCursorKey{r, g}, r); err == nil || f.bound != active || !f.live[active] {
+		t.Fatal("refusal changed active cursor", err)
+	}
+	f.fail = false
+	o.close()
+	o.close()
+	if len(f.live) != 0 || len(o.entries) != 0 || o.bytes != 0 || f.bound != 0 || o.backend.create != nil {
+		t.Fatal("retained native resources")
+	}
+	if err := o.apply(nativeCursorKey{latest, g}, latest); err == nil {
+		t.Fatal("closed owner reopened")
+	}
+}

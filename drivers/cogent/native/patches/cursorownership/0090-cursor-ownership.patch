+	if err := <-done; err == nil {
+		t.Fatal("closed window admitted")
+	}
+	a.retireCursor(c1)
+	if c1.window != nil || c1.app != nil || c1.Cur != nil || c1.Size.Custom != nil || len(a.cursorOwners) != 1 {
+		t.Fatal("closed references retained")
+	}
+	a.StopMain()
+	if err := c2.Set(cursors.Text); !errors.Is(err, base.ErrMainStopped) {
+		t.Fatal("stopped queue returned", err)
+	}
+	// A window removed from App.Windows still belongs to the terminal registry.
+	if a.NWindows() != 0 {
+		t.Fatal("fixture unexpectedly attached")
+	}
+	a.closeCursors()
+	a.closeCursors()
+	if len(a.cursorOwners) != 0 || !c2.closed || c2.owner.bytes != 0 {
+		t.Fatal("terminal registry retained resources")
+	}
+}

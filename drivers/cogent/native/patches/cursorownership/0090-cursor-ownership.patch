+		}
+		if err != nil {
+			return nil, Generation{}, err
+		}
+		theme, release = colors.ReadTheme()
+		cache.Lock()
+		syncLocked(theme)
+		if cache.generation != g {
+			cache.Unlock()
+			release()
+			continue
+		}
+		found, currentCustom := lookupLocked(k)
+		if found != nil {
+			cache.Unlock()
+			release()
+			return found, g, nil
+		}
+		if currentCustom != custom {
+			cache.Unlock()
+			release()
+			continue
+		}
+		n := len(r.Image.(*image.RGBA).Pix)
+		for cache.lru.Len() >= MaxEntries || cache.bytes+n > MaxBytes {

+	// Verify the same exact requested window is retained after context mutation.
+	if a.Cursor(c1.window) != c1 || a.Cursor(c2.window) != c2 {
+		t.Fatal("shared facade returned")
+	}
+	if err := cursorRun(t, a, q, func() error { return c1.Set(cursors.Text) }); err != nil {
+		t.Fatal(err)

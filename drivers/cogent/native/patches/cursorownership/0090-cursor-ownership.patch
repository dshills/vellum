+// Copyright 2026 Vellum contributors. SPDX-License-Identifier: MIT.
+package desktop
+
+import (
+	"cogentcore.org/core/cursors/cursorimg"
+	"container/list"
+	"fmt"
+)
+
+const nativeCursorEntries = 16
+const nativeCursorBytes = 1 << 20
+
+type nativeCursorBackend struct {
+	create  func(*cursorimg.Cursor) (any, error)
+	bind    func(any)
+	destroy func(any)
+}
+type nativeCursorKey struct {
+	raster     *cursorimg.Cursor
+	generation cursorimg.Generation
+}
+type nativeCursorEntry struct {
+	key    nativeCursorKey
+	handle any
+	bytes  int
+}
+
+// All fields and backend callbacks belong exclusively to the native main owner.
+// active and pending allocations count toward the same limits as inactive LRU.
+type nativeCursorOwner struct {
+	backend nativeCursorBackend
+	entries map[nativeCursorKey]*list.Element
+	lru     list.List
+	active  *list.Element
+	bytes   int
+	closed  bool
+}
+
+func newNativeCursorOwner(b nativeCursorBackend) *nativeCursorOwner {
+	return &nativeCursorOwner{backend: b, entries: make(map[nativeCursorKey]*list.Element)}
+}
+func (o *nativeCursorOwner) remove(e *list.Element) {
+	v := e.Value.(nativeCursorEntry)
+	delete(o.entries, v.key)
+	o.lru.Remove(e)
+	o.bytes -= v.bytes
+	if o.active == e {
+		o.active = nil
+	}
+	// Remove ownership before the native call: a native panic is terminal, and
+	// final teardown must never call Destroy twice on an uncertain native result.
+	o.backend.destroy(v.handle)
+}
+func (o *nativeCursorOwner) apply(k nativeCursorKey, pixels *cursorimg.Cursor) error {
+	if o.closed {
+		return fmt.Errorf("desktop: cursor closed")
+	}
+	// Preserve the current assignment across theme invalidation and allocation
+	// refusal; retire stale inactive handles immediately and the old active one
+	// only after a valid replacement has been bound.
+	for e := o.lru.Back(); e != nil; {
+		prev := e.Prev()
+		if e != o.active && e.Value.(nativeCursorEntry).key.generation != k.generation {
+			o.remove(e)
+		}
+		e = prev
+	}
+	if e := o.entries[k]; e != nil {
+		if e != o.active {
+			o.backend.bind(e.Value.(nativeCursorEntry).handle)
+			o.active = e
+		}
+		o.lru.MoveToFront(e)
+		return nil
+	}
+	// pixels is a separately owned bounded RGBA snapshot, never an application
+	// image/subimage. Admission precedes the backend allocation.
+	n := pixels.Image.Bounds().Dx() * pixels.Image.Bounds().Dy() * 4
+	if n <= 0 || n > nativeCursorBytes/2 {
+		return fmt.Errorf("desktop: cursor pixel budget")
+	}
+	for len(o.entries) >= nativeCursorEntries || o.bytes+n > nativeCursorBytes {
+		victim := o.lru.Back()
+		if victim == o.active {
+			victim = victim.Prev()
+		}
+		if victim == nil {
+			return fmt.Errorf("desktop: active cursor fills budget")
+		}
+		o.remove(victim)
+	}
+	handle, err := o.backend.create(pixels)
+	if err != nil {
+		return err
+	}
+	if handle == nil {
+		return fmt.Errorf("desktop: native cursor allocation refused")
+	}
+	old := o.active
+	e := o.lru.PushFront(nativeCursorEntry{k, handle, n})
+	o.entries[k] = e
+	o.bytes += n
+	// Pending ownership is registered before bind so terminal cleanup owns it
+	// if GLFW panics. The old active handle remains pinned until bind succeeds.
+	o.backend.bind(handle)
+	o.active = e
+	if old != nil && old.Value.(nativeCursorEntry).key.generation != k.generation {
+		o.remove(old)
+	}
+	return nil
+}
+
+// drainAll runs every cleanup despite a panic, then preserves the first panic.
+// GLFW termination is separately deferred by App.MainLoop.
+func drainAll(fs ...func()) {
+	var first any
+	panicked := false
+	for _, f := range fs {
+		func() {
+			returned := false
+			defer func() {
+				if !returned {
+					p := recover()
+					if !panicked {
+						first = p
+						panicked = true
+					}
+				}
+			}()
+			f()
+			returned = true
+		}()
+	}
+	if panicked {
+		panic(first)
+	}
+}
+func (o *nativeCursorOwner) close() {
+	if o.closed {
+		return
+	}
+	o.closed = true
+	fs := []func(){func() { o.backend.bind(nil) }}
+	for e := o.lru.Back(); e != nil; e = e.Prev() {
+		item := e
+		fs = append(fs, func() { o.remove(item) })
+	}
+	defer func() { o.active = nil; o.entries = nil; o.backend = nativeCursorBackend{}; o.lru.Init(); o.bytes = 0 }()
+	drainAll(fs...)
+}

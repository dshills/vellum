+// Reentry controls exercise actual enum/image callbacks without a cache or theme
+// lock, including callbacks that acquire the official theme writer lock.
+type reentrantImage struct {
+	image.Image
+	f func()
+}
+
+func (i reentrantImage) At(x, y int) color.Color { i.f(); return i.Image.At(x, y) }
+func TestVellumCursorThemeConcurrencyAndCallbacks(t *testing.T) {
+	cursorTestReset(t)
+	scheme := colors.Scheme
+	oldShadow := scheme.Shadow
+	t.Cleanup(func() { scheme.Shadow = oldShadow })
+	colors.Scheme.Shadow = reentrantImage{image.Black, func() { colors.SetScheme(false) }}
+	if _, err := Get(cursors.Arrow, 32); err == nil {
+		t.Fatal("theme-changing callback accepted stale raster")
+	}
+	scheme.Shadow = oldShadow
+	colors.SetScheme(false)
+	var wg sync.WaitGroup
+	wg.Add(3)
+	go func() {
+		defer wg.Done()
+		for i := 0; i < 40; i++ {
+			colors.SetScheme(i%2 == 0)
+		}
+	}()
+	for j := 0; j < 2; j++ {
+		go func() {
+			defer wg.Done()
+			for i := 0; i < 40; i++ {
+				r, g, err := GetWithGeneration(cursors.Arrow, 32)
+				if err == nil && (r == nil || g == (Generation{})) {
+					t.Error("invalid successful request")
+				}
+				Clear()
+			}
+		}()
+	}
+	wg.Wait()
+	colors.SetScheme(false)
+}

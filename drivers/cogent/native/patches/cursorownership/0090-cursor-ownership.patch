+
+// Clear invalidates managed rasters and generations. Native owners retire their
+// stale inactive handles on the next Set, and their active handle on replacement
+// or close. This function does not call a native backend.
+func Clear() { cache.Lock(); defer cache.Unlock(); clearLocked() }
+
+// IsCurrent is the validation point for a native assignment. A subsequent Clear
+// or theme update may overlap that already admitted assignment.
+func IsCurrent(g Generation) bool {

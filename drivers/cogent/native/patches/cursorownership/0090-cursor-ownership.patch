+func cursorFixture(t *testing.T, publish bool) (*App, *Cursor, *Cursor, chan base.FuncRun) {
+	t.Helper()
+	a := &App{}
+	a.This = &stoppedCreationApp{}
+	var queue chan base.FuncRun
+	if publish {
+		queue, _ = a.InitMainQueue()
+	}
+	makeCursor := func() *Cursor {
+		w := &Window{WindowMulti: base.NewWindowMulti[*App, *composer.ComposerDrawer](a, &system.NewWindowOptions{}), Glw: &glfw.Window{}}
+		w.LogDPI = 320
+		w.DevicePixelRatio = 2
+		w.publishCursorScale()
+		o, _ := fakeCursors()
+		cu := &Cursor{CursorBase: system.CursorBase{Size: units.Dp(32), Vis: true}, window: w, app: a, owner: o}
+		w.cursor = cu
+		if a.cursorOwners == nil {
+			a.cursorOwners = map[*Cursor]struct{}{}
+		}
+		a.cursorOwners[cu] = struct{}{}
+		return cu
+	}
+	c1, c2 := makeCursor(), makeCursor()
+	t.Cleanup(func() { a.StopMain(); a.closeCursors(); cursorimg.Clear() })
+	return a, c1, c2, queue
+}
+func cursorRun(t *testing.T, a *App, q chan base.FuncRun, fn func() error) error {
+	t.Helper()
+	done := make(chan error, 1)
+	go func() { done <- fn() }()
+	select {
+	case call := <-q:
+		a.ExecuteMain(call)
+	case err := <-done:
+		return err
+	case <-time.After(15 * time.Second):
+		t.Fatal("cursor dispatch did not arrive")
+	}
+	select {
+	case err := <-done:
+		return err
+	case <-time.After(5 * time.Second):
+		t.Fatal("cursor caller did not finish")
+	}
+	return nil
+}
+func TestVellumCursorExactWindowAndWorkerDispatch(t *testing.T) {
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()

+func GetWithGeneration(c enums.Enum, size int) (*Cursor, Generation, error) {
+	if size < 1 || size > MaxSize || !validEnum(c) {
+		return nil, Generation{}, fmt.Errorf("cursorimg: invalid cursor or size")
+	}
+	k := key{c, size}
+	for attempt := 0; attempt < 3; attempt++ {

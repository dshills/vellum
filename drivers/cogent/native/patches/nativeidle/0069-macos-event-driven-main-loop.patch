+func TestVellumMacIngressConcurrentStopRefusesWaitingCallers(t *testing.T) {
+	events := newIdleEvents()
+	a, queue, stopped := idleApp(events.post)
+	exited, active, release, firstDone := make(chan struct{}), make(chan struct{}), make(chan struct{}), make(chan struct{})
+	var releaseOnce sync.Once
+	go func() { defer close(exited); a.runMacMainLoop(queue, stopped, events.wait, events.post) }()
+	t.Cleanup(func() { releaseOnce.Do(func() { close(release) }); a.StopMain(); events.post(); idleWait(t, exited) })
+	go func() {
+		defer close(firstDone)
+		if !a.RunOnMainIfOpen(func() { close(active); <-release }) {
+			t.Error("active callback was refused")
+		}
+	}()
+	idleWait(t, active)
+	const callers = 64
+	results := make(chan bool, callers)
+	var entered sync.WaitGroup
+	entered.Add(callers)
+	for range callers {
+		go func() {
+			entered.Done()
+			results <- a.RunOnMainIfOpen(func() { t.Error("waiting callback ran after stop") })
+		}()
+	}
+	entered.Wait()
+	var stops sync.WaitGroup
+	stops.Add(callers)
+	for range callers {
+		go func() { defer stops.Done(); a.StopMain() }()
+	}
+	stops.Wait()
+	releaseOnce.Do(func() { close(release) })
+	idleWait(t, firstDone)
+	idleWait(t, exited)
+	for range callers {
+		select {
+		case accepted := <-results:
+			if accepted {
+				t.Fatal("waiting callback reported success after stop")
+			}
+		case <-time.After(3 * time.Second):
+			t.Fatal("concurrent stop stranded a synchronous caller")
+		}
+	}
+}

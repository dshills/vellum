+package desktop
+
+import (
+	"errors"
+	"runtime"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"cogentcore.org/core/system/driver/base"
+)
+
+// These tests use the real queue/ACK implementation and injected event waits.
+// They do not initialize GLFW, NSApplication, a surface or a GPU instance.
+type idleQueueApp struct {
+	*App
+	wake func()
+}
+
+func (a *idleQueueApp) SendEmptyEvent() { a.wake() }
+
+func idleApp(wake func()) (*App, chan base.FuncRun, chan struct{}) {
+	a := &App{AppMulti: base.NewAppMulti[*Window]()}
+	a.This = &idleQueueApp{App: a, wake: wake}
+	queue, stopped := a.InitMainQueue()
+	return a, queue, stopped
+}
+
+type idleEvents struct{ pending chan struct{} }
+
+func newIdleEvents() *idleEvents { return &idleEvents{pending: make(chan struct{}, 1)} }
+func (e *idleEvents) post() {
+	select {
+	case e.pending <- struct{}{}:
+	default:
+	}
+}
+func (e *idleEvents) wait() { <-e.pending }
+
+func idleWait(t *testing.T, ch <-chan struct{}) {
+	t.Helper()
+	select {
+	case <-ch:
+	case <-time.After(3 * time.Second):
+		t.Fatal("Mac main ingress did not retire")
+	}
+}
+
+func idleAckOnce(t *testing.T, ch <-chan struct{}) {
+	t.Helper()
+	idleWait(t, ch)
+	select {
+	case <-ch:
+		t.Fatal("duplicate acknowledgement")
+	default:
+	}
+}
+
+func idleEnqueue(t *testing.T, queue chan<- base.FuncRun, call base.FuncRun) {
+	t.Helper()
+	select {
+	case queue <- call:
+	case <-time.After(3 * time.Second):
+		t.Fatal("Mac ingress did not accept the expected bounded packet")
+	}
+}
+
+func TestVellumMacIngressRepairsWakeConsumedBeforePublicSend(t *testing.T) {
+	events := newIdleEvents()
+	reentered := make(chan struct{})
+	var waits, posts atomic.Int32
+	wake := func() {
+		events.post()
+		if posts.Add(1) == 1 {
+			// The original Base wake is consumed, and main is asleep again,
+			// before Base can attempt its public queue rendezvous.
+			<-reentered
+		}
+	}
+	a, queue, stopped := idleApp(wake)
+	exited := make(chan struct{})
+	go func() {
+		defer close(exited)
+		a.runMacMainLoop(queue, stopped, func() {
+			if waits.Add(1) == 2 {
+				close(reentered)
+			}
+			events.wait()
+		}, wake)
+	}()
+	t.Cleanup(func() { a.StopMain(); events.post(); idleWait(t, exited) })
+	done := make(chan struct{})
+	value := 0
+	go func() {
+		defer close(done)
+		if !a.RunOnMainIfOpen(func() { value = 42 }) || value != 42 {
+			t.Error("publication wake did not preserve synchronous output")
+		}
+	}()
+	idleWait(t, done)
+	if posts.Load() < 3 { // Base leading/trailing and the essential private wake.
+		t.Fatal("private publication did not post a wake")
+	}
+}
+
+func TestVellumMacIngressIdleHasNoPeriodicWaitAndStopWakes(t *testing.T) {
+	events := newIdleEvents()
+	entered := make(chan struct{})
+	var waits atomic.Int32
+	a, queue, stopped := idleApp(events.post)
+	exited := make(chan struct{})
+	go func() {
+		defer close(exited)
+		a.runMacMainLoop(queue, stopped, func() {
+			if waits.Add(1) == 1 {
+				close(entered)
+			}
+			events.wait()
+		}, events.post)
+	}()
+	t.Cleanup(func() { a.StopMain(); events.post(); idleWait(t, exited) })
+	idleWait(t, entered)
+	select {
+	case <-exited:
+		t.Fatal("idle loop returned without stop")
+	case <-time.After(250 * time.Millisecond):
+	}
+	if waits.Load() != 1 {
+		t.Fatal("idle loop polled its native wait", waits.Load())
+	}
+	a.StopMain() // Base does not post; the ingress must wake the native wait.
+	idleWait(t, exited)
+}
+
+func TestVellumMacIngressBoundsPendingCallsAndRefusesAfterStop(t *testing.T) {
+	var posts atomic.Int32
+	a, queue, stopped := idleApp(func() { posts.Add(1) })
+	pump := newMacMainIngress()
+	if cap(pump.ready) != 1 {
+		t.Fatal("native ready queue is not bounded at one")
+	}
+	go pump.run(a, queue, stopped, func() { posts.Add(1) })
+	t.Cleanup(func() { a.StopMain(); idleWait(t, pump.done) })
+	var invoked atomic.Int32
+	first, second := make(chan struct{}, 1), make(chan struct{}, 1)
+	for _, done := range []chan struct{}{first, second} {
+		idleEnqueue(t, queue, base.FuncRun{F: func() { invoked.Add(1) }, Done: done})
+	}
+	// The first call occupies ready; the second is pump-local. A third public
+	// sender must remain cancellable without becoming another retained packet.
+	thirdStarted, thirdDone := make(chan struct{}), make(chan struct{})
+	go func() {
+		defer close(thirdDone)
+		close(thirdStarted)
+		if a.RunOnMainIfOpen(func() { invoked.Add(1) }) {
+			t.Error("post-stop third call executed")
+		}
+	}()
+	idleWait(t, thirdStarted)
+	a.StopMain()
+	idleWait(t, pump.done)
+	idleAckOnce(t, first)
+	idleAckOnce(t, second)
+	idleWait(t, thirdDone)
+	if invoked.Load() != 0 || len(pump.ready) != 0 || posts.Load() == 0 {
+		t.Fatal("stopped ingress retained or executed pending calls")
+	}
+}
+
+func TestVellumMacIngressKeepsActiveCallbackOwnedThroughStop(t *testing.T) {
+	events := newIdleEvents()
+	a, queue, stopped := idleApp(events.post)
+	started, release, returned, exited := make(chan struct{}), make(chan struct{}), make(chan struct{}), make(chan struct{})
+	var releaseOnce sync.Once
+	go func() { defer close(exited); a.runMacMainLoop(queue, stopped, events.wait, events.post) }()
+	t.Cleanup(func() { releaseOnce.Do(func() { close(release) }); a.StopMain(); events.post(); idleWait(t, exited) })
+	value := 0
+	go func() {
+		defer close(returned)
+		if !a.RunOnMainIfOpen(func() { close(started); <-release; value = 42 }) || value != 42 {
+			t.Error("active callback output escaped its acknowledgement")
+		}
+	}()
+	idleWait(t, started)
+	a.StopMain()
+	select {
+	case <-returned:
+		t.Fatal("stop released a caller while its callback used output")
+	case <-time.After(10 * time.Millisecond):
+	}
+	releaseOnce.Do(func() { close(release) })
+	idleWait(t, returned)
+	idleWait(t, exited)
+}
+
+func TestVellumMacIngressCallbackFailureRetiresPendingCalls(t *testing.T) {
+	for _, mode := range []string{"panic", "nil-panic", "goexit"} {
+		t.Run(mode, func(t *testing.T) {
+			events := newIdleEvents()
+			a, queue, stopped := idleApp(events.post)
+			started, release, exited, callerDone := make(chan struct{}), make(chan struct{}), make(chan struct{}), make(chan struct{})
+			sentinel := errors.New("native callback failure")
+			var nativePanic, callerPanic any
+			go func() {
+				defer close(exited)
+				defer func() { nativePanic = recover() }()
+				a.runMacMainLoop(queue, stopped, events.wait, events.post)
+			}()
+			var releaseOnce sync.Once
+			t.Cleanup(func() { releaseOnce.Do(func() { close(release) }); a.StopMain(); events.post(); idleWait(t, exited) })
+			go func() {
+				defer close(callerDone)
+				defer func() { callerPanic = recover() }()
+				a.RunOnMainIfOpen(func() {
+					close(started)
+					<-release
+					if mode == "goexit" {
+						runtime.Goexit()
+					}
+					if mode == "nil-panic" {
+						panic(nil)
+					}
+					panic(sentinel)
+				})
+			}()
+			idleWait(t, started)
+			acks := []chan struct{}{make(chan struct{}, 1), make(chan struct{}, 1)}
+			for _, ack := range acks {
+				idleEnqueue(t, queue, base.FuncRun{F: func() { t.Error("pending failure callback executed") }, Done: ack})
+			}
+			releaseOnce.Do(func() { close(release) })
+			idleWait(t, exited)
+			idleWait(t, callerDone)
+			for _, ack := range acks {
+				idleAckOnce(t, ack)
+			}
+			if !a.MainStopped() || mode == "panic" && (nativePanic != sentinel || callerPanic != sentinel) || mode == "goexit" && (nativePanic != nil || callerPanic != base.ErrMainCallbackIncomplete) {
+				t.Fatal("callback failure contract changed", nativePanic, callerPanic)
+			}
+			if mode == "nil-panic" {
+				if _, ok := nativePanic.(*runtime.PanicNilError); !ok || callerPanic != nativePanic {
+					t.Fatal("nil panic identity changed", nativePanic, callerPanic)
+				}
+			}
+		})
+	}
+}
+
+func TestVellumMacIngressWakeFailureRetiresPublishedOwnership(t *testing.T) {
+	a, queue, stopped := idleApp(func() {})
+	pump := newMacMainIngress()
+	sentinel := errors.New("native wake failed")
+	exited := make(chan struct{})
+	var observed any
+	go func() {
+		defer close(exited)
+		defer func() { observed = recover() }()
+		pump.run(a, queue, stopped, func() { panic(sentinel) })
+	}()
+	ack := make(chan struct{}, 1)
+	t.Cleanup(func() { a.StopMain(); idleWait(t, exited) })
+	idleEnqueue(t, queue, base.FuncRun{F: func() { t.Error("wake failure executed callback") }, Done: ack})
+	idleWait(t, exited)
+	idleWait(t, pump.done)
+	idleAckOnce(t, ack)
+	if observed != sentinel || !a.MainStopped() || len(pump.ready) != 0 {
+		t.Fatal("wake failure swallowed or stranded ownership", observed)
+	}
+}
+
+func TestVellumMacIngressPublicationBeforeNativeWaitIsRetained(t *testing.T) {
+	events := newIdleEvents()
+	a, queue, stopped := idleApp(events.post)
+	betweenCheckAndWait, releaseWait, exited := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	var firstWait sync.Once
+	var releaseOnce sync.Once
+	go func() {
+		defer close(exited)
+		a.runMacMainLoop(queue, stopped, func() {
+			firstWait.Do(func() { close(betweenCheckAndWait); <-releaseWait })
+			events.wait()
+		}, events.post)
+	}()
+	t.Cleanup(func() {
+		releaseOnce.Do(func() { close(releaseWait) })
+		a.StopMain()
+		events.post()
+		idleWait(t, exited)
+	})
+	idleWait(t, betweenCheckAndWait)
+	var invoked atomic.Int32
+	ack := make(chan struct{}, 1)
+	idleEnqueue(t, queue, base.FuncRun{F: func() { invoked.Add(1) }, Done: ack})
+	// Main has already checked its private channel and has not yet entered
+	// the fake native wait. A publication event must remain queued for it.
+	select {
+	case <-events.pending:
+		events.post()
+	case <-time.After(3 * time.Second):
+		t.Fatal("published packet did not post an event before wait")
+	}
+	releaseOnce.Do(func() { close(releaseWait) })
+	idleAckOnce(t, ack)
+	if invoked.Load() != 1 {
+		t.Fatal("publication before wait was lost")
+	}
+}
+
+func TestVellumMacIngressPreservesFIFO(t *testing.T) {
+	events := newIdleEvents()
+	a, queue, stopped := idleApp(events.post)
+	started, release, exited := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	var releaseOnce sync.Once
+	go func() { defer close(exited); a.runMacMainLoop(queue, stopped, events.wait, events.post) }()
+	t.Cleanup(func() { releaseOnce.Do(func() { close(release) }); a.StopMain(); events.post(); idleWait(t, exited) })
+	var order []int // native-owned until the final packet is acknowledged
+	acks := []chan struct{}{make(chan struct{}, 1), make(chan struct{}, 1), make(chan struct{}, 1)}
+	idleEnqueue(t, queue, base.FuncRun{F: func() { close(started); <-release; order = append(order, 0) }, Done: acks[0]})
+	idleWait(t, started)
+	for i := 1; i < len(acks); i++ {
+		value := i
+		idleEnqueue(t, queue, base.FuncRun{F: func() { order = append(order, value) }, Done: acks[i]})
+	}
+	releaseOnce.Do(func() { close(release) })
+	for _, ack := range acks {
+		idleAckOnce(t, ack)
+	}
+	if len(order) != 3 || order[0] != 0 || order[1] != 1 || order[2] != 2 {
+		t.Fatal("ready/local ingress reordered calls", order)
+	}
+}
+
+func TestVellumMacIngressWaitFailureJoinsBeforeCleanup(t *testing.T) {
+	a, queue, stopped := idleApp(func() {})
+	waitEntered, failWait, exited := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	stopWakeEntered, releaseStopWake := make(chan struct{}), make(chan struct{})
+	sentinel := errors.New("native wait failed")
+	var observed any
+	var releaseOnce, releaseWakeOnce sync.Once
+	var wakes atomic.Int32
+	go func() {
+		defer close(exited)
+		defer func() { observed = recover() }()
+		a.runMacMainLoop(queue, stopped, func() { close(waitEntered); <-failWait; panic(sentinel) }, func() {
+			wakes.Add(1)
+			if a.MainStopped() {
+				close(stopWakeEntered)
+				<-releaseStopWake
+			}
+		})
+	}()
+	t.Cleanup(func() {
+		releaseOnce.Do(func() { close(failWait) })
+		releaseWakeOnce.Do(func() { close(releaseStopWake) })
+		a.StopMain()
+		idleWait(t, exited)
+	})
+	idleWait(t, waitEntered)
+	acks := []chan struct{}{make(chan struct{}, 1), make(chan struct{}, 1)}
+	for _, ack := range acks {
+		idleEnqueue(t, queue, base.FuncRun{F: func() { t.Error("wait failure executed pending call") }, Done: ack})
+	}
+	releaseOnce.Do(func() { close(failWait) })
+	idleWait(t, stopWakeEntered)
+	select {
+	case <-exited:
+		t.Fatal("native loop returned before its ingress wake retired")
+	case <-time.After(10 * time.Millisecond):
+	}
+	releaseWakeOnce.Do(func() { close(releaseStopWake) })
+	idleWait(t, exited)
+	// These ACKs are complete before the enclosing native loop can perform
+	// cleanup or terminate its event backend; no pump wake is still in flight.
+	for _, ack := range acks {
+		select {
+		case <-ack:
+		default:
+			t.Fatal("native loop returned before pending acknowledgement")
+		}
+		select {
+		case <-ack:
+			t.Fatal("duplicate pending acknowledgement")
+		default:
+		}
+	}
+	if observed != sentinel || !a.MainStopped() || wakes.Load() == 0 {
+		t.Fatal("native wait failure did not retire ingress", observed)
+	}
+}

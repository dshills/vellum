+func TestScrollPaintCaptureStopsAfterBudgetFailure(t *testing.T) {
+	uc := units.Context{}
+	uc.Defaults()
+	style := rich.NewStyle()
+	ts := text.NewStyle()
+	ts.ToDots(&uc)
+	lines := shapedgt.NewShaperWithFonts(fonts.Embedded).WrapLines(rich.NewText(style, []rune("Guard")), style, ts, math32.Vec2(200, 100))
+	lines.Color = color.RGBA{A: 255}
+	// The second run would panic on its nil font face if capture traversed it.
+	run := *lines.Lines[0].Runs[0].(*shapedgt.Run)
+	run.Face = nil
+	lines.Lines[0].Runs = append(lines.Lines[0].Runs, &run)
+	ctx := &render.Context{}
+	ctx.Init(styles.NewPaint(), &render.Bounds{Rect: math32.B2(0, 0, 240, 160)}, nil)
+	actual := New(math32.Vec2(240, 160)).(*Renderer)
+	plan := &scrollPaintPlan{bytes: scrollPlanBudget, winding: true}
+	actual.scrollRecord = plan
+	actual.TextLinesWithGeometry(ctx, lines, math32.Vec2(10, 10), nil)
+	if !plan.failed || len(plan.ops) != 0 {
+		t.Fatal("capture did not stop at budget")
+	}
+}

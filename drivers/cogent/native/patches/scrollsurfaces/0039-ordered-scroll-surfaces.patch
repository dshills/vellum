+	}{{-100, 40, -1, -100}, {-100, 40, 0, -100}, {-100, 40, 87.75, -13}, {-100, 40, 141, 40}, {-1 << 31, 1<<31 - 1, 1 << 32, 1<<31 - 1}, {1<<31 - 100, 1<<31 - 1, 99, 1<<31 - 1}} {
+		if got := relativeCurveCoordinate(c.origin, c.maximum, c.value); got != c.want {
+			t.Fatal(c, got)
+		}
+	}
+}

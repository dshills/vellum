+// Copyright (c) 2026, Davin Hills.
+// SPDX-License-Identifier: MIT
+
+package rasterx
+
+import (
+	"bytes"
+	"image"
+	"image/color"
+	"image/draw"
+	"math"
+	"math/rand"
+	"testing"
+
+	"cogentcore.org/core/math32"
+	"cogentcore.org/core/paint/pimage"
+	"cogentcore.org/core/paint/render"
+	"cogentcore.org/core/styles"
+	"cogentcore.org/core/styles/units"
+	"cogentcore.org/core/text/fonts"
+	"cogentcore.org/core/text/rich"
+	"cogentcore.org/core/text/shaped/shapers/shapedgt"
+	"cogentcore.org/core/text/text"
+	"cogentcore.org/core/text/textpos"
+)
+
+// Replay the previous dispatch, ignoring the new hint. This oracle executes
+// every original item at its original painter position, including later peers.
+func scrollReference(rs *Renderer, items render.Render) {
+	for i, item := range items {
+		switch x := item.(type) {
+		case *render.Path:
+			rs.RenderPath(x)
+		case *pimage.Params:
+			if i+1 < len(items) {
+				if next, ok := items[i+1].(*pimage.Params); ok && coveredUniformDraw(x, next) {
+					continue
+				}
+			}
+			x.Render(rs.image)
+		case *render.Text:
+			rs.RenderText(x)
+		}
+	}
+}
+
+func scrollPattern(bounds image.Rectangle, position image.Point, epoch uint64) render.Render {
+	items := render.Render{pimage.NewDraw(bounds, image.NewUniform(color.RGBA{R: 19, G: 27, B: 35, A: 255}), nil, bounds.Min, draw.Src)}
+	// The content is defined in stable world coordinates, not by a pooled slot.
+	for y := -8; y < bounds.Dy()+16; y += 8 {
+		for x := -12; x < bounds.Dx()+24; x += 12 {
+			worldX := x + position.X/12*12
+			worldY := y + position.Y/8*8
+			r := image.Rect(bounds.Min.X+x-position.X%12, bounds.Min.Y+y-position.Y%8, bounds.Min.X+x-position.X%12+10, bounds.Min.Y+y-position.Y%8+6).Intersect(bounds)
+			if r.Empty() {
+				continue
+			}
+			c := color.RGBA{R: uint8(worldX*3 + int(epoch)), G: uint8(worldY * 7), B: uint8(worldX ^ worldY), A: 149}
+			items = append(items, pimage.NewDraw(r, image.NewUniform(c), nil, r.Min, draw.Over))
+		}
+	}
+	return items
+}
+
+func scrollFrame(bounds image.Rectangle, position image.Point, epoch uint64) render.Render {
+	all := render.Render{pimage.NewDraw(image.Rect(0, 0, 240, 160), image.NewUniform(color.RGBA{R: uint8(epoch * 31), A: 255}), nil, image.Point{}, draw.Src)}
+	all = append(all, &render.ContextPush{Scroll: &render.ScrollSurface{ID: 7, Part: 2, Epoch: epoch, Position: position, Bounds: bounds}})
+	all = append(all, scrollPattern(bounds, position, epoch)...)
+	all = append(all, &render.ContextPop{})
+	// A fixed overlay intersects the surface. Capturing it into the scrolling
+	// image, or composing the surface after the scene, would move/cover it.
+	all = append(all, pimage.NewDraw(image.Rect(41, 27, 113, 71), image.NewUniform(color.RGBA{R: 241, G: 63, B: 7, A: 255}), nil, image.Point{}, draw.Src))
+	return all
+}
+
+func TestScrollSurfaceOrderedPixelsAndActualReuse(t *testing.T) {
+	actual := New(math32.Vec2(240, 160)).(*Renderer)
+	reference := New(math32.Vec2(240, 160)).(*Renderer)
+	bounds := image.Rect(11, 9, 191, 105)
+	position := image.Pt(120, 96)
+	epoch := uint64(1)
+	random := rand.New(rand.NewSource(91))
+	reused := 0
+	for frame := 0; frame < 160; frame++ {
+		if frame%23 == 0 {
+			epoch++
+		}
+		if frame > 0 {
+			position = position.Add(image.Pt(random.Intn(19)-9, random.Intn(13)-6))
+		}
+		items := scrollFrame(bounds, position, epoch)
+		actual.Render(items)
+		if actual.ScrollStats().CapturedPixels != actual.ScrollStats().RedrawPixels {
+			t.Fatal("cache capture exceeded exposed/redrawn area", actual.ScrollStats())
+		}
+		scrollReference(reference, items)
+		if !bytes.Equal(actual.image.Pix, reference.image.Pix) {
+			t.Fatalf("pixels differ at frame %d offset %v epoch %d", frame, position, epoch)
+		}
+		stats := actual.ScrollStats()
+		if stats.ReusedGroups > 0 {
+			reused++
+			if stats.ReusedPixels+stats.RedrawPixels != bounds.Dx()*bounds.Dy() {
+				t.Fatal("damage areas overlap or leave a hole", stats)
+			}
+		}
+		if frame%23 == 0 && stats.FullRedraws != 1 {
+			t.Fatal("changed content did not repair the complete surface", stats)
+		}
+		if stats.CachedBytes != 4*bounds.Dx()*bounds.Dy() {
+			t.Fatal("unexpected cache retention", stats)
+		}
+	}
+	if reused < 140 {
+		t.Fatalf("oracle passed without effective reuse: %d", reused)
+	}
+}
+
+func TestScrollSurfaceBoundsRepairAndUnsupportedFallback(t *testing.T) {
+	actual := New(math32.Vec2(240, 160)).(*Renderer)
+	reference := New(math32.Vec2(240, 160)).(*Renderer)
+	bounds := image.Rect(11, 9, 191, 105)
+	for i := 0; i < 5; i++ {
+		items := scrollFrame(bounds, image.Pt(i*3, 16), 1)
+		if i == 2 {
+			// A destination-dependent blur cannot be drawn strip by strip.
+			items = append(items[:len(items)-2], append(render.Render{pimage.NewBlur(bounds, 2)}, items[len(items)-2:]...)...)
+		}
+		if i == 3 {
+			bounds = image.Rect(13, 11, 189, 101)
+			items = scrollFrame(bounds, image.Pt(i*3, 16), 1)
+		}
+		actual.Render(items)
+		if actual.ScrollStats().CapturedPixels != actual.ScrollStats().RedrawPixels {

+func TestScrollPaintPacketBudgetAndExactBytes(t *testing.T) {
+	p := &scrollPaintPlan{}
+	fill := image.NewUniform(color.RGBA{A: 255})
+	mask := image.NewAlpha(image.Rect(0, 0, 128, 128))
+	mask.Pix[0] = 131
+	p.addMask(mask, image.Pt(3, 4), image.Rect(0, 0, 160, 160), fill)
+	if p.failed || p.ops[0].mask.Pix[0] != 131 {
+		t.Fatal("mask capture failed")
+	}
+	mask.Pix[0] = 19
+	if p.ops[0].mask.Pix[0] != 131 {
+		t.Fatal("retained source mask reference")
+	}
+	next := &scrollPaintPlan{}
+	next.addMask(mask, image.Pt(3, 4), image.Rect(0, 0, 160, 160), fill)
+	if sameScrollPaint(p, next, image.Rect(0, 0, 160, 160), image.Point{}) {
+		t.Fatal("different actual mask admitted")
+	}
+	for !p.failed {
+		p.addMask(mask, image.Point{}, image.Rect(0, 0, 160, 160), fill)
+	}
+	if p.bytes > scrollPlanBudget || len(p.ops) > scrollPlanMaxOps {
+		t.Fatal("packet budget exceeded")
+	}
+	actual := New(math32.Vec2(240, 160)).(*Renderer)
+	for i := uint64(1); i <= 80; i++ {
+		items := scrollFrame(image.Rect(11, 9, 191, 105), image.Pt(120, 96), 1)
+		hint := items[1].(*render.ContextPush).Scroll
+		hint.ID = i
+		hint.VerifyPaint = true
+		actual.Render(items)
+	}
+	if actual.scrollPlanBytes > scrollPlanBudget || actual.scrollBytes > scrollCacheBudget || len(actual.scrollCache) > scrollCacheGroups {
+		t.Fatal("retained aggregate budget exceeded")
+	}
+	actual.SetSize(units.UnitDot, math32.Vec2(241, 160))
+	if len(actual.scrollCache) != 0 || actual.scrollPlanBytes != 0 || actual.scrollBytes != 0 {
+		t.Fatal("resize did not retire proofs")
+	}
+}

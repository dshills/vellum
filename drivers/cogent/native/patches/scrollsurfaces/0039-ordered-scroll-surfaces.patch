+func TestScrollPaintSharedMaskCopiesPreserveCurrentBytes(t *testing.T) {
+	mask := &image.Alpha{Pix: make([]byte, 24*7), Stride: 24, Rect: image.Rect(-3, 5, 5, 12)}
+	for y := mask.Rect.Min.Y; y < mask.Rect.Max.Y; y++ {
+		for x := mask.Rect.Min.X; x < mask.Rect.Max.X; x++ {
+			mask.SetAlpha(x, y, color.Alpha{A: uint8(x*3 + y*11)})
+		}
+	}
+	fill := image.NewUniform(color.RGBA{R: 151, A: 255})
+	p := &scrollPaintPlan{}
+	p.addMask(mask, image.Pt(8, 9), image.Rect(0, 0, 40, 40), fill)
+	firstBytes := p.bytes
+	p.addMask(mask, image.Pt(10, 11), image.Rect(0, 0, 40, 40), image.NewUniform(color.NRGBA{B: 199, A: 137}))
+	if p.failed || p.ops[0].mask != p.ops[1].mask || p.bytes-firstBytes != int(unsafe.Sizeof(scrollPaintOp{})) {
+		t.Fatal("unchanged mask payload not shared/accounted once")
+	}
+	first := bytes.Clone(p.ops[0].mask.Pix)
+	mask.Pix[mask.PixOffset(-3, 5)] ^= 0xff
+	p.addMask(mask, image.Pt(12, 13), image.Rect(0, 0, 40, 40), fill)
+	if p.ops[2].mask == p.ops[0].mask || !bytes.Equal(first, p.ops[0].mask.Pix) || p.ops[2].mask.Pix[0] == first[0] {
+		t.Fatal("changed borrowed mask mutated earlier owned operation")
+	}
+	mask.Pix[mask.PixOffset(-3, 5)] ^= 0xff
+	p.addMask(mask, image.Pt(14, 15), image.Rect(0, 0, 40, 40), fill)
+	if !bytes.Equal(first, p.ops[3].mask.Pix) || p.ops[3].mask == p.ops[2].mask {
+		t.Fatal("same-pointer A B A capture lost exact paint bytes")
+	}
+	if p.bytes != 4*int(unsafe.Sizeof(scrollPaintOp{}))+3*(mask.Rect.Dx()*mask.Rect.Dy()+int(unsafe.Sizeof(image.Alpha{}))) {
+		t.Fatal("unique payload accounting", p.bytes)
+	}
+}
+
+func TestScrollPaintCoveredClearRetainsOneOwnedOperation(t *testing.T) {
+	bounds := image.Rect(11, 9, 191, 105)
+	p := &scrollPaintPlan{}
+	p.addUniform(pimage.NewDraw(bounds, image.NewUniform(color.NRGBA{R: 121, A: 17}), nil, bounds.Min, draw.Src))
+	p.addUniform(pimage.NewDraw(bounds, image.NewUniform(color.RGBA{G: 91, B: 31, A: 255}), nil, bounds.Min, draw.Over))
+	if len(p.ops) != 1 || p.bytes != int(unsafe.Sizeof(scrollPaintOp{})) {
+		t.Fatal("covered clear was retained/overaccounted")
+	}
+	actual := New(math32.Vec2(240, 160)).(*Renderer)
+	reference := New(math32.Vec2(240, 160)).(*Renderer)
+	fill := image.NewUniform(color.NRGBA{R: 221, G: 199, B: 173, A: 201})
+	draw.Draw(actual.image, actual.image.Bounds(), fill, image.Point{}, draw.Src)
+	copy(reference.image.Pix, actual.image.Pix)
+	actual.replayScrollPlan(p, bounds)
+	draw.Draw(reference.image, bounds, image.NewUniform(color.NRGBA{R: 121, A: 17}), bounds.Min, draw.Src)
+	draw.Draw(reference.image, bounds, image.NewUniform(color.RGBA{G: 91, B: 31, A: 255}), bounds.Min, draw.Over)
+	if !bytes.Equal(actual.image.Pix, reference.image.Pix) {
+		t.Fatal("covered-clear plan changed final pixels")
+	}
+	p.addUniform(pimage.NewDraw(bounds, image.NewUniform(color.NRGBA{R: 211, A: 31}), nil, bounds.Min, draw.Over))
+	if len(p.ops) != 2 {
+		t.Fatal("translucent draw elided a prior operation")
+	}
+}

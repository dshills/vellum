+func TestScrollPaintPathRetentionHasExactCapacity(t *testing.T) {
+	p := &scrollPaintPlan{winding: true}
+	var path Path
+	path.Start(math32.Vec2(1, 2).ToFixed())
+	path.Line(math32.Vec2(3, 4).ToFixed())
+	path.Stop(true)
+	p.addPath(path, image.Rect(0, 0, 10, 10), image.NewUniform(color.RGBA{A: 255}))
+	if p.failed || len(p.ops) != 1 || cap(p.ops[0].path) != len(p.ops[0].path) {
+		t.Fatal("retained path capacity exceeds accounted length")
+	}
+	path[1] += 64
+	if p.ops[0].path[1] == path[1] {
+		t.Fatal("retained borrowed path")
+	}
+}

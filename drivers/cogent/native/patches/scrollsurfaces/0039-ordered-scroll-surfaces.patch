+type curveLines struct {
+	*Filler
+	points []fixed.Point26_6
+}
+
+func (r *curveLines) LineF(p fixed.Point26_6) { r.points = append(r.points, p); r.A = p }
+func (r *curveLines) Line(p fixed.Point26_6)  { r.LineF(p) }
+func (r *curveLines) JoinF()                  {}
+
+func recordedCurve(points [4]fixed.Point26_6, cubic bool) []fixed.Point26_6 {
+	r := &curveLines{Filler: &Filler{A: points[0]}}
+	if cubic {
+		r.CubeBezierF(r, points[1], points[2], points[3])
+	} else {
+		r.QuadBezierF(r, points[1], points[2])
+	}
+	return r.points
+}
+
+func TestCurveFlatteningExactIntegerTranslations(t *testing.T) {
+	random := rand.New(rand.NewSource(319))
+	for index := 0; index < 800; index++ {
+		var points [4]fixed.Point26_6
+		for i := range points {
+			points[i] = fixed.Point26_6{X: fixed.Int26_6(random.Intn(32000) - 16000), Y: fixed.Int26_6(random.Intn(32000) - 16000)}
+		}
+		for _, cubic := range []bool{false, true} {
+			original := recordedCurve(points, cubic)
+			for _, delta := range []fixed.Point26_6{{X: 64, Y: 0}, {X: 0, Y: -64}, {X: 37 * 64, Y: -29 * 64}, {X: -251 * 64, Y: 109 * 64}, {X: 1 << 22, Y: -1 << 22}} {
+				translated := points
+				for i := range translated {
+					translated[i] = translated[i].Add(delta)
+				}
+				got := recordedCurve(translated, cubic)
+				if len(got) != len(original) {
+					t.Fatal("translation changed subdivision count", index, cubic, delta)
+				}
+				for i := range got {
+					if got[i] != original[i].Add(delta) {
+						t.Fatalf("translation changed edge: curve=%d cubic=%v delta=%v sample=%d got=%v want=%v", index, cubic, delta, i, got[i], original[i].Add(delta))
+					}
+				}
+			}
+		}
+	}
+}
+
+func TestCurveWideHullKeepsExactEndpointAndNextSegment(t *testing.T) {
+	for _, cubic := range []bool{false, true} {
+		for _, end := range []fixed.Point26_6{{X: 1, Y: -1}, {X: -17, Y: 65}, {X: 1<<30 - 3, Y: -(1 << 30) + 5}} {
+			r := &curveLines{Filler: &Filler{A: fixed.Point26_6{X: -(1 << 30), Y: 1 << 30}}}
+			b := fixed.Point26_6{X: 1 << 30, Y: -(1 << 30)}
+			if cubic {
+				r.CubeBezierF(r, b, fixed.Point26_6{X: 19, Y: 23}, end)
+			} else {
+				r.QuadBezierF(r, b, end)
+			}
+			if r.A != end || r.points[len(r.points)-1] != end {
+				t.Fatal("wide hull lost exact terminal point", cubic, end, r.A)
+			}
+			start := len(r.points)
+			next := fixed.Point26_6{X: 257, Y: 129}
+			r.QuadBezierF(r, end, next) // Degenerate first control preserves the start/end boundary.
+			if r.A != next || len(r.points) != start+1 || r.points[start] != next {
+				t.Fatal("successive segment boundary changed", end, next, r.A)
+			}
+		}
+	}
+}

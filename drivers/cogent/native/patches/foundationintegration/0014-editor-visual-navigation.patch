+func TestVellumEditorVisualWrappedIsolation(t *testing.T) {
+	_, ed := visualEditor(t, "\u2067אבג\u2069abc many words wrapping here", 12)
+	if ed.visualParagraphRTL(textpos.Pos{}) {
+		t.Fatal("isolated RTL text changed LTR paragraph direction")
+	}
+	g := ed.editorInteraction()
+	for _, a := range g.Carets {
+		for _, b := range g.Carets {
+			if a.Rune == b.Rune && a.Line+1 == b.Line {
+				ed.SetEditingSelection(a.Rune, a.Rune)
+				ed.rememberVisualCaret(a)
+				ed.cursorForward(1)
+				if ed.EditingState().Cursor != a.Rune || ed.visualState.line != b.Line {
+					t.Fatal("wrong cross-line direction after isolate")
+				}
+				return
+			}
+		}
+	}
+	t.Fatal("missing wrapped boundary")
+}

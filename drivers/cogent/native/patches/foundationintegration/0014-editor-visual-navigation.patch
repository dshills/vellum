+func TestVellumEditorVisualPreferredColumn(t *testing.T) {
+	_, ed := visualEditor(t, "abcdefghij\nx\nabcdefghij\n", 30)
+	ed.SetEditingSelection(8, 8)
+	ed.cursorDown(1)
+	if ed.CursorPos.Char != 1 {
+		t.Fatal("short line endpoint", ed.CursorPos)
+	}
+	ed.cursorDown(1)
+	if ed.CursorPos.Char != 8 {
+		t.Fatal("preferred visual X lost", ed.CursorPos)
+	}
+	ed.cursorUp(1)
+	ed.cursorUp(1)
+	if ed.CursorPos != (textpos.Pos{Line: 0, Char: 8}) {
+		t.Fatal("preferred X did not reverse", ed.CursorPos)
+	}
+	ed.SetEditingSelection(2, 2)
+	ed.cursorDown(1)
+	ed.cursorDown(1)
+	if ed.CursorPos.Char != 2 {
+		t.Fatal("explicit selection did not reset preferred X", ed.CursorPos)
+	}
+}

+package textcore
+
+import (
+	"cmp"
+	"cogentcore.org/core/math32"
+	"cogentcore.org/core/paint"
+	"cogentcore.org/core/text/shaped"
+	"cogentcore.org/core/text/textpos"
+	"golang.org/x/text/unicode/bidi"
+	"slices"
+)
+
+type editorVisualState struct {
+	line, offset      int
+	revision          uint64
+	scroll            float32
+	viewport          math32.Box2
+	unsupported       map[int]bool
+	interaction       *shaped.Interaction
+	vertical          bool
+	preferredX        float32
+	preferredRevision uint64
+	preferredCursor   textpos.Pos
+}
+
+func (ed *Base) visualAffinity(offset, fallback int) int {
+	if ed.visualState.revision == ed.nativeRevision && ed.visualState.offset == offset {
+		return ed.visualState.line
+	}
+	return fallback
+}
+func (ed *Base) rememberVisualCaret(c shaped.Caret) {
+	ed.visualState.line, ed.visualState.offset, ed.visualState.revision = c.Line, c.Rune, ed.nativeRevision
+}
+func (ed *Base) editorInteraction() *shaped.Interaction {
+	if ed.visualState.interaction != nil {
+		return ed.visualState.interaction
+	}
+	g := &shaped.Interaction{Carets: slices.Clone(ed.nativeGeometry.Carets)}
+	slices.SortFunc(g.Carets, func(a, b shaped.Caret) int {
+		if a.Line != b.Line {
+			return cmp.Compare(a.Line, b.Line)
+		}
+		if a.Pos.X != b.Pos.X {
+			return cmp.Compare(a.Pos.X, b.Pos.X)
+		}
+		return cmp.Compare(a.Rune, b.Rune)
+	})
+
+	// Nearest needs physical line bounds even when no unsupported runs exist.
+	bounds := map[int]math32.Box2{}
+	for _, c := range g.Carets {
+		box := math32.Box2{Min: c.Pos, Max: c.Pos.Add(math32.Vec2(0, c.Height))}
+		if old, ok := bounds[c.Line]; ok {
+			old.ExpandByBox(box)
+			box = old
+		}
+		bounds[c.Line] = box
+	}
+	for line := range ed.visualState.unsupported {
+		if _, ok := bounds[line]; !ok {
+			y := ed.Geom.Pos.Content.Y + float32(ed.Scene.SceneGeom.Pos.Y) + (float32(line)-ed.scrollPos)*ed.charSize.Y
+			bounds[line] = math32.B2(ed.nativeViewport().Min.X, y, ed.nativeViewport().Max.X, y+ed.charSize.Y)
+		}
+	}
+	g.Lines = nil
+	for line, box := range bounds {
+		g.Lines = append(g.Lines, shaped.InteractionLine{Index: line, Bounds: box, Unsupported: ed.visualState.unsupported[line]})
+	}
+	slices.SortFunc(g.Lines, func(a, b shaped.InteractionLine) int { return cmp.Compare(a.Index, b.Index) })
+	ed.visualState.interaction = g
+	return g
+}
+func (ed *Base) cachedVisualCaret(pos textpos.Pos) (shaped.Caret, bool) {
+	if ed.Lines == nil || ed.Scene == nil {
+		return shaped.Caret{}, false
+	}
+	ed.refreshNativeDocument()
+	if ed.nativeLayoutRevision != ed.nativeRevision || ed.visualState.scroll != ed.scrollPos || ed.visualState.viewport != ed.nativeViewport() {
+		return shaped.Caret{}, false
+	}
+	offset := ed.nativeOffset(pos)
+	line := ed.visualAffinity(offset, ed.Lines.PosToView(ed.viewId, pos).Line)
+	if ed.visualState.unsupported[line] {
+		return shaped.Caret{}, false
+	}
+	return ed.editorInteraction().At(offset, line)
+}
+
+// Refresh queued-edit/scroll layout into a scratch painter, without emitting a
+// render notification or appending commands to the active frame.
+func (ed *Base) refreshVisualGeometry() bool {
+	if ed.Scene == nil || ed.Lines == nil || ed.charSize.X <= 0 || ed.charSize.Y <= 0 {
+		return false
+	}
+	ed.refreshNativeDocument()
+	if len(ed.nativeGeometry.Carets) > 0 && ed.nativeLayoutRevision == ed.nativeRevision && ed.visualState.scroll == ed.scrollPos && ed.visualState.viewport == ed.nativeViewport() {
+		return true
+	}
+	ed.layoutAllLines()
+	if len(ed.lineRenders) == 0 || ed.visSize.Y <= 0 {
+		return false
+	}
+	painter := ed.Scene.Painter
+	ed.Scene.Painter = *paint.NewPainter(painter.Size)
+	defer func() { ed.Scene.Painter = painter }()
+	ed.beginNativeGeometry()
+	ed.renderLines()
+	ed.finishNativeGeometry()
+	return len(ed.nativeGeometry.Carets) > 0
+}
+func (ed *Base) visualParagraphRTL(pos textpos.Pos) bool {
+	if pos.Line < 0 || pos.Line >= len(ed.nativeOffsets) {
+		return false
+	}
+	start, end := ed.nativeOffsets[pos.Line], len(ed.nativeRunes)
+	if pos.Line+1 < len(ed.nativeOffsets) {
+		end = ed.nativeOffsets[pos.Line+1] - 1
+	}
+	isolateDepth := 0
+	for _, r := range ed.nativeRunes[start:end] {
+		prop, _ := bidi.LookupRune(r)
+		switch prop.Class() {
+		case bidi.LRI, bidi.RLI, bidi.FSI:
+			isolateDepth++
+		case bidi.PDI:
+			isolateDepth = max(0, isolateDepth-1)
+		case bidi.L:
+			if isolateDepth == 0 {
+				return false
+			}
+		case bidi.R, bidi.AL:
+			if isolateDepth == 0 {
+				return true
+			}
+		}
+	}
+	return false
+}
+func (ed *Base) cursorVisual(delta int, vertical bool) bool {
+	if !ed.refreshVisualGeometry() {
+		return false
+	}
+	org := ed.validateCursor()
+	offset := ed.nativeOffset(org)
+	g := ed.editorInteraction()
+	if vertical && (!ed.visualState.vertical || ed.visualState.preferredRevision != ed.nativeRevision || ed.visualState.preferredCursor != org) {
+		ed.visualState.preferredX = ed.charStartPos(org).X + float32(ed.Scene.SceneGeom.Pos.X)
+		ed.visualState.vertical = true
+		ed.visualState.preferredRevision = ed.nativeRevision
+	}
+	if !vertical {
+		ed.visualState.vertical = false
+	}
+	c, ok := g.At(offset, ed.visualAffinity(offset, ed.Lines.PosToView(ed.viewId, org).Line))
+	if !ok || !g.SupportsLine(c.Line) {
+		return false
+	}
+	old := c
+	if vertical {
+		target := c.Line + delta
+		if target >= 0 && target < ed.Lines.ViewLines(ed.viewId) && !g.SupportsLine(target) && !ed.visualState.unsupported[target] {
+			ed.scrollPos = float32(max(0, target-ed.visSize.Y/2))
+			if ed.refreshVisualGeometry() {
+				g = ed.editorInteraction()
+			}
+		}
+		if !g.SupportsLine(target) {
+			return false
+		}
+		found := false
+		distance := float32(1e30)
+		for _, other := range g.Carets {
+			if other.Line == target {
+				d := math32.Abs(other.Pos.X - ed.visualState.preferredX)
+				if d < distance {
+					c = other
+					distance = d
+					found = true
+				}
+			}
+		}
+		if !found {
+			return false
+		}
+	} else {
+		// Each source paragraph may choose a different cross-line direction.
+		g.RTL = ed.visualParagraphRTL(org)
+		c, ok = g.Move(c.Rune, c.Line, delta)
+		if !ok {
+			return false
+		}
+		if c == old {
+			// A true document edge stays put. If the adjacent line is outside the
+			// viewport, shift the viewport and choose its actual shaped edge.
+			step := 1
+			if delta < 0 {
+				step = -1
+			}
+			target := c.Line + step
+			if g.RTL {
+				target = c.Line - step
+			}
+			if target < 0 || target >= ed.Lines.ViewLines(ed.viewId) {
+				ed.cursorSelectShow(org)
+				return true
+			}
+			ed.scrollPos = float32(max(0, target-ed.visSize.Y/2))
+			if !ed.refreshVisualGeometry() {
+				return false
+			}
+			next := ed.editorInteraction()
+			found := false
+			for _, other := range next.Carets {
+				if other.Line == target {
+					if !found || step < 0 {
+						c = other
+						found = true
+					}
+				}
+			}
+			if !found || !next.SupportsLine(target) {
+				return false
+			}
+		}
+	}
+	ed.rememberVisualCaret(c)
+	ed.CursorPos = ed.Lines.ValidPos(ed.nativePos(c.Rune))
+	if !vertical {
+		ed.setCursorColumn(ed.CursorPos)
+	}
+	ed.cursorSelectShow(org)
+	return true
+}

+func TestVellumEditorVisualBeyondViewport(t *testing.T) {
+	b, ed := visualEditor(t, strings.Repeat("abc אבג xyz\n", 30), 30)
+	ed.SetEditingSelection(6, 6)
+	x := ed.charStartPos(ed.CursorPos).X
+	for i := 1; i <= 20; i++ {
+		ed.cursorDown(1)
+		b.Scene.LayoutRenderScene()
+		if ed.CursorPos.Line != i || math32.Abs(ed.charStartPos(ed.CursorPos).X-x) > 1 {
+			t.Fatal("visual column lost across viewport", i, ed.CursorPos, "x", x, "got", ed.charStartPos(ed.CursorPos).X, "preferred", ed.visualState.preferredX, "scroll", ed.scrollPos, "affinity", ed.visualState.line, ed.visualState.offset)
+		}
+	}
+}
+func TestVellumEditorVisualReflowAffinity(t *testing.T) {
+	b, ed := visualEditor(t, "many words that wrap across multiple narrow lines here", 12)
+	g := ed.editorInteraction()
+	c := g.Carets[len(g.Carets)-1]
+	ed.SetEditingSelection(c.Rune, c.Rune)
+	ed.rememberVisualCaret(c)
+	ed.Styler(func(s *styles.Style) { s.Min.X.Em(40); s.Max.X.Em(40) })
+	ed.Update()
+	b.Scene.Resize(math32.Geom2DInt{Size: image.Pt(700, 180)})
+	b.Scene.LayoutRenderScene()
+	state := ed.EditingState()
+	if _, ok := ed.editorInteraction().At(c.Rune, state.VisualLine); !ok {
+		t.Fatal("obsolete wrapped affinity", state.VisualLine)
+	}
+}

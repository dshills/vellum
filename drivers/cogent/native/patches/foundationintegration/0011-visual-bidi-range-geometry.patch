@@ -0,0 +1,168 @@
+// Experimental strong-caret navigation and owned layout geometry for Vellum.
+package core
+
+import (
+	"cogentcore.org/core/math32"
+	"cogentcore.org/core/text/shaped"
+	"cogentcore.org/core/text/textpos"
+	"image"
+	"slices"
+)
+
+func (tf *TextField) interactionGeometry() *shaped.Interaction {
+	if tf.renderAll == nil {
+		return nil
+	}
+	if tf.visualGeometry == nil {
+		tf.visualGeometry = tf.renderAll.InteractionLayout()
+		if tf.NoEcho || len(tf.editText) == 0 {
+			bounds := textpos.GraphemeBounds(tf.editText)
+			tf.visualGeometry.Carets = slices.DeleteFunc(tf.visualGeometry.Carets, func(c shaped.Caret) bool {
+				return func() bool { _, ok := slices.BinarySearch(bounds, c.Rune); return !ok }()
+			})
+		}
+	}
+	return tf.visualGeometry
+}
+func (tf *TextField) cursorVisual(delta int) {
+	tf.refreshInteractionLayout()
+	if g := tf.interactionGeometry(); g != nil {
+		if c, ok := g.Move(tf.cursorPos, tf.visualLine, delta); ok {
+			tf.cursorPos, tf.visualLine = c.Rune, c.Line
+			tf.cursorLine = c.Line
+			if tf.selectMode {
+				tf.selectRegionUpdate(tf.cursorPos)
+			}
+			tf.NeedsRender()
+			return
+		}
+	}
+	// Before layout, logical grapheme navigation is the only available behavior.
+	if delta > 0 {
+		tf.cursorForward(textpos.NextGrapheme(tf.editText, tf.cursorPos) - tf.cursorPos)
+	} else {
+		tf.cursorBackward(tf.cursorPos - textpos.PrevGrapheme(tf.editText, tf.cursorPos))
+	}
+}
+
+// TextFieldGeometry is an owned snapshot in physical window/scene pixels.
+// Native clients copy this on the UI thread and publish it with the same text/ack.
+type TextFieldGeometry struct {
+	Cells    []shaped.Cell
+	Carets   []shaped.Caret
+	Viewport math32.Box2
+}
+
+func (tf *TextField) NativeTextGeometry() TextFieldGeometry {
+	var out TextFieldGeometry
+	if tf.Scene == nil || tf.NoEcho {
+		return out
+	}
+	out.Viewport = math32.B2FromRect(tf.textViewport().Add(tf.Scene.SceneGeom.Pos))
+	if tf.renderAll == nil || tf.visualText != string(tf.editText) || tf.visualNoEcho != tf.NoEcho {
+		return out
+	}
+	off := tf.effPos.Add(math32.FromPoint(tf.Scene.SceneGeom.Pos)).Sub(math32.Vec2(tf.visualScroll, 0))
+	if len(tf.editText) == 0 {
+		out.Carets = []shaped.Caret{{Rune: 0, Line: 0, Pos: off, Height: max(1, tf.lineHeight)}}
+		return out
+	}
+	if g := tf.interactionGeometry(); g != nil {
+		for _, c := range g.Cells {
+			c.Rect = c.Rect.Translate(off)
+			out.Cells = append(out.Cells, c)
+		}
+		for _, c := range g.Carets {
+			c.Pos = c.Pos.Add(off)
+			out.Carets = append(out.Carets, c)
+		}
+	}
+	return out
+}
+
+func (tf *TextField) cursorVisualLine(delta int) {
+	tf.refreshInteractionLayout()
+	if g := tf.interactionGeometry(); g != nil {
+		if c, ok := g.At(tf.cursorPos, tf.visualLine); ok && g.SupportsLine(c.Line) && g.SupportsLine(c.Line+delta) {
+			target := c.Line + delta
+			best := c
+			distance := float32(1e30)
+			found := false
+			for _, other := range g.Carets {
+				if other.Line == target {
+					d := math32.Abs(other.Pos.X - c.Pos.X)
+					if d < distance {
+						best = other
+						distance = d
+						found = true
+					}
+				}
+			}
+			if found || target < 0 || target >= len(tf.renderAll.Lines) {
+				tf.cursorPos, tf.visualLine, tf.cursorLine = best.Rune, best.Line, best.Line
+				if tf.selectMode {
+					tf.selectRegionUpdate(tf.cursorPos)
+				}
+				tf.NeedsRender()
+				return
+			}
+		}
+	}
+	// Unsupported interaction runs retain their existing glyph-based navigation.
+	if tf.renderAll != nil {
+		r := tf.renderAll.RuneAtLineDelta(tf.cursorPos, delta)
+		tf.cursorPos = textpos.GraphemeAtOrBefore(tf.editText, max(0, min(len(tf.editText), r)))
+		tf.visualLine = -1
+		tf.updateLinePos()
+		if tf.selectMode {
+			tf.selectRegionUpdate(tf.cursorPos)
+		}
+		tf.NeedsRender()
+	}
+}
+
+// Exclude leading/trailing icons from text clipping and native hit-testing.
+func (tf *TextField) textViewport() image.Rectangle {
+	bounds := tf.Geom.ContentBBox
+	return image.Rect(int(tf.effPos.X), bounds.Min.Y, int(tf.effPos.X+tf.effSize.X), bounds.Max.Y).Intersect(bounds)
+}
+
+func (tf *TextField) refreshInteractionLayout() {
+	// A queued edit can precede its render. Refresh before consulting layout.
+	if tf.Scene != nil && (tf.renderAll == nil || tf.visualText != string(tf.editText) || tf.visualNoEcho != tf.NoEcho) {
+		tf.configTextSize(tf.Geom.Size.Actual.Content.Sub(tf.iconsSize()))
+		tf.clampVisualScroll()
+	}
+}
+
+func (tf *TextField) clampVisualScroll() {
+	if tf.hasWordWrap() {
+		tf.visualScroll = 0
+		return
+	}
+	width := max(float32(0), tf.effSize.X-1)
+	advance := float32(0)
+	if g := tf.interactionGeometry(); g != nil {
+		advance = max(advance, g.ExtentX)
+		for _, cell := range g.Cells {
+			advance = max(advance, cell.Rect.Max.X)
+		}
+	}
+	tf.visualScroll = max(float32(0), min(tf.visualScroll, max(float32(0), advance-width)))
+}
+
+// Preserve prior positioning for unsupported vertical/math interaction runs.
+func (tf *TextField) legacyCharPos(idx int) math32.Vector2 {
+	if idx <= 0 || len(tf.renderAll.Lines) == 0 {
+		return math32.Vector2{}
+	}
+	bb := tf.renderAll.RuneBounds(idx)
+	if idx >= len(tf.editText) {
+		if tf.numLines > 1 && tf.editText[len(tf.editText)-1] == ' ' {
+			bb.Max.X += tf.lineHeight * 0.2
+			return bb.Max
+		}
+		return bb.Max
+	}
+	return bb.Min
+}

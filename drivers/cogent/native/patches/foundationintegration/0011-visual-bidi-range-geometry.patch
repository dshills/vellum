+func TestVellumSplitGraphemeClustersAndRunsMerge(t *testing.T) {
+	makeRun := func(offset, count int, glyphs []shaping.Glyph) *Run {
+		r := &Run{Output: shaping.Output{Direction: di.DirectionLTR, Advance: fixed.I(10 * count), Runes: shaping.Range{Offset: offset, Count: count}, Glyphs: glyphs}}
+		r.MaxBounds = math32.B2(0, 0, float32(10*count), 20)
+		return r
+	}
+	a := shaping.Glyph{ClusterIndex: 0, RuneCount: 1, Advance: fixed.I(10)}
+	b := shaping.Glyph{ClusterIndex: 1, RuneCount: 1, Advance: fixed.I(10)}
+	for _, runs := range [][]shaped.Run{{makeRun(0, 2, []shaping.Glyph{a, b})}, {makeRun(0, 1, []shaping.Glyph{a}), makeRun(1, 1, []shaping.Glyph{b})}} {
+		ls := shaped.Lines{Source: rich.NewText(rich.NewStyle(), []rune("é")), Lines: []shaped.Line{{Runs: runs}}}

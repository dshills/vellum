+		corners := []math32.Vector2{box.Min, math32.Vec2(box.Max.X, box.Min.Y), box.Max, math32.Vec2(box.Min.X, box.Max.Y)}
+		transformed := math32.Box2{Min: ctx.Cumulative.MulPoint(corners[0]), Max: ctx.Cumulative.MulPoint(corners[0])}

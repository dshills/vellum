+	for range 3 {
+		rs.RenderText(item)
+		if item.Geometry != geometry {
+			t.Fatal("render replay replaced immutable geometry")
+		}
+	}
+	// Region changes use the same cells; the UI publishes a fresh matching item.
+	item.Text.SelectReset()
+	item.Text.SelectRegion(textpos.Range{Start: 0, End: 3})
+	next := render.NewTextWithGeometry(item.Text, &item.Context.Style, &item.Context, item.Position, geometry)
+	if next.Geometry != geometry {
+		t.Fatal("selection change rebuilt geometry")
+	}
+	rs.RenderText(next)

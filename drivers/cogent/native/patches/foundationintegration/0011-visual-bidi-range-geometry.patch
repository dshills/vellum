+// Experimental horizontal interaction geometry shared by Vellum editing and Cocoa.
+package shaped
+
+import (
+	"cogentcore.org/core/math32"
+	"cogentcore.org/core/text/rich"
+	"cogentcore.org/core/text/textpos"
+	"math"
+	"slices"
+)
+
+// Cell covers a complete source grapheme using typographic advance, including spaces.
+// Rect is relative to the rendered Lines origin. Line is a physical line index.
+type Cell struct {
+	Range textpos.Range
+	Rect  math32.Box2
+	RTL   bool
+	Line  int
+}
+
+// Caret chooses the strong (paragraph-direction) edge at a bidi junction.
+// Line preserves upstream/downstream affinity at a wrapped boundary.
+type Caret struct {
+	Rune, Line int
+	Pos        math32.Vector2
+	Height     float32
+}
+type Interaction struct {
+	Cells   []Cell
+	Carets  []Caret
+	RTL     bool
+	Lines   []InteractionLine
+	ExtentX float32
+}
+type InteractionLine struct {
+	Index       int
+	Bounds      math32.Box2
+	Unsupported bool
+}
+type cellRun interface {
+	InteractionCells([]int) []Cell
+	InteractionAdvance() math32.Vector2
+}
+
+// InteractionLayout follows rendered run order. Unsupported vertical/math runs
+// return no fabricated cells. A strong caret is chosen separately on each line.
+func (ls *Lines) InteractionLayout() *Interaction {
+	out := &Interaction{RTL: ls.Direction == rich.RTL, ExtentX: ls.Bounds.Max.X + ls.Offset.X}
+	bounds := textpos.GraphemeBounds(ls.Source.Join())
+	for li := range ls.Lines {
+		ln := &ls.Lines[li]
+		off := ls.Offset.Add(ln.Offset)
+		candidates := map[int]Caret{}
+		ranks := map[int]int{}
+		add := func(r int, x float32, rtl, leading bool, rect math32.Box2) {
+			rank := 0
+			if rtl == (ls.Direction == rich.RTL) {
+				rank += 2
+			}
+			if leading {
+				rank++
+			}
+			if old, ok := ranks[r]; !ok || rank > old {
+				candidates[r] = Caret{Rune: r, Line: li, Pos: math32.Vec2(x, rect.Min.Y), Height: rect.Size().Y}
+				ranks[r] = rank
+			}
+		}
+		var cells []Cell
+		indexes := map[textpos.Range]int{}
+		unsupported := false
+		for _, run := range ln.Runs {
+			if cr, ok := run.(cellRun); ok {
+				runCells := cr.InteractionCells(bounds)
+				if len(runCells) == 0 && run.Runes().Len() > 0 {
+					unsupported = true
+				}
+				for _, cell := range runCells {
+					cell.Line = li
+					cell.Rect = cell.Rect.Translate(off)
+					// Font fallback can split a grapheme across runs. Combine its advances
+					// before choosing edges so no interior fallback boundary becomes a caret.
+					if i, ok := indexes[cell.Range]; ok {
+						cells[i].Rect.ExpandByBox(cell.Rect)
+					} else {
+						indexes[cell.Range] = len(cells)
+						cells = append(cells, cell)
+					}
+				}
+			} else if run.Runes().Len() > 0 {
+				unsupported = true
+			}
+			if cr, ok := run.(cellRun); ok {
+				off = off.Add(cr.InteractionAdvance())
+			} else {
+				off.X += run.Advance()
+			}
+			out.ExtentX = max(out.ExtentX, off.X)
+		}
+		for _, cell := range cells {
+			out.Cells = append(out.Cells, cell)
+			a, b := cell.Rect.Min.X, cell.Rect.Max.X
+			if cell.RTL {
+				a, b = b, a
+			}
+			add(cell.Range.Start, a, cell.RTL, true, cell.Rect)
+			add(cell.Range.End, b, cell.RTL, false, cell.Rect)
+		}
+
+		if len(candidates) == 0 && len(ln.Runs) == 0 {
+			candidates[ln.SourceRange.Start] = Caret{Rune: ln.SourceRange.Start, Line: li, Pos: ls.Offset.Add(ln.Offset).Add(ln.Bounds.Min), Height: max(ln.Bounds.Size().Y, ls.LineHeight)}
+		}
+		var line []Caret
+		for _, c := range candidates {
+			line = append(line, c)
+		}
+		slices.SortFunc(line, func(a, b Caret) int {
+			if a.Pos.X < b.Pos.X {
+				return -1
+			}
+			if a.Pos.X > b.Pos.X {
+				return 1
+			}
+			return a.Rune - b.Rune
+		})
+		out.Carets = append(out.Carets, line...)
+		box := ln.Bounds.Translate(ls.Offset.Add(ln.Offset))
+		for _, c := range line {
+			box.ExpandByPoint(c.Pos)
+			box.ExpandByPoint(c.Pos.Add(math32.Vec2(0, c.Height)))
+		}
+		out.Lines = append(out.Lines, InteractionLine{Index: li, Bounds: box, Unsupported: unsupported})
+	}
+	return out
+}
+
+// At defaults to the downstream line when affinity does not identify a stop.
+func (g *Interaction) At(r, line int) (Caret, bool) {
+	var found Caret
+	ok := false
+	for _, c := range g.Carets {
+		if c.Rune == r {
+			found = c
+			ok = true
+			if c.Line == line {
+				return c, true
+			}
+		}
+	}
+	return found, ok
+}
+
+// SupportsLine reports whether the whole line has horizontal interaction geometry.
+func (g *Interaction) SupportsLine(line int) bool {
+	return !g.unsupportedLine(line)
+}
+
+func (g *Interaction) unsupportedLine(line int) bool {
+	for _, ln := range g.Lines {
+		if ln.Index == line {
+			return ln.Unsupported
+		}
+	}
+	return false
+}
+
+func (g *Interaction) Move(r, line, delta int) (Caret, bool) {
+	c, ok := g.At(r, line)
+	if !ok || g.unsupportedLine(c.Line) {
+		return c, false
+	}
+	if delta == 0 {
+		return c, true
+	}
+	step := 1
+	if delta < 0 {
+		step = -1
+		delta = -delta
+	}
+	for range delta {
+		i := slices.Index(g.Carets, c)
+		next := i + step
+		if next >= 0 && next < len(g.Carets) && g.Carets[next].Line == c.Line {
+			c = g.Carets[next]
+			continue
+		}
+		target := c.Line + step
+		if g.RTL {
+			target = c.Line - step
+		}
+		if g.unsupportedLine(target) {
+			return c, false
+		}
+		found := false
+		for _, other := range g.Carets {
+			if other.Line == target {
+				if !found || step < 0 {
+					c = other
+					found = true
+				}
+			}
+		}
+		if !found {
+			break
+		}
+	}
+	return c, true
+
+}
+
+// Nearest chooses a caret for pointer placement; native character hits instead
+// require a containing advance cell, so blank space does not claim a character.
+func (g *Interaction) Nearest(p math32.Vector2) (Caret, bool) {
+	if len(g.Carets) == 0 {
+		return Caret{}, false
+	}
+	lines := g.Lines
+	if len(lines) == 0 {
+		// Hand-constructed geometries also group carets by physical line.
+		indexes := map[int]int{}
+		for _, c := range g.Carets {
+			box := math32.Box2{Min: c.Pos, Max: c.Pos.Add(math32.Vec2(0, c.Height))}
+			if i, ok := indexes[c.Line]; ok {
+				lines[i].Bounds.ExpandByBox(box)
+			} else {
+				indexes[c.Line] = len(lines)
+				lines = append(lines, InteractionLine{Index: c.Line, Bounds: box})
+			}
+		}
+	}
+	line := lines[0].Index
+	vertical := float32(math.Inf(1))
+	for _, ln := range lines {
+		dy := max(ln.Bounds.Min.Y-p.Y, p.Y-ln.Bounds.Max.Y, float32(0))
+		if dy < vertical {
+			line = ln.Index
+			vertical = dy
+		}
+	}
+	if g.unsupportedLine(line) {
+		return Caret{}, false
+	}
+	best := g.Carets[0]
+	distance := float32(math.Inf(1))
+	for _, c := range g.Carets {
+		if c.Line != line {
+			continue
+		}
+		dx := math32.Abs(c.Pos.X - p.X)
+		if dx < distance {
+			best = c
+			distance = dx
+		}
+	}
+
+	return best, distance < float32(math.Inf(1))
+}

+// TextRegionFill fills selected advance fragments and avoids offscreen raster work.
+func (rs *Renderer) TextRegionFill(ctx *render.Context, cells []shaped.Cell, origin math32.Vector2, fill image.Image, ranges []textpos.Range) {
+	if fill == nil || len(ranges) == 0 {

+// InteractionCells exposes horizontal advance cells, never glyph ink bounds.
+// Ligatures are subdivided equally at extended grapheme boundaries; font GDEF
+// ligature carets are not currently used. Combining and ZWJ sequences stay whole.
+func (run *Run) InteractionCells(allBounds []int) []shaped.Cell {
+	if run.Direction.IsVertical() || run.Math.Path != nil {
+		return nil
+	}
+	var cells []shaped.Cell
+	x := float32(0)
+	for i := 0; i < len(run.Glyphs); {
+		g := run.Glyphs[i]
+		start, end := g.TextIndex(), g.TextIndex()+g.RunesCount()
+		advance := float32(0)
+		for i < len(run.Glyphs) && run.Glyphs[i].TextIndex() == start {
+			advance += math32.FromFixed(run.Glyphs[i].Advance)
+			i++
+		}
+		if len(allBounds) == 0 || start < 0 || end > allBounds[len(allBounds)-1] || end <= start {
+			x += advance
+			continue
+		}
+		a, _ := slices.BinarySearch(allBounds, start)
+		if a == len(allBounds) || allBounds[a] > start {
+			a--
+		}
+		b, _ := slices.BinarySearch(allBounds, end)
+		bounds := allBounds[a : b+1]
+
+		rtl := run.Direction.Progression() == di.TowardTopLeft
+		n := len(bounds) - 1
+		for j := 0; j < n; j++ {
+			k := j
+			if rtl {
+				k = n - 1 - j
+			}
+			a, b := x+advance*float32(k)/float32(n), x+advance*float32(k+1)/float32(n)
+			cells = append(cells, shaped.Cell{Range: textpos.Range{Start: bounds[j], End: bounds[j+1]}, Rect: math32.Box2{Min: math32.Vec2(a, run.MaxBounds.Min.Y), Max: math32.Vec2(b, run.MaxBounds.Max.Y)}, RTL: rtl})
+		}
+		x += advance
+	}
+	return cells
+}
+
+// InteractionAdvance follows the renderer even when cells are unsupported.
+func (run *Run) InteractionAdvance() math32.Vector2 {
+	if run.Direction.IsVertical() {
+		return math32.Vec2(0, run.Advance())
+	}
+	return math32.Vec2(run.Advance(), 0)
+}

+func TestVellumRenderedGeometryScrollAndWrap(t *testing.T) {
+	if cache := os.Getenv("VELLUM_FONT_CACHE"); cache != "" {
+		previous := shaped.NewShaper
+		defer func() { shaped.NewShaper = previous }()
+		shaped.NewShaper = func() shaped.Shaper {
+			sh := shapedgt.NewShaperWithFonts(fonts.Embedded).(*shapedgt.Shaper)
+			if err := sh.FontMap().UseSystemFonts(cache); err != nil {
+				panic(err)
+			}
+			return sh
+		}
+	}
+	for _, wrap := range []bool{false, true} {
+		b := NewBody()
+		source := "abc אבג 123 office é 👩‍💻 xyz more text"
+		tf := NewTextField(b).SetText(source)
+		tf.Styler(func(s *styles.Style) { s.SetTextWrap(wrap); s.Min.Set(units.Em(12), units.Em(2)); s.Max.X.Em(12) })
+		tf.SetEditingSelection(4, 7)
+		b.runAndShowNewWindow()
+		rw := b.Scene.RenderWindow()
+		b.waitNoEvents(rw)
+		b.AsyncLock()
+
+		tf.autoScroll()
+		tf.setEffPosAndSize()
+		g := tf.NativeTextGeometry()
+		if os.Getenv("VELLUM_FONT_CACHE") != "" {
+			count := 0
+			for _, ln := range tf.renderAll.Lines {
+				for _, run := range ln.Runs {
+					for _, glyph := range run.(*shapedgt.Run).Glyphs {
+						if glyph.TextIndex() >= 4 && glyph.TextIndex() < 7 {
+							if glyph.GlyphID == 0 {
+								t.Fatal("Hebrew fallback missing")
+							}
+							count++
+						}
+					}
+				}
+			}
+			if count != 3 {
+				t.Fatal("Hebrew glyphs not shaped")
+			}
+		}
+		if tf.renderVisible != tf.renderAll || len(g.Cells) == 0 || len(g.Carets) == 0 {
+			t.Fatal("geometry not tied to rendered layout")
+		}
+		if wrap && len(tf.renderAll.Lines) < 2 {
+			t.Fatal("wrap fixture did not wrap")
+		}
+		if !wrap {
+			tf.SetEditingSelection(len([]rune(source)), len([]rune(source)))
+			tf.autoScroll()
+			if tf.visualScroll <= 0 {
+				t.Fatal("long paragraph did not scroll")
+			}
+			tf.SetEditingSelection(0, 0)
+			tf.autoScroll()
+			if tf.visualScroll != 0 {
+				t.Fatal("scroll did not return to start")
+			}
+		}
+		for _, c := range g.Carets {
+			p := tf.charRenderPos(c.Rune)
+			want, _ := tf.interactionGeometry().At(c.Rune, tf.visualLine)
+			if p.X != want.Pos.X+tf.effPos.X-tf.visualScroll+float32(tf.Scene.SceneGeom.Pos.X) {
+				t.Fatal("caret and native layout disagree")
+			}
+		}
+		tf.SetEditingSelection(4, 7)
+		tf.NeedsRender()
+		b.AsyncUnlock()
+		for range 3 {
+			rw.renderWindow()
+		}
+		// Save the actual raster output for visual inspection; no self-generated golden.
+		if dir := os.Getenv("VELLUM_VISUAL_EVIDENCE"); dir != "" {
+			drawer := rw.SystemWindow.Composer().(*composer.ComposerDrawer).Drawer
+			path := dir + "/textfield-scroll.png"
+			if wrap {
+				path = dir + "/textfield-wrap.png"
+			}
+			f, err := os.Create(path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err = png.Encode(f, drawer.(getImager).GetImage()); err != nil {
+				t.Fatal(err)
+			}
+			f.Close()
+		}
+		rc := b.Scene.renderContext()
+		rc.Lock()
+		b.Close()
+		rc.Unlock()
+	}
+}

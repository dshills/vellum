+// textRegionRects normalizes logical ranges and coalesces physically adjacent
+// advance cells with matching vertical bounds. Disjoint bidi fragments stay apart.
+func textRegionRects(cells []shaped.Cell, ranges []textpos.Range) []math32.Box2 {
+	if len(ranges) == 0 {
+		return nil
+	}
+	normalized := slices.Clone(ranges)
+	slices.SortFunc(normalized, func(a, b textpos.Range) int {
+		if a.Start != b.Start {
+			return a.Start - b.Start
+		}
+		return a.End - b.End
+	})
+	merged := normalized[:0]
+	for _, r := range normalized {
+		if r.Len() <= 0 {
+			continue
+		}
+		if len(merged) > 0 && r.Start <= merged[len(merged)-1].End {
+			merged[len(merged)-1].End = max(merged[len(merged)-1].End, r.End)
+		} else {
+			merged = append(merged, r)
+		}
+	}
+	var rects []math32.Box2
+	for _, cell := range cells {
+		i := sort.Search(len(merged), func(i int) bool { return merged[i].End > cell.Range.Start })
+		if i < len(merged) && merged[i].Start < cell.Range.End {
+			rects = append(rects, cell.Rect)
+		}
+	}
+	slices.SortFunc(rects, func(a, b math32.Box2) int {
+		for _, pair := range [][2]float32{{a.Min.Y, b.Min.Y}, {a.Max.Y, b.Max.Y}, {a.Min.X, b.Min.X}} {
+			if pair[0] < pair[1] {
+				return -1
+			}
+			if pair[0] > pair[1] {
+				return 1
+			}
+		}
+		return 0
+	})
+	out := rects[:0]
+	for _, box := range rects {
+		if len(out) > 0 {
+			last := &out[len(out)-1]
+			if last.Min.Y == box.Min.Y && last.Max.Y == box.Max.Y && box.Min.X <= last.Max.X {
+				last.Max.X = max(last.Max.X, box.Max.X)
+				continue
+			}
+		}
+		out = append(out, box)
+	}
+	return out
+}

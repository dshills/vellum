+func TestVellumMixedAxisOffsetAndAggregatePointerLine(t *testing.T) {
+	a := &Run{Output: shaping.Output{Direction: di.DirectionTTB, Advance: fixed.I(20), Runes: shaping.Range{Offset: 0, Count: 1}}}
+	b := &Run{Output: shaping.Output{Direction: di.DirectionLTR, Advance: fixed.I(10), Runes: shaping.Range{Offset: 1, Count: 1}, Glyphs: []shaping.Glyph{{ClusterIndex: 1, RuneCount: 1, Advance: fixed.I(10)}}}}
+	b.MaxBounds = math32.Box2{Min: math32.Vec2(0, 0), Max: math32.Vec2(10, 20)}

+	"testing"
+)
+
+func visualField(source string) *TextField {
+	tf := NewTextField(NewBody()).SetText(source)
+	uc := units.Context{}
+	uc.Defaults()
+	ts := text.NewStyle()
+	ts.WhiteSpace = text.WrapNever
+	ts.ToDots(&uc)
+	sty := rich.NewStyle()
+	tf.renderAll = shapedgt.NewShaperWithFonts(fonts.Embedded).WrapLines(rich.NewText(sty, []rune(source)), sty, ts, math32.Vec2(1000, 100))
+	tf.visualText = source
+	tf.renderVisible = tf.renderAll
+	tf.numLines = 1
+	tf.lineHeight = tf.renderAll.LineHeight
+	return tf
+}
+func TestVellumVisualArrowHandlersAndSelection(t *testing.T) {
+	tf := visualField("abc אבג xyz")
+	tf.SetEditingSelection(0, 0)
+	var got []int
+	for range 7 {
+		ev := events.NewKey(events.KeyChord, 0, key.CodeRightArrow, 1<<key.Shift)
+		ev.Init()
+		tf.HandleEvent(ev)
+		if !ev.IsHandled() {
+			t.Fatal("handler not reached")
+		}
+		got = append(got, tf.cursorPos)
+	}
+	if !slices.Equal(got, []int{1, 2, 3, 4, 6, 5, 7}) {
+		t.Fatalf("right-arrow order %v", got)
+	}
+	if tf.selectRange.Start != 0 || tf.selectRange.End != 7 || tf.selectInit != 0 {
+		t.Fatal("logical selection anchor lost")
+	}
+	tf.cursorVisual(-1)
+	if tf.cursorPos != 5 || tf.selectRange.End != 5 {
+		t.Fatal("reverse arrow selection")
+	}
+	c, _ := tf.interactionGeometry().At(5, tf.visualLine)
+	tf.effPos = math32.Vec2(20, 30)
+	tf.visualScroll = 8
+	pos := tf.pixelToCursor(image.Pt(int(c.Pos.X+12), int(c.Pos.Y+31)))
+	if pos != 5 {
+		t.Fatalf("pointer placement %d", pos)
+	}
+	// Delete remains a logical grapheme edit, even after visual arrow movement.
+	tf.SetEditingSelection(4, 7)
+	tf.deleteSelection()
+	if string(tf.editText) != "abc  xyz" {
+		t.Fatal("selection deletion changed logical text")
+	}
+}

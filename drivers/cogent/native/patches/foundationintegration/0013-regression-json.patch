+package parse
+
+import (
+	"cogentcore.org/core/text/parse/languages"
+	"cogentcore.org/core/text/parse/lexer"
+	rules "cogentcore.org/core/text/parse/parser"
+	"cogentcore.org/core/tree"
+	"testing"
+)
+
+// Embedded grammars exercise many sibling replacements in the JSON node slice.
+func TestVellumEmbeddedGrammarNodeTypes(t *testing.T) {
+	for language := range StandardLanguageProperties {
+		data, err := languages.OpenParser(language)
+		if err != nil {
+			continue
+		}
+		t.Run(language.String(), func(t *testing.T) {
+			pr := NewParser()
+			if err := pr.ReadJSON(data); err != nil {
+				t.Fatal(err)
+			}
+			pr.Lexer.WalkDown(func(n tree.Node) bool {
+				if _, ok := n.(*lexer.Rule); !ok {
+					t.Errorf("lexer node %s decoded as %T", n.AsTree().Name, n)
+					return false
+				}
+				return true
+			})
+			pr.Parser.WalkDown(func(n tree.Node) bool {
+				if _, ok := n.(*rules.Rule); !ok {
+					t.Errorf("parser node %s decoded as %T", n.AsTree().Name, n)
+					return false
+				}
+				return true
+			})
+		})
+	}
+}

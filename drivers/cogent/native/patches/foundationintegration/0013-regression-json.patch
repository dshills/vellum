--- a/tree/json_vellum_test.go
+++ b/tree/json_vellum_test.go
@@ -0,0 +1,62 @@
+package tree_test
+
+import (
+	"bytes"
+	"cogentcore.org/core/tree"
+	"cogentcore.org/core/tree/testdata"
+	"encoding/json"
+	"sync"
+	"testing"
+)
+
+func TestVellumNodeJSONMetadataAndConcurrentDecode(t *testing.T) {
+	root := testNodeTree()
+	data, err := json.Marshal(root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Member order and formatting must not select metadata from descendants.
+	var fields map[string]json.RawMessage
+	if err = json.Unmarshal(data, &fields); err != nil {
+		t.Fatal(err)
+	}
+	reordered, err := json.MarshalIndent(fields, "", "  ")
+	if err != nil {
+		t.Fatal(err)
+	}
+	lower := bytes.ReplaceAll(data, []byte(`"Children"`), []byte(`"children"`))
+	if n, err := tree.UnmarshalRootJSON(lower); err != nil || n.AsTree().Child(1).AsTree().NumChildren() != 1 {
+		t.Fatal("case-folded child metadata", err)
+	}
+	var wg sync.WaitGroup
+	for range 12 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for range 20 {
+				node, err := tree.UnmarshalRootJSON(reordered)
+				if err != nil {
+					t.Error(err)
+					return
+				}
+				parent, ok := node.(*testdata.NodeEmbed)
+				if !ok || len(parent.Children) != 3 || parent.Child(1).AsTree().NumChildren() != 1 {
+					t.Error("nested children lost")
+					return
+				}
+				for _, child := range parent.Children {
+					if child.AsTree().Parent != parent {
+						t.Error("parent identity lost")
+						return
+					}
+				}
+			}
+		}()
+	}
+	wg.Wait()
+	for _, bad := range []string{`{}`, `{"nodeType":1}`, `{"nodeType":"unknown"}`, `{"nodeType":"cogentcore.org/core/tree.NodeBase","numChildren":-1}`, `{"nodeType":"cogentcore.org/core/tree.NodeBase","numChildren":2,"Children":[]}`} {
+		if _, err := tree.UnmarshalRootJSON([]byte(bad)); err == nil {
+			t.Errorf("invalid metadata accepted: %s", bad)
+		}
+	}
+}

+
+// HasInitialSizeDP reports whether both initial request dimensions are usable.
+func (o *NewWindowOptions) HasInitialSizeDP() bool {
+	return o.InitialSizeDP.X > 0 && o.InitialSizeDP.Y > 0 &&
+		!math.IsInf(float64(o.InitialSizeDP.X), 0) && !math.IsInf(float64(o.InitialSizeDP.Y), 0)
+}
+
+// initialSizePixels rounds DP to raw pixels and bounds before integer conversion.
+// At least one window-manager unit is required by native window creation.
+func (o *NewWindowOptions) initialSizePixels(sc *Screen) (image.Point, bool) {
+	if !o.HasInitialSizeDP() || sc == nil || sc.PixelSize.X <= 0 || sc.PixelSize.Y <= 0 ||
+		!(sc.LogicalDPI > 0) || !(sc.DevicePixelRatio > 0) ||
+		math.IsInf(float64(sc.LogicalDPI), 0) || math.IsInf(float64(sc.DevicePixelRatio), 0) {
+		return image.Point{}, false
+	}
+	dimension := func(dp float32, available int) int {
+		minimum, limit := initialPixelBounds(sc, available)
+		pixels := math.Round(float64(dp) * float64(sc.LogicalDPI) / 160)
+		return int(min(limit, max(minimum, pixels)))
+	}
+	return image.Pt(dimension(o.InitialSizeDP.X, sc.PixelSize.X), dimension(o.InitialSizeDP.Y, sc.PixelSize.Y)), true
+}
+
+// The backend's legacy size conversion uses float32. Keep a representable
+// margin below 2^31 so rounding cannot overflow GLFW's signed 32-bit dimensions.
+func initialPixelBounds(sc *Screen, available int) (minimum, limit float64) {
+	const safeNativeSize = float64(math.MaxInt32 - 127)
+	limit = max(1, math.Floor(min(float64(available), safeNativeSize*min(1, float64(sc.DevicePixelRatio)))))
+	minimum = min(limit, max(1, math.Ceil(float64(sc.DevicePixelRatio))))
+	return
+}
+
+// FixupForScreen resolves creation options using an already chosen screen snapshot.
+// Desktop creation passes this same snapshot to GLFW, avoiding a second screen
+// lookup with potentially different DPI, scale or geometry.
+func (o *NewWindowOptions) FixupForScreen(sc *Screen) {
+	if sc == nil {
+		return
+	}
+	if size, ok := o.initialSizePixels(sc); ok && !o.Flags.HasFlag(Fullscreen) {
+		o.Size, o.StdPixels = size, false
+		// The legacy screen constraint round trip truncates fractional DPR and
+		// can undo the minimum. Preserve native-safe final creation dimensions.
+		defer func() {
+			bound := func(value, available int) int {
+				minimum, limit := initialPixelBounds(sc, available)
+				return int(min(limit, max(minimum, float64(value))))
+			}
+			o.Size = image.Pt(bound(o.Size.X, sc.PixelSize.X), bound(o.Size.Y, sc.PixelSize.Y))
+		}()
 	}
 	scsz := sc.Geometry.Size() // window coords size
 

+package system
+
+import (
+	"cogentcore.org/core/math32"
+	"image"
+	"math"
+	"testing"
+)
+
+func initialTestApp(t *testing.T) {
+	previous := TheApp
+	TheApp = &sizingSnapshotApp{}
+	t.Cleanup(func() { TheApp = previous })
+}
+func initialTestScreen(dpi, dpr float32) *Screen {
+	return &Screen{ScreenNumber: 1, Geometry: image.Rect(2000, 0, 4000, 1200), PixelSize: image.Pt(int(2000*dpr), int(1200*dpr)), LogicalDPI: dpi, DevicePixelRatio: dpr}
+}
+func TestInitialWindowOptionsResolveAtCreation(t *testing.T) {
+	initialTestApp(t)
+	for _, tt := range []struct {
+		name     string
+		dp       math32.Vector2
+		dpi, dpr float32
+		want     image.Point
+	}{
+		{"small", math32.Vec2(320, 240), 160, 1, image.Pt(320, 240)},
+		{"distinct-small", math32.Vec2(640, 400), 160, 1, image.Pt(640, 400)},
+		{"retina", math32.Vec2(640, 400), 320, 2, image.Pt(1280, 800)},
+		{"logical-zoom", math32.Vec2(640, 400), 240, 2, image.Pt(960, 600)},
+		{"rounded-screen-dpi", math32.Vec2(640, 400), 318, 2, image.Pt(1272, 794)},
+		{"fractional-scale", math32.Vec2(640, 400), 200, 1.25, image.Pt(800, 500)},
+		{"nearest-pixel", math32.Vec2(320.5, 240.49), 160, 1, image.Pt(321, 240)},
+		{"tiny-fractional", math32.Vec2(math.SmallestNonzeroFloat32, math.SmallestNonzeroFloat32), 200, 1.25, image.Pt(2, 2)},
+		{"tiny", math32.Vec2(math.SmallestNonzeroFloat32, math.SmallestNonzeroFloat32), 320, 2, image.Pt(2, 2)},
+		{"extreme-finite", math32.Vec2(math.MaxFloat32, math.MaxFloat32), 320, 2, image.Pt(4000, 2400)},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			sc := initialTestScreen(tt.dpi, tt.dpr)
+			before := *sc
+			opts := NewWindowOptions{Size: image.Pt(1800, 1000), StdPixels: true, Pos: image.Pt(1, 1), InitialSizeDP: tt.dp}
+			opts.FixupForScreen(sc)
+			if opts.Size != tt.want || opts.StdPixels {
+				t.Fatalf("got %v std=%v, want %v", opts.Size, opts.StdPixels, tt.want)
+			}
+			if wm := sc.WindowSizeFromPixels(opts.Size); wm.X < 1 || wm.Y < 1 || wm.X > math.MaxInt32 || wm.Y > math.MaxInt32 {
+				t.Fatalf("invalid native dimensions %v", wm)
+			}
+			if *sc != before {
+				t.Fatal("mutated screen snapshot")
+			}
+		})
+	}
+}
+func TestInitialWindowOptionsUseOnlyChosenScreen(t *testing.T) {
+	initialTestApp(t)
+	opts := NewWindowOptions{InitialSizeDP: math32.Vec2(400, 300), Pos: image.Pt(1, 1), Screen: 1}
+	// The supplied secondary screen differs from the app's primary-screen defaults.
+	sc := initialTestScreen(240, 2)
+	opts.FixupForScreen(sc)
+	if opts.Size != image.Pt(600, 450) || opts.Screen != 1 {
+		t.Fatalf("wrong creation screen: %+v", opts)
+	}
+}
+func TestInitialWindowOptionsLeaveLegacyAndFullscreen(t *testing.T) {
+	initialTestApp(t)
+	sc := initialTestScreen(320, 2)
+	opts := NewWindowOptions{Size: image.Pt(800, 600), Pos: image.Pt(1, 1)}
+	opts.FixupForScreen(sc)
+	if opts.Size != image.Pt(800, 600) {
+		t.Fatal("legacy content size changed")
+	}
+	opts.InitialSizeDP = math32.Vec2(300, 200)
+	opts.Flags.SetFlag(true, Fullscreen)
+	opts.FixupForScreen(sc)
+	if opts.Size != sc.PixelSize {
+		t.Fatal("initial request overrode fullscreen")
+	}
+	for _, dp := range []math32.Vector2{{}, math32.Vec2(-1, 2), math32.Vec2(float32(math.NaN()), 2), math32.Vec2(2, float32(math.Inf(1)))} {
+		opts = NewWindowOptions{InitialSizeDP: dp, Size: image.Pt(800, 600), Pos: image.Pt(1, 1)}
+		opts.FixupForScreen(sc)
+		if opts.Size != image.Pt(800, 600) {
+			t.Fatal("invalid optional request affected legacy path")
+		}
+	}
+}
+
+func TestInitialWindowOptionsFinalNativeIntegerBound(t *testing.T) {
+	initialTestApp(t)
+	for _, dpr := range []float32{1, 1.25, 2, .5} {
+		sc := &Screen{PixelSize: image.Pt(math.MaxInt32, math.MaxInt32), Geometry: image.Rect(0, 0, math.MaxInt32, math.MaxInt32), LogicalDPI: 320, DevicePixelRatio: dpr}
+		opts := NewWindowOptions{InitialSizeDP: math32.Vec2(math.MaxFloat32, math.MaxFloat32), Pos: image.Pt(1, 1)}
+		opts.FixupForScreen(sc)
+		wm := sc.WindowSizeFromPixels(opts.Size)
+		if opts.Size.X < 1 || opts.Size.X > math.MaxInt32-127 || wm.X < 1 || wm.X > math.MaxInt32 || wm.Y < 1 || wm.Y > math.MaxInt32 {
+			t.Fatalf("DPR %v raw=%v native=%v", dpr, opts.Size, wm)
+		}
+	}
+}

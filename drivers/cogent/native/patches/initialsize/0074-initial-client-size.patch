+package core
+
+import (
+	"cogentcore.org/core/math32"
+	"cogentcore.org/core/system"
+	"image"
+	"testing"
+)
+
+func TestStageInitialWindowOptionsAndSavedPrecedence(t *testing.T) {
+	sc := &system.Screen{ScreenNumber: 1, LogicalDPI: 240, DevicePixelRatio: 2, Geometry: image.Rect(0, 0, 2000, 1200), PixelSize: image.Pt(4000, 2400)}
+	body := NewBody("initial size")
+	st := body.NewWindow().SetInitialSizeDP(400, 300)
+	// Large intrinsic/preliminary geometry must not replace an explicit request.
+	st.Scene.SceneGeom.Size = image.Pt(3000, 2000)
+	opts := st.initialWindowOptions(sc, nil, nil)
+	opts.Pos = image.Pt(1, 1)
+	opts.FixupForScreen(sc)
+	if opts.Size != image.Pt(600, 450) || opts.Screen != 1 {
+		t.Fatalf("request lost: %+v", opts)
+	}
+	savedScreen := *sc
+	savedScreen.ScreenNumber = 2
+	saved := &windowGeometry{Size: image.Pt(900, 700), Pos: image.Pt(30, 40), Max: true}
+	opts = st.initialWindowOptions(sc, saved, &savedScreen)
+	if opts.InitialSizeDP != (math32.Vector2{}) || opts.Size != saved.Size || opts.Pos != saved.Pos || opts.Screen != 2 || !opts.Flags.HasFlag(system.Maximized) {
+		t.Fatalf("saved geometry lost: %+v", opts)
+	}
+	if st.InitialSizeDP != math32.Vec2(400, 300) {
+		t.Fatal("mutated stage request")
+	}
+}

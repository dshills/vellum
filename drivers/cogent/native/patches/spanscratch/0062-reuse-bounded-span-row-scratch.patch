+// Copyright (c) 2026, Davin Hills.
+// SPDX-License-Identifier: MIT
+package sceneplan
+
+import (
+	"bytes"
+	"image"
+	"image/color"
+	"image/draw"
+	"math/rand"
+	"reflect"
+	"testing"
+	"unsafe"
+)
+
+func assertSpanScratchReference(t *testing.T, b *Builder, w *spanScratchReferenceBuilder) {
+	t.Helper()
+	if b.failed != w.failed || b.packet.bytes != w.packet.bytes || b.count != w.count || b.streamRowMin != w.streamRowMin || !reflect.DeepEqual(b.stream, w.stream) {
+		t.Fatal("span state or admission differs from pinned pre-reuse builder")
+	}
+	if b.spanScratchCount < 0 || b.spanScratchCount > 32 || b.spanScratchBytes < 0 || b.spanScratchBytes > 64<<10 {
+		t.Fatal("scratch bound exceeded")
+	}
+	total := 0
+	seen := map[*span]bool{}
+	for i, row := range b.spanScratch {
+		if i >= b.spanScratchCount {
+			if row != nil {
+				t.Fatal("inactive scratch slot retains backing")
+			}
+			continue
+		}
+		if len(row) != 0 || cap(row) == 0 || cap(row) > 256 {
+			t.Fatal("invalid scratch row")
+		}
+		total += cap(row) * int(unsafe.Sizeof(span{}))
+		pointer := &row[:cap(row)][0]
+		if seen[pointer] {
+			t.Fatal("scratch rows alias one another")
+		}
+		seen[pointer] = true
+	}
+	if total != b.spanScratchBytes {
+		t.Fatal("scratch byte counter differs from backing")
+	}
+}
+
+func TestVellumSpanScratchPinnedAdmissionOrderAndPixels(t *testing.T) {
+	rng := rand.New(rand.NewSource(62059))
+	bounds := image.Rect(0, 0, 48, 64)
+	for trial := 0; trial < 80; trial++ {
+		b, w := New(bounds), newSpanScratchReference(bounds)
+		for stream := 0; stream < 12; stream++ {
+			c := color.RGBA{byte(rng.Intn(90)), byte(rng.Intn(90)), byte(rng.Intn(90)), 128}
+			op := draw.Op(stream % 2)
+			b.BeginSpans(c, op)
+			w.BeginSpans(c, op)
+			assertSpanScratchReference(t, b, w)
+			for i := 0; i < 30; i++ {
+				y := rng.Intn(80) - 8
+				if stream%3 == 0 {
+					y = 40 - i
+				}
+				x0, x1 := rng.Intn(64)-8, rng.Intn(64)-8
+				alpha := uint32(rng.Intn(65536))
+				if i%7 == 0 {
+					alpha = 0
+				}
+				b.Span(y, x0, x1, alpha)
+				w.Span(y, x0, x1, alpha)
+				assertSpanScratchReference(t, b, w)
+			}
+			b.flush()
+			w.flush()
+			assertSpanScratchReference(t, b, w)
+		}
+		got, want := b.Seal(trial%2 == 0), w.Seal(trial%2 == 0)
+		if got == nil || want == nil || got.Bytes() != want.Bytes() || got.Operations() != want.Operations() {
+			t.Fatal("packet accounting differs")
+		}
+		for _, compact := range []bool{false, true} {
+			encode := func(p *Packet) (*Encoded, bool) {
+				if compact {
+					return p.EncodeGPU()
+				}
+				return p.Encode()
+			}
+			g, gok := encode(got)
+			v, vok := encode(want)
+			if !gok || !vok || !reflect.DeepEqual(g, v) {
+				t.Fatal("serialized span order or coverage differs", trial, compact)
+			}
+		}
+		actual, reference := image.NewRGBA(bounds), image.NewRGBA(bounds)
+		rng.Read(actual.Pix)
+		copy(reference.Pix, actual.Pix)
+		if !got.Replay(actual) || !want.Replay(reference) || !bytes.Equal(actual.Pix, reference.Pix) {
+			t.Fatal("seeded replay differs")
+		}
+		if b.spanScratchCount != 0 || b.spanScratchBytes != 0 || !reflect.DeepEqual(b.spanScratch, [32][]span{}) {
+			t.Fatal("sealed builder retains scratch")
+		}
+	}
+}
+
+func TestVellumSpanScratchReusedConstructionCannotChangeEarlierOperation(t *testing.T) {
+	b := New(image.Rect(0, 0, 24, 24))
+	b.BeginSpans(color.RGBA{7, 9, 11, 128}, draw.Src)
+	b.Span(3, 1, 9, 65535)
+	staging := b.stream.rows[0]
+	b.flush()
+	if b.spanScratchCount != 1 {
+		t.Fatal("retired row was not retained")
+	}
+	first := b.head.ops[0]
+	held := Packet{bounds: b.packet.bounds, bytes: b.packet.bytes, ops: []operation{first}}
+	before, ok := held.EncodeGPU()
+	if !ok {
+		t.Fatal("held encode refused")
+	}
+	b.BeginSpans(color.RGBA{19, 23, 31, 128}, draw.Over)
+	b.Span(11, 2, 17, 32767)
+	if &b.stream.rows[0][0] != &staging[0] {
+		t.Fatal("fixture did not actually reuse the construction buffer")
+	}
+	after, ok := held.EncodeGPU()
+	if !ok || !reflect.DeepEqual(before, after) {
+		t.Fatal("reused staging changed earlier operation")
+	}
+	b.flush()
+	for i := range staging {
+		staging[i] = span{0, 24, 1}
+	}
+	after, ok = held.EncodeGPU()
+	if !ok || !reflect.DeepEqual(before, after) {
+		t.Fatal("borrowed staging changed held operation")
+	}
+	if p := b.Seal(false); p == nil || p.Operations() != 2 {
+		t.Fatal("reused stream did not seal")
+	}
+}
+
+func TestVellumSpanScratchBoundsAndWarmRefusal(t *testing.T) {
+	for _, capacity := range []int{1, 256, 257} {
+		b := New(image.Rect(0, 0, 8, 32))
+		for i := 0; i < 64; i++ {
+			b.retainSpanScratch(make([]span, 1, capacity))
+		}
+		if capacity == 1 && (b.spanScratchCount != 32 || b.spanScratchBytes != 32*int(unsafe.Sizeof(span{}))) {
+			t.Fatal("slot limit not enforced")
+		}
+		expected := min(32, (64<<10)/(256*int(unsafe.Sizeof(span{}))))
+		if capacity == 256 && (b.spanScratchCount != expected || b.spanScratchBytes != expected*256*int(unsafe.Sizeof(span{}))) {
+			t.Fatal("backing limit not enforced")
+		}
+		if capacity == 257 && b.spanScratchCount != 0 {
+			t.Fatal("large backing retained")
+		}
+		b.Refuse()
+		if b.Seal(false) != nil || b.spanScratchCount != 0 || b.spanScratchBytes != 0 {
+			t.Fatal("refused seal retained scratch")
+		}
+	}
+	need := int(unsafe.Sizeof([]span{})) + int(unsafe.Sizeof(span{}))
+	for _, short := range []int{0, 1} {
+		b, w := New(image.Rect(0, 0, 8, 32)), newSpanScratchReference(image.Rect(0, 0, 8, 32))
+		b.BeginSpans(color.RGBA{}, draw.Src)
+		w.BeginSpans(color.RGBA{}, draw.Src)
+		b.Span(4, 0, 8, 1)
+		w.Span(4, 0, 8, 1)
+		b.flush()
+		w.flush()
+		b.BeginSpans(color.RGBA{}, draw.Src)
+		w.BeginSpans(color.RGBA{}, draw.Src)
+		b.packet.bytes, w.packet.bytes = MaxBytes-need+short, MaxBytes-need+short
+		count, backing := b.spanScratchCount, b.spanScratchBytes
+		b.Span(18, 0, 8, 1)
+		w.Span(18, 0, 8, 1)
+		assertSpanScratchReference(t, b, w)
+		if short == 1 && (b.spanScratchCount != count || b.spanScratchBytes != backing || len(b.stream.rows) != 0) {
+			t.Fatal("warm row borrowed before budget admission")
+		}
+		if short == 0 && (b.Failed() || b.spanScratchCount != count-1 || len(b.stream.rows) != 1) {
+			t.Fatal("exact budget did not admit same row")
+		}
+	}
+	// Three rows grow four logical headers; the one spare refund must precede
+	// the operation charge, including when a warm row was reused.
+	for _, short := range []int{0, 1} {
+		b, w := New(image.Rect(0, 0, 8, 32)), newSpanScratchReference(image.Rect(0, 0, 8, 32))
+		for i := 0; i < 2; i++ {
+			b.BeginSpans(color.RGBA{}, draw.Src)
+			w.BeginSpans(color.RGBA{}, draw.Src)
+			for y := 4; y < 7; y++ {
+				b.Span(y, 0, 8, 1)
+				w.Span(y, 0, 8, 1)
+			}
+			b.flush()
+			w.flush()
+			assertSpanScratchReference(t, b, w)
+		}
+		b.BeginSpans(color.RGBA{}, draw.Src)
+		w.BeginSpans(color.RGBA{}, draw.Src)
+		for y := 12; y < 15; y++ {
+			b.Span(y, 0, 8, 1)
+			w.Span(y, 0, 8, 1)
+		}
+		spare := int(unsafe.Sizeof([]span{}))
+		charge := int(unsafe.Sizeof(operation{}))
+		b.packet.bytes, w.packet.bytes = MaxBytes-charge+spare+short, MaxBytes-charge+spare+short
+		b.flush()
+		w.flush()
+		assertSpanScratchReference(t, b, w)
+		if b.Failed() != (short == 1) {
+			t.Fatal("spare header refund boundary changed")
+		}
+	}
+}

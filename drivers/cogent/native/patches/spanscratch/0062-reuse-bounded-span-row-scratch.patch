+// Copyright (c) 2026, Davin Hills.
+// SPDX-License-Identifier: MIT
+package sceneplan
+
+import (
+	"image"
+	"image/color"
+	"image/draw"
+	"unsafe"
+)
+
+// Pinned pre-reuse builder methods retain original row allocation and admission.
+type spanScratchReferenceBuilder struct {
+	packet       Packet
+	failed       bool
+	head, tail   *operationBlock
+	count        int
+	masks        map[*image.Alpha]*image.Alpha
+	stream       *operation
+	streamRowMin int
+}
+
+func newSpanScratchReference(bounds image.Rectangle) *spanScratchReferenceBuilder {
+	b := &spanScratchReferenceBuilder{packet: Packet{bounds: bounds, bytes: int(unsafe.Sizeof(Packet{}))}}
+	if bounds.Min != (image.Point{}) || bounds.Empty() || bounds.Dx() > MaxDimension || bounds.Dy() > MaxDimension || bounds.Dx()*bounds.Dy() > MaxPixels {
+		b.failed = true
+	}
+	return b
+}
+
+func (b *spanScratchReferenceBuilder) Failed() bool { return b.failed }
+
+func (b *spanScratchReferenceBuilder) Refuse() { b.failed = true }
+
+func (b *spanScratchReferenceBuilder) reserve(n int) bool {
+	if b.failed || n < 0 || n > MaxBytes-b.packet.bytes {
+		b.failed = true
+		return false
+	}
+	b.packet.bytes += n
+	return true
+}
+
+func (b *spanScratchReferenceBuilder) add(o operation) {
+	if b.failed || o.rect.Empty() {
+		return
+	}
+	if b.count == MaxOps || !b.reserve(int(unsafe.Sizeof(operation{}))) {
+		b.failed = true
+		return
+	}
+	if b.count == 0 && o.rect == b.packet.bounds && (o.kind == Uniform && (o.op == draw.Src || o.color[3] == 65535)) {
+		b.packet.independent = true
+	}
+	if b.count%operationBlockSize == 0 {
+		block := new(operationBlock)
+		if b.tail == nil {
+			b.head = block
+		} else {
+			b.tail.next = block
+		}
+		b.tail = block
+	}
+	b.tail.ops[b.count%operationBlockSize] = o
+	b.count++
+}
+
+func (b *spanScratchReferenceBuilder) flush() {
+	if b.stream == nil {
+		return
+	}
+	o := *b.stream
+	rowMin := b.streamRowMin
+	b.stream = nil
+	b.streamRowMin = 0
+	if b.failed || o.rect.Empty() {
+		return
+	}
+	b.packet.bytes -= (len(o.rows) - o.rect.Dy()) * int(unsafe.Sizeof([]span{}))
+	// Refund spare row headers before checking the unchanged operation charge.
+	// A refused stream need not allocate compact rows that can never be retained.
+	if b.count == MaxOps || int(unsafe.Sizeof(operation{})) > MaxBytes-b.packet.bytes {
+		b.failed = true
+		return
+	}
+	o.rows = o.rows[o.rect.Min.Y-rowMin : o.rect.Max.Y-rowMin]
+	// Compact each row to exactly its retained capacity; replacement transients
+	// and the construction row index are accounted separately from owned packets.
+	// One detached backing holds every retained span. Row capacities are capped
+	// at their lengths, so appending cannot overwrite the following row. The
+	// same exact row/span charges cover this storage once, as before.
+	total := 0
+	for _, row := range o.rows {
+		total += len(row)
+	}
+	storage := make([]span, total)
+	exact := make([][]span, len(o.rows))
+	offset := 0
+	for i, row := range o.rows {
+		end := offset + len(row)
+		copy(storage[offset:end], row)
+		exact[i] = storage[offset:end:end]
+		offset = end
+	}
+	o.rows = exact
+	b.add(o)
+}
+
+func (b *spanScratchReferenceBuilder) BeginSpans(c color.RGBA, op draw.Op) {
+	b.flush()
+	if b.failed {
+		return
+	}
+	if op != draw.Src && op != draw.Over {
+		b.Refuse()
+		return
+	}
+	r, g, bl, a := c.RGBA()
+	b.stream = &operation{kind: Spans, op: op, color: [4]uint32{r, g, bl, a}}
+}
+
+func (b *spanScratchReferenceBuilder) Span(y, x0, x1 int, alpha uint32) {
+	if b.failed || b.stream == nil {
+		return
+	}
+	if alpha > 65535 {
+		b.failed = true
+		return
+	}
+	if y < 0 || y >= b.packet.bounds.Dy() {
+		return
+	}
+	x0 = max(0, x0)
+	x1 = min(b.packet.bounds.Dx(), x1)
+	if x0 >= x1 || alpha == 0 && b.stream.op == draw.Over {
+		return
+	}
+	rows := b.stream.rows
+	rowMin, size := b.streamRowMin, len(rows)
+	grow := y < rowMin || y >= rowMin+size
+	if grow {
+		minY, maxY := y, y+1
+		if !b.stream.rect.Empty() {
+			minY = min(minY, b.stream.rect.Min.Y)
+			maxY = max(maxY, b.stream.rect.Max.Y)
+		}
+		// Geometric growth bounds repeated ascending or descending row work.
+		// Keep all touched rows; spare headers may move to either side of them.
+		size = min(b.packet.bounds.Dy(), max(maxY-minY, max(1, len(rows)*2)))
+		rowMin = min(minY, b.packet.bounds.Dy()-size)
+		if len(rows) != 0 && y < b.streamRowMin {
+			rowMin = max(0, maxY-size)
+		}
+	}
+	// Charge construction capacity and the span before either allocation. Flush
+	// retires spare headers and compacts into the unchanged relative row format.
+	if !b.reserve(int(unsafe.Sizeof(span{})) + (size-len(rows))*int(unsafe.Sizeof([]span{}))) {
+		return
+	}
+	if grow {
+		grown := make([][]span, size)
+		if !b.stream.rect.Empty() {
+			r := b.stream.rect
+			copy(grown[r.Min.Y-rowMin:], rows[r.Min.Y-b.streamRowMin:r.Max.Y-b.streamRowMin])
+		}
+		b.stream.rows = grown
+		b.streamRowMin = rowMin
+	}
+	b.stream.rows[y-b.streamRowMin] = append(b.stream.rows[y-b.streamRowMin], span{x0, x1, alpha})
+	r := image.Rect(x0, y, x1, y+1)
+	if b.stream.rect.Empty() {
+		b.stream.rect = r
+	} else {
+		b.stream.rect = b.stream.rect.Union(r)
+	}
+}
+
+func (b *spanScratchReferenceBuilder) Seal(winding bool) *Packet {
+	defer b.retire()
+	b.flush()
+	if b.failed {
+		return nil
+	}
+	exact := make([]operation, b.count)
+	for block, offset := b.head, 0; block != nil; block = block.next {
+		offset += copy(exact[offset:], block.ops[:])
+	}
+	b.packet.ops = exact
+	b.packet.winding = winding
+	packet := b.packet
+	return &packet
+}
+
+func (b *spanScratchReferenceBuilder) retire() {
+	b.packet = Packet{}
+	b.head, b.tail = nil, nil
+	b.count = 0
+	b.masks = nil
+	b.stream = nil
+	b.streamRowMin = 0
+	b.failed = true // construction callbacks cannot mutate the sealed result
+}

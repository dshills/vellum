+// SPDX-License-Identifier: Unlicense OR BSD-3-Clause
+package font
+
+import (
+	"container/list"
+	"encoding/binary"
+	"fmt"
+	"github.com/go-text/typesetting/font/opentype/tables"
+	"io"
+	"sync"
+)
+
+const sbixGlyphLimit = 2 * 1024 * 1024
+const sbixCacheLimit = 4 * 1024 * 1024
+const sbixCacheEntries = 32
+
+// Only strike headers are retained at font load. Offset pairs and bitmap payloads
+// are read on demand. The LRU bounds internal payload retention; returned bitmap
+// slices owned by application/render caches are outside this internal budget.
+type lazySbix struct {
+	mu      sync.Mutex
+	r       io.ReaderAt
+	length  int64
+	glyphs  int
+	offsets []uint32
+	sizes   sbix
+	cache   map[uint64]*list.Element
+	lru     list.List
+	bytes   int
+}
+type sbixEntry struct {
+	key   uint64
+	data  tables.BitmapGlyphData
+	bytes int
+}
+
+func newLazySbix(r io.ReaderAt, length int64, glyphs int) (*lazySbix, error) {
+	if glyphs < 0 || glyphs > 65535 || length < 8 {
+		return nil, fmt.Errorf("invalid sbix bounds")
+	}
+	var h [8]byte
+	if _, e := r.ReadAt(h[:], 0); e != nil {
+		return nil, e
+	}
+	count := binary.BigEndian.Uint32(h[4:])
+	if binary.BigEndian.Uint16(h[:]) != 1 || count == 0 || count > 256 || int64(count)*4 > length-8 {
+		return nil, fmt.Errorf("invalid sbix header")
+	}
+	b := make([]byte, int(count)*4)
+	if _, e := r.ReadAt(b, 8); e != nil {
+		return nil, e
+	}
+	s := &lazySbix{r: r, length: length, glyphs: glyphs, cache: make(map[uint64]*list.Element)}
+	for i := 0; i < int(count); i++ {
+		off := binary.BigEndian.Uint32(b[4*i:])
+		minSize := int64(4) + 4*int64(glyphs+1)
+		if int64(off) < 8+int64(count)*4 || int64(off) > length-minSize {
+			return nil, fmt.Errorf("invalid strike offset")
+		}
+		var header [4]byte
+		if _, e := r.ReadAt(header[:], int64(off)); e != nil {
+			return nil, e
+		}
+		// Scan bounded offset metadata so an over-budget record selects eager
+		// compatibility for the entire bitmap table at load time.
+		indices := make([]byte, 4*(glyphs+1))
+		if _, e := r.ReadAt(indices, int64(off)+4); e != nil {
+			return nil, e
+		}
+		for j := 0; j < glyphs; j++ {
+			start, end := int64(binary.BigEndian.Uint32(indices[4*j:])), int64(binary.BigEndian.Uint32(indices[4*(j+1):]))
+			if start < minSize || end < start || end > length-int64(off) || end-start > sbixGlyphLimit {
+				return nil, fmt.Errorf("bitmap table requires eager compatibility or has invalid offsets")
+			}
+		}
+		s.offsets = append(s.offsets, off)
+		s.sizes = append(s.sizes, tables.Strike{Ppem: binary.BigEndian.Uint16(header[:]), Ppi: binary.BigEndian.Uint16(header[2:])})
+	}
+	return s, nil
+}
+func (s *lazySbix) glyph(g gID, x, y uint16) (tables.BitmapGlyphData, uint16, error) {
+	st := s.sizes.chooseStrike(x, y)
+	if st == nil || st.Ppem == 0 {
+		return tables.BitmapGlyphData{}, 0, errEmptySbixTable
+	}
+	index := 0
+	for i := range s.sizes {
+		if &s.sizes[i] == st {
+			index = i
+			break
+		}
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	for depth := 0; depth <= 8; depth++ {
+		if int(g) >= s.glyphs {
+			return tables.BitmapGlyphData{}, 0, fmt.Errorf("glyph outside sbix")
+		}
+		key := uint64(index)<<32 | uint64(g)
+		var data tables.BitmapGlyphData
+		if entry := s.cache[key]; entry != nil {
+			s.lru.MoveToFront(entry)
+			data = entry.Value.(sbixEntry).data
+		} else {
+			base := int64(s.offsets[index])
+			var pair [8]byte
+			if _, e := s.r.ReadAt(pair[:], base+4+4*int64(g)); e != nil {
+				return data, 0, e
+			}
+			start, end := int64(binary.BigEndian.Uint32(pair[:])), int64(binary.BigEndian.Uint32(pair[4:]))
+			if end < start || start < 4+4*int64(s.glyphs+1) || end > s.length-base || end-start > sbixGlyphLimit {
+				return data, 0, fmt.Errorf("invalid or oversized bitmap glyph")
+			}
+			if start == end {
+				return data, 0, fmt.Errorf("empty bitmap glyph")
+			}
+			raw := make([]byte, int(end-start))
+			if _, e := s.r.ReadAt(raw, base+start); e != nil {
+				return data, 0, e
+			}
+			var e error
+			data, _, e = tables.ParseBitmapGlyphData(raw)
+			if e != nil {
+				return data, 0, e
+			}
+			for s.bytes+len(raw) > sbixCacheLimit || s.lru.Len() >= sbixCacheEntries {
+				e := s.lru.Back()
+				v := e.Value.(sbixEntry)
+				s.bytes -= v.bytes
+				delete(s.cache, v.key)
+				s.lru.Remove(e)
+			}
+			s.cache[key] = s.lru.PushFront(sbixEntry{key, data, len(raw)})
+			s.bytes += len(raw)
+		}
+		if data.GraphicType != dupe {
+			return data, st.Ppem, nil
+		}
+		if len(data.Data) < 2 {
+			return data, 0, fmt.Errorf("short duplicate glyph")
+		}
+		g = gID(binary.BigEndian.Uint16(data.Data))
+	}
+	return tables.BitmapGlyphData{}, 0, fmt.Errorf("cyclic/deep duplicate glyph")
+}
+func (s *lazySbix) glyphData(g gID, x, y uint16) (GlyphBitmap, error) {
+	d, _, e := s.glyph(g, x, y)
+	if e != nil {
+		return GlyphBitmap{}, e
+	}
+	w, h, f, e := decodeBitmapConfig(d)
+	return GlyphBitmap{Data: d.Data, Width: w, Height: h, Format: f}, e
+}
+func (s *lazySbix) extents(g gID, x, y, upem uint16) (GlyphExtents, bool) {
+	d, ppem, e := s.glyph(g, x, y)
+	if e != nil || ppem == 0 {
+		return GlyphExtents{}, false
+	}
+	v, ok := bitmapGlyphExtents(d)
+	scale := float32(upem) / float32(ppem)
+	v.XBearing *= scale
+	v.YBearing *= scale
+	v.Width *= scale
+	v.Height *= scale
+	return v, ok
+}

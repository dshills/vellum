+package fontscan
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestStableDeferredReader(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "font")
+	if e := os.WriteFile(path, []byte("abcd"), 0600); e != nil {
+		t.Fatal(e)
+	}
+	f, e := os.Open(path)
+	if e != nil {
+		t.Fatal(e)
+	}
+	r, e := newStableFile(f)
+	if e != nil {
+		t.Fatal(e)
+	}
+	f.Close()
+	defer r.Close()
+	b := make([]byte, 2)
+	if n, e := r.ReadAt(b, 1); n != 2 || e != nil || string(b) != "bc" {
+		t.Fatal(n, e, string(b))
+	}
+	if e := os.WriteFile(path, []byte("WXYZ"), 0600); e != nil {
+		t.Fatal(e)
+	}
+	if n, e := r.ReadAt(b, 1); n != 2 || e != nil || string(b) != "bc" {
+		t.Fatal("snapshot changed with source", n, e, string(b))
+	}
+	replacement := path + "new"
+	os.WriteFile(replacement, []byte("EFGH"), 0600)
+	if e := os.Rename(replacement, path); e != nil {
+		t.Fatal(e)
+	}
+	if n, e := r.ReadAt(b, 1); n != 2 || e != nil || string(b) != "bc" {
+		t.Fatal("snapshot changed with replacement", n, e, string(b))
+	}
+}
+
+func TestStableSnapshotBudgetAndClose(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "font")
+	os.WriteFile(path, []byte("abcd"), 0600)
+	source, e := os.Open(path)
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer source.Close()
+	snapshotBudget.Lock()
+	beforeCount, beforeBytes := snapshotBudget.count, snapshotBudget.bytes
+	snapshotBudget.Unlock()
+	var snapshots []*stableFile
+	for i := beforeCount; i < snapshotCountLimit; i++ {
+		s, e := newStableFile(source)
+		if e != nil {
+			t.Fatal(e)
+		}
+		snapshots = append(snapshots, s)
+	}
+	if s, e := newStableFile(source); e == nil {
+		s.Close()
+		t.Fatal("global snapshot count cap ignored")
+	}
+	for _, s := range snapshots {
+		s.Close()
+		s.Close()
+	}
+	snapshotBudget.Lock()
+	defer snapshotBudget.Unlock()
+	if snapshotBudget.count != beforeCount || snapshotBudget.bytes != beforeBytes {
+		t.Fatal("snapshot credits retained after close")
+	}
+}
+
+func TestStableSnapshotExhaustionFallsBack(t *testing.T) {
+	snapshotBudget.Lock()
+	before := snapshotBudget.count
+	snapshotBudget.count = snapshotCountLimit
+	snapshotBudget.Unlock()
+	defer func() { snapshotBudget.Lock(); snapshotBudget.count = before; snapshotBudget.Unlock() }()
+	f, e := (&Footprint{Location: Location{File: "../font/testdata/Roboto-Regular.ttf"}}).loadFromDisk()
+	if e != nil || f == nil {
+		t.Fatal("valid font rejected on snapshot exhaustion", e)
+	}
+	if _, ok := f.NominalGlyph('A'); !ok {
+		t.Fatal("fallback font coverage lost")
+	}
+}

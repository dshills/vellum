+// SPDX-License-Identifier: Unlicense OR BSD-3-Clause
+package fontscan
+
+import (
+	"fmt"
+	"io"
+	"os"
+	"runtime"
+	"sync"
+)
+
+const snapshotFileLimit int64 = 512 * 1024 * 1024
+const snapshotBytesLimit int64 = 2 * 1024 * 1024 * 1024
+const snapshotCountLimit = 32
+
+var snapshotBudget struct {
+	sync.Mutex
+	bytes     int64
+	count     int
+	fallbacks uint64
+}
+
+// An immutable, library-owned private snapshot backs initial and deferred parsing.
+// The source is never reopened after parsing. Snapshot count/disk size are bounded;
+// the finalizer releases its descriptor/storage/credit after the last font reader.
+type stableFile struct {
+	*os.File
+	path string
+	size int64
+	once sync.Once
+}
+
+func newStableFile(source *os.File) (*stableFile, error) {
+	info, e := source.Stat()
+	if e != nil {
+		return nil, e
+	}
+	size := info.Size()
+	if size < 0 || size > snapshotFileLimit {
+		return nil, fmt.Errorf("font exceeds snapshot file budget")
+	}
+	snapshotBudget.Lock()
+	if snapshotBudget.count >= snapshotCountLimit || size > snapshotBytesLimit-snapshotBudget.bytes {
+		snapshotBudget.Unlock()
+		return nil, fmt.Errorf("font snapshot admission capacity exhausted")
+	}
+	snapshotBudget.count++
+	snapshotBudget.bytes += size
+	snapshotBudget.Unlock()
+	s := &stableFile{size: size}
+	ok := false
+	defer func() {
+		if !ok {
+			s.Close()
+		}
+	}()
+	f, e := os.CreateTemp("", "vellum-font-*")
+	if e != nil {
+		return nil, e
+	}
+	s.File = f
+	s.path = f.Name()
+	if _, e = source.Seek(0, io.SeekStart); e != nil {
+		return nil, e
+	}
+	// Read at most declared size+1, so a growing source cannot bypass the budget.
+	n, e := io.Copy(f, io.LimitReader(source, size+1))
+	if e != nil {
+		return nil, e
+	}
+	if n != size {
+		return nil, fmt.Errorf("font changed while snapshotting")
+	}
+	after, e := source.Stat()
+	if e != nil {
+		return nil, e
+	}
+	if after.Size() != size || !after.ModTime().Equal(info.ModTime()) {
+		return nil, fmt.Errorf("font changed while snapshotting")
+	}
+	if _, e = f.Seek(0, io.SeekStart); e != nil {
+		return nil, e
+	}
+	// No path remains on Unix; Windows defers deletion until its descriptor closes.
+	if e = os.Remove(s.path); e == nil {
+		s.path = ""
+	}
+	runtime.SetFinalizer(s, func(s *stableFile) { s.Close() })
+	ok = true
+	return s, nil
+}
+func (s *stableFile) StableReaderAt() io.ReaderAt { return s }
+func (s *stableFile) Close() error {
+	var err error
+	s.once.Do(func() {
+		if s.File != nil {
+			err = s.File.Close()
+		}
+		if s.path != "" {
+			_ = os.Remove(s.path)
+		}
+		snapshotBudget.Lock()
+		snapshotBudget.count--
+		snapshotBudget.bytes -= s.size
+		snapshotBudget.Unlock()
+	})
+	return err
+}
+
+func (s *stableFile) ReadAt(b []byte, off int64) (int, error) {
+	n, e := s.File.ReadAt(b, off)
+	runtime.KeepAlive(s)
+	return n, e
+}
+
+func fmSnapshotFallback() { snapshotBudget.Lock(); snapshotBudget.fallbacks++; snapshotBudget.Unlock() }
+
+// SnapshotStats reports process-wide disk-snapshot admission, not Go heap usage.
+func (fm *FontMap) SnapshotStats() (int, int64, uint64) {
+	snapshotBudget.Lock()
+	defer snapshotBudget.Unlock()
+	return snapshotBudget.count, snapshotBudget.bytes, snapshotBudget.fallbacks
+}

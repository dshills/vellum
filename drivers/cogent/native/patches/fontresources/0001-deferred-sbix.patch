+package font
+
+import (
+	"bytes"
+	"container/list"
+	"encoding/binary"
+	"github.com/go-text/typesetting/font/opentype/tables"
+	"io"
+	"testing"
+)
+
+type countedReader struct {
+	*bytes.Reader
+	n int
+}
+
+func (r *countedReader) ReadAt(b []byte, o int64) (int, error) {
+	r.n += len(b)
+	return r.Reader.ReadAt(b, o)
+}
+func fixtureSbix(glyphs, payload int) []byte {
+	header := 4 + 4*(glyphs+1)
+	b := make([]byte, 12+header+glyphs*(8+payload))
+	binary.BigEndian.PutUint16(b, 1)
+	binary.BigEndian.PutUint32(b[4:], 1)
+	binary.BigEndian.PutUint32(b[8:], 12)
+	binary.BigEndian.PutUint16(b[12:], 16)
+	for i := 0; i <= glyphs; i++ {
+		binary.BigEndian.PutUint32(b[16+4*i:], uint32(header+i*(8+payload)))
+	}
+	for i := 0; i < glyphs; i++ {
+		pos := 12 + header + i*(8+payload)
+		copy(b[pos+4:], []byte("png "))
+		for j := 0; j < payload; j++ {
+			b[pos+8+j] = byte(i)
+		}
+	}
+	return b
+}
+func TestDeferredSbixParityAndBudget(t *testing.T) {
+	raw := fixtureSbix(48, 128*1024)
+	reader := &countedReader{Reader: bytes.NewReader(raw)}
+	s, e := newLazySbix(reader, int64(len(raw)), 48)
+	if e != nil {
+		t.Fatal(e)
+	}
+	if reader.n != 16+4*(48+1) {
+		t.Fatal("eager payload read", reader.n)
+	}
+	parsed, _, e := tables.ParseSbix(raw, 48)
+	if e != nil {
+		t.Fatal(e)
+	}
+	eager := newSbix(parsed)
+	for g := 0; g < 48; g++ {
+		d, ppem, e := s.glyph(gID(g), 16, 16)
+		if e != nil {
+			t.Fatal(e)
+		}
+		expected := strikeGlyph(eager.chooseStrike(16, 16), gID(g), 0)
+		if ppem != 16 || !bytes.Equal(d.Data, expected.Data) || d.GraphicType != expected.GraphicType {
+			t.Fatal("eager/lazy divergence", g)
+		}
+		if s.bytes > sbixCacheLimit || s.lru.Len() > sbixCacheEntries {
+			t.Fatal("cache exceeds bound", s.bytes, s.lru.Len())
+		}
+	}
+	if _, ok := s.cache[0]; ok {
+		t.Fatal("old glyph not evicted")
+	}
+	if _, _, e := s.glyph(0, 0, 0); e != nil {
+		t.Fatal("evicted glyph cannot reload", e)
+	}
+}
+func TestDeferredSbixInvalidAndCycles(t *testing.T) {
+	raw := fixtureSbix(1, sbixGlyphLimit)
+	s, e := newLazySbix(bytes.NewReader(raw), int64(len(raw)), 1)
+	if e == nil || s != nil {
+		t.Fatal("oversize bitmap must select eager compatibility")
+	}
+	parsed, _, err := tables.ParseSbix(raw, 1)
+	if err != nil || len(newSbix(parsed).chooseStrike(16, 16).GlyphDatas[0].Data) == 0 {
+		t.Fatal("valid large bitmap lost on eager compatibility", err)
+	}
+	raw = fixtureSbix(1, 2)
+	copy(raw[28:], []byte("dupe"))
+	raw[32] = 0
+	raw[33] = 0
+	s, e = newLazySbix(bytes.NewReader(raw), int64(len(raw)), 1)
+	if e != nil {
+		t.Fatal(e)
+	}
+	if _, _, e = s.glyph(0, 16, 16); e == nil {
+		t.Fatal("duplicate cycle accepted")
+	}
+	for n := 0; n < 24; n++ {
+		if _, e = newLazySbix(bytes.NewReader(raw[:n]), int64(n), 1); e == nil {
+			t.Fatal("truncated metadata", n)
+		}
+	}
+	s.r = errorReader{}
+	s.cache = make(map[uint64]*list.Element)
+	if _, _, e = s.glyph(0, 16, 16); e == nil {
+		t.Fatal("read error ignored")
+	}
+}
+
+type errorReader struct{}
+
+func (errorReader) ReadAt([]byte, int64) (int, error) { return 0, io.ErrUnexpectedEOF }

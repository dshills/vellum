+// coveredUniformDraw recognizes an immediately overwritten rectangular clear.
+// Check the live image values at replay, not while recording borrowed sources.
+// Keep unknown image/color implementations on their original call path, and
+// leave the render items intact for subsequent replay and other renderers.
+func coveredUniformDraw(clear, fill *pimage.Params) bool {
+	if clear == nil || fill == nil || clear.Cmd != pimage.Draw || fill.Cmd != pimage.Draw ||
+		clear.Op != draw.Src || fill.Op != draw.Over || clear.Mask != nil || fill.Mask != nil ||
+		clear.Rect.Empty() || clear.Rect != fill.Rect || clear.SourcePos != fill.SourcePos {
+		return false
+	}
+	if _, ok := valueUniform(clear.Source); !ok {
+		return false
+	}
+	u, ok := valueUniform(fill.Source)
+	if !ok {
+		return false
+	}
+	_, _, _, alpha := u.C.RGBA()
+	return alpha == 0xffff
+}
+
+func valueUniform(src image.Image) (*image.Uniform, bool) {
+	u, ok := src.(*image.Uniform)
+	if !ok || u == nil {
+		return nil, false
+	}
+	switch u.C.(type) {
+	case color.RGBA, color.RGBA64, color.NRGBA, color.NRGBA64,
+		color.Alpha, color.Alpha16, color.Gray, color.Gray16:
+		return u, true
+	}
+	return nil, false
 }
 

+func BenchmarkCoveredUniformDraw(b *testing.B) {
+	items := make(render.Render, 0, 1000)
+	for y := 0; y < 50; y++ {
+		for x := 0; x < 10; x++ {
+			r := image.Rect(x*96, y*12, (x+1)*96, (y+1)*12)
+			items = append(items, coveredDrawPair(r, r.Min, color.RGBA{41, 73, 99, 255})...)
+		}
+	}
+	for _, optimized := range []bool{false, true} {
+		b.Run(fmt.Sprint(optimized), func(b *testing.B) {
+			rs := New(math32.Vec2(960, 600)).(*Renderer)
+			b.ReportAllocs()
+			b.ResetTimer()
+			for i := 0; i < b.N; i++ {
+				if optimized {
+					rs.Render(items)
+				} else {
+					coveredDrawReference(rs, items)
+				}
+			}
+		})
+	}
+}

+func TestCoveredUniformDrawFallbackPixelAndCallParity(t *testing.T) {
+	bound := image.Rect(0, 0, 23, 19)
+	items := coveredDrawPair(image.Rect(2, 3, 19, 17), image.Point{}, color.RGBA{41, 73, 99, 255})
+	items[1].(*pimage.Params).Rect.Max.X--
+	coveredDrawCompare(t, bound, items) // The unmatched strip must retain the clear.
+	calls := 0
+	items = coveredDrawPair(image.Rect(2, 3, 19, 17), image.Point{}, color.RGBA{41, 73, 99, 255})
+	items[0].(*pimage.Params).Source = image.NewUniform(coveredDrawColor{&calls})
+	coveredDrawCompare(t, bound, items) // Unknown clear colors may have observable calls.
+	if calls != 2 {
+		t.Fatalf("custom clear color original calls lost: got %d", calls)
+	}
+}

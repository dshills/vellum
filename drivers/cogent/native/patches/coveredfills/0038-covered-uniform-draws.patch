+// Replay the pre-elision dispatch: an independent pixel oracle, not a copy of
+// the eligibility predicate. Captured items get shallow copies because legacy
+// full-image draws mutate their zero-rectangle sentinel on first use.
+func coveredDrawReference(rs *Renderer, items render.Render) {
+	for _, item := range items {
+		switch x := item.(type) {
+		case *render.Path:
+			rs.RenderPath(x)
+		case *pimage.Params:
+			x.Render(rs.image)
+		case *render.Text:
+			rs.RenderText(x)
+		}
+	}
+}
+
+func coveredDrawCopies(items render.Render) render.Render {
+	copy := append(render.Render(nil), items...)
+	for i, item := range copy {
+		if p, ok := item.(*pimage.Params); ok {
+			value := *p
+			copy[i] = &value
+		}
+	}
+	return copy
+}
+
+func coveredDrawTarget(rect image.Rectangle) *image.RGBA {
+	// Dirty premultiplied pixels, padded stride, and guard bytes exercise the
+	// overwrite proof without depending on a fresh transparent destination.
+	stride := rect.Dx()*4 + 16
+	pix := make([]byte, stride*rect.Dy()+32)
+	for i := range pix {
+		pix[i] = byte((i*37 + 11) % 128)
+	}
+	for y := 0; y < rect.Dy(); y++ {
+		for x := 0; x < rect.Dx(); x++ {
+			pix[y*stride+x*4+3] = 192
+		}
+	}
+	return &image.RGBA{Pix: pix, Stride: stride, Rect: rect}
+}
+
+func coveredDrawCompare(t *testing.T, bounds image.Rectangle, items render.Render) {
+	t.Helper()
+	coveredDrawCompareFrom(t, coveredDrawTarget(bounds), items)
+}
+
+func coveredDrawRenderer(target *image.RGBA) *Renderer {
+	rs := New(math32.FromPoint(target.Rect.Size())).(*Renderer)
+	rs.image = target
+	rs.ImgSpanner = scan.NewImgSpanner(target)
+	rs.Scanner = scan.NewScannerWithRowTracking(rs.ImgSpanner, target.Rect.Dx(), target.Rect.Dy())
+	rs.Raster = NewDasher(target.Rect.Dx(), target.Rect.Dy(), rs.Scanner)
+	return rs
+}
+
+func coveredDrawCompareFrom(t *testing.T, seed *image.RGBA, items render.Render) {
+	t.Helper()
+	actual, expected := *seed, *seed
+	actual.Pix = append([]byte(nil), seed.Pix...)
+	expected.Pix = append([]byte(nil), seed.Pix...)
+	optimized, original := coveredDrawRenderer(&actual), coveredDrawRenderer(&expected)
+	originalItems, optimizedItems := coveredDrawCopies(items), coveredDrawCopies(items)
+	coveredDrawReference(original, originalItems)
+	optimized.Render(optimizedItems)
+	if !bytes.Equal(actual.Pix, expected.Pix) {
+		t.Fatalf("optimized replay differs from original pixels/stride guards: bounds=%v items=%v", seed.Rect, items)
+	}
+	if !reflect.DeepEqual(optimizedItems, originalItems) {
+		t.Fatal("optimized replay changed captured item state")
+	}
+}
+
+func coveredDrawPair(rect image.Rectangle, sourcePos image.Point, foreground color.Color) render.Render {
+	return render.Render{
+		&pimage.Params{Cmd: pimage.Draw, Rect: rect, SourcePos: sourcePos, Op: draw.Src, Source: image.NewUniform(color.NRGBA{12, 44, 81, 97})},
+		&pimage.Params{Cmd: pimage.Draw, Rect: rect, SourcePos: sourcePos, Op: draw.Over, Source: image.NewUniform(foreground)},
+	}
+}

+// Exercise the actual widget box painter, not fabricated draw parameters.
+func coveredDrawStandardBox(scale float32, clip image.Rectangle, decorated bool, parent image.Image) render.Render {
+	pc := paint.NewPainter(math32.Vec2(128, 96))
+	pc.Transform = math32.Scale2D(scale, scale)
+	pc.Context().Bounds.Rect = math32.B2FromRect(clip)
+	var style styles.Style
+	style.Defaults()
+	style.ZeroSpace()
+	style.ActualBackground = image.NewUniform(color.RGBA{27, 83, 119, 255})
+	if decorated {
+		style.Border.Width.Set(units.Dot(2))
+		style.Border.Radius.Set(units.Dot(5))
+		style.Border.Style.Set(styles.BorderSolid)
+		style.Border.Color.Set(image.NewUniform(color.RGBA{220, 30, 50, 255}))
+		style.BoxShadow = []styles.Shadow{{OffsetX: units.Dot(2), OffsetY: units.Dot(1), Blur: units.Dot(4), Color: image.NewUniform(color.NRGBA{1, 2, 3, 180})}}
+	}
+	style.ToDots()
+	pc.StandardBox(&style, math32.Vec2(3.25, 4.75), math32.Vec2(40.5, 26.25), parent)
+	return pc.RenderDone()
+}
+
+func coveredDrawEligibleCount(items render.Render) int {
+	count := 0
+	for i := 0; i+1 < len(items); i++ {
+		a, aok := items[i].(*pimage.Params)
+		b, bok := items[i+1].(*pimage.Params)
+		if aok && bok && coveredUniformDraw(a, b) {
+			count++
+		}
+	}
+	return count
+}
+
+func TestCoveredUniformDrawStandardBox(t *testing.T) {
+	parent := image.NewUniform(color.NRGBA{10, 19, 44, 83})
+	for _, scale := range []float32{1, 1.25, 1.5, 1.6875, 2} {
+		for _, clip := range []image.Rectangle{image.Rect(0, 0, 128, 96), image.Rect(13, 9, 69, 47)} {
+			t.Run(fmt.Sprintf("scale-%g/clip-%v", scale, clip), func(t *testing.T) {
+				plain := coveredDrawStandardBox(scale, clip, false, parent)
+				if coveredDrawEligibleCount(plain) != 1 {
+					t.Fatal("real plain StandardBox did not emit a covered pair")
+				}
+				bounds := image.Rect(0, 0, 128, 96)
+				coveredDrawCompare(t, bounds, plain)
+				decorated := coveredDrawStandardBox(scale, clip, true, parent)
+				if coveredDrawEligibleCount(decorated) != 0 {
+					t.Fatal("decorated box unexpectedly elided")
+				}
+				coveredDrawCompare(t, bounds, decorated)
+				// Replay the undecorated replacement on a real prior border/shadow frame.
+				seed := coveredDrawTarget(bounds)
+				previous := coveredDrawRenderer(seed)
+				coveredDrawReference(previous, coveredDrawCopies(decorated))
+				coveredDrawCompareFrom(t, seed, plain)
+				// The same captured items are replayable following resize/regrowth.
+				rs := New(math32.Vec2(128, 96)).(*Renderer)
+				for _, size := range []math32.Vector2{math32.Vec2(128, 96), math32.Vec2(32, 24), math32.Vec2(128, 96)} {
+					rs.SetSize(units.UnitDot, size)
+					draw.Draw(rs.image, rs.image.Bounds(), parent, image.Point{}, draw.Src)
+					expected := image.NewRGBA(rs.image.Bounds())
+					copy(expected.Pix, rs.image.Pix)
+					reference := coveredDrawRenderer(expected)
+					coveredDrawReference(reference, coveredDrawCopies(plain))
+					rs.Render(coveredDrawCopies(plain))
+					if !bytes.Equal(rs.image.Pix, expected.Pix) {
+						t.Fatal("resized replay differs from original")
+					}
+				}
+			})
+		}
+	}
+}

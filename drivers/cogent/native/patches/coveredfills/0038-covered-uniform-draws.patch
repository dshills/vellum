+func TestCoveredUniformDrawLiveSourcesAndFallbacks(t *testing.T) {
+	bound, rect := image.Rect(0, 0, 23, 19), image.Rect(2, 3, 19, 17)
+	items := coveredDrawPair(rect, rect.Min, color.RGBA{41, 73, 99, 255})
+	fill := items[1].(*pimage.Params).Source.(*image.Uniform)
+	for _, c := range []color.Color{color.RGBA{41, 73, 99, 255}, color.NRGBA{71, 33, 12, 127}, color.RGBA{11, 29, 31, 255}} {
+		fill.C = c // The borrowed source changes after recording, before replay.
+		coveredDrawCompare(t, bound, items)
+	}
+	calls := 0
+	fill.C = coveredDrawColor{&calls}
+	if coveredUniformDraw(items[0].(*pimage.Params), items[1].(*pimage.Params)) || calls != 0 {
+		t.Fatal("unknown color was evaluated or elided during eligibility")
+	}
+	coveredDrawCompare(t, bound, items)
+	if calls != 2 {
+		t.Fatalf("unknown color must keep each original replay call: got%d", calls)
+	}
+
+	mask := image.NewAlpha(bound)
+	for i := range mask.Pix {
+		mask.Pix[i] = byte(i * 17)
+	}
+	imageSource := coveredDrawTarget(bound)
+	cases := []struct {
+		name   string
+		change func(clear, fill *pimage.Params)
+	}{
+		{"translucent", func(_, b *pimage.Params) { b.Source = image.NewUniform(color.NRGBA{71, 33, 12, 127}) }},
+		{"different-rect", func(_, b *pimage.Params) { b.Rect.Max.X-- }},
+		{"different-source-origin", func(_, b *pimage.Params) { b.SourcePos = image.Pt(1<<30, 1<<30) }},
+		{"clear-mask", func(a, _ *pimage.Params) { a.Mask = mask }},
+		{"fill-mask", func(_, b *pimage.Params) { b.Mask = mask }},
+		{"clear-over", func(a, _ *pimage.Params) { a.Op = draw.Over }},
+		{"fill-src", func(_, b *pimage.Params) { b.Op = draw.Src }},
+		{"clear-image", func(a, _ *pimage.Params) { a.Source = imageSource }},
+		{"fill-image", func(_, b *pimage.Params) { b.Source = imageSource }},
+		{"full-image-sentinel", func(a, b *pimage.Params) { a.Rect, b.Rect = image.Rectangle{}, image.Rectangle{} }},
+		{"empty-region", func(a, b *pimage.Params) { a.Rect, b.Rect = image.Rect(2, 3, 2, 17), image.Rect(2, 3, 2, 17) }},
+		{"clear-pixel", func(a, _ *pimage.Params) { a.Cmd, a.SourcePos = pimage.SetPixel, image.Pt(3, 4) }},
+		{"fill-transform", func(_, b *pimage.Params) { b.Cmd, b.Cumulative = pimage.Transform, math32.Scale2D(1.25, 1.5) }},
+	}
+	for _, test := range cases {
+		t.Run(test.name, func(t *testing.T) {
+			items := coveredDrawPair(rect, rect.Min, color.RGBA{41, 73, 99, 255})
+			a, b := items[0].(*pimage.Params), items[1].(*pimage.Params)
+			test.change(a, b)
+			if coveredUniformDraw(a, b) {
+				t.Fatal("operation boundary was elided")
+			}
+			coveredDrawCompare(t, bound, items)
+		})
+	}
+	if coveredUniformDraw(nil, &pimage.Params{}) || coveredUniformDraw(&pimage.Params{}, nil) {
+		t.Fatal("nil draw was eligible")
+	}
+	if _, ok := valueUniform((*image.Uniform)(nil)); ok {
+		t.Fatal("nil uniform was eligible")
+	}
+}

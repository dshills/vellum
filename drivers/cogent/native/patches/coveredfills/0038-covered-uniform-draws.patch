+func TestCoveredUniformDrawDirtyPixelParity(t *testing.T) {
+	colors := []color.Color{color.RGBA{9, 40, 83, 255}, color.RGBA64{900, 1300, 60000, 65535}, color.NRGBA{12, 83, 244, 255}, color.NRGBA64{192, 4096, 12288, 65535}, color.Alpha{255}, color.Alpha16{65535}, color.Gray{85}, color.Gray16{30001}}
+	bounds := []image.Rectangle{image.Rect(0, 0, 23, 19), image.Rect(-7, -3, 16, 16), image.Rect(11, 17, 34, 36)}
+	rects := []image.Rectangle{image.Rect(0, 0, 23, 19), image.Rect(-4, -6, 15, 11), image.Rect(8, 4, 40, 35), image.Rect(-100, -100, 100, 100), image.Rect(0, 0, 1, 1)}
+	positions := []image.Point{{}, {-17, 29}, {1 << 30, -(1 << 30)}}
+	eligible := 0
+	for ci, c := range colors {
+		for bi, bound := range bounds {
+			for ri, rect := range rects {
+				for pi, position := range positions {
+					t.Run(fmt.Sprintf("%d-%d-%d-%d", ci, bi, ri, pi), func(t *testing.T) {
+						items := coveredDrawPair(rect, position, c)
+						if !coveredUniformDraw(items[0].(*pimage.Params), items[1].(*pimage.Params)) {
+							t.Fatal("genuinely covered uniform pair was not eligible")
+						}
+						eligible++
+						coveredDrawCompare(t, bound, items)
+					})
+				}
+			}
+		}
+	}
+	if eligible != 360 {
+		t.Fatalf("eligible replay count=%d", eligible)
+	}
+}

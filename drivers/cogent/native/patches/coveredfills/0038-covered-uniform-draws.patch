+type coveredDrawGradient struct {
+	*gradient.Linear
+	updates, reads int
+}
+
+func (g *coveredDrawGradient) Update(opacity float32, box math32.Box2, transform math32.Matrix2) {
+	g.updates++
+	g.Linear.Update(opacity, box, transform)
+}
+func (g *coveredDrawGradient) At(x, y int) color.Color { g.reads++; return g.Linear.At(x, y) }
+
+func TestCoveredUniformDrawPreservesPainterGradientAndPath(t *testing.T) {
+	g := &coveredDrawGradient{Linear: gradient.NewLinear().AddStop(color.RGBA{9, 21, 43, 255}, 0).AddStop(color.RGBA{61, 71, 91, 255}, 1)}
+	clip := image.Rect(13, 9, 69, 47)
+	items := coveredDrawStandardBox(1.25, clip, false, g)
+	if g.updates != 1 || g.reads != 0 || coveredDrawEligibleCount(items) != 0 {
+		t.Fatal("gradient recording/evaluation contract changed")
+	}
+	coveredDrawCompare(t, image.Rect(0, 0, 128, 96), items)
+	area := items[0].(*pimage.Params).Rect
+	if g.updates != 1 || g.reads != 2*area.Dx()*area.Dy() {
+		t.Fatalf("gradient original calls lost: updates=%d reads=%d area=%v", g.updates, g.reads, area)
+	}
+	// A path between clear and fill must retain all three ordered operations.
+	pc := paint.NewPainter(math32.Vec2(128, 96))
+	pc.Fill.Color = image.NewUniform(color.RGBA{211, 19, 31, 255})
+	pc.Stroke.Color = nil
+	pc.Rectangle(7, 8, 20, 11)
+	pc.Draw()
+	pathItems := pc.RenderDone()
+	if len(pathItems) == 0 {
+		t.Fatal("real path recording empty")
+	}
+	pair := coveredDrawPair(image.Rect(3, 4, 53, 43), image.Point{}, color.RGBA{27, 83, 119, 255})
+	interrupted := append(render.Render{pair[0]}, pathItems...)
+	interrupted = append(interrupted, pair[1])
+	if coveredDrawEligibleCount(interrupted) != 0 {
+		t.Fatal("path boundary was ignored")
+	}
+	coveredDrawCompare(t, image.Rect(0, 0, 128, 96), interrupted)
+	// Rounded parent clipping produces paths and must stay on original dispatch.
+	pc.PushContext(pc.Paint, render.NewBoundsRect(clip, sides.NewFloats(5)))
+	var style styles.Style
+	style.Defaults()
+	style.ZeroSpace()
+	style.ToDots()
+	style.ActualBackground = image.NewUniform(color.RGBA{21, 43, 81, 255})
+	pc.PushContext(pc.Paint, render.NewBoundsRect(clip, sides.Floats{}))
+	pc.StandardBox(&style, math32.Vec2(13, 9), math32.Vec2(40, 26), image.Black)
+	pc.PopContext()
+	pc.PopContext()
+	rounded := pc.RenderDone()
+	if coveredDrawEligibleCount(rounded) != 0 {
+		t.Fatal("rounded parent clipping was elided")
+	}
+	coveredDrawCompare(t, image.Rect(0, 0, 128, 96), rounded)
+}

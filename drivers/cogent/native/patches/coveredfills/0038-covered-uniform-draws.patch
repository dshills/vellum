+func TestCoveredUniformDrawKeepsOrderedChains(t *testing.T) {
+	bound := image.Rect(0, 0, 48, 40)
+	items := coveredDrawPair(image.Rect(1, 2, 24, 18), image.Point{}, color.RGBA{17, 51, 79, 255})
+	items = append(items, &pimage.Params{Cmd: pimage.SetPixel, SourcePos: image.Pt(5, 8), Source: image.NewUniform(color.RGBA{255, 0, 0, 255})})
+	items = append(items, coveredDrawPair(image.Rect(15, 9, 39, 28), image.Point{}, color.RGBA{11, 77, 31, 255})...)
+	items = append(items, &pimage.Params{Cmd: pimage.Blur, Rect: image.Rect(8, 6, 33, 25), BlurRadius: 1})
+	items = append(items, coveredDrawPair(image.Rect(3, 13, 43, 32), image.Point{}, color.NRGBA{111, 53, 90, 133})...)
+	for i := 0; i < 3; i++ {
+		coveredDrawCompare(t, bound, items)
+	}
+}

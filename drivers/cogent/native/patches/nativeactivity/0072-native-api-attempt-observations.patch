+//go:build vellum_native_checks
+
+package desktop
+
+import (
+	"testing"
+
+	"cogentcore.org/core/base/nativeactivity"
+)
+
+// The actual lifecycle admission uses injected callbacks; no GLFW/AppKit call.
+func TestVellumNativeActivityCountsOnlyAdmittedPostAttempts(t *testing.T) {
+	before := nativeactivity.Read()
+	var n nativeEventLifecycle
+	n.wake(func() { t.Fatal("uninitialized post") })
+	if got := nativeactivity.Read(); got != before {
+		t.Fatal("refused post counted", before, got)
+	}
+	if err := n.start(func() error { return nil }); err != nil {
+		t.Fatal(err)
+	}
+	posts := 0
+	n.wake(func() {
+		posts++
+		if got := nativeactivity.Read(); got.EmptyEventPostAttempts != before.EmptyEventPostAttempts+1 {
+			t.Fatal("post was not counted before callback", got)
+		}
+	})
+	sentinel := "injected post failure"
+	func() {
+		defer func() {
+			if recover() != sentinel {
+				t.Error("post panic changed")
+			}
+		}()
+		n.wake(func() { panic(sentinel) })
+	}()
+	n.stop(func() {})
+	n.wake(func() { t.Fatal("retired post") })
+	after := nativeactivity.Read()
+	if posts != 1 || after.EmptyEventPostAttempts-before.EmptyEventPostAttempts != 2 || after.SurfacePresentAttempts != before.SurfacePresentAttempts || after.Saturated {
+		t.Fatal("admission/panic post count differs", before, after)
+	}
+}

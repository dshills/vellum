+//go:build vellum_native_checks
+
+package gpu
+
+import (
+	"time"
+
+	"cogentcore.org/core/base/nativeactivity"
+)
+
+// presentObserved is only in explicit instrumentation builds. The callback is
+// synchronous and never retained. Deferred retirement covers counter/backend
+// unwind; idle frames never attempt the backend or increment its counter.
+func (sf *Surface) presentObserved(present func() int64) int64 {
+	if !sf.frame.held() {
+		return 0
+	}
+	defer sf.AbortCurrentTexture()
+	nativeactivity.RecordSurfacePresent()
+	return present()
+}
+
+func (sf *Surface) Present() {
+	sf.presentObserved(func() int64 { sf.surface.Present(); return 0 })
+}
+
+// Counter observation precedes the timer; retirement follows it. As before,
+// only elapsed backend call time is excluded from encompassing UI work.
+func (sf *Surface) PresentMeasured() int64 {
+	return sf.presentObserved(func() int64 {
+		start := time.Now()
+		sf.surface.Present()
+		return time.Since(start).Nanoseconds()
+	})
+}

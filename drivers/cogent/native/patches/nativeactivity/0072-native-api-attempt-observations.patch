+//go:build !vellum_native_checks
+
+// Original method bodies retained from the pinned upstream plus owned lifetime patches.
+package gpu
+
+import "time"
+
+// Present is the final step for showing the rendered texture to the window.
+// The current texture is automatically Released and Unlock() is called.
+func (sf *Surface) Present() {
+	if !sf.frame.held() {
+		return
+	}
+	defer sf.AbortCurrentTexture()
+	sf.surface.Present()
+}
+
+// PresentMeasured excludes only the backend presentation call. Texture cleanup
+// and ownership release remain charged in the encompassing encoding interval.
+func (sf *Surface) PresentMeasured() int64 {
+	if !sf.frame.held() {
+		return 0
+	}
+	defer sf.AbortCurrentTexture()
+	start := time.Now()
+	sf.surface.Present()
+	return time.Since(start).Nanoseconds()
+}

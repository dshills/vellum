+//go:build vellum_native_checks
+
+package nativeactivity
+
+import (
+	"math"
+	"os"
+	"sync"
+	"testing"
+)
+
+func TestVellumNativeActivityConcurrentCounterAndSaturation(t *testing.T) {
+	var c counter
+	var workers sync.WaitGroup
+	for range 16 {
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			for range 1024 {
+				c.add()
+			}
+		}()
+	}
+	workers.Wait()
+	if c.value.Load() != 16*1024 {
+		t.Fatal("concurrent attempts were lost", c.value.Load())
+	}
+	// Saturate only a local fixture. Never reset or poison process counters.
+	c.value.Store(math.MaxUint64 - 1)
+	for range 16 {
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			for range 32 {
+				c.add()
+			}
+		}()
+	}
+	workers.Wait()
+	if c.value.Load() != math.MaxUint64 {
+		t.Fatal("saturated counter wrapped", c.value.Load())
+	}
+	for _, pair := range [][2]uint64{{math.MaxUint64, 0}, {0, math.MaxUint64}, {math.MaxUint64, math.MaxUint64}} {
+		if got := sample(123, pair[0], pair[1]); !got.Saturated || got.EmptyEventPostAttempts != pair[0] || got.SurfacePresentAttempts != pair[1] {
+			t.Fatal("loaded saturation was not published in the same sample", got)
+		}
+	}
+}
+
+func TestVellumNativeActivityAvailableDetachedProcessSamples(t *testing.T) {
+	before := Read()
+	RecordEventPost()
+	RecordEventPost()
+	RecordSurfacePresent()
+	after := Read()
+	if !before.Available || !after.Available || after.ProcessID != os.Getpid() || before.ProcessID != after.ProcessID || before.Saturated || after.Saturated || after.EmptyEventPostAttempts-before.EmptyEventPostAttempts != 2 || after.SurfacePresentAttempts-before.SurfacePresentAttempts != 1 {
+		t.Fatal("wrong process attempt deltas", before, after)
+	}
+	after.EmptyEventPostAttempts = 0
+	if Read().EmptyEventPostAttempts != before.EmptyEventPostAttempts+2 {
+		t.Fatal("caller mutated global counters")
+	}
+}

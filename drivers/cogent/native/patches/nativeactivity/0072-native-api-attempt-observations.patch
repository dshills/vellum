+//go:build vellum_native_checks
+
+package gpu
+
+import (
+	"reflect"
+	"testing"
+
+	"cogentcore.org/core/base/nativeactivity"
+)
+
+func TestVellumNativeActivityOwnedSurfaceAttemptAndPanicRetire(t *testing.T) {
+	for _, panics := range []bool{false, true} {
+		t.Run(map[bool]string{false: "return", true: "panic"}[panics], func(t *testing.T) {
+			before := nativeactivity.Read()
+			var events []string
+			view := &countedFrameRef{name: "view", events: &events}
+			texture := &countedFrameRef{name: "texture", events: &events}
+			sf := &Surface{}
+			sf.Lock()
+			sf.frame = surfaceFrame{view: view, texture: texture}
+			sentinel := "injected backend attempt panic"
+			func() {
+				defer func() {
+					if got := recover(); panics && got != sentinel || !panics && got != nil {
+						t.Error("backend unwind changed", got)
+					}
+				}()
+				elapsed := sf.presentObserved(func() int64 {
+					events = append(events, "attempt")
+					if !sf.frame.held() || sf.TryLock() || nativeactivity.Read().SurfacePresentAttempts != before.SurfacePresentAttempts+1 {
+						t.Error("attempt was not counted under original ownership before backend")
+					}
+					if panics {
+						panic(sentinel)
+					}
+					return 7
+				})
+				if elapsed != 7 {
+					t.Error("measured callback value changed", elapsed)
+				}
+			}()
+			if sf.frame.held() || !sf.TryLock() {
+				t.Fatal("attempt retained frame or lock")
+			}
+			sf.Unlock()
+			if view.releases != 1 || texture.releases != 1 || !reflect.DeepEqual(events, []string{"attempt", "view", "texture"}) {
+				t.Fatal("retirement order/count changed", events)
+			}
+			sf.Present() // nil native surface is safe because the frame is idle.
+			if sf.PresentMeasured() != 0 || (&RenderTexture{}).PresentMeasured() != 0 {
+				t.Fatal("idle/offscreen target reported presentation time")
+			}
+			after := nativeactivity.Read()
+			if after.SurfacePresentAttempts-before.SurfacePresentAttempts != 1 || after.EmptyEventPostAttempts != before.EmptyEventPostAttempts {
+				t.Fatal("idle/repeated/RenderTexture counted a backend attempt", before, after)
+			}
+		})
+	}
+}

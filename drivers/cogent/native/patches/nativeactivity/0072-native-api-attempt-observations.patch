+//go:build vellum_native_checks
+
+package nativeactivity
+
+import (
+	"math"
+	"os"
+	"sync/atomic"
+)
+
+type counter struct{ value atomic.Uint64 }
+
+func (c *counter) add() {
+	for {
+		old := c.value.Load()
+		if old == math.MaxUint64 || c.value.CompareAndSwap(old, old+1) {
+			return
+		}
+	}
+}
+
+var eventPosts, surfacePresents counter
+
+// RecordEventPost counts an admitted framework post attempt before its backend
+// call. Coalescing, returned native events and successful wakeups are unknown.
+func RecordEventPost() { eventPosts.add() }
+
+// RecordSurfacePresent counts an owned surface's backend Present attempt before
+// the call. Failed/panicking attempts count; RenderTexture no-ops do not.
+func RecordSurfacePresent() { surfacePresents.add() }
+
+// Read never resets global counters, dispatches work or retains native objects.
+// MaxUint64 is a saturated/unusable observation, including the first arrival at
+// that value. Deriving Saturated from these exact loads avoids a flag race.
+func Read() Counters {
+	posts, presents := eventPosts.value.Load(), surfacePresents.value.Load()
+	return sample(os.Getpid(), posts, presents)
+}
+
+func sample(pid int, posts, presents uint64) Counters {
+	return Counters{Available: true, ProcessID: pid, EmptyEventPostAttempts: posts, SurfacePresentAttempts: presents, Saturated: posts == math.MaxUint64 || presents == math.MaxUint64}
+}

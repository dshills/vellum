+// Copyright 2026 Vellum contributors. MIT license in the Vellum repository.
+
+// Package nativeactivity exposes bounded diagnostic API-attempt observations.
+// Counters are enabled only by vellum_native_checks. They do not count OS
+// wakeups, GPU completions or compositor presentations.
+package nativeactivity
+
+// Counters is a detached process-local sample. The two counters are loaded
+// independently, not atomically together. Read intervals bracket observations;
+// they do not identify an exact shared timestamp. ProcessID is a necessary scope
+// check, not cross-process provenance or a process-lifetime capability.
+type Counters struct {
+	Available              bool   `json:"available"`
+	ProcessID              int    `json:"process_id"`
+	EmptyEventPostAttempts uint64 `json:"empty_event_post_attempts"`
+	SurfacePresentAttempts uint64 `json:"surface_present_attempts"`
+	Saturated              bool   `json:"saturated"`
+}

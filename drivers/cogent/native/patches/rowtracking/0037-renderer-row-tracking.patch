+// The production Renderer constructor owns a row-tracked scanner. The reference
+// is a separately constructed renderer whose scanner and both raster pipelines
+// are replaced with ordinary full-row components. All tested drawing goes
+// through Renderer.Render, including Fill, Stroke, path transforms and clipping.
+func TestVellumRowTrackingOwnedRendererPixels(t *testing.T) {
+	tracked := New(math32.Vec2(96, 64)).(*Renderer)
+	full := New(math32.Vec2(96, 64)).(*Renderer)
+	frames := 0
+	// Shrink, regrow and a tall target exercise actual SetSize caller rebuilding.
+	for _, height := range []int{64, 1152, 32, 8192, 64} {
+		size := math32.Vec2(96, float32(height))
+		tracked.SetSize(units.UnitDot, size)
+		full.SetSize(units.UnitDot, size)
+		vellumOwnedFullRowRenderer(full)
+		for _, scenario := range vellumOwnedPathScenes(height) {
+			t.Run(fmt.Sprintf("height-%d/%s/frame-%d", height, scenario.name, frames), func(t *testing.T) {
+				draw.Draw(tracked.image, tracked.image.Bounds(), image.Transparent, image.Point{}, draw.Src)
+				draw.Draw(full.image, full.image.Bounds(), image.Transparent, image.Point{}, draw.Src)
+				for replay := range 2 {
+					tracked.Render(scenario.items)
+					full.Render(scenario.items)
+					vellumOwnedEqualRGBA(t, tracked.image, full.image)
+					if vellumOwnedNonzero(full.image.Pix) == 0 {
+						t.Fatal("reference drawing unexpectedly blank")
+					}
+					if scenario.clip != nil {
+						for y := range full.image.Bounds().Dy() {
+							for x := range full.image.Bounds().Dx() {
+								if !(image.Pt(x, y).In(*scenario.clip)) && full.image.RGBAAt(x, y) != (color.RGBA{}) {
+									t.Fatalf("drawing escaped clip at (%d,%d)", x, y)
+								}
+							}
+						}
+					}
+					t.Logf("owned-renderer height=%d case=%s replay=%d rgba_sha256=%x", height, scenario.name, replay, sha256.Sum256(full.image.Pix))
+				}
+			})
+			frames++
+		}
+	}
+	if frames != 35 {
+		t.Fatalf("expected all 35 renderer scenes, got %d", frames)
+	}
+}
+
+func vellumOwnedFullRowRenderer(rs *Renderer) {
+	size := rs.image.Bounds().Size()
+	rs.Scanner = scan.NewScanner(rs.ImgSpanner, size.X, size.Y)
+	rs.Raster = NewDasher(size.X, size.Y, rs.Scanner)
+}
+
+type vellumOwnedPathScene struct {
+	name  string
+	items render.Render
+	clip  *image.Rectangle
+}
+
+func vellumOwnedPathItem(path *ppath.Path, clip image.Rectangle, transform math32.Matrix2, fill, stroke color.Color, rule ppath.FillRules, dash bool) *render.Path {
+	style := styles.NewPaint()
+	style.Transform = transform
+	style.Fill.Color = nil
+	style.Stroke.Color = nil
+	style.Fill.Rule = rule
+	if fill != nil {
+		style.Fill.Color = colors.Uniform(fill)
+	}
+	if stroke != nil {
+		style.Stroke.Color = colors.Uniform(stroke)
+		style.Stroke.Width = units.Dot(2.75)
+		style.Stroke.Width.Dots = 2.75
+		style.Stroke.Cap = ppath.CapRound
+		style.Stroke.Join = ppath.JoinRound
+		if dash {
+			style.Stroke.Dashes = []float32{4.5, 2.25, 1.5, 2.25}
+		}
+	}
+	parent := &render.Context{}
+	parent.Init(styles.NewPaint(), &render.Bounds{Rect: math32.B2FromRect(clip)}, nil)
+	return render.NewPath(*path, style, parent)
+}
+
+func vellumOwnedPathScenes(height int) []vellumOwnedPathScene {
+	bounds := image.Rect(0, 0, 96, height)
+	identity := math32.Identity2()
+	blue := color.NRGBA{R: 30, G: 75, B: 210, A: 220}
+	red := color.NRGBA{R: 220, G: 25, B: 45, A: 180}
+	green := color.NRGBA{R: 10, G: 130, B: 65, A: 255}
+	item := func(p *ppath.Path, fill, stroke color.Color, rule ppath.FillRules, dash bool) *render.Path {
+		return vellumOwnedPathItem(p, bounds, identity, fill, stroke, rule, dash)
+	}
+	rect := ppath.New().Rectangle(3.25, 2.5, 24.5, 13.75)
+	compound := ppath.New()
+	for _, r := range [][4]float32{{6, 3, 48, 23}, {18, 8, 22, 11}} {
+		compound.MoveTo(r[0], r[1])
+		compound.LineTo(r[0]+r[2], r[1])
+		compound.LineTo(r[0]+r[2], r[1]+r[3])
+		compound.LineTo(r[0], r[1]+r[3])
+		compound.Close()
+	}
+	curve := ppath.New()
+	curve.MoveTo(7.5, 5.25)
+	curve.QuadTo(28.25, -7.5, 48.75, 9.5)
+	curve.CubeTo(80.5, 3.25, 77.75, 32.5, 41.5, 25.75)
+	curve.QuadTo(9.25, 30.5, 7.5, 5.25)
+	curve.Close()
+	open := ppath.New()
+	open.MoveTo(2.25, 8.5)
+	open.QuadTo(28.5, 29.5, 51.5, 5.25)
+	open.CubeTo(60.75, -3.5, 80.25, 21.25, 91.5, 11.75)
+	transform := math32.Translate2D(12.25, 4.5).Rotate(0.17).Scale(0.72, 0.65)
+	clip := image.Rect(9, 4, 47, min(height, 24))
+	clipped := ppath.New().Rectangle(-30, -12, 130, 52)
+	bottom := ppath.New().Rectangle(53.5, float32(height)-12.25, 31.75, 9.5)
+	return []vellumOwnedPathScene{
+		{name: "fill-fractional", items: render.Render{item(rect, blue, nil, ppath.NonZero, false)}},
+		{name: "compound-nonzero", items: render.Render{item(compound, green, red, ppath.NonZero, false)}},
+		{name: "compound-evenodd", items: render.Render{item(compound, green, red, ppath.EvenOdd, false)}},
+		{name: "quadratic-cubic-fill-stroke", items: render.Render{item(curve, blue, red, ppath.NonZero, false)}},
+		{name: "open-dashed-transformed-curves", items: render.Render{vellumOwnedPathItem(open, bounds, transform, nil, green, ppath.NonZero, true)}},
+		{name: "negative-clipped", items: render.Render{vellumOwnedPathItem(clipped, clip, identity, blue, nil, ppath.NonZero, false)}, clip: &clip},
+		{name: "disjoint-high-then-low", items: render.Render{item(bottom, red, green, ppath.NonZero, true), item(rect, blue, nil, ppath.NonZero, false)}},
+	}
+}

+// NewScannerWithRowTracking creates a scanner for an exclusively owned
+// renderer. Draw and Clear visit the bounding range of rows allocated by
+// scanner methods.
+// Callers must not modify Cell or CellIndex directly; use NewScanner when
+// directly supplying accumulated cells. SetBounds always initializes all rows.
+func NewScannerWithRowTracking(xs Spanner, width, height int) *Scanner {
+	sc := &Scanner{Spanner: xs, UseNonZeroWinding: true, trackRows: true}
+	sc.SetBounds(width, height)

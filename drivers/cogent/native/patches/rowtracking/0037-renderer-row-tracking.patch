+func TestVellumRowTrackingFindCellAndWinding(t *testing.T) {
+	p := vellumNewScannerPair(24, 64)
+	for _, s := range []*Scanner{p.tracked, p.original.Scanner} {
+		s.Xi, s.Yi = -100, 31
+		first := s.FindCell()
+		if first < 0 || s.FindCell() != first || len(s.Cell) != 1 || s.Cell[first].Xi != -1 {
+			t.Fatal("duplicate negative-X FindCell must reuse the same saved cell")
+		}
+		s.Xi = 100
+		if next := s.FindCell(); next == first || len(s.Cell) != 2 || s.Cell[next].Xi != s.Width {
+			t.Fatal("right-offscreen cell must clamp to Width")
+		}
+		for _, row := range []int{-1, 64} {
+			s.Yi = row
+			if s.FindCell() != -1 || len(s.Cell) != 2 {
+				t.Fatal("offscreen FindCell altered stored cells")
+			}
+		}
+	}
+	p.draw(t)
+	p.both(func(s vellumScannerPath) { s.Clear() })
+	vellumCompareSavedState(t, p.tracked, p.original.Scanner)
+	for _, index := range p.tracked.CellIndex {
+		if index != -1 {
+			t.Fatal("Clear did not retire a FindCell row with zero accumulated coverage")
+		}
+	}
+	var nonZero []vellumCapturedSpan
+	for _, winding := range []bool{true, false} {
+		p.both(func(s vellumScannerPath) {
+			s.Clear()
+			s.SetWinding(winding)
+			vellumRectangle(s, 4, 8, 17, 13)
+			vellumRectangle(s, 4, 8, 17, 13)
+		})
+		spans := p.draw(t)
+		if winding {
+			nonZero = spans
+		} else if len(spans) != 0 {
+			t.Fatalf("even-odd duplicate rectangle did not cancel: %v", spans)
+		}
+	}
+	if len(nonZero) == 0 {
+		t.Fatal("nonzero duplicate rectangle fixture did not render")
+	}
+}

+func BenchmarkVellumRowTrackingSmallShape(b *testing.B) {
+	for _, height := range []int{64, 1152, 8192} {
+		for _, tracked := range []bool{true, false} {
+			name := "full-row-reference"
+			if tracked {
+				name = "tracked"
+			}
+			b.Run(fmt.Sprintf("height%d/%s", height, name), func(b *testing.B) {
+				var checksum uint64
+				spanner := &vellumSpanCollector{fn: func(y, x0, x1 int, alpha uint32) {
+					checksum += uint64(y) + uint64(x0) + uint64(x1) + uint64(alpha)
+				}}
+				var s vellumScannerPath
+				if tracked {
+					s = NewScannerWithRowTracking(spanner, 64, height)
+				} else {
+					s = &vellumFullRowOracle{NewScanner(spanner, 64, height)}
+				}
+				// Warm saved-cell capacity outside measurement. Same tiny shape,
+				// same span consumer, no image allocation at any surface height.
+				vellumRectangle(s, 5, 7, 21, 16)
+				s.Draw()
+				s.Clear()
+				b.ReportAllocs()
+				b.ResetTimer()
+				for i := 0; i < b.N; i++ {
+					s.Clear()
+					vellumRectangle(s, 5, 7, 21, 16)
+					s.Draw()
+				}
+				vellumTouchedRowsBenchmarkSink = checksum
+			})
+		}
+	}

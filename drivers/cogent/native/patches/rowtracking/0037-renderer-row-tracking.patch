+// These are independent caches, not copies of the global cache or its mutex.
+// The reference uses full-row accumulation but the same real font outlines,
+// mask generation and lookup methods as the production-owned cache.
+func TestVellumRowTrackingOwnedGlyphColdWarmPixels(t *testing.T) {
+	var tracked, full glyphCache
+	tracked.init()
+	full.init()
+	full.scanner = scan.NewScanner(full.imgSpanner, full.maxSize.X, full.maxSize.Y)
+	full.filler = NewFiller(full.maxSize.X, full.maxSize.Y, full.scanner)
+	full.filler.SetWinding(true)
+	full.filler.SetColor(colors.Uniform(color.Black))
+	full.scanner.SetClip(full.image.Bounds())
+	shaper := shapedgt.NewShaperWithFonts([]fs.FS{fonts.Default})
+	positions := []math32.Vector2{math32.Vec2(20, 60), math32.Vec2(20.25, 60.5), math32.Vec2(20.5, 60.25), math32.Vec2(-6.25, 44.75)}
+	cold := 0
+	for _, size := range []float32{24, 48} {
+		unitContext := units.Context{}
+		unitContext.Defaults()
+		textStyle := text.NewStyle()
+		textStyle.FontSize = units.Dot(size)
+		textStyle.WhiteSpace = text.WrapNever
+		textStyle.ToDots(&unitContext)
+		style := rich.NewStyle()
+		runs := shaper.Shape(rich.NewText(style, []rune("AgQjpMWé")), textStyle)
+		if len(runs) == 0 {
+			t.Fatal("embedded real font produced no shaped runs")
+		}
+		for _, shapedRun := range runs {
+			run, ok := shapedRun.(*shapedgt.Run)
+			if !ok || run.Face == nil {
+				t.Fatal("embedded shaper did not provide a real outline face")
+			}
+			scale := math32.FromFixed(run.Size) / float32(run.Face.Upem())
+			for i := range run.Glyphs {
+				glyph := &run.Glyphs[i]
+				outline, ok := run.Face.GlyphDataOutline(glyph.GlyphID)
+				if !ok || len(outline.Segments) == 0 {
+					t.Fatalf("real text glyph %d has no outline", glyph.GlyphID)
+				}
+				for _, pos := range positions {
+					beforeTracked, beforeFull := tracked.CacheSize(), full.CacheSize()
+					mask, placement := tracked.Glyph(run.Face, glyph, outline, scale, pos)
+					reference, referencePlacement := full.Glyph(run.Face, glyph, outline, scale, pos)
+					if mask == nil || reference == nil {
+						t.Fatalf("expected cacheable real glyph %d at size %g", glyph.GlyphID, size)
+					}
+					if mask == reference {
+						t.Fatal("independent caches shared a mask")
+					}
+					vellumOwnedEqualAlpha(t, mask, reference)
+					if vellumOwnedNonzero(reference.Pix) == 0 {
+						t.Fatalf("blank real glyph mask %d", glyph.GlyphID)
+					}
+					wantPlacement := image.Pt(int(math32.Floor(pos.X))-2+glyph.XBearing.Round(), int(math32.Floor(pos.Y))-2-glyph.YBearing.Round())
+					if placement != referencePlacement || placement != wantPlacement {
+						t.Fatalf("glyph placement got %v reference %v want %v", placement, referencePlacement, wantPlacement)
+					}
+					cost := mask.Bounds().Dx() * mask.Bounds().Dy()
+					if tracked.CacheSize() != beforeTracked+cost || full.CacheSize() != beforeFull+cost {
+						t.Fatal("cold lookup did not add exactly one independent mask")
+					}
+					warm, warmPlacement := tracked.Glyph(run.Face, glyph, outline, scale, pos)
+					warmReference, warmReferencePlacement := full.Glyph(run.Face, glyph, outline, scale, pos)
+					translatedPos := pos.Add(math32.Vec2(7, -5))
+					translated, translatedPlacement := tracked.Glyph(run.Face, glyph, outline, scale, translatedPos)
+					translatedReference, translatedReferencePlacement := full.Glyph(run.Face, glyph, outline, scale, translatedPos)
+					if warm != mask || warmReference != reference || translated != mask || translatedReference != reference {
+						t.Fatal("warm lookup or integer translation replaced cached mask")
+					}
+					if warmPlacement != placement || warmReferencePlacement != referencePlacement || translatedPlacement != placement.Add(image.Pt(7, -5)) || translatedReferencePlacement != translatedPlacement {
+						t.Fatal("warm or translated placement changed subpixel semantics")
+					}
+					if tracked.CacheSize() != beforeTracked+cost || full.CacheSize() != beforeFull+cost {
+						t.Fatal("warm lookup grew cache")
+					}
+					vellumOwnedEqualAlpha(t, warm, warmReference)
+					vellumOwnedEqualAlpha(t, translated, translatedReference)
+					canvas := image.NewRGBA(image.Rect(0, 0, 100, 100))
+					referenceCanvas := image.NewRGBA(canvas.Bounds())
+					draw.DrawMask(canvas, mask.Bounds().Add(placement), colors.Uniform(color.NRGBA{R: 30, G: 60, B: 180, A: 220}), image.Point{}, mask, image.Point{}, draw.Over)
+					draw.DrawMask(referenceCanvas, reference.Bounds().Add(referencePlacement), colors.Uniform(color.NRGBA{R: 30, G: 60, B: 180, A: 220}), image.Point{}, reference, image.Point{}, draw.Over)
+					vellumOwnedEqualRGBA(t, canvas, referenceCanvas)
+					t.Logf("owned-glyph size=%g gid=%d pos=(%g,%g) placement=%v alpha_sha256=%x", size, glyph.GlyphID, pos.X, pos.Y, placement, sha256.Sum256(reference.Pix))
+					cold++
+				}
+			}
+		}
+	}
+	if cold != 64 || tracked.CacheSize() == 0 || tracked.CacheSize() != full.CacheSize() {
+		t.Fatalf("expected 64 cold and 128 warm/translated real glyph lookups, got %d cold, cache %d vs %d", cold, tracked.CacheSize(), full.CacheSize())
+	}
+}
+
+func vellumOwnedEqualRGBA(t *testing.T, actual, reference *image.RGBA) {
+	t.Helper()
+	if actual.Bounds() != reference.Bounds() || actual.Stride != reference.Stride || !bytes.Equal(actual.Pix, reference.Pix) {
+		t.Fatalf("RGBA differs: bounds %v vs %v stride %d vs %d sha256 %x vs %x", actual.Bounds(), reference.Bounds(), actual.Stride, reference.Stride, sha256.Sum256(actual.Pix), sha256.Sum256(reference.Pix))
+	}
+}
+
+func vellumOwnedEqualAlpha(t *testing.T, actual, reference *image.Alpha) {
+	t.Helper()
+	if actual.Bounds() != reference.Bounds() || actual.Stride != reference.Stride || !bytes.Equal(actual.Pix, reference.Pix) {
+		t.Fatalf("glyph alpha differs: bounds %v vs %v stride %d vs %d sha256 %x vs %x", actual.Bounds(), reference.Bounds(), actual.Stride, reference.Stride, sha256.Sum256(actual.Pix), sha256.Sum256(reference.Pix))
+	}
+}
+
+func vellumOwnedNonzero(pixels []uint8) int {
+	n := 0
+	for _, value := range pixels {
+		if value != 0 {
+			n++
+		}
+	}
+	return n
+}

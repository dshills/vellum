+func TestVellumRowTrackingBoundsReuse(t *testing.T) {
+	p := vellumNewScannerPair(32, 1152)
+	p.both(func(s vellumScannerPath) { vellumRectangle(s, 3, 1100, 21, 1110) })
+	if len(p.draw(t)) == 0 {
+		t.Fatal("high-row fixture is empty")
+	}
+	capacity := cap(p.tracked.CellIndex)
+	// Shrink while old cells still exist; regrow into exactly the same backing
+	// capacity. Initializing only a new touched interval would retain old links.
+	for _, bounds := range []image.Point{
+		image.Pt(32, 8), image.Pt(32, 1152), image.Pt(0, 0),
+		image.Pt(-7, -3), image.Pt(0, 64), image.Pt(32, 1152), image.Pt(40, 8192),
+	} {
+		p.both(func(s vellumScannerPath) { s.SetBounds(bounds.X, bounds.Y) })
+		vellumCompareSavedState(t, p.tracked, p.original.Scanner)
+		for y, index := range p.tracked.CellIndex {
+			if index != -1 {
+				t.Fatalf("SetBounds(%v) retained/zero-initialized link at row%d: %d", bounds, y, index)
+			}
+		}
+		if got := p.draw(t); len(got) != 0 {
+			t.Fatalf("SetBounds(%v) retained spans: %v", bounds, got)
+		}
+		if bounds == image.Pt(32, 1152) && cap(p.tracked.CellIndex) != capacity {
+			t.Fatal("fixture unexpectedly reallocated rather than regrowing retained capacity")
+		}
+		p.both(func(s vellumScannerPath) { vellumRectangle(s, 2, 1, 7, 5) })
+		p.draw(t)
+	}
+	if cap(p.tracked.CellIndex) <= capacity {
+		t.Fatal("large SetBounds did not exercise reallocation")
+	}
+	// Clear must also discard unflushed area/coverage, not save it into a new path.
+	for _, s := range []*Scanner{p.tracked, p.original.Scanner} {
+		s.SetCell(7, 8180)
+		s.Scan(8180, 7*64+11, 0, 7*64+11, 29)
+	}
+	p.both(func(s vellumScannerPath) { s.Clear() })
+	if got := p.draw(t); len(got) != 0 {
+		t.Fatalf("Clear preserved pending old area/coverage: %v", got)
+	}
+}
+
+func TestVellumRowTrackingDefaultDirectMutation(t *testing.T) {
+	got, want := vellumNewCollector(), vellumNewCollector()
+	actual := NewScanner(got, 24, 1152)
+	original := &vellumFullRowOracle{NewScanner(want, 24, 1152)}
+	for _, s := range []*Scanner{actual, original.Scanner} {
+		s.Cell = []Cell{{Xi: 4, Cover: 64, Next: 1}, {Xi: 17, Cover: -64, Next: -1}}
+		s.CellIndex[1107] = 0 // Exported slices can be populated without FindCell.
+	}
+	actual.Draw()
+	original.Draw()
+	if len(got.spans) == 0 || !reflect.DeepEqual(got.spans, want.spans) {
+		t.Fatalf("ordinary constructor narrowed direct mutation behavior: %v vs %v", got.spans, want.spans)
+	}
+	actual.Clear()
+	original.Clear()
+	vellumCompareSavedState(t, actual, original.Scanner)
+	got.spans, want.spans = nil, nil
+	actual.Draw()
+	original.Draw()
+	if len(got.spans) != 0 || len(want.spans) != 0 {
+		t.Fatal("ordinary constructor Clear left a directly installed row")
+	}
+}

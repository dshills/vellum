+func TestVellumRowTrackingDifferential(t *testing.T) {
+	shapes := []struct {
+		name string
+		draw func(vellumScannerPath)
+	}{
+		{"empty", func(vellumScannerPath) {}},
+		{"integer-small", func(s vellumScannerPath) { vellumRectangle(s, 3, 7, 19, 16) }},
+		{"fractional-diagonal", func(s vellumScannerPath) {
+			vellumContour(s, fixed.Point26_6{X: 91, Y: 217}, fixed.Point26_6{X: 2117, Y: 1301}, fixed.Point26_6{X: 331, Y: 2329})
+		}},
+		{"negative-crossing", func(s vellumScannerPath) { vellumRectangle(s, -17, -8, 25, 23) }},
+		{"entirely-offscreen", func(s vellumScannerPath) { vellumRectangle(s, -23, -19, -7, -2) }},
+		{"right-and-bottom", func(s vellumScannerPath) { vellumRectangle(s, 29, 51, 71, 99) }},
+		{"disjoint-rows", func(s vellumScannerPath) {
+			vellumRectangle(s, 2, 1, 15, 4)
+			vellumRectangle(s, 21, 58, 38, 63)
+		}},
+		{"self-intersection", func(s vellumScannerPath) {
+			vellumContour(s, fixed.P(2, 2), fixed.P(31, 39), fixed.P(2, 39), fixed.P(31, 2))
+		}},
+	}
+	clips := []image.Rectangle{
+		{}, image.Rect(4, 5, 29, 37), image.Rect(-9, 11, 12, 73),
+		image.Rect(100, 100, 130, 150), image.Rect(-30, -20, -1, -1),
+		image.Rect(8, 3, 8, 11), // Baseline zero-width clip means no additional clip.
+	}
+	for _, height := range []int{0, 8, 64, 1152} {
+		for _, nonZero := range []bool{false, true} {
+			for i, clip := range clips {
+				for _, shape := range shapes {
+					t.Run(fmt.Sprintf("h%d/nonzero%t/clip%d/%s", height, nonZero, i, shape.name), func(t *testing.T) {
+						p := vellumNewScannerPair(40, height)
+						p.both(func(s vellumScannerPath) { s.SetWinding(nonZero); s.SetClip(clip); shape.draw(s) })
+						first := p.draw(t)
+						if again := p.draw(t); !reflect.DeepEqual(first, again) {
+							t.Fatalf("repeated Draw changed the span stream: %v versus %v", first, again)
+						}
+						p.both(func(s vellumScannerPath) { s.Clear() })
+						if spans := p.draw(t); len(spans) != 0 {
+							t.Fatalf("Clear retained spans: %v", spans)
+						}
+					})
+				}
+			}
+		}
+	}
+}

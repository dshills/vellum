+func TestVellumRowTrackingClipWidenAndReverseInsertion(t *testing.T) {
+	p := vellumNewScannerPair(32, 1152)
+	p.both(func(s vellumScannerPath) {
+		// Allocate the high range first, then extend the interval downward.
+		vellumRectangle(s, 18, 1000, 29, 1006)
+		vellumRectangle(s, 3, 2, 13, 7)
+		s.SetClip(image.Rect(0, 0, 32, 10))
+	})
+	narrow := p.draw(t)
+	if len(narrow) == 0 {
+		t.Fatal("narrow clip must retain the visible low contour")
+	}
+	for _, span := range narrow {
+		if span.Y >= 10 {
+			t.Fatal("narrow clip exposed a hidden contour")
+		}
+	}
+	p.both(func(s vellumScannerPath) { s.SetClip(image.Rectangle{}) })
+	wide := p.draw(t)
+	if len(wide) <= len(narrow) || wide[len(wide)-1].Y < 1000 {
+		t.Fatal("widening clip lost previously accumulated hidden rows")
+	}
+	// Clear while that high contour is clipped out; it must still retire its
+	// saved links before the same backing rows are exposed by a later clip.
+	p.both(func(s vellumScannerPath) {
+		s.SetClip(image.Rect(0, 0, 32, 10))
+		s.Clear()
+		s.SetClip(image.Rectangle{})
+	})
+	if spans := p.draw(t); len(spans) != 0 {
+		t.Fatalf("Clear missed clip-hidden saved rows: %v", spans)
+	}
+}

+// The oracle copies Draw, Clear, SetBounds and AreaToAlpha from the original
+// full-row scan.go SHA256 3fff7c692cbb2847cc28703af39f1abe8911eac62a19dac25442d08cfac274c2.
+// Path accumulation still uses the actual Scanner Start/Line/Scan/FindCell.
+// This differential isolates row traversal/reset and initialization; it does
+// not independently qualify the unchanged curve algorithm or image compositor.
+// In particular, the oracle NEVER calls Scanner.Draw/Clear/SetBounds or reads
+// its private row-tracking fields.
+type vellumFullRowOracle struct{ *Scanner }
+
+func (o *vellumFullRowOracle) Draw() {
+	s := o.Scanner
+	b := image.Rect(0, 0, s.Width, len(s.CellIndex))
+	if s.Clip.Dx() != 0 && s.Clip.Dy() != 0 {
+		b = b.Intersect(s.Clip)
+	}
+	s.SaveCell()
+	span := s.Spanner.GetSpanFunc()
+	for yi := b.Min.Y; yi < b.Max.Y; yi++ {
+		xi, cover := 0, 0
+		for c := s.CellIndex[yi]; c != -1; c = s.Cell[c].Next {
+			if cover != 0 && s.Cell[c].Xi > xi {
+				alpha := vellumFullRowAlpha(cover*64*2, s.UseNonZeroWinding)
+				if alpha != 0 {
+					xi0, xi1 := xi, s.Cell[c].Xi
+					if xi0 < b.Min.X {
+						xi0 = b.Min.X
+					}
+					if xi1 > b.Max.X {
+						xi1 = b.Max.X
+					}
+					if xi0 < xi1 {
+						span(yi, xi0, xi1, alpha)
+					}
+				}
+			}
+			cover += s.Cell[c].Cover
+			alpha := vellumFullRowAlpha(cover*64*2-s.Cell[c].Area, s.UseNonZeroWinding)
+			xi = s.Cell[c].Xi + 1
+			if alpha != 0 {
+				xi0, xi1 := s.Cell[c].Xi, xi
+				if xi0 < b.Min.X {
+					xi0 = b.Min.X
+				}
+				if xi1 > b.Max.X {
+					xi1 = b.Max.X
+				}
+				if xi0 < xi1 {
+					span(yi, xi0, xi1, alpha)
+				}
+			}
+		}
+	}
+}
+
+func vellumFullRowAlpha(area int, nonZero bool) uint32 {
+	a := (area + 1) >> 1
+	if a < 0 {
+		a = -a
+	}
+	alpha := uint32(a)
+	if nonZero {
+		if alpha > 0x0fff {
+			alpha = 0x0fff
+		}
+	} else {
+		alpha &= 0x1fff
+		if alpha > 0x1000 {
+			alpha = 0x2000 - alpha
+		} else if alpha == 0x1000 {
+			alpha = 0x0fff
+		}
+	}
+	return alpha<<4 | alpha>>8
+}
+
+func (o *vellumFullRowOracle) Clear() {
+	s := o.Scanner
+	s.A = fixed.Point26_6{}
+	s.Xi, s.Yi, s.Area, s.Cover = 0, 0, 0, 0
+	s.Cell = s.Cell[:0]
+	for i := 0; i < len(s.CellIndex); i++ {
+		s.CellIndex[i] = -1
+	}
+	const mxfi = fixed.Int26_6(math.MaxInt32)
+	s.MinX, s.MinY, s.MaxX, s.MaxY = mxfi, mxfi, -mxfi, -mxfi
+}
+
+func (o *vellumFullRowOracle) SetBounds(width, height int) {
+	s := o.Scanner
+	if width < 0 {
+		width = 0
+	}
+	if height < 0 {
+		height = 0
+	}
+	s.Width = width
+	s.Cell = s.Cell[:0]
+	if height > cap(s.CellIndex) {
+		s.CellIndex = make([]int, height)
+	}
+	s.CellIndex = s.CellIndex[:height]
+	s.Width = width
+	o.Clear()
+}
+
+type vellumCapturedSpan struct {
+	Y, X0, X1 int
+	Alpha     uint32
+}
+
+type vellumSpanCollector struct {
+	spans []vellumCapturedSpan
+	fn    SpanFunc
+}
+
+func vellumNewCollector() *vellumSpanCollector {
+	c := &vellumSpanCollector{}
+	c.fn = func(y, x0, x1 int, alpha uint32) {
+		c.spans = append(c.spans, vellumCapturedSpan{y, x0, x1, alpha})
+	}
+	return c
+}
+func (*vellumSpanCollector) SetColor(image.Image)    {}
+func (c *vellumSpanCollector) GetSpanFunc() SpanFunc { return c.fn }
+
+type vellumScannerPath interface {
+	Start(fixed.Point26_6)
+	Line(fixed.Point26_6)
+	SetClip(image.Rectangle)
+	SetWinding(bool)
+	Clear()
+	SetBounds(int, int)
+	Draw()
+}
+
+type vellumScannerPair struct {
+	tracked   *Scanner
+	original  *vellumFullRowOracle
+	got, want *vellumSpanCollector
+}
+
+func vellumNewScannerPair(width, height int) vellumScannerPair {
+	got, want := vellumNewCollector(), vellumNewCollector()
+	return vellumScannerPair{
+		tracked:  NewScannerWithRowTracking(got, width, height),
+		original: &vellumFullRowOracle{NewScanner(want, width, height)},
+		got:      got, want: want,
+	}
+}
+
+func (p vellumScannerPair) both(fn func(vellumScannerPath)) {
+	fn(p.tracked)
+	fn(p.original)
+}
+
+func (p vellumScannerPair) draw(t *testing.T) []vellumCapturedSpan {
+	t.Helper()
+	p.got.spans, p.want.spans = p.got.spans[:0], p.want.spans[:0]
+	p.tracked.Draw()
+	p.original.Draw()
+	if !reflect.DeepEqual(p.got.spans, p.want.spans) {
+		t.Fatalf("span stream differs:\ntracked %v\nfull-row %v", p.got.spans, p.want.spans)
+	}
+	vellumCompareSavedState(t, p.tracked, p.original.Scanner)
+	for i, span := range p.got.spans {
+		if span.Y < 0 || span.Y >= len(p.tracked.CellIndex) || span.X0 < 0 || span.X0 >= span.X1 || span.X1 > p.tracked.Width || span.Alpha == 0 || span.Alpha > 0xffff {
+			t.Fatalf("invalid actual span %d: %+v", i, span)
+		}
+		if i > 0 {
+			prev := p.got.spans[i-1]
+			if span.Y < prev.Y || span.Y == prev.Y && span.X0 < prev.X1 {
+				t.Fatalf("unordered/overlapping spans %d: %+v followed by %+v", i, prev, span)
+			}
+		}
+	}
+	return append([]vellumCapturedSpan(nil), p.got.spans...)
+}
+
+func vellumCompareSavedState(t *testing.T, got, want *Scanner) {
+	t.Helper()
+	if !reflect.DeepEqual(got.Cell, want.Cell) || !reflect.DeepEqual(got.CellIndex, want.CellIndex) {
+		t.Fatalf("saved cells differ:\ntracked Cell=%v Index=%v\nfull-row Cell=%v Index=%v", got.Cell, got.CellIndex, want.Cell, want.CellIndex)
+	}
+	if got.Width != want.Width || got.A != want.A || got.Xi != want.Xi || got.Yi != want.Yi || got.Area != want.Area || got.Cover != want.Cover || got.Clip != want.Clip || got.GetPathExtent() != want.GetPathExtent() {
+		t.Fatalf("scanner public state differs: tracked %+v, full-row %+v", got, want)
+	}
+}
+
+func vellumContour(s vellumScannerPath, points ...fixed.Point26_6) {
+	s.Start(points[0])
+	for _, p := range points[1:] {
+		s.Line(p)
+	}
+	s.Line(points[0])
+}
+
+func vellumRectangle(s vellumScannerPath, x0, y0, x1, y1 int) {
+	vellumContour(s, fixed.P(x0, y0), fixed.P(x1, y0), fixed.P(x1, y1), fixed.P(x0, y1))
+}

+func TestVellumRowTrackingPendingFinalCell(t *testing.T) {
+	p := vellumNewScannerPair(32, 1152)
+	for _, s := range []*Scanner{p.tracked, p.original.Scanner} {
+		s.SetCell(9, 1109)
+		s.Scan(1109, 9*64+13, 0, 9*64+13, 47)
+		if len(s.Cell) != 0 || s.Area == 0 || s.Cover == 0 {
+			t.Fatalf("fixture must have only an unsaved final cell: %+v", s)
+		}
+	}
+	spans := p.draw(t)
+	if len(spans) != 1 || spans[0].Y != 1109 || spans[0].X0 != 9 || spans[0].X1 != 10 {
+		t.Fatalf("Draw omitted/changed final pending cell: %v", spans)
+	}
+	if len(p.tracked.Cell) != 1 || p.tracked.Area != 0 || p.tracked.Cover != 0 {
+		t.Fatal("Draw did not save and consume the final cell")
+	}
+	p.both(func(s vellumScannerPath) { s.Clear() })
+	if got := p.draw(t); len(got) != 0 {
+		t.Fatalf("cleared final-cell row survived: %v", got)
+	}
+}

+// Temporary header bands remain local to one builder and never enter a packet.
+// One exact power-of-two allocation for sizes1..256 bounds backing to511
+// slice headers (~12KiB on64-bit). Empty slots and all returned bands hold no
+// span references. Logical charges are still checked before borrowing a band.
+func spanHeaderSlot(size int) int {
+	if size < 1 || size > 256 || size&(size-1) != 0 {
+		return -1
+	}
+	slot := 0
+	for size > 1 {
+		size >>= 1
+		slot++
+	}
+	return slot
+}
+func (b *Builder) borrowSpanHeaders(size int) [][]span {
+	if slot := spanHeaderSlot(size); slot >= 0 {
+		if headers := b.spanHeaders[slot]; headers != nil {
+			b.spanHeaders[slot] = nil
+			return headers
+		}
+	}
+	return make([][]span, size)
+}
+func (b *Builder) retainSpanHeaders(headers [][]span) {
+	slot := spanHeaderSlot(len(headers))
+	if slot < 0 || cap(headers) != len(headers) || b.spanHeaders[slot] != nil {
+		return
+	}
+	clear(headers)
+	b.spanHeaders[slot] = headers
+}

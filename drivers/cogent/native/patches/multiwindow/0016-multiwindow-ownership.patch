+package base
+
+import (
+	"cogentcore.org/core/system"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+type queueTestApp struct{ system.App }
+
+func (*queueTestApp) SendEmptyEvent() {}
+
+func TestMainQueuePublicationDuringStartupDispatch(t *testing.T) {
+	for round := 0; round < 20; round++ {
+		a := &App{This: &queueTestApp{}}
+		var executed atomic.Int32
+		// Calls before the platform loop preserve the direct synchronous fallback.
+		a.RunOnMain(func() { executed.Add(1) })
+		if executed.Load() != 1 {
+			t.Fatal("pre-loop callback was not synchronous")
+		}
+		start := make(chan struct{})
+		var callers sync.WaitGroup
+		for i := 0; i < 50; i++ {
+			callers.Add(1)
+			go func() { defer callers.Done(); <-start; a.RunOnMain(func() { executed.Add(1) }) }()
+		}
+		exited := make(chan struct{})
+		go func() { <-start; a.MainLoop(); close(exited) }()
+		close(start)
+		completed := make(chan struct{})
+		go func() { callers.Wait(); close(completed) }()
+		select {
+		case <-completed:
+		case <-time.After(3 * time.Second):
+			t.Fatal("startup publication lost or blocked a callback")
+		}
+		if executed.Load() != 51 {
+			t.Fatal("startup callback was lost or duplicated")
+		}
+		a.StopMain()
+		select {
+		case <-exited:
+		case <-time.After(3 * time.Second):
+			t.Fatal("main loop did not stop")
+		}
+	}
+}
+
+func TestMainQueueInitializationPreservesIdentityAndCompletion(t *testing.T) {
+	a := &App{This: &queueTestApp{}}
+	queue, stopped := a.InitMainQueue()
+	var initializers sync.WaitGroup
+	for i := 0; i < 100; i++ {
+		initializers.Add(1)
+		go func() {
+			defer initializers.Done()
+			q, d := a.InitMainQueue()
+			if q != queue || d != stopped {
+				t.Error("main-loop channel identity changed")
+			}
+		}()
+	}
+	initializers.Wait()
+	completed := make(chan struct{})
+	go func() { a.RunOnMain(func() {}); close(completed) }()
+	var call FuncRun
+	select {
+	case call = <-queue:
+	case <-time.After(3 * time.Second):
+		t.Fatal("published queue did not receive caller")
+	}
+	call.F()
+	select {
+	case <-completed:
+		t.Fatal("queued caller returned before main-loop acknowledgment")
+	default:
+	}
+	call.Done <- struct{}{}
+	select {
+	case <-completed:
+	case <-time.After(3 * time.Second):
+		t.Fatal("acknowledged caller did not return")
+	}
+}
+
+func TestMainThreadRequiredCallbackWaitsForLoopPublication(t *testing.T) {
+	a := &App{This: &queueTestApp{}}
+	var queuedRan atomic.Bool
+	completed := make(chan struct{})
+	go func() { a.RunOnMainQueued(func() { queuedRan.Store(true) }); close(completed) }()
+	deadline := time.Now().Add(3 * time.Second)
+	for {
+		a.mainQueueMu.Lock()
+		waiting := a.mainQueueReady != nil
+		queueUnpublished := a.MainQueue == nil
+		a.mainQueueMu.Unlock()
+		if !queueUnpublished {
+			t.Fatal("worker published a queue before the platform loop")
+		}
+		if waiting {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("worker did not reach readiness wait")
+		}
+		time.Sleep(time.Millisecond)
+	}
+	if queuedRan.Load() {
+		t.Fatal("main-thread callback ran inline on startup worker")
+	}
+	// The main thread must still be able to construct initial windows inline.
+	var inlineRan bool
+	a.RunOnMain(func() { inlineRan = true })
+	if !inlineRan {
+		t.Fatal("queued startup worker blocked inline initial creation")
+	}
+	queue, _ := a.InitMainQueue()
+	var call FuncRun
+	select {
+	case call = <-queue:
+	case <-time.After(3 * time.Second):
+		t.Fatal("loop publication did not release queued worker")
+	}
+	if queuedRan.Load() {
+		t.Fatal("worker executed callback instead of main-loop consumer")
+	}
+	call.F()
+	call.Done <- struct{}{}
+	select {
+	case <-completed:
+	case <-time.After(3 * time.Second):
+		t.Fatal("main-loop callback did not complete")
+	}
+	if !queuedRan.Load() {
+		t.Fatal("queued native callback missing")
+	}
+}

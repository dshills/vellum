+func TestScreenSnapshotDuringCacheRebuild(t *testing.T) {
+	a := &App{}
+	var writers sync.WaitGroup
+	done := make(chan struct{})
+	writers.Add(1)
+	go func() {
+		defer writers.Done()
+		for {
+			select {
+			case <-done:
+				return
+			default:
+			}
+			// GetScreens replaces the slice and fills screen fields under this lock.
+			a.Mu.Lock()
+			a.Screens = []*system.Screen{{}}
+			a.Screens[0].Name = "Complete"
+			a.Screens[0].LogicalDPI = 160
+			a.Mu.Unlock()
+		}
+	}()
+	defer func() { close(done); writers.Wait() }()
+	for i := 0; i < 1000; i++ {
+		if snapshot := a.ScreenSnapshot(0); snapshot != nil {
+			if snapshot.Name != "Complete" || snapshot.LogicalDPI != 160 {
+				t.Fatal("screen snapshot exposed a partially rebuilt cache")
+			}
+			snapshot.Name = "Private"
+			snapshot.LogicalDPI = 1
+		}
+	}
+	empty := &App{}
+	if empty.ScreenSnapshot(0) != nil {
+		t.Fatal("empty screen cache did not use the render-context fallback")
+	}

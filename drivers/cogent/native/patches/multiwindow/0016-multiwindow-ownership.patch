+func TestNewWindowSizingOwnsContextDuringOtherWindowResize(t *testing.T) {
+	previous := currentRenderWindow
+	existing := &renderContext{logicalDPI: 123, geom: math32.Geom2DInt{Size: image.Pt(333, 222)}}
+	currentRenderWindow = &renderWindow{mains: stages{renderContext: existing}}
+	defer func() { currentRenderWindow = previous }()
+	// The actual event loop owns these mutations under the old window's mutex.
+	// New-window sizing must never read any of them, even before its OS window exists.
+	var writers sync.WaitGroup
+	done := make(chan struct{})
+	writers.Add(1)
+	go func() {
+		defer writers.Done()
+		for {
+			select {
+			case <-done:
+				return
+			default:
+			}
+			existing.Lock()
+			existing.logicalDPI++
+			existing.geom.Size.X++
+			existing.Unlock()
+		}
+	}()
+	defer func() { close(done); writers.Wait() }()
+	for i := 0; i < 100; i++ {
+		sc := NewScene()
+		st := &Stage{NewWindow: true, Scene: sc}
+		sc.Stage = st
+		st.setMains(st.windowSizingStages())
+		if st.renderContext == existing || st.Mains == &currentRenderWindow.mains {
+			t.Fatal("new window borrowed another window's mutable sizing state")
+		}
+		if st.renderContext.geom.Size.X <= 0 || st.renderContext.logicalDPI <= 0 {

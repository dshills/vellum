+package desktop
+
+import (
+	"sync"
+	"testing"
+	"time"
+
+	"cogentcore.org/core/system/composer"
+)
+
+func TestComposerPublicationAndWithdrawal(t *testing.T) {
+	w := &Window{}
+	if !w.IsClosed() || w.Composer() != nil || w.Lock() {
+		t.Fatal("unpublished window admitted rendering")
+	}
+	value := &composer.ComposerDrawer{}
+	w.Compose = value
+	w.composerPointer.Store(value)
+	if w.IsClosed() || w.Composer() != value {
+		t.Fatal("published composer unavailable")
+	}
+	if !w.Lock() {
+		t.Fatal("live window lock failed")
+	}
+	w.Unlock()
+	var readers sync.WaitGroup
+	for i := 0; i < 8; i++ {
+		readers.Add(1)
+		go func() {
+			defer readers.Done()
+			for j := 0; j < 1000; j++ {
+				_ = w.IsClosed()
+				_ = w.Composer()
+			}
+		}()
+	}
+	w.Mu.Lock()
+	w.composerPointer.Store(nil)
+	w.Compose = nil
+	w.Mu.Unlock()
+	readers.Wait()
+	if !w.IsClosed() || w.Composer() != nil || w.Lock() {
+		t.Fatal("withdrawn composer admitted rendering")
+	}
+}
+func TestLockRechecksAfterWaitingForNativeTeardown(t *testing.T) {
+	w := &Window{}
+	value := &composer.ComposerDrawer{}
+	w.Compose = value
+	w.composerPointer.Store(value)
+	w.Mu.Lock()
+	attempting := make(chan struct{})
+	result := make(chan bool, 1)
+	go func() {
+		close(attempting)
+		locked := w.Lock()
+		if locked {
+			w.Unlock()
+		}
+		result <- locked
+	}()
+	<-attempting
+	w.composerPointer.Store(nil)
+	w.Compose = nil
+	w.Mu.Unlock()
+	select {
+	case locked := <-result:
+		if locked {
+			t.Fatal("lock admitted a composer withdrawn during wait")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("lock did not return after teardown")
+	}
+}
+
+type withdrawalAttachment struct{ check func() }
+
+func (*withdrawalAttachment) Focus(bool) {}
+func (a *withdrawalAttachment) Close()   { a.check() }
+func TestComposerWithdrawnBeforeNativeTeardownEvenWithoutGLFW(t *testing.T) {
+	w := &Window{}
+	value := &composer.ComposerDrawer{}
+	w.Compose = value
+	w.composerPointer.Store(value)
+	nativeClosed := false
+	w.Native = &withdrawalAttachment{check: func() {
+		nativeClosed = true
+		if !w.IsClosed() || w.Composer() != nil {
+			t.Error("native teardown observed a still-published composer")
+		}
+	}}
+	w.Mu.Lock()
+	w.releaseNativeResources()
+	w.Mu.Unlock()
+	if !nativeClosed || w.Native != nil || !w.IsClosed() || w.Composer() != nil || w.Lock() {
+		t.Fatal("partial teardown stranded a published composer")
+	}
+}

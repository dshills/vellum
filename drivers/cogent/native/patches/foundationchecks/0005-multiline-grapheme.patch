+package lines
+
+import (
+	"cogentcore.org/core/text/textpos"
+	"testing"
+)
+
+func TestFoundationGraphemeNavigationAndDelete(t *testing.T) {
+	for _, s := range []string{"é", "👩‍💻", "👨‍👩‍👧‍👦", "🇺🇳", "नमस्ते"} {
+		t.Run(s, func(t *testing.T) {
+			ls := NewLines().SetText([]byte(s))
+			defer ls.Close()
+			end := ls.EndPos()
+			prev := ls.MoveBackwardGrapheme(end, 1)
+			want := textpos.PrevGrapheme([]rune(s), len([]rune(s)))
+			if prev.Char != want {
+				t.Fatalf("backward %+v, want rune %d", prev, want)
+			}
+			if next := ls.MoveForwardGrapheme(prev, 1); next != end {
+				t.Fatalf("roundtrip %+v != %+v", next, end)
+			}
+			ls.DeleteText(prev, end)
+			if got := string(ls.Line(0)); got != string([]rune(s)[:want]) {
+				t.Fatalf("delete %q", got)
+			}
+		})
+	}
+	ls := NewLines().SetText([]byte("é\n👩‍💻"))
+	defer ls.Close()
+	a := textpos.Pos{Line: 0, Char: 2}
+	b := textpos.Pos{Line: 1, Char: 0}
+	if ls.MoveForwardGrapheme(a, 1) != b || ls.MoveBackwardGrapheme(b, 1) != a {
+		t.Fatal("line boundary")
+	}
+	if ls.MoveForwardGrapheme(a, -1) != a || ls.MoveBackwardGrapheme(b, -1) != b {
+		t.Fatal("negative steps")
+	}
+	if ls.MoveForwardGrapheme(textpos.Pos{}, 1).Char != 2 {
+		t.Fatal("forward combining")
+	}
+	if ls.MoveForward(textpos.Pos{}, 1).Char != 1 {
+		t.Fatal("rune API changed")
+	}
+}

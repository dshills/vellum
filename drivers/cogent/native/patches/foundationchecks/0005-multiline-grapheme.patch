+package lines
+
+import "cogentcore.org/core/text/textpos"
+
+// MoveForwardGrapheme moves in logical extended grapheme clusters. A line
+// boundary is one step. MoveForward retains its existing rune semantics.
+func (ls *Lines) MoveForwardGrapheme(pos textpos.Pos, steps int) textpos.Pos {
+	ls.Lock()
+	defer ls.Unlock()
+	if !ls.isValidPos(pos) {
+		return pos
+	}
+	for range max(0, steps) {
+		line := ls.lines[pos.Line]
+		if pos.Char < len(line) {
+			pos.Char = textpos.NextGrapheme(line, pos.Char)
+		} else if pos.Line < len(ls.lines)-1 {
+			pos.Line++
+			pos.Char = 0
+		}
+	}
+	return pos
+}
+
+// MoveBackwardGrapheme moves in logical extended grapheme clusters. A line
+// boundary is one step. MoveBackward retains its existing rune semantics.
+func (ls *Lines) MoveBackwardGrapheme(pos textpos.Pos, steps int) textpos.Pos {
+	ls.Lock()
+	defer ls.Unlock()
+	if !ls.isValidPos(pos) {
+		return pos
+	}
+	for range max(0, steps) {
+		if pos.Char > 0 {
+			pos.Char = textpos.PrevGrapheme(ls.lines[pos.Line], pos.Char)
+		} else if pos.Line > 0 {
+			pos.Line--
+			pos.Char = len(ls.lines[pos.Line])
+		}
+	}
+	return pos
+}

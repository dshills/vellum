+package textcore
+
+import (
+	"cogentcore.org/core/text/textpos"
+	"testing"
+)
+
+func TestFoundationEditorGraphemeEditing(t *testing.T) {
+	for _, tc := range []struct{ input, prefix, first string }{
+		{"é", "", "é"}, {"👩‍💻", "", "👩‍💻"}, {"👨‍👩‍👧‍👦", "", "👨‍👩‍👧‍👦"}, {"🇺🇳", "", "🇺🇳"}, {"नमस्ते", "नम", "न"},
+	} {
+		t.Run(tc.input, func(t *testing.T) {
+			ed := NewEditor()
+			defer ed.Lines.Close()
+			ed.Lines.SetText([]byte(tc.input))
+			ed.CursorPos = ed.Lines.EndPos()
+			ed.cursorBackspace(1)
+			if got := string(ed.Lines.Line(0)); got != tc.prefix || ed.CursorPos.Char != len([]rune(tc.prefix)) {
+				t.Fatalf("backspace %q @%+v", got, ed.CursorPos)
+			}
+			ed.Lines.SetText([]byte(tc.input))
+			ed.CursorPos = textpos.Pos{}
+			ed.cursorForward(1)
+			if ed.CursorPos.Char != len([]rune(tc.first)) {
+				t.Fatalf("forward @%+v", ed.CursorPos)
+			}
+			ed.cursorBackward(1)
+			if ed.CursorPos.Char != 0 {
+				t.Fatalf("backward @%+v", ed.CursorPos)
+			}
+			ed.cursorDelete(1)
+			if got := string(ed.Lines.Line(0)); got != string([]rune(tc.input)[len([]rune(tc.first)):]) || ed.CursorPos.Char != 0 {
+				t.Fatalf("delete %q @%+v", got, ed.CursorPos)
+			}
+		})
+	}
+}

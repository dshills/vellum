+// SPDX-License-Identifier: Unlicense OR BSD-3-Clause
+package font
+
+import (
+	"github.com/go-text/typesetting/font/opentype/tables"
+	"os"
+	"reflect"
+	"testing"
+)
+
+func vellumBoundedTestFace(t *testing.T) *Face {
+	t.Helper()
+	f, e := os.Open("testdata/UbuntuMono-R.ttf")
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer f.Close()
+	face, e := ParseTTF(f)
+	if e != nil {
+		t.Fatal(e)
+	}
+	return face
+}
+func TestVellumBoundedOutlineOrdinaryParity(t *testing.T) {
+	face := vellumBoundedTestFace(t)
+	if !face.SupportsBoundedOutlines() || face.HasEncodedGlyphResources() {
+		t.Fatal("ordinary static outline font refused")
+	}
+	composites := 0
+	for i := 0; i < face.glyfCount(); i++ {
+		gid := GID(i)
+		want, ok := face.GlyphDataOutline(gid)
+		got, gok := face.GlyphDataOutlineBounded(gid, NewGlyphOutlineBudget(1<<20, 1<<20))
+		if ok != gok || !reflect.DeepEqual(got, want) {
+			t.Fatalf("outline parity gid=%d", i)
+		}
+		g, _ := face.glyfGlyph(gID(i))
+		if _, ok := g.Data.(tables.CompositeGlyph); ok {
+			composites++
+		}
+	}
+	if composites == 0 {
+		t.Fatal("font did not exercise composites")
+	}
+}
+func TestVellumBoundedOutlineAggregateCompositeAndLatch(t *testing.T) {
+	face := vellumBoundedTestFace(t)
+	face.lazyGlyf = nil
+	face.glyf = make(tables.Glyf, 12)
+	face.glyf[0] = tables.Glyph{Data: tables.SimpleGlyph{Points: []tables.GlyphContourPoint{{X: 0, Y: 0, Flag: 1}, {X: 100, Y: 0, Flag: 1}, {X: 0, Y: 100, Flag: 1}}, EndPtsOfContours: []uint16{2}}}
+	for i := 1; i < len(face.glyf); i++ {
+		face.glyf[i] = tables.Glyph{Data: tables.CompositeGlyph{Glyphs: []tables.CompositeGlyphPart{{GlyphIndex: tables.GlyphID(i - 1)}, {GlyphIndex: tables.GlyphID(i - 1)}}}}
+	}
+	ordinary, ok := face.GlyphDataOutline(11)
+	if !ok || len(ordinary.Segments) < 1000 {
+		t.Fatal("fixture did not expand composite")
+	}
+	budget := NewGlyphOutlineBudget(1000, 1000)
+	if _, ok := face.GlyphDataOutlineBounded(11, budget); ok || !budget.failed {
+		t.Fatal("aggregate composite expansion admitted")
+	}
+	points, operations := budget.points, budget.operations
+	if _, ok := face.GlyphDataOutlineBounded(0, budget); ok || points != budget.points || operations != budget.operations {
+		t.Fatal("failed budget resumed work")
+	}
+	shared := NewGlyphOutlineBudget(50, 1000)
+	accepted := 0
+	for i := 0; i < 100; i++ {
+		if _, ok := face.GlyphDataOutlineBounded(0, shared); !ok {
+			break
+		}
+		accepted++
+	}
+	if accepted == 0 || accepted >= 100 || !shared.failed {
+		t.Fatal("per-glyph reset bypassed aggregate budget", accepted)
+	}
+	for _, n := range []int{-1, 0, 1<<20 + 1} {
+		if NewGlyphOutlineBudget(n, 100) != nil {
+			t.Fatal("invalid admission", n)
+		}
+	}
+}
+func TestVellumBoundedOutlineEncodedPresenceRefuses(t *testing.T) {
+	for _, kind := range []string{"svg", "bitmap", "sbix", "lazySbix"} {
+		t.Run(kind, func(t *testing.T) {
+			face := vellumBoundedTestFace(t)
+			switch kind {
+			case "svg":
+				face.svg = make(svg, 1)
+			case "bitmap":
+				face.bitmap = make(bitmap, 1)
+			case "sbix":
+				face.sbix = make(sbix, 1)
+			case "lazySbix":
+				face.lazySbix = &lazySbix{}
+			}
+			if !face.HasEncodedGlyphResources() || face.SupportsBoundedOutlines() {
+				t.Fatal("encoded resource not detected")
+			}
+			budget := NewGlyphOutlineBudget(100, 100)
+			if _, ok := face.GlyphDataOutlineBounded(0, budget); ok || !budget.failed || budget.points != 100 || budget.operations != 100 {
+				t.Fatal("encoded retrieval performed work")
+			}
+		})
+	}
+}

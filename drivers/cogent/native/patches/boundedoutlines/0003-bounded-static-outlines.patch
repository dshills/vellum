+// SPDX-License-Identifier: Unlicense OR BSD-3-Clause
+package font
+
+// GlyphOutlineBudget bounds aggregate logical point/segment slots and traversal
+// operations across a batch. It is caller-owned, not safe for concurrent use.
+// Slice-capacity/allocator overhead is not an exact byte counter.
+// Refusal latches: subsequent calls do no resource work. Limits are at most 1M.
+type GlyphOutlineBudget struct {
+	points, operations int
+	failed             bool
+}
+
+func NewGlyphOutlineBudget(points, operations int) *GlyphOutlineBudget {
+	if points <= 0 || operations <= 0 || points > 1<<20 || operations > 1<<20 {
+		return nil
+	}
+	return &GlyphOutlineBudget{points: points, operations: operations}
+}
+func (b *GlyphOutlineBudget) take(points, operations int) bool {
+	if b == nil {
+		return true
+	} // The ordinary public outline path retains its behavior.
+	if b.failed || points < 0 || operations < 0 || points > b.points || operations > b.operations {
+		b.failed = true
+		return false
+	}
+	b.points -= points
+	b.operations -= operations
+	return true
+}
+
+// HasEncodedGlyphResources reports any font bitmap/SVG resources without
+// retrieving, decompressing or allocating them. Presence requires fallback for
+// callers without a separately bounded decoder, even if a particular glyph is
+// an outline in that font.
+func (f *Font) HasEncodedGlyphResources() bool {
+	return f == nil || len(f.svg) > 0 || len(f.bitmap) > 0 || len(f.sbix) > 0 || f.lazySbix != nil
+}
+
+// SupportsBoundedOutlines reports the static TrueType retrieval path supported
+// by GlyphDataOutlineBounded. CFF and variable outline expansion are refused.
+func (f *Face) SupportsBoundedOutlines() bool {
+	return f != nil && f.Font != nil && f.Upem() != 0 && !f.HasEncodedGlyphResources() && f.cff == nil && f.cff2 == nil && len(f.fvar) == 0
+}
+
+// GlyphDataOutlineBounded preserves ordinary static TrueType outlines, charging
+// every composite traversal and point allocation/copy before growth. Deferred
+// records additionally have the parser's 64KiB/8192-point bounds; eager data is
+// borrowed and checked before conversion. No bitmap/SVG/CFF decoder is called.
+func (f *Face) GlyphDataOutlineBounded(gid GID, budget *GlyphOutlineBudget) (GlyphOutline, bool) {
+	if budget == nil || budget.failed || !f.SupportsBoundedOutlines() {
+		if budget != nil {
+			budget.failed = true
+		}
+		return GlyphOutline{}, false
+	}
+	var points []contourPoint
+	if !f.getPointsForGlyphRecBudget(gID(gid), 0, make(glyphSet), &points, budget) || len(points) < phantomCount {
+		budget.failed = true
+		return GlyphOutline{}, false
+	}
+	n := len(points) - phantomCount
+	// buildSegments emits no more than three segments per input contour point.
+	if !budget.take(3*n+2, 3*n+2) {
+		return GlyphOutline{}, false
+	}
+	return GlyphOutline{Segments: buildSegments(points[:n])}, true
+}

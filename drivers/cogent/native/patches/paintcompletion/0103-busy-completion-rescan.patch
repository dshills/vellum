+// Delegate the actual software composer, manual queue and clock. Observe only
+// paint admission, with an optional rendezvous before publishing the fallback.
+type completionPaintWindow struct {
+	system.Window
+	manual                   manualSystemWindow
+	painter                  requestedPainter
+	immediate                atomic.Int64
+	fallbackEntered, release chan struct{}
+	once                     sync.Once
+}
+
+func (w *completionPaintWindow) ManualExecution() bool { return w.manual.ManualExecution() }
+func (w *completionPaintWindow) ManualState() system.ManualWindowState {
+	return w.manual.ManualState()
+}
+func (w *completionPaintWindow) FlushReadyPaint() bool { return w.manual.FlushReadyPaint() }
+func (w *completionPaintWindow) IsOnDemand() bool      { return w.painter.IsOnDemand() }
+func (w *completionPaintWindow) RequestPaint()         { w.painter.RequestPaint() }
+func (w *completionPaintWindow) RequestPaintAfter(delay time.Duration) {
+	if delay <= 0 {
+		w.immediate.Add(1)
+	} else if w.fallbackEntered != nil {
+		w.once.Do(func() { close(w.fallbackEntered); <-w.release })
+	}
+	w.painter.RequestPaintAfter(delay)
+}
+
+func observeCompletionPaint(m *ManualWindow) *completionPaintWindow {
+	original := m.window.SystemWindow
+	w := &completionPaintWindow{Window: original, manual: original.(manualSystemWindow), painter: original.(requestedPainter)}
+	m.window.SystemWindow = w
+	return w
+}
+
+func holdCompletionComposition(t *testing.T, m *ManualWindow, d *busyRetryDrawer, measured bool) func() {
+	t.Helper()
+	w := m.window
+	atomic.AddInt32(&w.winRenderCounter, 1)
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		if measured {
+			w.renderAsyncMeasured(w.SystemWindow.Composer(), &FrameTrace{}, 0)
+		} else {
+			w.renderAsync(w.SystemWindow.Composer())
+		}
+	}()
+	var once sync.Once
+	finish := func() {
+		once.Do(func() { close(d.release) })
+		select {
+		case <-done:
+		case <-time.After(2 * time.Second):
+			t.Fatal("controlled completion did not retire")
+		}
+	}
+	t.Cleanup(finish)
+	select {
+	case <-d.entered:
+	case <-time.After(2 * time.Second):
+		t.Fatal("actual software composer did not start")
+	}
+	return finish
+}
+
+func completionSnapshot(t *testing.T, m *ManualWindow) ManualSnapshot {
+	t.Helper()
+	s, err := m.Snapshot(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	return s
+}

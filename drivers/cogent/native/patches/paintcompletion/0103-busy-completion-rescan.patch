+func TestVellumBusyCompletionClosedWindowDoesNotWake(t *testing.T) {
+	m, _, _, drawer := busyRetryFixture(t)
+	paint := observeCompletionPaint(m)
+	w := m.window
+	finish := holdCompletionComposition(t, m, drawer, false)
+	w.renderWindow()
+	closed := make(chan struct{})
+	go func() { defer close(closed); paint.Window.Close() }()
+	deadline := time.Now().Add(2 * time.Second)
+	for !paint.IsClosed() {
+		if time.Now().After(deadline) {
+			t.Fatal("actual backend close did not revoke the window")
+		}
+		runtime.Gosched()
+	}
+	finish()
+	select {
+	case <-closed:
+	case <-time.After(2 * time.Second):
+		t.Fatal("actual backend close did not retire after composition")
+	}
+	if paint.immediate.Load() != 0 || atomic.LoadInt32(&w.winRenderCounter) != 0 {
+		t.Fatal("completion woke a revoked window or retained active work")
+	}
+	if err := m.Close(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	if m.window != nil {
+		t.Fatal("manual window retained closed scene")
+	}
+}

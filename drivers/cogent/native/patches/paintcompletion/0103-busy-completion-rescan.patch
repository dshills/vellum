+func TestVellumBusyCompletionWithoutBusyRequestStaysIdle(t *testing.T) {
+	for _, measured := range []bool{false, true} {
+		t.Run(map[bool]string{false: "ordinary", true: "measured"}[measured], func(t *testing.T) {
+			m, _, _, drawer := busyRetryFixture(t)
+			paint := observeCompletionPaint(m)
+			finish := holdCompletionComposition(t, m, drawer, measured)
+			finish()
+			state := completionSnapshot(t, m)
+			if paint.immediate.Load() != 0 || state.ReadyPaint || state.FuturePaint || drawer.ends.Load() != 1 {
+				t.Fatalf("completion without busy admission scheduled work: wakes%d state%+v", paint.immediate.Load(), state)
+			}
+		})
+	}
+}

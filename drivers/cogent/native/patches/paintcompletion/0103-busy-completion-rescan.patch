+func TestVellumBusyCompletionQueuedDirtyPixels(t *testing.T) {
+	m, body, clock, drawer := busyRetryFixture(t)
+	observeCompletionPaint(m)
+	handled := 0
+	body.Scene.On(events.Custom, func(e events.Event) {
+		handled++
+		body.Styles.Background = image.NewUniform(color.RGBA{R: 23, G: 211, B: 43, A: 255})
+		body.NeedsRender()
+		e.SetHandled()
+	})
+	now := clock.Now()
+	finish := holdCompletionComposition(t, m, drawer, false)
+	m.window.SystemWindow.Events().Custom("dirty-before-completion")
+	m.window.renderWindow()
+	finish()
+	if !completionSnapshot(t, m).ReadyPaint {
+		t.Fatal("busy completion waited for timer before queued input")
+	}
+	drainManual(t, m)
+	if handled != 1 || drawer.ends.Load() != 2 || !clock.Now().Equal(now) {
+		t.Fatalf("dirty input lost, duplicated or delayed: handled%d compositions%d", handled, drawer.ends.Load())
+	}
+	after, err := m.Image(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	p := after.RGBAAt(after.Bounds().Dx()/2, after.Bounds().Dy()/2)
+	if p.G < 180 || p.R > 60 || p.B > 80 {
+		t.Fatalf("queued dirty frame is stale: %v", p)
+	}
+	clock.Advance(time.Second / 60)
+	drainManual(t, m)
+	if drawer.ends.Load() != 2 {
+		t.Fatal("fallback forced an unchanged dirty frame")
+	}
+}

+func TestVellumBusyCompletionImmediateCoalescedRescan(t *testing.T) {
+	for _, measured := range []bool{false, true} {
+		t.Run(map[bool]string{false: "ordinary", true: "measured"}[measured], func(t *testing.T) {
+			m, _, clock, drawer := busyRetryFixture(t)
+			paint := observeCompletionPaint(m)
+			before, err := m.Image(context.Background())
+			if err != nil {
+				t.Fatal(err)
+			}
+			now := clock.Now()
+			finish := holdCompletionComposition(t, m, drawer, measured)
+			for range 64 {
+				m.window.renderWindow()
+			}
+			if paint.immediate.Load() != 0 {
+				t.Fatal("busy admission requested an immediate retry before completion")
+			}
+			finish()
+			s := completionSnapshot(t, m)
+			if !s.ReadyPaint || !clock.Now().Equal(now) || !s.FuturePaint {
+				t.Fatalf("completion did not wake rescan before timer: %+v", s)
+			}
+			if paint.immediate.Load() != 1 {
+				t.Fatalf("duplicate busy requests emitted %d completion wakes, want1", paint.immediate.Load())
+			}
+			drainManual(t, m)
+			clock.Advance(time.Second / 60)
+			drainManual(t, m)
+			if drawer.ends.Load() != 1 || completionSnapshot(t, m).ReadyPaint {
+				t.Fatal("unchanged completion/fallback rescan composed again or self-woke")
+			}
+			after, err := m.Image(context.Background())
+			if err != nil || !bytes.Equal(before.Pix, after.Pix) {
+				t.Fatal("unchanged rescan changed real pixels", err)
+			}
+		})
+	}
+}

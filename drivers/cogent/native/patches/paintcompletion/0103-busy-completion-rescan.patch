+func TestVellumBusyCompletionPreservesResizeFlag(t *testing.T) {
+	m, _, _, drawer := busyRetryFixture(t)
+	observeCompletionPaint(m)
+	finish := holdCompletionComposition(t, m, drawer, false)
+	m.window.flags.SetFlag(true, winRenderSkipped)
+	m.window.renderWindow()
+	finish()
+	if !completionSnapshot(t, m).ReadyPaint {
+		t.Fatal("resize rescan waited for timer")
+	}
+	drainManual(t, m)
+	if drawer.ends.Load() != 2 || m.window.flags.HasFlag(winRenderSkipped) {
+		t.Fatal("completion rescan lost or repeated the existing forced resize frame")
+	}
+}

+func TestVellumBusyCompletionBeforeFallbackPublication(t *testing.T) {
+	m, _, clock, drawer := busyRetryFixture(t)
+	paint := observeCompletionPaint(m)
+	paint.fallbackEntered, paint.release = make(chan struct{}), make(chan struct{})
+	finish := holdCompletionComposition(t, m, drawer, false)
+	admitted := make(chan struct{})
+	var releaseOnce sync.Once
+	releaseFallback := func() { releaseOnce.Do(func() { close(paint.release) }) }
+	t.Cleanup(releaseFallback)
+	go func() { defer close(admitted); m.window.renderWindow() }()
+	select {
+	case <-paint.fallbackEntered:
+	case <-time.After(2 * time.Second):
+		t.Fatal("busy fallback was not admitted")
+	}
+	// Finish while the fallback has not yet reached the actual manual queue.
+	finish()
+	if !completionSnapshot(t, m).ReadyPaint || paint.immediate.Load() != 1 {
+		t.Fatal("completion wake lost to in-flight timer publication")
+	}
+	releaseFallback()
+	select {
+	case <-admitted:
+	case <-time.After(2 * time.Second):
+		t.Fatal("fallback publisher did not retire")
+	}
+	if !completionSnapshot(t, m).ReadyPaint || !completionSnapshot(t, m).FuturePaint {
+		t.Fatal("fallback publication erased immediate wake or fallback")
+	}
+	drainManual(t, m)
+	clock.Advance(time.Second / 60)
+	drainManual(t, m)
+	if drawer.ends.Load() != 1 {
+		t.Fatal("timer/completion race forced duplicate composition")
+	}
+}
+
+func TestVellumBusyCompletionRacesHaveBoundedFallback(t *testing.T) {
+	for range 16 {
+		m, _, clock, drawer := busyRetryFixture(t)
+		observeCompletionPaint(m)
+		finish := holdCompletionComposition(t, m, drawer, false)
+		start, admitted := make(chan struct{}), make(chan struct{})
+		go func() { defer close(admitted); <-start; m.window.renderWindow() }()
+		close(start)
+		finish()
+		select {
+		case <-admitted:
+		case <-time.After(2 * time.Second):
+			t.Fatal("racing busy admission did not retire")
+		}
+		// Either admission observes completion or the wake/fallback rescans the
+		// real unchanged scene. The fallback covers a late pending publication.
+		drainManual(t, m)
+		clock.Advance(time.Second / 60)
+		drainManual(t, m)
+		if drawer.ends.Load() != 1 || completionSnapshot(t, m).ReadyPaint {
+			t.Fatal("racing completion duplicated or self-scheduled unchanged work")
+		}
+	}
+}

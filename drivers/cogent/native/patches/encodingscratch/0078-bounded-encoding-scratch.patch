+// Copyright (c) 2026, Davin Hills.
+// SPDX-License-Identifier: MIT
+package gpuscene
+
+import (
+	"cogentcore.org/core/math32"
+	"cogentcore.org/core/paint/renderers/sceneplan"
+	"cogentcore.org/core/styles/units"
+	"image"
+	"reflect"
+	"testing"
+)
+
+func TestVellumGPUSceneEncodingScratchLifecycle(t *testing.T) {
+	r := New(math32.Vec2(23, 19)).(*Renderer)
+	fill := func() {
+		p, _ := inputTimingFixture(t, image.Rect(0, 0, 23, 19))
+		if _, ok := p.EncodeGPUWithScratch(&r.encoding); !ok {
+			t.Fatal("fixture refused")
+		}
+		if reflect.DeepEqual(r.encoding, sceneplan.EncodingScratch{}) {
+			t.Fatal("fixture did not populate scratch")
+		}
+	}
+	fill()
+	r.SetSize(units.UnitDot, math32.Vec2(17, 13))
+	if !reflect.DeepEqual(r.encoding, sceneplan.EncodingScratch{}) {
+		t.Fatal("resize retained encoding backing")
+	}
+	fill()
+	r.Release()
+	r.Release()
+	if !reflect.DeepEqual(r.encoding, sceneplan.EncodingScratch{}) {
+		t.Fatal("release retained encoding backing")
+	}
+}

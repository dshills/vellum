+// Copyright (c) 2026, Davin Hills.
+// SPDX-License-Identifier: MIT
+package sceneplan
+
+// MaxEncodingScratchBytes bounds retained byte-buffer capacity per scratch.
+const MaxEncodingScratchBytes = 1 << 20
+
+// EncodingScratch owns only scalar bytes. Its owner must serialize calls and
+// consume each borrowed encoding before the next call or Reset. It retains no
+// packet, image, font or GPU references. Encode and EncodeGPU remain detached.
+type EncodingScratch struct {
+	ops, rows, refs, data []byte
+}
+
+// Reset drops all retained backing. Existing borrowed encodings expire here.
+func (s *EncodingScratch) Reset() {
+	if s != nil {
+		*s = EncodingScratch{}
+	}
+}
+
+// EncodeGPUWithScratch has EncodeGPU's exact encoding and admission rules.
+// Its result may borrow scratch until the next call or Reset; a nil scratch
+// selects the detached path. Oversized encodings do not enter retained storage.
+func (p *Packet) EncodeGPUWithScratch(scratch *EncodingScratch) (*Encoded, bool) {
+	return p.encodeWithScratch(true, scratch)
+}
+
+func encodingBuffers(s *EncodingScratch, ops, rows, refs, data int) *Encoded {
+	if s == nil {
+		return &Encoded{Ops: make([]byte, 0, ops), Rows: make([]byte, 0, rows), Refs: make([]byte, refs), Data: make([]byte, 0, data)}
+	}
+	if max(cap(s.ops), ops)+max(cap(s.rows), rows)+max(cap(s.refs), refs)+max(cap(s.data), data) > MaxEncodingScratchBytes {
+		s.Reset()
+	}
+	if ops+rows+refs+data > MaxEncodingScratchBytes {
+		return encodingBuffers(nil, ops, rows, refs, data)
+	}
+	buffer := func(old []byte, size int) []byte {
+		if old == nil || cap(old) < size {
+			return make([]byte, size)
+		}
+		return old[:size]
+	}
+	s.ops = buffer(s.ops, ops)
+	s.rows = buffer(s.rows, rows)
+	s.refs = buffer(s.refs, refs)
+	s.data = buffer(s.data, data)
+	// Nonempty sections overwrite every logical word. Empty Ops/Data/Refs
+	// retain one zero word, as in a fresh encoding, even after a larger frame.
+	clear(s.ops[:min(4, len(s.ops))])
+	clear(s.refs[:min(4, len(s.refs))])
+	clear(s.data[:min(4, len(s.data))])
+	return &Encoded{Ops: s.ops[:0], Rows: s.rows[:0], Refs: s.refs, Data: s.data[:0]}
+}

+// Copyright (c) 2026, Davin Hills.
+// SPDX-License-Identifier: MIT
+package sceneplan
+
+import (
+	"bytes"
+	"image"
+	"image/color"
+	"image/draw"
+	"math/rand"
+	"reflect"
+	"testing"
+)
+
+func scratchCapacity(s *EncodingScratch) int {
+	return cap(s.ops) + cap(s.rows) + cap(s.refs) + cap(s.data)
+}
+func scratchPacket(size, count int) *Packet {
+	b := New(image.Rect(0, 0, size, size))
+	mask := image.NewAlpha(image.Rect(0, 0, 8, 12))
+	for i := range mask.Pix {
+		mask.Pix[i] = byte(i * 19)
+	}
+	for i := 0; i < count; i++ {
+		x, y := (i%80)*18, (i/80)*18
+		b.Draw(image.Rect(x, y, x+8, y+12), image.NewUniform(color.RGBA{19, 37, 61, 255}), image.Point{}, mask, image.Point{}, draw.Over)
+	}
+	return b.Seal(false)
+}
+
+func TestVellumEncodingScratchExactAlternatingPackets(t *testing.T) {
+	var scratch EncodingScratch
+	rng := rand.New(rand.NewSource(7801))
+	for trial := 0; trial < 400; trial++ {
+		size := 17 + rng.Intn(100)
+		b := New(image.Rect(0, 0, size, size))
+		mask := image.NewAlpha(image.Rect(0, 0, 7, 9))
+		rng.Read(mask.Pix)
+		pixels := image.NewRGBA(image.Rect(0, 0, 7, 9))
+		rng.Read(pixels.Pix)
+		for i := 0; i < trial%30; i++ {
+			x, y := rng.Intn(size), rng.Intn(size)
+			r := image.Rect(x, y, x+7, y+9)
+			switch i % 4 {
+			case 0:
+				b.Draw(r, image.White, image.Point{}, nil, image.Point{}, draw.Src)
+				b.Draw(r, image.Black, image.Point{}, nil, image.Point{}, draw.Over)
+			case 1:
+				b.Draw(r, image.NewUniform(color.NRGBA{13, 31, 77, 91}), image.Point{}, mask, image.Point{}, draw.Over)
+			case 2:
+				b.Draw(r, pixels, image.Point{}, mask, image.Point{}, draw.Src)
+			case 3:
+				b.BeginSpans(color.RGBA{19, 23, 37, 51}, draw.Over)
+				b.Span(y, x, x+7, uint32(rng.Intn(65536)))
+			}
+		}
+		p := b.Seal(trial%2 == 0)
+		if p == nil {
+			t.Fatal("fixture refused")
+		}
+		want, ok := p.EncodeGPU()
+		if !ok {
+			t.Fatal("reference encoding refused")
+		}
+		got, ok := p.EncodeGPUWithScratch(&scratch)
+		if !ok || !reflect.DeepEqual(got, want) {
+			t.Fatal("borrowed encoding differs", trial)
+		}
+		if scratchCapacity(&scratch) > MaxEncodingScratchBytes {
+			t.Fatal("retained cap exceeded")
+		}
+		// A later use may overwrite borrowed data; detached API output and packet
+		// replay must stay independent of that storage.
+		empty := New(image.Rect(0, 0, 1, 1)).Seal(false)
+		small, ok := empty.EncodeGPUWithScratch(&scratch)
+		fresh, _ := empty.EncodeGPU()
+		if !ok || !reflect.DeepEqual(small, fresh) {
+			t.Fatal("empty words retain previous bytes")
+		}
+		again, _ := p.EncodeGPU()
+		if !reflect.DeepEqual(again, want) {
+			t.Fatal("scratch changed detached encoding or packet")
+		}
+		if trial%7 == 0 {
+			scratch.Reset()
+			if scratchCapacity(&scratch) != 0 {
+				t.Fatal("reset retained backing")
+			}
+		}
+	}
+}
+
+func TestVellumEncodingScratchBoundAndFailureRecovery(t *testing.T) {
+	var scratch EncodingScratch
+	for _, p := range []*Packet{scratchPacket(1519, 4800), scratchPacket(17, 1), scratchPacket(1519, 4800)} {
+		want, ok := p.EncodeGPU()
+		got, accepted := p.EncodeGPUWithScratch(&scratch)
+		if ok != accepted || !reflect.DeepEqual(got, want) {
+			t.Fatal("large/small encoding differs")
+		}
+		if scratchCapacity(&scratch) > MaxEncodingScratchBytes {
+			t.Fatal("aggregate backing exceeded cap")
+		}
+	}
+	// Accepted oversized pixel payloads keep the detached fallback and retire
+	// prior scratch. The 1MiB cache cap is not an encoding admission limit.
+	b := New(image.Rect(0, 0, 600, 600))
+	pixels := image.NewRGBA(image.Rect(0, 0, 600, 600))
+	for i := range pixels.Pix {
+		pixels.Pix[i] = byte(i * 17)
+	}
+	b.Draw(pixels.Rect, pixels, image.Point{}, nil, image.Point{}, draw.Src)
+	p := b.Seal(false)
+	want, ok := p.EncodeGPU()
+	got, accepted := p.EncodeGPUWithScratch(&scratch)
+	if !ok || !accepted || !reflect.DeepEqual(got, want) || scratchCapacity(&scratch) != 0 {
+		t.Fatal("oversized accepted encoding changed or retained")
+	}
+	// Cross-shaped growth must consider capacities, rather than just new lengths.
+	encodingBuffers(&scratch, 4, 4, 4, 900000)
+	encodingBuffers(&scratch, 900000, 4, 4, 4)
+	if scratchCapacity(&scratch) > MaxEncodingScratchBytes {
+		t.Fatal("alternating capacities exceeded cap")
+	}
+	zero := &Packet{}
+	wantZero, _ := zero.EncodeGPU()
+	gotZero, _ := zero.EncodeGPUWithScratch(&scratch)
+	if !reflect.DeepEqual(gotZero, wantZero) {
+		t.Fatal("zero-value packet differs")
+	}
+	var nilPacket *Packet
+	if e, ok := nilPacket.EncodeGPUWithScratch(&scratch); ok || e != nil {
+		t.Fatal("nil packet admitted")
+	}
+	bad := &Packet{bounds: image.Rect(0, 0, 8192, 2048), ops: make([]operation, 65)}
+	for i := range bad.ops {
+		bad.ops[i] = operation{kind: Uniform, op: draw.Src, rect: bad.bounds}
+	}
+	if _, ok := bad.EncodeGPU(); ok {
+		t.Fatal("refusal fixture did not exceed tile bound")
+	}
+	if e, ok := bad.EncodeGPUWithScratch(&scratch); ok || e != nil {
+		t.Fatal("scratch waived original tile bound")
+	}
+	p = scratchPacket(23, 1)
+	want, _ = p.EncodeGPU()
+	got, accepted = p.EncodeGPUWithScratch(&scratch)
+	if !accepted || !reflect.DeepEqual(got, want) {
+		t.Fatal("refusal poisoned recovery")
+	}
+	nilResult, _ := p.EncodeGPUWithScratch(nil)
+	if !reflect.DeepEqual(nilResult, want) {
+		t.Fatal("nil scratch differs")
+	}
+	scratch.Reset()
+}
+
+var scratchBenchmarkSink *Encoded
+
+func BenchmarkVellumEncodingScratch(b *testing.B) {
+	p := scratchPacket(1519, 4800)
+	if p == nil {
+		b.Fatal("fixture refused")
+	}
+	for _, reuse := range []bool{false, true} {
+		name := "detached"
+		if reuse {
+			name = "borrowed"
+		}
+		b.Run(name, func(b *testing.B) {
+			var scratch EncodingScratch
+			b.ReportAllocs()
+			for i := 0; i < b.N; i++ {
+				var ok bool
+				if reuse {
+					scratchBenchmarkSink, ok = p.EncodeGPUWithScratch(&scratch)
+				} else {
+					scratchBenchmarkSink, ok = p.EncodeGPU()
+				}
+				if !ok {
+					b.Fatal("encoding refused")
+				}
+			}
+		})
+	}
+}
+
+func TestVellumEncodingScratchDetachedOutputOwnership(t *testing.T) {
+	p := scratchPacket(64, 3)
+	a, _ := p.EncodeGPU()
+	b, _ := p.EncodeGPU()
+	var scratch EncodingScratch
+	c, _ := p.EncodeGPUWithScratch(&scratch)
+	for _, v := range [][]byte{c.Ops, c.Rows, c.Refs, c.Data} {
+		for i := range v {
+			v[i] = 255
+		}
+	}
+	if !reflect.DeepEqual(a, b) {
+		t.Fatal("borrowed write changed detached output")
+	}
+	again, _ := p.EncodeGPU()
+	if !bytes.Equal(again.Ops, a.Ops) || !reflect.DeepEqual(again, a) {
+		t.Fatal("borrowed write changed packet")
+	}
+}
+
+func TestVellumEncodingScratchExactCapacityBoundary(t *testing.T) {
+	var scratch EncodingScratch
+	at := MaxEncodingScratchBytes - 12
+	e := encodingBuffers(&scratch, at, 4, 4, 4)
+	if scratchCapacity(&scratch) != MaxEncodingScratchBytes {
+		t.Fatal("exact cap did not retain permitted backing")
+	}
+	e.Ops = append(e.Ops, 93)
+	if scratch.ops[0] != 93 {
+		t.Fatal("boundary did not exercise borrowed storage")
+	}
+	e = encodingBuffers(&scratch, at+4, 4, 4, 4)
+	if scratchCapacity(&scratch) != 0 || cap(e.Ops) != at+4 {
+		t.Fatal("first aligned over-cap did not use detached storage")
+	}
+	e.Ops = append(e.Ops, 71)
+	e = encodingBuffers(&scratch, 4, 4, 4, 4)
+	if scratchCapacity(&scratch) != 16 || len(e.Refs) != 4 || e.Refs[0] != 0 {
+		t.Fatal("over-cap recovery differs")
+	}
+}

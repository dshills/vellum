+// bodyRichText keeps document shaping monospaced without changing the widget's
+// UI typography, which is also used by line-number chrome. NewRichText returns
+// fresh values; neither widget style nor previously submitted rich text aliases
+// these normalized body styles.
+func (ed *Base) bodyRichText() (*rich.Style, *text.Style) {
+	sty, tsty := ed.Styles.NewRichText()
+	sty.Family = rich.Monospace
+	tsty.CustomFont = ""
+	return sty, tsty
+}
 

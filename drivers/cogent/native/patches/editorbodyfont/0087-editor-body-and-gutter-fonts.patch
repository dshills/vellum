+func configureEditorSceneShaper(b *core.Body) {
+	previous := shaped.NewShaper
+	defer func() { shaped.NewShaper = previous }()
+	shaped.NewShaper = func() shaped.Shaper {
+		return shapedgt.NewShaperWithFonts([]fs.FS{fonts.Default})
+	}
+	b.Scene.MakeTextShaper()
+}

+package core
+
+import (
+	"errors"
+	"image"
+	"runtime"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"cogentcore.org/core/events"
+	"cogentcore.org/core/math32"
+	"cogentcore.org/core/system/composer"
+)
+
+func traceScroll() *events.MouseScroll {
+	e := events.NewScroll(image.Pt(8, 12), math32.Vector2{Y: 12}, 0)
+	e.Init()
+	return e
+}
+
+type testTraceReserved struct{ *events.MouseScroll }
+
+func (e *testTraceReserved) FrameTraceEvent() events.Event { return e.MouseScroll }
+func TestVellumFrameTraceDispatchUnwrapsOriginalInput(t *testing.T) {
+	scroll := traceScroll()
+	if unwrapFrameTraceEvent(&testTraceReserved{scroll}) != scroll || unwrapFrameTraceEvent(scroll) != scroll {
+		t.Fatal("dispatch altered event identity")
+	}
+}
+
+func TestVellumFrameTracePrefixCompositionCannotFinalizeAfterLateArm(t *testing.T) {
+	trace := &FrameTrace{}
+	e := traceScroll()
+	if err := trace.Begin(3, e); err != nil {
+		t.Fatal(err)
+	}
+	tag, start := trace.startEvent(e)
+	trace.ExpectOwner(tag)
+	trace.endEvent(tag, start)
+	if trace.startFrame() != 3 {
+		t.Fatal("prefix not claimed")
+	}
+	trace.frameWork(3, 11, 13)
+	// The owner and native refresh may finish while earlier composition waits.
+	trace.Transition(3, 9)
+	trace.OwnerWork(3, 17)
+	trace.Reconciled(3, 19)
+	trace.finishFrame(3, composer.ComposeTiming{Supported: true, Submitted: true, RasterUploadNS: 23, EncodeSubmitNS: 29, AcquireNS: 100, PresentCallNS: 200})
+	if _, ok := trace.Take(); ok {
+		t.Fatal("prefix completed the newly armed generation")
+	}
+	if trace.startFrame() != 3 {
+		t.Fatal("final armed frame missing")
+	}
+	trace.frameWork(3, 31, 37)
+	trace.finishFrame(3, composer.ComposeTiming{Supported: true, Submitted: true, RasterUploadNS: 41, EncodeSubmitNS: 43, AcquireNS: 300, PresentCallNS: 400})
+	s, ok := trace.Take()
+	if !ok || !s.Completed || s.Generation != 9 || s.LayoutPaintNS != 42 || s.GatherNS != 50 || s.RasterUploadNS != 64 || s.EncodeSubmitNS != 72 || s.AcquireNS != 400 || s.PresentCallNS != 600 || s.TotalUIWorkNS != s.InputNS+17+19+42+50+64+72 {
+		t.Fatalf("lost prefix work: %+v", s)
+	}
+}
+
+func TestVellumFrameTraceCancelledRenderingKeepsClaimUntilTerminal(t *testing.T) {
+	trace := &FrameTrace{}
+	e := traceScroll()
+	if err := trace.Begin(3, e); err != nil {
+		t.Fatal(err)
+	}
+	tag, start := trace.startEvent(e)
+	trace.ExpectOwner(tag)
+	trace.endEvent(tag, start)
+	trace.Transition(3, 9)
+	trace.OwnerWork(3, 1)
+	trace.Reconciled(3, 1)
+	trace.startFrame()
+	trace.Fail(3, "cancelled")
+	if _, ok := trace.Take(); ok {
+		t.Fatal("released running native frame")
+	}
+	trace.frameFailed(3, "compose unwound")
+	s, ok := trace.Take()
+	if !ok || s.Completed || s.Failure != "cancelled" {
+		t.Fatalf("terminal lost: %+v", s)
+	}
+}
+
+func TestVellumFrameTraceSameTicketAndWorkExclusions(t *testing.T) {
+	trace := &FrameTrace{}
+	e := traceScroll()
+	if trace.Begin(0, e) == nil || trace.Begin(1, (*events.MouseScroll)(nil)) == nil {
+		t.Fatal("accepted invalid input")
+	}
+	if err := trace.Begin(7, e); err != nil {
+		t.Fatal(err)
+	}
+	if !errors.Is(trace.Begin(8, traceScroll()), ErrFrameTraceBusy) {
+		t.Fatal("overwrote ticket")
+	}
+	if tag, _ := trace.startEvent(traceScroll()); tag != 0 {
+		t.Fatal("attributed another event")
+	}
+	if trace.startFrame() != 0 || trace.OwnerTag() != 0 {
+		t.Fatal("armed before input")
+	}
+	tag, start := trace.startEvent(e)
+	if tag != 7 || trace.CurrentTag() != 7 {
+		t.Fatal("missing routed tag")
+	}
+	trace.Transition(77, 90)
+	trace.ExpectOwner(tag)
+	trace.endEvent(tag, start)
+	if trace.CurrentTag() != 0 || trace.OwnerTag() != 7 {
+		t.Fatal("input terminal not owned")
+	}
+	trace.OwnerWork(7, 11)
+	if trace.ReconcileTag() != 0 || trace.startFrame() != 7 {
+		t.Fatal("missing pre-owner frame attribution")
+	}
+	trace.noComposition(7, 3, 5)
+	trace.Transition(7, 91)
+	trace.OwnerWork(7, 13)
+	if trace.ReconcileTag() != 7 {
+		t.Fatal("owner not complete")
+	}
+	trace.Reconciled(77, 999)
+	trace.Reconciled(7, 17)
+	if trace.startFrame() != 7 || trace.startFrame() != 0 {
+		t.Fatal("more than one frame claimed")
+	}
+	trace.frameWork(77, 999, 999)
+	trace.frameWork(7, 19, 23)
+	trace.finishFrame(7, composer.ComposeTiming{RasterUploadNS: 29, EncodeSubmitNS: 31, AcquireNS: 1000, PresentCallNS: 2000, Supported: true, Submitted: true})
+	sample, ok := trace.Take()
+	if !ok || !sample.Completed || sample.Tag != 7 || sample.Generation != 91 || sample.OwnerNS != 24 || sample.ReconcileNS != 17 || sample.LayoutPaintNS != 22 || sample.GatherNS != 28 {
+		t.Fatalf("wrong linked sample: %+v", sample)
+	}
+	if sample.TotalUIWorkNS != sample.InputNS+24+17+22+28+29+31 || sample.AcquireNS != 1000 || sample.PresentCallNS != 2000 {
+		t.Fatalf("mixed/excluded work: %+v", sample)
+	}
+	if _, ok := trace.Take(); ok || trace.Pending() {
+		t.Fatal("sample not retired once")
+	}
+}
+
+func TestVellumFrameTraceCancellationKeepsInputOwnerOwnership(t *testing.T) {
+	trace := &FrameTrace{}
+	e := traceScroll()
+	if err := trace.Begin(1, e); err != nil {
+		t.Fatal(err)
+	}
+	trace.Fail(1, "cancelled")
+	if _, ok := trace.Take(); ok {
+		t.Fatal("released still queued input")
+	}
+	if !errors.Is(trace.Begin(2, traceScroll()), ErrFrameTraceBusy) {
+		t.Fatal("new ticket admitted before old input")
+	}
+	tag, start := trace.startEvent(e)
+	if tag != 1 {
+		t.Fatal("cancelled input lost its tag")
+	}
+	trace.ExpectOwner(tag)
+	trace.endEvent(tag, start)
+	if _, ok := trace.Take(); ok {
+		t.Fatal("released outstanding owner transition")
+	}
+	trace.Transition(tag, 9)
+	trace.OwnerWork(tag, 12)
+	if trace.ReconcileTag() != 0 || trace.startFrame() != 0 {
+		t.Fatal("rendered cancelled measurement")
+	}
+	sample, ok := trace.Take()
+	if !ok || sample.Completed || sample.Failure != "cancelled" || sample.Generation != 9 {
+		t.Fatalf("lost cancellation: %+v", sample)
+	}
+	if err := trace.Begin(2, traceScroll()); err != nil {
+		t.Fatal(err)
+	}
+	trace.Retire(2, "closed")
+	if sample, ok := trace.Take(); !ok || sample.Failure != "closed" || sample.Completed {
+		t.Fatalf("window terminal: %+v", sample)
+	}
+}
+
+func TestVellumFrameTraceConcurrentObservationAndFailure(t *testing.T) {
+	trace := &FrameTrace{}
+	e := traceScroll()
+	if err := trace.Begin(1, e); err != nil {
+		t.Fatal(err)
+	}
+	var wg sync.WaitGroup
+	wg.Add(2)
+	go func() {
+		defer wg.Done()
+		for range 1000 {
+			trace.Pending()
+			trace.CurrentTag()
+			trace.OwnerTag()
+			trace.ReconcileTag()
+			trace.Take()
+		}
+	}()
+	go func() {
+		defer wg.Done()
+		for range 1000 {
+			trace.Fail(1, "cancelled")
+		}
+	}()
+	tag, start := trace.startEvent(e)
+	trace.ExpectOwner(tag)
+	trace.endEvent(tag, start)
+	trace.Transition(tag, 8)
+	trace.OwnerWork(tag, 1)
+	wg.Wait()
+	// Observer may already have consumed the failed terminal. It cannot have
+	// opened a different ticket or changed the event's lifetime.
+	trace.Take()
+	if trace.Pending() || trace.CurrentTag() != 0 {
+		t.Fatal("pending after terminals")
+	}
+}
+
+func TestVellumFrameTraceUnsupportedCompositionFails(t *testing.T) {
+	trace := &FrameTrace{}
+	e := traceScroll()
+	if err := trace.Begin(1, e); err != nil {
+		t.Fatal(err)
+	}
+	tag, start := trace.startEvent(e)
+	trace.ExpectOwner(tag)
+	trace.endEvent(tag, start)
+	trace.Transition(tag, 2)
+	trace.OwnerWork(tag, 1)
+	trace.Reconciled(tag, 1)
+	if trace.startFrame() != tag {
+		t.Fatal("not armed")
+	}
+	trace.finishFrame(tag, composer.ComposeTiming{})
+	sample, ok := trace.Take()
+	if !ok || sample.Completed || sample.Failure == "" {
+		t.Fatal("qualified unsupported composer")
+	}
+	var absent *FrameTrace
+	if absent.CurrentTag() != 0 || absent.OwnerTag() != 0 || absent.ReconcileTag() != 0 || absent.startFrame() != 0 || absent.Pending() {
+		t.Fatal("nil observer changed default route")
+	}
+	if tag, start := absent.startEvent(e); tag != 0 || start != (time.Time{}) {
+		t.Fatal("nil observer started timing")
+	}
+	absent.endEvent(0, time.Time{})
+}
+
+func TestVellumFrameTraceNoHandlerEndsWithoutWindowRetirement(t *testing.T) {
+	trace := &FrameTrace{}
+	e := traceScroll()
+	if err := trace.Begin(1, e); err != nil {
+		t.Fatal(err)
+	}
+	tag, start := trace.startEvent(e)
+	trace.endEvent(tag, start) // no handler posted anything
+	s, ok := trace.Take()
+	if !ok || s.Completed || s.Failure != "traced input did not post owner work" || trace.Pending() {
+		t.Fatalf("lost unhandled input terminal: %+v", s)
+	}
+	if err := trace.Begin(2, traceScroll()); err != nil {
+		t.Fatal("blocked subsequent admission", err)
+	}
+	trace.Retire(2, "test complete")
+	trace.Take()
+}
+
+type traceFaultComposer struct {
+	composer.Composer
+	goexit  bool
+	entered chan struct{}
+}
+
+func (c *traceFaultComposer) ComposeMeasured() composer.ComposeTiming {
+	close(c.entered)
+	if c.goexit {
+		runtime.Goexit()
+	}
+	panic("test-composition-fault")
+}
+
+func TestVellumFrameTraceProductionComposeUnwindRetiresClaimAndLocks(t *testing.T) {
+	for _, goexit := range []bool{false, true} {
+		for _, owned := range []bool{false, true} {
+			trace := &FrameTrace{}
+			e := traceScroll()
+			if err := trace.Begin(1, e); err != nil {
+				t.Fatal(err)
+			}
+			tag, start := trace.startEvent(e)
+			trace.ExpectOwner(tag)
+			trace.endEvent(tag, start)
+			trace.Transition(tag, 2)
+			trace.OwnerWork(tag, 1)
+			trace.Reconciled(tag, 1)
+			if trace.startFrame() != tag {
+				t.Fatal("not armed")
+			}
+			native := &contextTestWindow{}
+			w := &renderWindow{SystemWindow: native, winRenderCounter: 1}
+			w.mains.renderContext = &renderContext{}
+			cp := &traceFaultComposer{goexit: goexit, entered: make(chan struct{})}
+			done := make(chan struct{})
+			var caught any
+			go func() {
+				defer close(done)
+				defer func() { caught = recover() }()
+				if owned {
+					w.renderAsyncMeasuredOwned(cp, trace, tag)
+				} else {
+					w.renderAsyncMeasured(cp, trace, tag)
+				}
+			}()
+			select {
+			case <-done:
+			case <-time.After(time.Second):
+				t.Fatal("composition unwind stuck")
+			}
+			select {
+			case <-cp.entered:
+			default:
+				t.Fatal("production composer never called")
+			}
+			if !goexit && caught != "test-composition-fault" || goexit && caught != nil {
+				t.Fatalf("changed original unwind: %v", caught)
+			}
+			if atomic.LoadInt32(&w.winRenderCounter) != 0 || !native.mu.TryLock() {
+				t.Fatal("retained native render ownership")
+			}
+			native.mu.Unlock()
+			if !w.renderContext().TryLock() {
+				t.Fatal("retained render context")
+			}
+			w.renderContext().Unlock()
+			s, ok := trace.Take()
+			if !ok || s.Completed || s.Failure != "composition terminated before diagnostic completion" || trace.Pending() {
+				t.Fatalf("missing abnormal terminal: %+v", s)
+			}
+		}
+	}
+}

+package gpudraw
+
+import (
+	"cogentcore.org/core/system/composer"
+	"time"
+)
+
+// EndMeasured is the opt-in normal End path. No readback, queue wait or extra
+// draw is inserted. Acquisition and the present call remain explicit exclusions.
+func (dw *Drawer) EndMeasured() composer.ComposeTiming {
+	dw.Lock()
+	defer dw.Unlock()
+	timing := composer.ComposeTiming{Supported: true}
+	dw.lastOpN = len(dw.opList)
+	if dw.lastOpN == 0 {
+		timing.Failure = "no composition operations"
+		return timing
+	}
+	start := time.Now()
+	err := dw.drawAllMeasured(&timing)
+	timing.EncodeSubmitNS = time.Since(start).Nanoseconds() - timing.AcquireNS - timing.PresentCallNS
+	if err != nil {
+		timing.Failure = err.Error()
+	}
+	dw.opList = dw.opList[:0]
+	return timing
+}

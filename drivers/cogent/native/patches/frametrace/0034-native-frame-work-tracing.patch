+package gpu
+
+import (
+	"errors"
+	"time"
+
+	"github.com/oliverbestmann/webgpu/wgpu"
+)
+
+// BeginRenderPassMeasured is the normal clear pass with surface acquisition
+// separated from encoder creation. Only the renderer's acquisition wait and
+// acquisition lock wait are excluded; reconfiguration and view work are charged.
+func (sy *GraphicsSystem) BeginRenderPassMeasured() (*wgpu.RenderPassEncoder, int64, error) {
+	rd := sy.Renderer
+	measured, ok := rd.(interface {
+		GetCurrentTextureMeasured() (*wgpu.TextureView, int64, error)
+		AbortCurrentTexture()
+		PresentMeasured() int64
+	})
+	if !ok {
+		return nil, 0, errors.New("renderer does not support measured acquisition")
+	}
+	view, acquire, err := measured.GetCurrentTextureMeasured()
+	if view == nil || err != nil {
+		return nil, acquire, err
+	}
+	cmd, err := sy.NewCommandEncoder()
+	if err != nil {
+		measured.AbortCurrentTexture()
+		return nil, acquire, err
+	}
+	sy.CommandEncoder = cmd
+	return rd.Render().BeginRenderPass(cmd, view), acquire, nil
+}
+
+// EndRenderPassMeasured separates the renderer present call from encoding and
+// queue submission. It reports submission failure rather than qualifying a frame.
+func (sy *GraphicsSystem) EndRenderPassMeasured(rp *wgpu.RenderPassEncoder) (int64, error) {
+	err := sy.SubmitRender(rp)
+	if measured, ok := sy.Renderer.(interface{ PresentMeasured() int64 }); ok {
+		return measured.PresentMeasured(), err
+	}
+	start := time.Now()
+	sy.Renderer.Present()
+	return time.Since(start).Nanoseconds(), errors.New("renderer lost measured presentation support")
+}

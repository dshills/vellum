+package gpu
+
+import (
+	"time"
+
+	"cogentcore.org/core/base/errors"
+	"github.com/oliverbestmann/webgpu/wgpu"
+)
+
+// GetCurrentTextureMeasured preserves the ordinary acquisition/retry order.
+// Only waiting for ownership and the backend acquisition calls are excluded.
+// Reconfiguration, status checks and texture view creation remain UI work.
+func (sf *Surface) GetCurrentTextureMeasured() (*wgpu.TextureView, int64, error) {
+	start := time.Now()
+	sf.Lock()
+	acquireNS := time.Since(start).Nanoseconds()
+	stexture, err := acquireSurfaceFrame(func() (wgpu.SurfaceTexture, error) {
+		start := time.Now()
+		frame, err := sf.surface.TryGetCurrentTexture()
+		acquireNS += time.Since(start).Nanoseconds()
+		return frame, err
+	}, sf.Config)
+	if errors.Log(err) != nil {
+		sf.Unlock()
+		return nil, acquireNS, err
+	}
+	texture, ok := stexture.Get()
+	if !ok || texture == nil {
+		sf.Unlock()
+		return nil, acquireNS, nil
+	}
+	view, err := texture.TryCreateView(&wgpu.TextureViewDescriptor{
+		MipLevelCount: texture.GetMipLevelCount(), ArrayLayerCount: texture.GetDepthOrArrayLayers(), Format: sf.Format.Format,
+	})
+	if errors.Log(err) != nil {
+		texture.Release()
+		sf.Unlock()
+		return nil, acquireNS, err
+	}
+	sf.curTextureOwner, sf.curTexture = texture, view
+	return view, acquireNS, nil
+}
+
+// AbortCurrentTexture withdraws an acquired diagnostic frame without presenting
+// unsubmitted contents. The caller must own a successful texture acquisition.
+func (sf *Surface) AbortCurrentTexture() {
+	if sf.curTexture != nil {
+		sf.curTexture.Release()
+		sf.curTexture = nil
+	}
+	if sf.curTextureOwner != nil {
+		sf.curTextureOwner.Release()
+		sf.curTextureOwner = nil
+	}
+	sf.Unlock()
+}
+
+// PresentMeasured excludes only the backend presentation call. Texture cleanup
+// and ownership release remain charged in the encompassing encoding interval.
+func (sf *Surface) PresentMeasured() int64 {
+	start := time.Now()
+	sf.surface.Present()
+	presentNS := time.Since(start).Nanoseconds()
+	sf.AbortCurrentTexture()
+	return presentNS
+}
+
+// A render texture has no surface acquisition or presentation wait.
+func (rt *RenderTexture) GetCurrentTextureMeasured() (*wgpu.TextureView, int64, error) {
+	view, err := rt.GetCurrentTexture()
+	return view, 0, err
+}
+func (rt *RenderTexture) AbortCurrentTexture()   {}
+func (rt *RenderTexture) PresentMeasured() int64 { return 0 }

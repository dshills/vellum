+package base
+
+import (
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func stopWait(t *testing.T, done <-chan struct{}) {
+	t.Helper()
+	select {
+	case <-done:
+	case <-time.After(3 * time.Second):
+		t.Fatal("main-queue waiter or loop survived stop")
+	}
+}
+func TestVellumMainQueueStopBeforePublication(t *testing.T) {
+	a := &App{This: &queueTestApp{}}
+	done := make(chan struct{})
+	var ran atomic.Bool
+	go func() { a.RunOnMainQueued(func() { ran.Store(true) }); close(done) }()
+	_, signal := a.mainQueueChannels()
+	a.StopMain()
+	a.StopMain()
+	stopWait(t, done)
+	a.mainQueueMu.Lock()
+	queue := a.MainQueue
+	stopped := a.MainDone
+	a.mainQueueMu.Unlock()
+	if queue != nil || ran.Load() || signal != stopped {
+		t.Fatal("stop published a queue, changed signal or executed worker")
+	}
+	if a.RunOnMainIfOpen(func() { ran.Store(true) }) || ran.Load() {
+		t.Fatal("post-stop inline callback executed")
+	}
+	published, signal := a.InitMainQueue()
+	if published == nil || signal != stopped {
+		t.Fatal("stop/loop channel identity changed")
+	}
+	exited := make(chan struct{})
+	go func() { a.MainLoop(); close(exited) }()
+	stopWait(t, exited)
+}
+func TestVellumMainQueueStopReleasesPendingDelivery(t *testing.T) {
+	a := &App{This: &queueTestApp{}}
+	a.InitMainQueue()
+	done := make(chan struct{})
+	var ran atomic.Bool
+	go func() {
+		if a.RunOnMainIfOpen(func() { ran.Store(true) }) {
+			t.Error("refused operation reported success")
+		}
+		close(done)
+	}()
+	a.StopMain()
+	stopWait(t, done)
+	if ran.Load() {
+		t.Fatal("unconsumed callback executed")
+	}
+}
+func TestVellumMainQueueStopDuringCallbackPreservesSynchronousOutput(t *testing.T) {
+	a := &App{This: &queueTestApp{}}
+	a.InitMainQueue()
+	exited := make(chan struct{})
+	go func() { a.MainLoop(); close(exited) }()
+	started, release, done := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	output := 0
+	go func() {
+		if !a.RunOnMainIfOpen(func() { close(started); <-release; output = 42 }) || output != 42 {
+			t.Error("accepted callback returned before output completed")
+		}
+		close(done)
+	}()
+	stopWait(t, started)
+	a.StopMain()
+	select {
+	case <-done:
+		t.Fatal("stop released an executing callback's caller")
+	case <-time.After(10 * time.Millisecond):
+	}
+	close(release)
+	stopWait(t, done)
+	stopWait(t, exited)
+}
+func TestVellumMainQueueStopIsConcurrentAndIdempotent(t *testing.T) {
+	a := &App{This: &queueTestApp{}}
+	var group sync.WaitGroup
+	for i := 0; i < 100; i++ {
+		group.Add(1)
+		go func() { defer group.Done(); a.StopMain() }()
+	}
+	group.Wait()
+	_, stopped := a.InitMainQueue()
+	select {
+	case <-stopped:
+	default:
+		t.Fatal("stop signal absent")
+	}
+	done := make(chan struct{})
+	go func() { a.RunOnMainQueued(func() { t.Error("closed queue callback ran") }); close(done) }()
+	stopWait(t, done)
+}
+func TestVellumMainQueueStopAcknowledgesAcceptedRefusal(t *testing.T) {
+	a := &App{This: &queueTestApp{}}
+	queue, _ := a.InitMainQueue()
+	done := make(chan struct{})
+	var ran atomic.Bool
+	go func() {
+		if a.RunOnMainIfOpen(func() { ran.Store(true) }) {
+			t.Error("refused delivery succeeded")
+		}
+		close(done)
+	}()
+	var call FuncRun
+	select {
+	case call = <-queue:
+	case <-time.After(3 * time.Second):
+		t.Fatal("delivery absent")
+	}
+	a.StopMain()
+	if a.ExecuteMain(call) {
+		t.Fatal("stopped loop executed accepted delivery")
+	}
+	stopWait(t, done)
+	if ran.Load() {
+		t.Fatal("callback executed after refusal")
+	}
+}
+
+type noStopWakeApp struct{ queueTestApp }
+
+func (*noStopWakeApp) SendEmptyEvent() { panic("stop posted to native backend") }
+
+func TestVellumMainQueueStopNeedsNoNativeWake(t *testing.T) {
+	for _, a := range []*App{{}, {This: &noStopWakeApp{}}} {
+		a.InitMainQueue()
+		a.StopMain()
+		a.StopMain()
+		done := make(chan struct{})
+		go func() { a.MainLoop(); close(done) }()
+		stopWait(t, done)
+		if a.RunOnMainIfOpen(func() { t.Error("stopped callback ran") }) {
+			t.Fatal("stopped callback admitted")
+		}
+	}
+}

 // FuncRun is a simple helper type that contains a function to call and a channel
 // to send a signal on when the function is finished running.
 type FuncRun struct {
-	F    func()
-	Done chan struct{}
+	F        func()
+	Done     chan struct{}
+	executed *bool
 }
+
+// ExecuteMain admits work under the same lock as StopMain, then releases that
+// lock before invoking code. Admitted work retains synchronous completion;
+// refusal is also acknowledged. Only the native loop calls this method.
+func (a *App) ExecuteMain(f FuncRun) bool {
+	a.mainQueueMu.Lock()
+	executed := !a.mainQueueStopped
+	a.mainQueueMu.Unlock()
+	if executed {
+		f.F()
+	}
+	if f.executed != nil {
+		*f.executed = executed
+	}
+	if f.Done != nil {
+		f.Done <- struct{}{}
+	}
+	return executed
+}

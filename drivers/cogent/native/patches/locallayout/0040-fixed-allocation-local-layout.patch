+func localFixture(t *testing.T, count int) (*ManualWindow, *Scene, []*localLayoutFixture) {
+	t.Helper()
+	roots := make([]*localLayoutFixture, count)
+	m, b, _ := manualFixture(t, func(b *Body) {
+		for i := range roots {
+			roots[i] = tree.New[localLayoutFixture](b)
+		}
+	})
+	drainManual(t, m)
+	return m, b.Scene, roots
+}
+
+// These calls own the originating RC on an actual manual scene. No event loop
+// or native/GPU window can advance it in the background.
+func localOwnedUpdate(sc *Scene) bool {
+	rc := sc.renderContext()
+	rc.Lock()
+	defer rc.Unlock()
+	return sc.doUpdate()
+}
+func localOwnedRequest(sc *Scene, root LocalLayoutRoot) bool {
+	rc := sc.renderContext()
+	rc.Lock()
+	defer rc.Unlock()
+	return sc.NeedsLocalLayout(root)
+}
+
+type localPaintCounter struct {
+	system.Window
+	requests int
+}
+
+func (w *localPaintCounter) RequestPaint()                     { w.requests++ }
+func (w *localPaintCounter) RequestPaintAfter(_ time.Duration) {}
+func (w *localPaintCounter) IsOnDemand() bool                  { return true }
+
+func TestVellumLocalLayoutBoundIdentityAndPaint(t *testing.T) {
+	_, sc, roots := localFixture(t, localLayoutCapacity+1)
+	if !localOwnedRequest(sc, roots[0]) || !localOwnedRequest(sc, roots[0]) || len(sc.localLayouts) != 1 {
+		t.Fatal("same initialized identity did not coalesce")
+	}
+	// Names are deliberately equal; a different actual tree must not coalesce.
+	for i := 1; i < localLayoutCapacity; i++ {
+		roots[i].SetName(roots[0].Name)
+		if !localOwnedRequest(sc, roots[i]) {
+			t.Fatal("valid root refused before bound", i)
+		}
+	}
+	if len(sc.localLayouts) != localLayoutCapacity {
+		t.Fatal("queue did not admit exact bound")
+	}
+	if localOwnedRequest(sc, roots[localLayoutCapacity]) || len(sc.localLayouts) != 0 || !sc.hasFlag(sceneNeedsLayout) {
+		t.Fatal("capacity refusal did not retire queue/promote full layout")
+	}
+	localOwnedUpdate(sc)
+	for _, root := range roots {
+		if root.calls != 0 {
+			t.Fatal("capacity fallback still called local roots")
+		}
+	}
+}

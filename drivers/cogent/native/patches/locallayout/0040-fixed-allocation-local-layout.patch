+func TestVellumLocalLayoutOriginalPainterOrderAndRealGeometry(t *testing.T) {
+	var root *localLayoutFixture
+	var overlap *Frame
+	m, b, _ := manualFixture(t, func(b *Body) {
+		host := NewFrame(b)
+		host.Styler(func(s *styles.Style) {
+			s.Display = styles.Custom
+			s.Min.Set(units.Dp(220), units.Dp(140))
+			s.Grow.SetZero()
+			s.Padding.Zero()
+		})
+		root = tree.New[localLayoutFixture](host)
+		root.x = 8
+		root.moving = NewFrame(root)
+		root.moving.Styler(func(s *styles.Style) {
+			s.Min.Set(units.Dp(24), units.Dp(24))
+			s.Max.Set(units.Dp(24), units.Dp(24))
+			s.Grow.SetZero()
+			s.Padding.Zero()
+			s.Background = image.NewUniform(color.RGBA{R: 193, G: 31, B: 23, A: 255})
+		})
+		overlap = NewFrame(host)
+		overlap.Styler(func(s *styles.Style) {
+			s.Pos.Set(units.Dp(24), units.Dp(8))
+			s.Min.Set(units.Dp(18), units.Dp(18))
+			s.Max.Set(units.Dp(18), units.Dp(18))
+			s.Grow.SetZero()
+			s.Padding.Zero()
+			s.Background = image.NewUniform(color.RGBA{R: 29, G: 53, B: 197, A: 255})
+		})
+	})
+	drainManual(t, m)
+	sc := b.Scene
+	beforeSizes := root.sizes
+	previous := root.moving.Geom.TotalBBox
+	root.x += 19
+	if !localOwnedRequest(sc, root) {
+		t.Fatal("request refused")
+	}
+	drainManual(t, m)
+	actual, err := m.Image(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if root.calls != 1 || root.sizes != beforeSizes || root.moving.Geom.TotalBBox == previous {
+		t.Fatal("local did not move geometry without full sizing", root.calls, root.sizes, beforeSizes, root.moving.Geom.TotalBBox, previous)
+	}
+	moved := root.moving.Geom.TotalBBox
+	intersection := moved.Intersect(overlap.Geom.TotalBBox)
+	if intersection.Empty() {
+		t.Fatal("fixture later peer did not overlap moved content", moved, overlap.Geom.TotalBBox)
+	}
+	point := intersection.Min.Add(intersection.Size().Div(2))
+	if actual.RGBAAt(point.X, point.Y) != (color.RGBA{R: 29, G: 53, B: 197, A: 255}) {
+		t.Fatal("local render covered later peer", point, actual.RGBAAt(point.X, point.Y))
+	}
+	// Independently run ordinary full layout/paint; equality checks stale old
+	// pixels as well as later overlap, rather than consulting queue counters only.
+	rc := sc.renderContext()
+	rc.Lock()
+	sc.LayoutRenderScene()
+	expected := sc.Renderer.Render(sc.Painter.RenderDone()).Image().(*image.RGBA)
+	if root.moving.Geom.TotalBBox != moved || actual.Bounds() != expected.Bounds() || !bytes.Equal(actual.Pix, expected.Pix) {
+		t.Error("local geometry/pixels differ from ordinary full layout")
+	}
+	rc.Unlock()
+}

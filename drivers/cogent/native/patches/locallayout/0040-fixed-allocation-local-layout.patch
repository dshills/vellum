+			other := NewScene()
+			switch mode {
+			case "detach":
+				// Parent can outlive membership; don't merely test root.Parent=nil.
+				parent := root.Parent.AsTree()
+				parent.Children = parent.Children[:0]
+			case "destroy":
+				root.Delete()
+			case "foreign":
+				tree.MoveToParent(root, other)
+				root.SetScene(other)
+			case "same-scene-parent":
+				parent := NewFrame(sc.Body)
+				tree.MoveToParent(root, parent)
+				root.SetScene(sc)
+			}
+			sc.doUpdate()
+			rc.Unlock()
+			if root.calls != 0 || len(sc.localLayouts) != 0 {
+				t.Fatal("retired request invoked", mode)
+			}
+			if mode == "detach" {
+				root.Destroy()
+			}
+			other.Destroy()
+		})
+	}
+	_, sc, roots := localFixture(t, 1)
+	var nilRoot *localLayoutFixture
+	if localOwnedRequest(sc, nilRoot) {
+		t.Fatal("typed nil admitted")
+	}
+	other := NewScene()
+	defer other.Destroy()
+	foreign := tree.New[localLayoutFixture](other)
+	if localOwnedRequest(sc, foreign) || sc.NeedsLocalLayout(roots[0]) == false {
+		t.Fatal("foreign admission affected valid root")
+	}
+}

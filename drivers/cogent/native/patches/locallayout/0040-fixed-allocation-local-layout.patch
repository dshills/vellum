+func TestVellumLocalLayoutFullPaintPreservesLaterGlobalRequest(t *testing.T) {
+	for _, mode := range []string{"layout", "restyle", "rebuild", "fallback"} {
+		t.Run(mode, func(t *testing.T) {
+			var root *localLayoutFixture
+			m, b, _ := manualFixture(t, func(b *Body) {
+				root = tree.New[localLayoutFixture](b)
+				root.x = 8
+				root.moving = NewFrame(root)
+				root.moving.Styler(func(s *styles.Style) {
+					s.Min.Set(units.Dp(16), units.Dp(16))
+					s.Max.Set(units.Dp(16), units.Dp(16))
+					s.Padding.Zero()
+					s.Background = image.NewUniform(color.RGBA{R: 193, G: 31, B: 23, A: 255})
+				})
+			})
+			drainManual(t, m)
+			sc := b.Scene
+			rc := sc.renderContext()
+			before := root.moving.Geom.TotalBBox
+			paints := 0
+			root.onRendered = func() {
+				paints++
+				if !sc.GlobalLayoutPending() {
+					t.Error("full painting released the inspection fence before callback")
+				}
+				if paints == 1 {
+					// Sizing and positioning have already finished. This change can
+					// only take effect in the next ordinary layout, not this paint.
+					root.x = 27
+					root.NeedsLayout()
+				}
+			}
+			func() {
+				rc.Lock()
+				defer rc.Unlock()
+				switch mode {
+				case "layout":
+					root.NeedsLayout()
+				case "restyle":
+					sc.lastRender.logicalDPI = -1
+				case "rebuild":
+					rc.rebuild = true
+					defer func() { rc.rebuild = false }()
+				case "fallback":
+					root.accept = false
+					if !sc.NeedsLocalLayout(root) {
+						t.Fatal("fallback request refused")
+					}
+				}
+				if !sc.doUpdate() {
+					t.Fatal("initial full pass did not run")
+				}
+			}()
+			if paints != 1 || root.moving.Geom.TotalBBox != before || !sc.hasFlag(sceneNeedsLayout) || !sc.GlobalLayoutPending() {
+				t.Fatal("later global layout request was erased after full painting", paints, root.moving.Geom.TotalBBox, before, sc.hasFlag(sceneNeedsLayout), sc.GlobalLayoutPending())
+			}
+			first := sc.Renderer.Render(sc.Painter.RenderDone()).Image().(*image.RGBA)
+			firstPixels := bytes.Clone(first.Pix)
+			if !localOwnedUpdate(sc) || paints != 2 || root.moving.Geom.TotalBBox == before || sc.hasFlag(sceneNeedsLayout) || sc.GlobalLayoutPending() {
+				t.Fatal("next full pass did not apply geometry and retire the fence", paints, root.moving.Geom.TotalBBox, before)
+			}
+			second := sc.Renderer.Render(sc.Painter.RenderDone()).Image().(*image.RGBA)
+			if bytes.Equal(firstPixels, second.Pix) {
+				t.Fatal("next full pass did not change actual scene pixels")
+			}
+			if localOwnedUpdate(sc) {
+				t.Fatal("completed second pass left unrequested scene work")
+			}
+		})
+	}
+}

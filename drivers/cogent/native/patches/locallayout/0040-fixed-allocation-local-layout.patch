+func TestVellumLocalLayoutSliderRenderReachesQuiescence(t *testing.T) {
+	var slider *Slider
+	m, b, _ := manualFixture(t, func(b *Body) {
+		slider = NewSlider(b)
+		slider.SetValue(0.1)
+	})
+	drainManual(t, m)
+	sc := b.Scene
+	before := slider.pos
+	rc := sc.renderContext()
+	func() {
+		rc.Lock()
+		defer rc.Unlock()
+		slider.SetValue(0.9)
+		if !sc.hasFlag(sceneNeedsRender) || !slider.hasFlag(widgetNeedsRender) {
+			t.Fatal("external slider change did not request painting")
+		}
+		if !sc.doUpdate() {
+			t.Fatal("slider paint did not run")
+		}
+	}()
+	if slider.pos == before || sc.hasFlag(sceneNeedsRender) || slider.hasFlag(widgetNeedsRender) {
+		t.Fatal("slider paint did not consume its position update", before, slider.pos)
+	}
+	sc.Painter.RenderDone()
+	if localOwnedUpdate(sc) {
+		t.Fatal("slider render requested another paint for work it just completed")
+	}
+	// Existing setter semantics also request a repaint for an unchanged value.
+	func() {
+		rc.Lock()
+		defer rc.Unlock()
+		slider.SetValue(slider.Value)
+		if !sc.hasFlag(sceneNeedsRender) || !sc.doUpdate() {
+			t.Fatal("unchanged external setter lost its existing repaint contract")
+		}
+	}()
+	sc.Painter.RenderDone()
+	if localOwnedUpdate(sc) {
+		t.Fatal("unchanged-value slider repaint did not become idle")
+	}
+}

+func TestVellumLocalLayoutGlobalFenceTransitionsAndCompletion(t *testing.T) {
+	_, sc, roots := localFixture(t, 1)
+	if sc.GlobalLayoutPending() {
+		t.Fatal("initial full layout never released fence")
+	}
+	rc := sc.renderContext()
+	root := roots[0]
+	observedSizing, observedPaint := false, false
+	func() {
+		rc.Lock()
+		defer rc.Unlock()
+		sc.setFlag(true, sceneNeedsLayout)
+		sc.setFlag(false, sceneNeedsRender)
+		if !sc.GlobalLayoutPending() || !sc.hasFlag(sceneNeedsLayout) {
+			t.Fatal("unrelated flag cleared requested layout fence")
+		}
+		root.onSized = func() { observedSizing = sc.GlobalLayoutPending() }
+		root.onRendered = func() { observedPaint = sc.GlobalLayoutPending() }
+		sc.doUpdate()
+	}()
+	if !observedSizing || !observedPaint || sc.GlobalLayoutPending() || sc.hasFlag(sceneNeedsLayout) {
+		t.Fatal("full layout fence did not cover sizing/paint through completion")
+	}
+	// A declined local callback also enters ordinary full layout with the fence,
+	// even when it did not request sceneNeedsLayout itself.
+	root.accept = false
+	observedSizing, observedPaint = false, false
+	localOwnedRequest(sc, root)
+	localOwnedUpdate(sc)
+	if !observedSizing || !observedPaint || sc.GlobalLayoutPending() {
+		t.Fatal("local fallback omitted full-layout inspection fence")
+	}
+}

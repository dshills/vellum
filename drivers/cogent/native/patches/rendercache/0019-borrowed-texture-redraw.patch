+package gpudraw
+
+import (
+	"image"
+	"image/draw"
+	"testing"
+
+	"cogentcore.org/core/gpu"
+)
+
+// The minimal cached batch has no live GPU system deliberately: rejection must
+// precede any backend access after the owner has retired its borrowed texture.
+func TestVellumRedrawRejectsRetiredBorrowedTextureBeforeGPUAccess(t *testing.T) {
+	tx := &gpu.Texture{}
+	dw := &Drawer{opList: make([]draw.Op, 0, 1), lastOpN: 1}
+	dw.images.init()
+	dw.images.use(tx)
+	tx.Release()
+	defer func() {
+		if failure := recover(); failure != nil {
+			t.Errorf("retired borrowed batch reached GPU replay: %v", failure)
+		}
+	}()
+	dw.Redraw()
+}
+
+func TestVellumRedrawEligibilityFollowsLastBatch(t *testing.T) {
+	dw := &Drawer{lastOpN: 1}
+	dw.images.init()
+	tx := &gpu.Texture{}
+	dw.images.use(tx)
+	if dw.CanRedraw() {
+		t.Fatal("borrowed texture eligible for cached redraw")
+	}
+	// End truncates opList, not images.used. That retained batch must remain
+	// ineligible even when its owner has already released the texture.
+	dw.opList = nil
+	tx.Release()
+	if dw.CanRedraw() {
+		t.Fatal("End/owner retirement forgot borrowed batch")
+	}
+	// A new independent batch must not permanently inherit a former texture's
+	// lifetime restriction. Stale entries in all are not part of this batch.
+	dw.images.start()
+	dw.images.use(image.NewRGBA(image.Rect(0, 0, 10, 10)))
+	if !dw.CanRedraw() {
+		t.Fatal("new owned raster batch remained ineligible")
+	}
+	dw.lastOpN = 0
+	if dw.CanRedraw() {
+		t.Fatal("empty batch eligible for redraw")
+	}
+}

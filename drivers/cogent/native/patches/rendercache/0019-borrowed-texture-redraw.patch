+package core
+
+import (
+	"image"
+	"image/color"
+	"image/draw"
+	"testing"
+
+	"cogentcore.org/core/system/composer"
+)
+
+type redrawAdmissionDrawer struct {
+	composer.DrawerBase
+	eligible               bool
+	replays, presentations int
+}
+
+func (d *redrawAdmissionDrawer) CanRedraw() bool { return d.eligible }
+func (d *redrawAdmissionDrawer) Redraw()         { d.replays++ }
+func (d *redrawAdmissionDrawer) End()            { d.presentations++ }
+
+type redrawAdmissionSource struct{ image *image.RGBA }
+
+func (s *redrawAdmissionSource) Draw(cp composer.Composer) {
+	cp.(*composer.ComposerDrawer).Drawer.Copy(image.Point{}, s.image, s.image.Bounds(), draw.Src, composer.Changed)
+}
+
+func TestVellumUnsafeResizeReplayRequiresFreshComposition(t *testing.T) {
+	d := &redrawAdmissionDrawer{DrawerBase: composer.DrawerBase{Image: image.NewRGBA(image.Rect(0, 0, 1, 1))}}
+	cp := &composer.ComposerDrawer{Drawer: d}
+	if redrawCached(cp) || d.replays != 0 {
+		t.Fatal("borrowed resize batch replayed")
+	}
+	// The caller takes the normal gather/compose path on refusal. A fresh
+	// source after replacement reaches the target without any model update.
+	current := image.NewRGBA(image.Rect(0, 0, 1, 1))
+	current.SetRGBA(0, 0, color.RGBA{G: 255, A: 255})
+	cp.Start()
+	cp.Add(&redrawAdmissionSource{image: current}, current)
+	w := &renderWindow{SystemWindow: &contextTestWindow{}}
+	w.renderAsyncOwned(cp)
+	if d.presentations != 1 || d.Image.RGBAAt(0, 0).G != 255 {
+		t.Fatal("fallback did not present replacement source")
+	}
+	d.eligible = true
+	if !redrawCached(cp) || d.replays != 1 {
+		t.Fatal("owned batch resize replay lost")
+	}
+}

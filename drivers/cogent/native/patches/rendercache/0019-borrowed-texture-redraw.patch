+package composer
+
+import "testing"
+
+type vellumRedrawDrawer struct {
+	DrawerBase
+	eligible bool
+	redraws  int
+}
+
+func (d *vellumRedrawDrawer) CanRedraw() bool { return d.eligible }
+func (d *vellumRedrawDrawer) End()            {}
+func (d *vellumRedrawDrawer) Redraw()         { d.redraws++ }
+
+type vellumLegacyDrawer struct{ DrawerBase }
+
+func (d *vellumLegacyDrawer) End()    {}
+func (d *vellumLegacyDrawer) Redraw() {}
+
+func TestVellumComposerPropagatesCachedRedrawAdmission(t *testing.T) {
+	drawer := &vellumRedrawDrawer{}
+	c := &ComposerDrawer{Drawer: drawer}
+	if c.CanRedraw() {
+		t.Fatal("borrowed batch admitted")
+	}
+	drawer.eligible = true
+	if !c.CanRedraw() {
+		t.Fatal("owned batch rejected")
+	}
+	if !(&ComposerDrawer{Drawer: &vellumLegacyDrawer{}}).CanRedraw() {
+		t.Fatal("legacy drawer replay changed")
+	}
+}

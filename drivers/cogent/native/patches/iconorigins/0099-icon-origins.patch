+// Five pre-existing Material derivatives gain only prominent XML change notices.
+// Independently frozen preceding-Core hashes prevent a changed path/viewBox from
+// being hidden by a self-comparison; actual parser/raster equality checks comments.
+func TestVellumMaterialChangeNoticesPreservePixels(t *testing.T) {
+	preimages := map[string]string{
+		"check_box_outline_blank.svg": "82953245de0af44060fe2b37956aa9636ce29e63d999817ec4f1eaff3fbf3b4a",
+		"toggle_off-fill.svg":         "c004f1549345d80e9b9d156822c8fa581e13411566a130027e5a8220184aafaf",
+		"toggle_off.svg":              "26ea80be6efb69e16558d4db4c71336295b8efeb190e3f710f64fdab09002dba",
+		"toggle_on-fill.svg":          "9dd35a9bcdbecc1a0b3c82dfc801cdf4f5e400f3bc989af1fe9b584ecc0b73f6",
+		"toggle_on.svg":               "8a8c68bba238462285d73ca50c1e3b8f97c6e36323ffdc58eec073afb9e9f9c8",
+	}
+	for name, want := range preimages {
+		body, err := os.ReadFile(filepath.Join("svg", name))
+		if err != nil {
+			t.Fatal(err)
+		}
+		marker := []byte("-->\n")
+		end := bytes.Index(body, marker)
+		if !bytes.HasPrefix(body, []byte("<!-- Vellum stage 0099 modification notice.")) || end < 0 {
+			t.Fatal("missing prominent per-file notice", name)
+		}
+		end += len(marker)
+		prefix, prior := body[:end], body[end:]
+		if !bytes.Contains(prefix, []byte("Cogent Core")) || !bytes.Contains(prefix, []byte("Vellum adds")) || !bytes.Contains(prefix, []byte("Apache-2.0")) {
+			t.Fatal("missing change provenance", name)
+		}
+		if got := fmt.Sprintf("%x", sha256.Sum256(prior)); got != want {
+			t.Fatal("notice changed original artwork bytes", name, got, want)
+		}
+		for _, size := range []int{16, 24, 32, 48} {
+			for _, tint := range []color.NRGBA{{20, 40, 60, 255}, {230, 210, 190, 255}} {
+				t.Run(fmt.Sprintf("%s/%d/%d", name, size, tint.R), func(t *testing.T) {
+					before, after := renderNeutral(t, prior, size, tint), renderNeutral(t, body, size, tint)
+					ink := 0
+					for y := 0; y < size; y++ {
+						for x := 0; x < size; x++ {
+							a := color.NRGBAModel.Convert(before.At(x, y)).(color.NRGBA)
+							b := color.NRGBAModel.Convert(after.At(x, y)).(color.NRGBA)
+							if a != b {
+								t.Fatalf("notice changed raster pixel %s (%d,%d): %v %v", name, x, y, a, b)
+							}
+							if a.A != 0 {
+								ink++
+							}
+						}
+					}
+					if ink == 0 {
+						t.Fatal("empty equivalence control", name, size)
+					}
+				})
+			}
+		}
+	}
+}

+func TestVellumIconOriginCoverage(t *testing.T) {
+	raw, err := os.ReadFile("NOTICE.origins")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(raw) > 1<<20 {
+		t.Fatal("unbounded ledger")
+	}
+	var ledger struct {
+		Schema        int                        `json:"schema"`
+		Records       [][]string                 `json:"records"`
+		Sources       map[string]json.RawMessage `json:"sources"`
+		Rights        bool                       `json:"rights_approved"`
+		Modifications map[string]json.RawMessage `json:"modifications"`
+	}
+	if err = json.Unmarshal(raw, &ledger); err != nil {
+		t.Fatal(err)
+	}
+	if ledger.Schema != 1 || ledger.Rights || len(ledger.Records) != 4105 || len(ledger.Modifications) != 5 {
+		t.Fatal("ledger scope")
+	}
+	seen := map[string]bool{}
+	prior := ""
+	counts := map[string]int{}
+	for _, row := range ledger.Records {
+		if len(row) < 3 || len(row) > 4 || row[0] <= prior || filepath.Base(row[0]) != row[0] || !strings.HasSuffix(row[0], ".svg") || ledger.Sources[row[2]] == nil || (len(row) == 4 && (filepath.Base(row[3]) != row[3] || !strings.HasSuffix(row[3], ".svg"))) {
+			t.Fatalf("invalid row %v", row)
+		}
+		b, e := os.ReadFile(filepath.Join("svg", row[0]))
+		if e != nil {
+			t.Fatal(e)
+		}
+		if fmt.Sprintf("%x", sha256.Sum256(b)) != row[1] {
+			t.Fatalf("hash mismatch: %s", row[0])
+		}
+		prior = row[0]
+		seen[row[0]] = true
+		counts[row[2]]++
+	}
+	files, err := filepath.Glob("svg/*.svg")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(files) != len(seen) {
+		t.Fatalf("missing/extra ledger entries %d/%d", len(files), len(seen))
+	}
+	for _, f := range files {
+		if !seen[filepath.Base(f)] {
+			t.Fatal("unlisted", f)
+		}
+	}
+	if counts["vellum"] != 13 || counts["core"] != 2 {
+		t.Fatal("incorrect ownership scope", counts)
+	}
+	for n, export := range neutralExports {
+		b, e := os.ReadFile(filepath.Join("svg", n))
+		if e != nil || string(export) != string(b) {
+			t.Fatal("export identity", n, e)
+		}
+	}
+	for _, pair := range [][2]string{{"latex.svg", "tex.svg"}, {"make.svg", "makefile.svg"}} {
+		if neutralExports[pair[0]] != neutralExports[pair[1]] {
+			t.Fatal("alias changed", pair)
+		}
+	}
+}

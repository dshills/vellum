+func TestVellumIconSourceLinks(t *testing.T) {
+	raw, err := os.ReadFile("NOTICE.origins")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var ledger struct {
+		Records [][]string `json:"records"`
+		Sources map[string]struct {
+			Prefix string `json:"url_prefix"`
+		} `json:"sources"`
+	}
+	if err = json.Unmarshal(raw, &ledger); err != nil {
+		t.Fatal(err)
+	}
+	const base = "https://github.com/marella/material-symbols/blob/097888d1375f87c1e9fe75ed65e20ef1cc2fb774/svg/400/"
+	want := map[string]string{"abc-fill.svg": base + "outlined/abc-fill.svg", "blur_medium.svg": base + "rounded/blur_medium.svg", "mode_cool.svg": base + "sharp/mode_cool.svg"}
+	for _, row := range ledger.Records {
+		expected, ok := want[row[0]]
+		if !ok {
+			continue
+		}
+		name := row[0]
+		if len(row) == 4 {
+			name = row[3]
+		}
+		got := ledger.Sources[row[2]].Prefix + name
+		if got != expected {
+			t.Errorf("%s: source URL %s, want %s", row[0], got, expected)
+		}
+		delete(want, row[0])
+	}
+	if len(want) != 0 {
+		t.Fatal("missing source link cases", want)
+	}
+}

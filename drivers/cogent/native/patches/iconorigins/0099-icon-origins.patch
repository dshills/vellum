+func renderNeutral(t *testing.T, body []byte, size int, tint color.NRGBA) image.Image {
+	t.Helper()
+	sv := svg.NewSVG(math32.Vec2(float32(size), float32(size)))
+	sv.TextShaper = shapedgt.NewShaperWithFonts(nil)
+	if err := sv.ReadXML(bytes.NewReader(body)); err != nil {
+		t.Fatal(err)
+	}
+	sv.DefaultFill = image.NewUniform(tint)
+	rs := rasterx.New(math32.Vec2(float32(size), float32(size))).(*rasterx.Renderer)
+	defer rs.Release()
+	rs.Render(sv.Render(nil).RenderDone())
+	// Release must not invalidate caller inspection of this detached copy.
+	out := image.NewNRGBA(image.Rect(0, 0, size, size))
+	for y := 0; y < size; y++ {
+		for x := 0; x < size; x++ {
+			out.Set(x, y, rs.Image().At(x, y))
+		}
+	}
+	return out
+}
+func TestVellumNeutralIconsRender(t *testing.T) {
+	for n, body := range neutralExports {
+		for _, size := range []int{16, 24, 32, 48} {
+			for _, tint := range []color.NRGBA{{20, 40, 60, 255}, {230, 210, 190, 255}} {
+				t.Run(fmt.Sprintf("%s/%d/%d", n, size, tint.R), func(t *testing.T) {
+					img := renderNeutral(t, []byte(body), size, tint)
+					ink, opaque := 0, 0
+					for y := 0; y < size; y++ {
+						for x := 0; x < size; x++ {
+							c := color.NRGBAModel.Convert(img.At(x, y)).(color.NRGBA)
+							if c.A != 0 {
+								ink++
+							}
+							if c.A == 255 {
+								opaque++
+								if c.R != tint.R || c.G != tint.G || c.B != tint.B {
+									t.Fatalf("fill does not follow UI tint: %v", c)
+								}
+							}
+						}
+					}
+					if ink < size || ink >= size*size*9/10 || opaque == 0 {
+						t.Fatalf("empty/clipped/solid asset ink=%d opaque=%d", ink, opaque)
+					}
+					if _, _, _, a := img.At(0, 0).RGBA(); a != 0 {
+						t.Fatal("corner must be transparent")
+					}
+				})
+			}
+		}
+	}
+}
+func TestVellumNeutralPartialStates(t *testing.T) {
+	tint := color.NRGBA{40, 80, 120, 255}
+	for _, tc := range []struct {
+		name    string
+		on, off image.Point
+	}{{"radio_button_partial.svg", image.Pt(12, 16), image.Pt(20, 16)}, {"toggle_mid.svg", image.Pt(16, 16), image.Pt(9, 16)}} {
+		img := renderNeutral(t, []byte(neutralExports[tc.name]), 32, tint)
+		_, _, _, a := img.At(tc.on.X, tc.on.Y).RGBA()
+		_, _, _, b := img.At(tc.off.X, tc.off.Y).RGBA()
+		if a == 0 || b != 0 {
+			t.Fatalf("%s partial-state pixels %d/%d", tc.name, a, b)
+		}
+	}
+}

+			t.Fatal(err)
+		}
+		if err := sy.EndComputePass(); err != nil {
+			t.Fatal(err)
+		}
+		if old.IsValid() || !replacement.IsValid() || len(pipeline.oldBindGroups) != 0 {
+			t.Fatal("pass completion retired wrong binding")
+		}
+		result := make([]uint32, 4)
+		if err := value.ReadSync(); err != nil {
+			t.Fatal(err)
+		}
+		if err := ReadToBytes(value, result); err != nil {
+			t.Fatal(err)
+		}
+		if !reflect.DeepEqual(result, []uint32{10, 14, 22, 34}) {
+			t.Fatal("retry shader output", result)
+		}
+		pipeline.Release()
+		pipeline.Release()
+		if replacement.IsValid() || pipeline.currentBindGroups != nil || pipeline.currentBindGroupsCount != nil {
+			t.Fatal("pipeline cache retained state")
+		}
+		record(map[string]any{"case": "binding_failure_retry_and_dispatch", "refused_replacements": 3, "computed_words_checked": 4, "old_binding_refs_retired": 1, "current_binding_refs_retired": 1})
+	})
+}

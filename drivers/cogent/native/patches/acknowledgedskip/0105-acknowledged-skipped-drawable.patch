+func TestVellumDisplayBackpressureAcknowledgedSkipAfterCPUEnd(t *testing.T) {
+	for _, at := range []float64{0, math.Copysign(0, -1)} {
+		g, wake := displayGateFixture(t)
+		credit := displayAdmit(t, g)
+		seq := g.acquire(credit)
+		g.finish(credit)
+		g.complete(seq, at, false)
+		if s := g.status(); s.Active != 0 || s.NativePending != 0 || s.Retired != credit || s.Failure != "" || wake.Load() != 0 {
+			t.Fatalf("acknowledged skip failed ownership retirement or caused replay: %+v wakes%d", s, wake.Load())
+		}
+		select {
+		case err := <-g.refusals:
+			t.Fatal("finite-zero acknowledgement invented terminal failure", err)
+		default:
+		}
+		next := displayAdmit(t, g)
+		g.finish(next)
+		if wake.Load() != 0 {
+			t.Fatal("unused subsequent batch requested replay")
+		}
+	}
+}

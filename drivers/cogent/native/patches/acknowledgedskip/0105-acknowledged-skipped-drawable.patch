+func TestVellumDisplayAdmissionAcknowledgedSkipDoesNotReplayUnchangedScene(t *testing.T) {
+	m, body, _, drawer, w := displayManualFixture(t)
+	displayDirty(body, color.RGBA{R: 211, G: 23, B: 43, A: 255})
+	m.window.renderWindow()
+	for range 32 {
+		m.window.renderWindow()
+	}
+	if drawer.ends.Load() != 1 || !w.dirty || !w.nativePending {
+		t.Fatal("busy unchanged requests bypassed pending native ownership")
+	}
+	w.present() // Controlled acknowledgement, including the acknowledged-skip case.
+	m.window.renderWindow()
+	for range 32 {
+		m.window.renderWindow()
+	}
+	if drawer.ends.Load() != 1 || w.active != 0 || w.begun != 1 {
+		t.Fatal("acknowledged skip manufactured an unchanged composition")
+	}
+	displayDirty(body, color.RGBA{R: 23, G: 211, B: 43, A: 255})
+	m.window.renderWindow()
+	if drawer.ends.Load() != 2 || !w.nativePending {
+		t.Fatal("genuinely changed work did not resume after acknowledgement")
+	}
+	img, err := m.Image(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	p := img.RGBAAt(img.Bounds().Dx()/2, img.Bounds().Dy()/2)
+	if p.G < 180 || p.R > 60 || p.B > 80 {
+		t.Fatalf("resumed changed frame is stale: %v", p)
+	}
+	w.present()
+}

+	credit := displayAdmit(t, g)
+	seq := g.acquire(credit)
+	g.finish(credit)
+	g.expire(credit)
+	before := g.status()
+	if before.Active != credit || before.NativePending != seq || before.Failure != "presentation deadline exceeded" {
+		t.Fatalf("timeout fabricated a native acknowledgement: %+v", before)
+	}
+	g.complete(seq, 0, false)
+	if after := g.status(); after.Active != 0 || after.NativePending != 0 || after.Retired != credit || after.Failure != before.Failure {
+		t.Fatalf("late zero lost ownership or reset refusal: %+v", after)
+	}
+	if credit, err := g.admit(); credit != 0 || err == nil {
+		t.Fatal("late zero reopened a failed gate")
+	}
+}

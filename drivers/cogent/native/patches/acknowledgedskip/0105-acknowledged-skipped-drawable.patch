+func TestVellumDisplayBackpressureClosedAndReplacedWindowIgnoreZero(t *testing.T) {
+	var registry nativePresentationRegistry
+	first, _ := displayGateFixture(t)
+	old, err := registry.register(first)
+	if err != nil {
+		t.Fatal(err)
+	}
+	credit := displayAdmit(t, first)
+	seq := first.acquire(credit)
+	registry.close(old)
+	closed := first.status()
+	first.complete(seq, 0, false)
+	first.finish(credit)
+	if first.status() != closed {
+		t.Fatal("late zero changed closed ownership")
+	}
+	next, _ := displayGateFixture(t)
+	token, err := registry.register(next)
+	if err != nil || token <= old {
+		t.Fatal(token, err)
+	}
+	defer registry.close(token)
+	newCredit := displayAdmit(t, next)
+	newSequence := next.acquire(newCredit)
+	next.finish(newCredit)
+	before := next.status()
+	registry.presented(old, newSequence, 0, 0)
+	if next.status() != before {
+		t.Fatal("old window zero callback retired replacement credit")
+	}
+	registry.presented(token, newSequence, 0, 0)
+	if s := next.status(); s.Active != 0 || s.NativePending != 0 || s.Failure != "" {
+		t.Fatalf("current incarnation zero did not acknowledge: %+v", s)
+	}
+}

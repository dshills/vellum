+func TestVellumDisplayBackpressureConcurrentDirtyAndSkippedCompletion(t *testing.T) {
+	g, wake := displayGateFixture(t)
+	credit := displayAdmit(t, g)
+	seq := g.acquire(credit)
+	var wg sync.WaitGroup
+	for range 64 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			if credit, err := g.admit(); credit != 0 || !errors.Is(err, errDisplayPending) {
+				t.Error("busy gate admitted or refused with wrong error", credit, err)
+			}
+		}()
+	}
+	wg.Wait()
+	wg.Add(2)
+	go func() { defer wg.Done(); g.finish(credit) }()
+	go func() { defer wg.Done(); g.complete(seq, 0, false) }()
+	wg.Wait()
+	if s := g.status(); s.Active != 0 || s.NativePending != 0 || s.Retired != credit || s.Failure != "" || wake.Load() != 1 {
+		t.Fatalf("zero/CPU race lost existing dirty work: %+v wakes%d", s, wake.Load())
+	}
+}

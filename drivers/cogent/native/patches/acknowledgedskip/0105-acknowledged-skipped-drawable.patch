+func TestVellumDisplayBackpressureStaleZeroCannotRetireRetryOrNewBatch(t *testing.T) {
+	g, _ := displayGateFixture(t)
+	credit := displayAdmit(t, g)
+	first := g.acquire(credit)
+	g.unavailable(first)
+	second := g.acquire(credit)
+	if first == 0 || second <= first {
+		t.Fatal("unavailable retry lost its independent sequence")
+	}
+	g.complete(first, 0, false)
+	g.finish(credit)
+	if s := g.status(); s.Active != credit || s.NativePending != second || s.Failure != "" {
+		t.Fatalf("stale zero retired current retry: %+v", s)
+	}
+	g.complete(second, 0, false)
+	next := displayAdmit(t, g)
+	third := g.acquire(next)
+	before := g.status()
+	g.complete(second, 0, false)
+	g.complete(0, 0, false)
+	if after := g.status(); after != before {
+		t.Fatalf("old zero changed new native ownership: %+v -> %+v", before, after)
+	}
+	g.finish(next)
+	g.complete(third, 0, false)
+}

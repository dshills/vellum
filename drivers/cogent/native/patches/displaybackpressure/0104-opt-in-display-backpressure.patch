+	w := &displayAdmissionWindow{completionPaintWindow: observeCompletionPaint(m)}
+	m.window.SystemWindow = w
+	return m, b, clock, drawer, w
+}
+func displayDirty(body *Body, c color.RGBA) {
+	body.Styles.Background = image.NewUniform(c)
+	body.NeedsRender()
+}
+func TestVellumDisplayAdmissionDefersRealPixelsUntilNativeAcknowledgement(t *testing.T) {

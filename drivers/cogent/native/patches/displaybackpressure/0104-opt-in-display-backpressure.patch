+// Copyright (c) 2026, Davin Hills. SPDX-License-Identifier: MIT
+package desktop
+
+import (
+	"errors"
+	"math"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func displayGateFixture(t *testing.T) (*displayGate, *atomic.Int64) {
+	t.Helper()
+	wake := new(atomic.Int64)
+	g, err := newDisplayGate(5*time.Second, func() { wake.Add(1) })
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(g.close)
+	return g, wake
+}
+func displayAdmit(t *testing.T, g *displayGate) uint64 {
+	t.Helper()
+	c, err := g.admit()
+	if err != nil || c == 0 {
+		t.Fatal(c, err)
+	}
+	return c
+}
+func displayPending(t *testing.T, g *displayGate) {
+	t.Helper()
+	if c, err := g.admit(); c != 0 || !errors.Is(err, errDisplayPending) {
+		t.Fatal("second batch was admitted", c, err)
+	}
+}
+func TestVellumDisplayBackpressureWaitsForAsynchronousPresentation(t *testing.T) {
+	g, wake := displayGateFixture(t)

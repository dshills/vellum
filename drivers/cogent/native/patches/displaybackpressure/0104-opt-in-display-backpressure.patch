+	done := make(chan struct{})
+	go func() { defer close(done); <-release; g.complete(native, 1, false) }()
+	close(release)
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("asynchronous acknowledgement blocked")
+	}
+	if s := g.status(); s.Active != 0 || s.NativePending != 0 || s.Retired != credit || wake.Load() != 1 {
+		t.Fatalf("lost or duplicate dirty wake: %+v wakes%d", s, wake.Load())
+	}
+	next := displayAdmit(t, g)
+	if next <= credit {

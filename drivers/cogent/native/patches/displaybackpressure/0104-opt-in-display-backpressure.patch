+
+// The real manual owner, layout, software compositor and pixels remain in use.
+// Only asynchronous native presentation is replaced by an explicit callback.
+type fakeDisplayPending struct{}
+
+func (fakeDisplayPending) Error() string        { return "controlled display pending" }
+func (fakeDisplayPending) DisplayPending() bool { return true }
+
+type displayAdmissionWindow struct {
+	*completionPaintWindow
+	mu                            sync.Mutex
+	next, active                  uint64
+	admitted, finished, begun     int
+	cpuDone, nativePending, dirty bool
+}
+
+func (w *displayAdmissionWindow) AdmitDisplayFrame() (uint64, error) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	if w.active != 0 {
+		w.dirty = true
+		return 0, fakeDisplayPending{}
+	}
+	w.next++
+	w.active = w.next
+	w.cpuDone = false
+	w.admitted++
+	return w.active, nil
+}
+func (w *displayAdmissionWindow) FinishDisplayFrame(credit uint64) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	if credit == 0 || credit != w.active {
+		return
+	}
+	w.finished++
+	w.cpuDone = true
+	if !w.nativePending {
+		w.active = 0
+	}
+}
+func (w *displayAdmissionWindow) DisplayBackpressureEnabled() bool { return true }
+func (w *displayAdmissionWindow) BeginDisplayFrame() {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	w.begun++
+	w.nativePending = true
+}
+func (w *displayAdmissionWindow) EndDisplayFrame() {}
+func (w *displayAdmissionWindow) present() {
+	w.mu.Lock()
+	w.nativePending = false
+	if w.cpuDone {
+		w.active = 0
+	}
+	dirty := w.dirty
+	w.dirty = false
+	w.mu.Unlock()
+	if dirty {
+		w.RequestPaintAfter(0)
+	}
+}

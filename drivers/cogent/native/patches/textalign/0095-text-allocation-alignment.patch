+
+// paintTextOrigin positions the entire shaped text block inside the actual
+// content allocation. Shaping already aligns shorter lines to the longest
+// line; this adds only the remaining block-to-allocation horizontal offset.
+// Rendering and all pointer/selection/link coordinates must share this origin.
+func (tx *Text) paintTextOrigin() math32.Vector2 {
+	origin := tx.Geom.Pos.Content
+	if tx.paintText != nil {
+		spare := tx.Geom.Size.Actual.Content.X - tx.paintText.Bounds.Size().X
+		if spare > 0 {
+			origin.X += spare * tx.Styles.Text.Align.Factor()
+		}
+	}
+	return origin
 }
 

+func TestVellumGrowingTextFillsFinalAllocationAndKeepsWrapping(t *testing.T) {
+	var tx *Text
+	m, body, _ := manualFixture(t, func(b *Body) {
+		column := NewFrame(b)
+		column.Styler(func(s *styles.Style) {
+			s.Direction = styles.Column
+			s.Min.X.Dp(240)
+			s.Max.X.Dp(240)
+			s.Align.Items = styles.Center
+			s.Align.Content = styles.Center
+		})
+		tx = NewText(column).SetText("one two three four five six seven eight nine ten")
+		tx.Styler(func(s *styles.Style) { s.Grow.Set(1, 0); s.Font.Size.Dp(24); s.Text.Align = text.Center })
+	})
+	drainManual(t, m)
+	rc := body.Scene.renderContext()
+	rc.Lock()
+	defer rc.Unlock()
+	if tx.Geom.Size.Actual.Content.X != tx.Geom.Size.Alloc.Content.X || tx.Geom.Size.Actual.Content.X < 230 {
+		t.Fatalf("explicit growth left intrinsic content size: %+v", tx.Geom.Size)
+	}
+	if !tx.Styles.GrowWrap || len(tx.paintText.Lines) < 2 {
+		t.Fatal("final allocation disabled wrapping measurement", tx.Styles.GrowWrap, len(tx.paintText.Lines))
+	}
+	for _, line := range tx.paintText.Lines {
+		if line.Bounds.Size().X > tx.Geom.Size.Actual.Content.X+1 {
+			t.Fatal("wrapped line exceeds final content", line.Bounds, tx.Geom.Size)
+		}
+	}
+}

+func TestVellumTextAlignmentOriginMatchesSelectionAndLinks(t *testing.T) {
+	for _, alignment := range []text.Aligns{text.Start, text.Center, text.End} {
+		t.Run(alignment.String(), func(t *testing.T) {
+			var tx *Text
+			m, body, _ := manualFixture(t, func(b *Body) {
+				tx = NewText(b).SetText(`<a href="https://example.com">12345</a>`)
+				tx.Styler(func(s *styles.Style) {
+					s.Min.Set(units.Dp(240), units.Dp(40))
+					s.Max.Set(units.Dp(240), units.Dp(40))
+					s.Grow.Set(0, 0)
+					s.Text.Align = alignment
+				})
+			})
+			drainManual(t, m)
+			rc := body.Scene.renderContext()
+			rc.Lock()
+			defer rc.Unlock()
+			origin := tx.paintTextOrigin()
+			spare := tx.Geom.Size.Actual.Content.X - tx.paintText.Bounds.Size().X
+			want := spare * alignment.Factor()
+			if spare < 100 || math.Abs(float64(origin.X-tx.Geom.Pos.Content.X-want)) > .01 {
+				t.Fatalf("origin=%v content=%v spare=%v want offset=%v", origin, tx.Geom.Pos.Content, spare, want)
+			}
+			for ri := 0; ri < 5; ri++ {
+				bounds := tx.paintText.RuneBounds(ri).Translate(origin)
+				point := bounds.Center().ToPoint()
+				if got := tx.pixelToRune(point); got != ri {
+					t.Fatalf("selection at rendered rune %d resolved %d", ri, got)
+				}
+				link, hit := tx.findLink(point)
+				if link == nil || !point.In(hit) || !point.In(bounds.ToRect()) {
+					t.Fatalf("link bounds missed rendered rune %d: %v", ri, hit)
+				}
+			}
+		})
+	}
+}
+
+func TestVellumTextAlignmentMultilineAddsOnlyBlockSpare(t *testing.T) {
+	var tx *Text
+	m, body, _ := manualFixture(t, func(b *Body) {
+		tx = NewText(b).SetText("123456789<br>12")
+		tx.Styler(func(s *styles.Style) {
+			s.Min.Set(units.Dp(240), units.Dp(80))
+			s.Max.Set(units.Dp(240), units.Dp(80))
+			s.Grow.Set(0, 0)
+			s.Text.Align = text.End
+		})
+	})
+	drainManual(t, m)
+	rc := body.Scene.renderContext()
+	rc.Lock()
+	defer rc.Unlock()
+	if len(tx.paintText.Lines) != 2 {
+		t.Fatalf("expected two lines, got %d", len(tx.paintText.Lines))
+	}
+	origin := tx.paintTextOrigin()
+	var right float32
+	for i, line := range tx.paintText.Lines {
+		edge := origin.X + line.Offset.X + line.Bounds.Max.X
+		if i == 0 {
+			right = edge
+		} else if math.Abs(float64(edge-right)) > 1 {
+			t.Fatalf("double-aligned line: edges %v %v", right, edge)
+		}
+	}
+	if math.Abs(float64(right-(tx.Geom.Pos.Content.X+tx.Geom.Size.Actual.Content.X))) > 1 {
+		t.Fatalf("aligned right edge %v missed content right", right)
+	}
+}

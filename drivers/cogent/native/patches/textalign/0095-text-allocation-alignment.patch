+func TestVellumTextAlignmentPreservesLinkedInteriorSpace(t *testing.T) {
+	var tx *Text
+	m, body, _ := manualFixture(t, func(b *Body) {
+		tx = NewText(b).SetText(`<a href="https://example.com">one two</a>`)
+		tx.Styler(func(s *styles.Style) {
+			s.Min.Set(units.Dp(300), units.Dp(60))
+			s.Max.Set(units.Dp(300), units.Dp(60))
+			s.Grow.Set(0, 0)
+			s.Font.Size.Dp(32)
+			s.Text.Align = text.End
+		})
+	})
+	drainManual(t, m)
+	rc := body.Scene.renderContext()
+	rc.Lock()
+	defer rc.Unlock()
+	origin := tx.paintTextOrigin()
+	for _, cell := range tx.paintText.InteractionLayout().Cells {
+		if cell.Range.Start != 3 {
+			continue
+		}
+		point := cell.Rect.Translate(origin).Center().ToPoint()
+		point.X = int(cell.Rect.Max.X + origin.X - 1)
+		if got := tx.pixelToRune(point); got != 3 {
+			t.Fatalf("linked space resolved rune %d", got)
+		}
+		if link, _ := tx.findLink(point); link == nil || link.URL != "https://example.com" {
+			t.Fatal("interior linked space lost hyperlink hit")
+		}
+		return
+	}
+	t.Fatal("missing interior space advance cell")
+}

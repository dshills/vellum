+// SizeFinal preserves intrinsic wrapping during measurement but honors an
+// explicit Grow at final allocation. GrowWrap otherwise prevents the base
+// widget from expanding at all, leaving paragraph alignment no content space
+// and allowing parent content/item alignment to position the intrinsic block
+// twice within an already expanded allocation.
+func (tx *Text) SizeFinal() {
+	wrap := tx.Styles.GrowWrap
+	if tx.Styles.Grow.X > 0 || tx.Styles.Grow.Y > 0 {
+		tx.Styles.GrowWrap = false
+	}
+	defer func() { tx.Styles.GrowWrap = wrap }()
+	tx.WidgetBase.SizeFinal()
+}

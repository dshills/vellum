+package system
+
+import (
+	"errors"
+	"time"
+)
+
+// ManualWindowOptions explicitly constructs an offscreen window with no paint
+// or event goroutine. Unsupported drivers expose no NewManualWindow factory.
+type ManualWindowOptions struct {
+	Now        func() time.Time
+	LogicalDPI float32
+}
+
+type ManualWindowState struct {
+	ReadyPaint bool
+	NextPaint  time.Time
+	Closed     bool
+}
+
+var ErrManualWindowMode = errors.New("system: automatic and manual windows cannot share one app")

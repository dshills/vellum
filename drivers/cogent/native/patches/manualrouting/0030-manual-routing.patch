+func drainManual(t *testing.T, m *ManualWindow) {
+	t.Helper()
+	for range 256 {
+		snap, err := m.Snapshot(context.Background())
+		if err != nil {
+			t.Fatal(err)
+		}
+		if snap.Events == 0 && !snap.ReadyPaint {
+			return
+		}
+		if snap.Blocked && !snap.ReadyPaint {
+			t.Fatal("blocked source")
+		}
+		if _, err = m.Step(context.Background(), 1); err != nil {
+			t.Fatal(err)
+		}
+	}
+	t.Fatal("explicit step budget exhausted")
+}
+func inputManual(t *testing.T, m *ManualWindow, input ManualInput) {
+	t.Helper()
+	if err := m.Input(context.Background(), input); err != nil {

+// An OS close request must visit a stable top-to-bottom policy snapshot. Each
+// accepted Scene.Close deletes and shifts the live stack while its callback runs.
+func TestVellumManualClosePolicySceneSnapshot(t *testing.T) {
+	for _, mode := range []string{"veto", "accept", "retire-other"} {
+		t.Run(mode, func(t *testing.T) {
+			m, body, _ := manualFixture(t, nil)
+			drainManual(t, m)
+			w := m.window
+			mainScene := body.Scene
+			mainStage := mainScene.Stage
+			dialog := NewBody("close-policy dialog")
+			NewText(dialog).SetText("Unsaved changes")
+			dialog.NewFullDialog(body).Run()
+			drainManual(t, m)
+			dialogScene := dialog.Scene
+			dialogStage := dialogScene.Stage
+			beforeRegistry := AllRenderWindows.snapshot()
+			beforeMainRegistry := mainRenderWindows.snapshot()
+			var order []string
+			mainScene.OnClose(func(events.Event) { order = append(order, "main") })
+			dialogScene.OnClose(func(e events.Event) {
+				order = append(order, "dialog")
+				if mode == "veto" {
+					e.SetHandled()
+				}
+				if mode == "retire-other" && !mainScene.Close() {
+					t.Error("callback main close refused")
+				}
+			})
+			dialogScene.OnFirst(events.KeyChord, func(e events.Event) {
+				e.SetHandled()
+				w.closeReq()
+			})
+			inputManual(t, m, ManualInput{Type: events.KeyChord, Rune: 'w', Code: key.CodeW})
+			if _, err := m.Step(context.Background(), 1); err != nil {
+				t.Fatal(err)
+			}
+			if mode == "veto" {
+				if !slices.Equal(order, []string{"dialog"}) {
+					t.Fatalf("veto callback order %v", order)
+				}
+				if w.SystemWindow.IsClosed() || m.window != w || w.flags.HasFlag(winClosing) {
+					t.Fatal("veto closed native window")
+				}
+				if mainScene.This == nil || mainStage.Scene != mainScene || mainStage.Mains != &w.mains || dialogStage.Scene != dialogScene || dialogStage.Mains != &w.mains {
+					t.Fatal("veto destroyed a live scene")
+				}
+				if len(w.mains.stack.Order) != 2 || w.mains.stack.Order[0].Value != mainStage || w.mains.stack.Order[1].Value != dialogStage {
+					t.Fatal("veto changed live stack")
+				}
+				if !slices.Equal(beforeRegistry, AllRenderWindows.snapshot()) || !slices.Equal(beforeMainRegistry, mainRenderWindows.snapshot()) {
+					t.Fatal("veto changed window registry")
+				}
+				if s, err := m.Snapshot(context.Background()); err != nil || s.Closed || s.Failure != nil {
+					t.Fatalf("veto terminalized controller %+v %v", s, err)
+				}
+				return
+			}
+			if !slices.Equal(order, []string{"dialog", "main"}) {
+				t.Fatalf("accepted callback order %v", order)
+			}
+			drainManual(t, m)
+			if s, err := m.Snapshot(context.Background()); err != nil || !s.Closed {
+				t.Fatalf("accepted close incomplete %+v %v", s, err)
+			}
+			for _, rw := range AllRenderWindows.snapshot() {
+				if rw == w {
+					t.Fatal("accepted close retained window")
+				}
+			}
+		})
+	}
+}

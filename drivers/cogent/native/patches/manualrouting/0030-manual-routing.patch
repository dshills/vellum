+	w.PhysDPI = execution.LogicalDPI
+	w.LogDPI = execution.LogicalDPI
+	w.Event.Now = execution.Now
+	w.manualScreen = system.Screen{Name: "vellum-manual", PixelSize: opts.Size, DevicePixelRatio: 1, LogicalDPI: execution.LogicalDPI, PhysicalDPI: execution.LogicalDPI}
+	w.manualScreen.Geometry.Max = opts.Size
+	w.Paint.Demand.Store(true)
+	a.Mu.Lock()
+	for _, existing := range a.Windows {
+		if !existing.manual {
+			a.Mu.Unlock()
+			return nil, system.ErrManualWindowMode
+		}
+	}
+	a.Windows = append(a.Windows, w)
+	a.Mu.Unlock()
+	w.Event.WindowResize()
+	w.Event.Window(events.WinShow)

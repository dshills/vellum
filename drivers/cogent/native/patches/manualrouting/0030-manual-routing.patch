+package core
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"image"
+	"math"
+	"reflect"
+	"slices"
+	"sync"
+	"sync/atomic"
+	"time"
+	"unicode/utf8"
+
+	"cogentcore.org/core/events"
+	"cogentcore.org/core/events/key"
+	"cogentcore.org/core/math32"
+	"cogentcore.org/core/system"
+	"cogentcore.org/core/system/composer"
+	"cogentcore.org/core/text/shaped"
+)
+
+var (
+	ErrManualConfig           = errors.New("core: invalid manual window configuration")
+	ErrManualUnsupported      = errors.New("core: driver does not support manual windows")
+	ErrManualBusy             = errors.New("core: concurrent or reentrant manual operation")
+	ErrManualClosed           = errors.New("core: manual window closed")
+	ErrManualInput            = errors.New("core: invalid manual input")
+	ErrManualCapacity         = errors.New("core: manual input capacity exhausted")
+	ErrManualBudget           = errors.New("core: manual step budget exhausted")
+	ErrManualAsyncCreation    = errors.New("core: asynchronous window construction is unsupported in manual mode")
+	ErrManualTimerUnsupported = errors.New("core: timed widget callback requires the next manual timer integration checkpoint")
+	ErrManualNoFrame          = errors.New("core: no manual software frame captured")
+	ErrManualStartupTimer     = errors.New("core: timer admission before manual window publication is unsupported")
+	ErrManualCallback         = errors.New("core: manual callback terminated abnormally")
+)
+
+// ManualWindowConfig is immutable after admission. No implicit time advance or
+// first frame occurs. Shaper must contain the caller's explicit fixture fonts.
+type ManualCallbackError struct{ Value any }
+
+func (*ManualCallbackError) Error() string { return ErrManualCallback.Error() }
+func (*ManualCallbackError) Unwrap() error { return ErrManualCallback }
+
+type ManualWindowConfig struct {
+	Size          image.Point
+	LogicalDPI    float32
+	EventCapacity int
+	Now           func() time.Time
+	NewShaper     func() (shaped.Shaper, error)
+	// AfterFunc must be checked/bounded and use the same clock as Now. It only
+	// enqueues a callback; Step owns actual widget execution.
+	AfterFunc func(context.Context, time.Duration, func()) (ManualTimer, error)
+}
+
+type manualSystemFactory interface {
+	ManualWindowsOnly() bool
+	NewManualWindow(*system.NewWindowOptions, system.ManualWindowOptions) (system.Window, error)
+}
+type manualSystemWindow interface {
+	ManualExecution() bool
+	ManualState() system.ManualWindowState
+	FlushReadyPaint() bool
+}
+
+// ManualWindow is the sole event/frame owner. A backend must never also launch
+// its eventLoop/WinLoop. Public operations refuse concurrent/reentrant use.
+type ManualWindow struct {
+	self     *ManualWindow
+	window   *renderWindow
+	config   ManualWindowConfig
+	lifetime context.Context
+	cancel   context.CancelFunc
+	busy     atomic.Bool
+	mu       sync.Mutex
+	failure  error
+	frames   uint64
+	timers   map[*manualTimer]struct{}
+}
+
+type ManualInput struct {
+	Type      events.Types
+	Rune      rune
+	Code      key.Codes
+	Modifiers key.Modifiers
+	Button    events.Buttons
+	Position  image.Point
+	Delta     math32.Vector2
+}
+
+type ManualSnapshot struct {
+	Now         time.Time
+	Events      int
+	Blocked     bool
+	ReadyPaint  bool
+	FuturePaint bool
+	NextPaint   time.Time
+	Frames      uint64
+	Closed      bool
+	Failure     error
+	Timers      int
+}
+
+type ManualStepResult struct {
+	Events      int
+	Frames      int
+	LastType    events.Types
+	LastHandled bool
+}
+
+func validateManualConfig(config ManualWindowConfig) error {
+	if config.Size.X <= 0 || config.Size.Y <= 0 || config.Size.X > 32768 || config.Size.Y > 32768 || config.Size.X > 16*1024*1024/config.Size.Y || config.LogicalDPI <= 0 || config.LogicalDPI > 1920 || math.IsNaN(float64(config.LogicalDPI)) || math.IsInf(float64(config.LogicalDPI), 0) || config.EventCapacity < 4 || config.EventCapacity > 1<<20 || config.Now == nil || config.NewShaper == nil || config.AfterFunc == nil {
+		return ErrManualConfig
+	}
+	return nil
+}
+
+func (st *Stage) RunManual(ctx context.Context, config ManualWindowConfig) (*ManualWindow, error) {
+	if ctx == nil {
+		return nil, ErrManualConfig
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if err := validateManualConfig(config); err != nil {
+		return nil, err
+	}
+	if st == nil || st.Scene == nil || st.Scene.This == nil || st.Mains != nil {
+		return nil, ErrManualConfig
+	}
+	if system.OnSystemWindowCreated != nil {
+		return nil, ErrManualAsyncCreation
+	}
+	factory, ok := system.TheApp.(manualSystemFactory)
+	if !ok || system.TheApp.Platform() != system.Offscreen {
+		return nil, ErrManualUnsupported
+	}
+	if !factory.ManualWindowsOnly() {
+		return nil, system.ErrManualWindowMode
+	}
+	shaper, err := config.NewShaper()
+	if err != nil {
+		return nil, err
+	}
+	if manualNil(shaper) {
+		return nil, ErrManualConfig
+	}
+	lifetime, cancel := context.WithCancel(ctx)
+	m := &ManualWindow{config: config, lifetime: lifetime, cancel: cancel, timers: make(map[*manualTimer]struct{})}
+	m.self = m
+	rc := &renderContext{geom: math32.Geom2DInt{Size: config.Size}, logicalDPI: config.LogicalDPI, visible: true, textShaper: shaper, manual: m}
+	temporary := &stages{renderContext: rc}
+	st.Type = WindowStage
+	st.NewWindow = true
+	st.FullWindow = true
+	st.Mains = nil
+	st.setMains(temporary)
+	st.configMainStage()
+	st.addSceneParts()
+	st.Scene.Resize(rc.geom)
+	m.mu.Lock()
+	constructionFailure := m.failure
+	m.mu.Unlock()
+	if constructionFailure == nil {
+		constructionFailure = ctx.Err()
+	}
+	if constructionFailure != nil {
+		cancel()
+		st.Mains = nil
+		st.renderContext = nil
+		return nil, constructionFailure
+	}
+	opts := &system.NewWindowOptions{Title: st.Title, Size: config.Size, StdPixels: false}
+	var createErr error
+	win := newRenderWindow(st.Name, st.Title, opts, func(opts *system.NewWindowOptions) (system.Window, error) {
+		systemWindow, err := factory.NewManualWindow(opts, system.ManualWindowOptions{Now: config.Now, LogicalDPI: config.LogicalDPI})
+		createErr = err
+		return systemWindow, err
+	})
+	if win == nil {
+		cancel()
+		st.Mains = nil
+		st.renderContext = nil
+		if createErr != nil {
+			return nil, createErr
+		}
+		return nil, ErrManualUnsupported
+	}
+	m.window = win
+	win.manual = m
+	win.mains.renderWindow = win
+	win.mains.renderContext = rc
+	win.mains.push(st)
+	st.setMains(&win.mains)
+	AllRenderWindows.add(win)
+	mainRenderWindows.add(win)
+	setCurrentRenderWindow(win)
+	// Intentionally no goStartEventLoop, WinLoop, WindowWait or first frame.
+	return m, nil
+}
+
+func (m *ManualWindow) enter(ctx context.Context, cleanup bool) error {
+	if m == nil || m.self != m || ctx == nil || m.config.Now == nil || m.lifetime == nil {
+		return ErrManualConfig
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if !m.busy.CompareAndSwap(false, true) {
+		return ErrManualBusy
+	}
+	if m.window == nil && !cleanup {
+		m.busy.Store(false)
+		return ErrManualClosed
+	}
+	if !cleanup {
+		if err := m.lifetime.Err(); err != nil {
+			m.busy.Store(false)
+			return err
+		}
+		m.mu.Lock()
+		failure := m.failure
+		m.mu.Unlock()
+		if failure != nil {
+			m.busy.Store(false)
+			return failure
+		}
+	}
+	return nil
+}
+func (m *ManualWindow) fail(err error) {
+	m.mu.Lock()
+	if m.failure == nil {
+		m.failure = err
+	}
+	m.mu.Unlock()
+}
+func (m *ManualWindow) leave() { m.busy.Store(false) }
+func (m *ManualWindow) snapshotOwned() ManualSnapshot {
+	s := ManualSnapshot{Now: m.config.Now(), Frames: m.frames}
+	m.mu.Lock()
+	s.Failure = m.failure
+	s.Timers = len(m.timers)
+	m.mu.Unlock()
+	if m.window == nil {
+		s.Closed = true
+		return s
+	}
+	q := &m.window.SystemWindow.Events().Deque
+	q.Mu.Lock()
+	s.Events = len(q.Front) + len(q.Back)
+	if len(q.Front) == 0 && len(q.Back) > 0 {
+		if deferred, ok := q.Back[0].(events.DeferredEvent); ok {
+			s.Blocked = !deferred.Ready()
+		}
+	}
+	q.Mu.Unlock()
+	native := m.window.SystemWindow.(manualSystemWindow).ManualState()
+	s.ReadyPaint = native.ReadyPaint
+	s.NextPaint = native.NextPaint
+	s.FuturePaint = !native.NextPaint.IsZero() && s.Now.Before(native.NextPaint)
+	s.Closed = native.Closed
+	return s
+}
+func (m *ManualWindow) Snapshot(ctx context.Context) (ManualSnapshot, error) {
+	if err := m.enter(ctx, true); err != nil {
+		return ManualSnapshot{}, err
+	}
+	defer m.leave()
+	return m.snapshotOwned(), nil
+}
+
+func (m *ManualWindow) Input(ctx context.Context, input ManualInput) error {
+	if err := m.enter(ctx, false); err != nil {
+		return err
+	}
+	defer m.leave()
+	if m.window.SystemWindow.IsClosed() {
+		return ErrManualClosed
+	}
+	if !utf8.ValidRune(input.Rune) || input.Modifiers < 0 || input.Modifiers & ^(key.Modifiers(1<<key.ModifiersN)-1) != 0 || input.Position.X < math.MinInt32 || input.Position.X > math.MaxInt32 || input.Position.Y < math.MinInt32 || input.Position.Y > math.MaxInt32 {
+		return ErrManualInput
+	}
+	units := 1
+	switch input.Type {
+	case events.KeyDown, events.KeyUp, events.KeyChord:
+		valid := false
+		for _, code := range key.CodesValues() {
+			if input.Code == code {
+				valid = true
+				break
+			}
+		}
+		if !valid {
+			return ErrManualInput
+		}
+		if input.Type == events.KeyDown {
+			units = 2
+		}
+	case events.MouseDown, events.MouseUp:
+		if input.Button < 0 || input.Button >= events.ButtonsN {
+			return ErrManualInput
+		}
+	case events.MouseMove:
+	case events.Scroll:
+		if math.IsNaN(float64(input.Delta.X)) || math.IsNaN(float64(input.Delta.Y)) || math.IsInf(float64(input.Delta.X), 0) || math.IsInf(float64(input.Delta.Y), 0) || math.Abs(float64(input.Delta.X)) > 1e6 || math.Abs(float64(input.Delta.Y)) > 1e6 {
+			return ErrManualInput
+		}
+	default:
+		return ErrManualInput
+	}
+	source := m.window.SystemWindow.Events()
+	source.Deque.Mu.Lock()
+	queued := len(source.Deque.Front) + len(source.Deque.Back)
+	source.Deque.Mu.Unlock()
+	if queued > m.config.EventCapacity-units {
+		return ErrManualCapacity
+	}
+	switch input.Type {
+	case events.KeyDown, events.KeyUp, events.KeyChord:
+		source.Key(input.Type, input.Rune, input.Code, input.Modifiers)
+	case events.MouseDown, events.MouseUp:
+		source.MouseButton(input.Type, input.Button, input.Position, input.Modifiers)
+	case events.MouseMove:
+		source.MouseMove(input.Position)
+	case events.Scroll:
+		source.Scroll(input.Position, input.Delta)
+	}
+	return nil
+}
+
+func (m *ManualWindow) stepOwned() (result ManualStepResult, err error) {
+	completed := false
+	defer func() {
+		if !completed {
+			err = &ManualCallbackError{Value: recover()}
+			m.fail(err)
+		}
+	}()
+	w := m.window
+	w.SystemWindow.(manualSystemWindow).FlushReadyPaint()
+	event, ok := w.SystemWindow.Events().Deque.PollEvent()
+	if !ok {
+		completed = true
+		return result, nil
+	}
+	result.Events = 1
+	result.LastType = event.Type()
+	if w.SystemWindow.IsClosed() {
+		closing, ok := event.(*events.WindowEvent)
+		if !ok || closing.Action != events.WinClose {
+			completed = true
+			return result, nil
+		}
+	}
+	w.handleEvent(event)
+	result.LastHandled = event.IsHandled()
+	if event.Type() == events.WindowPaint {
+		m.frames++
+		result.Frames = 1
+	}
+	if w.flags.HasFlag(winStopEventLoop) {
+		m.retireOwned()
+	}
+	m.mu.Lock()
+	err = m.failure
+	m.mu.Unlock()
+	completed = true
+	return result, err
+}
+func (m *ManualWindow) Step(ctx context.Context, maximum int) (ManualStepResult, error) {
+	if maximum <= 0 {
+		return ManualStepResult{}, ErrManualBudget
+	}
+	if err := m.enter(ctx, false); err != nil {
+		return ManualStepResult{}, err
+	}
+	defer m.leave()
+	var result ManualStepResult
+	for range maximum {
+		if err := ctx.Err(); err != nil {
+			return result, err
+		}
+		step, err := m.stepOwned()
+		result.Events += step.Events
+		result.Frames += step.Frames
+		if step.Events > 0 {
+			result.LastType, result.LastHandled = step.LastType, step.LastHandled
+		}
+		if err != nil {
+			return result, err
+		}
+		if step.Events == 0 || m.window == nil {
+			return result, nil
+		}
+	}
+	return result, nil
+}
+func (m *ManualWindow) Frame(ctx context.Context) (ManualStepResult, error) {
+	if err := m.enter(ctx, false); err != nil {
+		return ManualStepResult{}, err
+	}
+	defer m.leave()
+	if m.window.SystemWindow.IsClosed() {
+		return ManualStepResult{}, ErrManualClosed
+	}
+	// The normal queue prioritizes WindowPaint over back input. Use that same
+	// route rather than calling a widget render method or draining owner posts.
+	m.window.SystemWindow.(interface{ RequestPaint() }).RequestPaint()
+	return m.stepOwned()
+}
+func (m *ManualWindow) Image(ctx context.Context) (*image.RGBA, error) {
+	if err := m.enter(ctx, false); err != nil {
+		return nil, err
+	}
+	defer m.leave()
+	if m.frames == 0 {
+		return nil, ErrManualNoFrame
+	}
+	drawer, ok := m.window.SystemWindow.Composer().(*composer.ComposerDrawer)
+	if !ok {
+		return nil, ErrManualUnsupported
+	}
+	imager, ok := drawer.Drawer.(getImager)
+	if !ok {
+		return nil, ErrManualUnsupported
+	}
+	source := imager.GetImage()
+	if source == nil {
+		return nil, ErrManualNoFrame
+	}
+	return &image.RGBA{Pix: slices.Clone(source.Pix), Stride: source.Stride, Rect: source.Rect}, nil
+}
+func (m *ManualWindow) retireOwned() {
+	w := m.window
+	if w == nil {
+		return
+	}
+	m.cancel()
+	m.stopTimers()
+	defer func() {
+		q := &w.SystemWindow.Events().Deque
+		q.Mu.Lock()
+		q.Front = nil
+		q.Back = nil
+		q.Mu.Unlock()
+		m.mu.Lock()
+		clear(m.timers)
+		m.mu.Unlock()
+		m.window = nil
+	}()
+	rc := w.renderContext()
+	rc.Lock()
+	defer rc.Unlock()
+	w.mains.deleteAll()
+}
+
+// Close force-retires an owned manual window even after a callback failure or
+// canceled window lifetime. It creates no consumer goroutine or native loop.
+func (m *ManualWindow) Close(ctx context.Context) (err error) {
+	if m == nil {
+		return ErrManualConfig
+	}
+	if err := m.enter(ctx, true); err != nil {
+		return err
+	}
+	defer m.leave()
+	if m.window == nil {
+		return nil
+	}
+	completed := false
+	defer func() {
+		if !completed {
+			err = &ManualCallbackError{Value: recover()}
+			m.fail(err)
+			if m.window != nil {
+				m.window.closed()
+				m.retireOwned()
+			}
+		}
+	}()
+	m.window.SystemWindow.Close()
+	// Dispatch actual WinClose for registry/current-window behavior, then perform
+	// the eventLoop's terminal scene/resource action exactly once.
+	for m.window != nil {
+		step, err := m.stepOwned()
+		if err != nil && m.window != nil {
+			m.window.closed()
+			m.retireOwned()
+			completed = true
+			return err
+		}
+		if step.Events == 0 && m.window != nil {
+			m.window.closed()
+			m.retireOwned()
+		}
+	}
+	completed = true
+	return nil
+}
+func (w *renderWindow) now() time.Time {
+	if w.manual != nil {
+		return w.manual.config.Now()
+	}
+	return time.Now()
+}
+func (sc *Scene) Now() time.Time {
+	if sc != nil {
+		if rc := sc.renderContext(); rc != nil && rc.manual != nil {
+			return rc.manual.config.Now()
+		}
+	}
+	return time.Now()
+}
+func (sc *Scene) allowWallTimer(name string) bool {
+	if sc != nil {
+		if rc := sc.renderContext(); rc != nil && rc.manual != nil {
+			rc.manual.fail(fmt.Errorf("%w: %s", ErrManualTimerUnsupported, name))
+			return false
+		}
+	}
+	return true
+}
+
+// Newly generated scene events use the scene's clock; events cloned from an
+// admitted source retain that original timestamp and origin by design.
+func (sc *Scene) stampManualEvent(e events.Event) {
+	if sc != nil {
+		if rc := sc.renderContext(); rc != nil && rc.manual != nil {
+			e.AsBase().GenTime.SetTime(rc.manual.config.Now())
+		}
+	}
+}
+
+func manualNil(value any) bool {
+	if value == nil {
+		return true
+	}
+	v := reflect.ValueOf(value)
+	switch v.Kind() {
+	case reflect.Pointer, reflect.Func, reflect.Chan, reflect.Interface, reflect.Map, reflect.Slice:
+		return v.IsNil()
+	}
+	return false
+}

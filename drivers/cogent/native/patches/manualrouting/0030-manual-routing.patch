+type fixtureClock struct {
+	mu     sync.Mutex
+	now    time.Time
+	timers []*fixtureTimer
+	refuse error
+}
+type fixtureTimer struct {
+	clock    *fixtureClock
+	due      time.Time
+	callback func()
+	stopped  bool
+}
+
+func (t *fixtureTimer) Stop() bool {
+	t.clock.mu.Lock()
+	defer t.clock.mu.Unlock()
+	was := !t.stopped
+	t.stopped = true
+	return was
+}
+func (c *fixtureClock) Now() time.Time { c.mu.Lock(); defer c.mu.Unlock(); return c.now }
+func (c *fixtureClock) After(ctx context.Context, d time.Duration, f func()) (ManualTimer, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if c.refuse != nil {
+		return nil, c.refuse
+	}
+	timer := &fixtureTimer{clock: c, due: c.now.Add(d), callback: f}
+	c.timers = append(c.timers, timer)
+	return timer, nil
+}
+func (c *fixtureClock) Advance(d time.Duration) {
+	c.mu.Lock()
+	c.now = c.now.Add(d)
+	var callbacks []func()
+	for _, t := range c.timers {
+		if !t.stopped && !t.due.After(c.now) {
+			t.stopped = true
+			callbacks = append(callbacks, t.callback)
+		}
+	}
+	c.mu.Unlock()
+	for _, callback := range callbacks {
+		callback()
+	}
+}

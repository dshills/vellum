@@ -0,0 +1,86 @@
+package events
+
+import (
+	"image"
+	"testing"
+	"time"
+
+	"cogentcore.org/core/events/key"
+)
+
+func sourceClockTake(t *testing.T, source *Source) Event {
+	t.Helper()
+	event, ok := source.Deque.PollEvent()
+	if !ok {
+		t.Fatal("missing originating event")
+	}
+	return event
+}
+
+func TestVellumSourceClockKeyAndDerivedChord(t *testing.T) {
+	now := time.Unix(1700000000, 12)
+	source := Source{Now: func() time.Time { return now }}
+	var mods key.Modifiers
+	mods.SetFlag(true, key.Control)
+	source.Key(KeyDown, 'a', key.CodeA, mods)
+	for _, typ := range []Types{KeyDown, KeyChord} {
+		event := sourceClockTake(t, &source)
+		if event.Type() != typ || !event.Time().Equal(now) {
+			t.Fatal("event type/time", event.Type(), event.Time(), typ, now)
+		}
+	}
+	if _, ok := source.Deque.PollEvent(); ok {
+		t.Fatal("unexpected derived event")
+	}
+	if !source.Now().Equal(now) {
+		t.Fatal("source advanced time")
+	}
+}
+
+func TestVellumSourceClockDragCompressionRetainsVirtualOrigins(t *testing.T) {
+	anchor := time.Unix(1700000000, 0)
+	now := anchor
+	source := Source{Now: func() time.Time { return now }}
+	source.MouseButton(MouseDown, Left, image.Pt(1, 2), 0)
+	now = anchor.Add(10 * time.Millisecond)
+	source.MouseMove(image.Pt(2, 3))
+	now = anchor.Add(20 * time.Millisecond)
+	source.MouseMove(image.Pt(3, 4))
+	down := sourceClockTake(t, &source)
+	drag := sourceClockTake(t, &source)
+	if !down.Time().Equal(anchor) || drag.Type() != MouseDrag || !drag.Time().Equal(now) || !drag.StartTime().Equal(anchor) || !drag.PrevTime().Equal(anchor) || drag.SinceStart() != 20*time.Millisecond || drag.SincePrev() != 20*time.Millisecond {
+		t.Fatal("derived compressed drag lost virtual timing", down, drag, drag.StartTime(), drag.PrevTime())
+	}
+	if _, ok := source.Deque.PollEvent(); ok {
+		t.Fatal("ordinary drag compression changed")
+	}
+}
+
+func TestVellumSourceClockWindowAndTouch(t *testing.T) {
+	now := time.Unix(1700000000, 0)
+	source := Source{Now: func() time.Time { return now }}
+	source.Window(WinFocus)
+	source.WindowResize()
+	for range 2 {
+		if event := sourceClockTake(t, &source); !event.Time().Equal(now) {
+			t.Fatal("window timestamp", event)
+		}
+	}
+	source.Touch(TouchStart, 1, image.Pt(3, 4))
+	for _, typ := range []Types{TouchStart, MouseDown} {
+		if event := sourceClockTake(t, &source); event.Type() != typ || !event.Time().Equal(now) {
+			t.Fatal("touch derivation", event)
+		}
+	}
+}
+
+func TestVellumSourceClockNilRetainsProductionTime(t *testing.T) {
+	before := time.Now()
+	source := Source{}
+	source.Custom("production")
+	after := time.Now()
+	event := sourceClockTake(t, &source)
+	if event.Time().Before(before) || event.Time().After(after) {
+		t.Fatal("nil clock changed wall timestamp", event.Time(), before, after)
+	}
+}

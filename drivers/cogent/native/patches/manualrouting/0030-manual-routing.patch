+type panicManualComposer struct {
+	composer.Composer
+	start  bool
+	called bool
+}
+
+func (c *panicManualComposer) Start() {
+	if c.start {
+		c.called = true
+		panic(maliciousPanic{})
+	}
+	c.Composer.Start()
+}
+func (c *panicManualComposer) Compose() { c.called = true; panic(maliciousPanic{}) }
+
+type panicManualWindow struct {
+	system.Window
+	fault composer.Composer
+}
+
+func (w *panicManualWindow) Composer() composer.Composer { return w.fault }
+func (w *panicManualWindow) ManualExecution() bool {
+	return w.Window.(manualSystemWindow).ManualExecution()

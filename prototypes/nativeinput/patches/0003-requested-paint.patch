+// Experimental opt-in invalidation seam for the Vellum trial.
+package core
+
+import "time"
+
+type requestedPainter interface {
+	RequestPaint()
+	RequestPaintAfter(time.Duration)
+	IsOnDemand() bool
+}
+
+func (sc *Scene) requestPaint() {
+	if rw := sc.RenderWindow(); rw != nil && rw.SystemWindow != nil {
+		if painter, ok := rw.SystemWindow.(requestedPainter); ok {
+			painter.RequestPaint()
+		}
+	}
+}
+func (w *renderWindow) requestPaintAfter(delay time.Duration) {
+	if painter, ok := w.SystemWindow.(requestedPainter); ok {
+		painter.RequestPaintAfter(delay)
+	}
+}
+func (w *renderWindow) onDemand() bool {
+	painter, ok := w.SystemWindow.(requestedPainter)
+	return ok && painter.IsOnDemand()
+}

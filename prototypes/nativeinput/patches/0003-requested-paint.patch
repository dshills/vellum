@@ -0,0 +1,43 @@
+package base
+
+import (
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestVellumPaintRequests(t *testing.T) {
+	p := NewPaintRequests()
+	p.Request()
+	if len(p.Wake) != 0 {
+		t.Fatal("default mode changed")
+	}
+	p.SetDemand(true)
+	<-p.Wake
+	var group sync.WaitGroup
+	for i := 0; i < 1000; i++ {
+		group.Add(1)
+		go func() { defer group.Done(); p.Request() }()
+	}
+	group.Wait()
+	if len(p.Wake) != 1 {
+		t.Fatal("paint invalidations did not coalesce")
+	}
+	<-p.Wake
+	p.After(time.Hour)
+	first := p.deadline
+	p.After(2 * time.Hour)
+	if p.deadline != first {
+		t.Fatal("later deadline postponed frame")
+	}
+	p.After(30 * time.Minute)
+	if !p.deadline.Before(first) {
+		t.Fatal("earlier deadline ignored")
+	}
+	p.Close()
+	p.Request()
+	p.After(0)
+	if p.timer != nil || len(p.Wake) != 0 {
+		t.Fatal("closed scheduler retained work")
+	}
+}

+// HasActive reports whether any sprite needs its existing update deadline.
+func (ss *Sprites) HasActive() bool {
+	ss.Lock()
+	defer ss.Unlock()
+	active := false
+	ss.Do(func(sl *SpriteList) {
+		for _, sp := range sl.Values {
+			if sp.Active {
+				active = true
+			}
+		}
+	})
+	return active
+}

+// Experimental opt-in paint requests for Vellum's scheduling trial.
+package base
+
+import (
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+// PaintRequests coalesces paint invalidations, not input or command events.
+type PaintRequests struct {
+	Wake       chan struct{}
+	Demand     atomic.Bool
+	Closed     atomic.Bool
+	Wakes      atomic.Uint64
+	mu         sync.Mutex
+	timer      *time.Timer
+	deadline   time.Time
+	generation uint64
+}
+
+func NewPaintRequests() *PaintRequests { return &PaintRequests{Wake: make(chan struct{}, 1)} }
+func (p *PaintRequests) signal() {
+	if p.Closed.Load() {
+		return
+	}
+	select {
+	case p.Wake <- struct{}{}:
+	default:
+	}
+}
+func (p *PaintRequests) SetDemand(on bool) { p.Demand.Store(on); p.signal() }
+func (p *PaintRequests) Request() {
+	if p.Demand.Load() {
+		p.signal()
+	}
+}
+
+// After keeps the earliest outstanding deadline. Close invalidates callbacks.
+func (p *PaintRequests) After(delay time.Duration) {
+	if !p.Demand.Load() || p.Closed.Load() {
+		return
+	}
+	if delay <= 0 {
+		p.Request()
+		return
+	}
+	deadline := time.Now().Add(delay)
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.Closed.Load() || p.timer != nil && !deadline.Before(p.deadline) {
+		return
+	}
+	if p.timer != nil {
+		p.timer.Stop()
+	}
+	p.generation++
+	generation := p.generation
+	p.deadline = deadline
+	p.timer = time.AfterFunc(delay, func() {
+		p.mu.Lock()
+		if p.Closed.Load() || generation != p.generation {
+			p.mu.Unlock()
+			return
+		}
+		p.timer = nil
+		p.mu.Unlock()
+		p.Request()
+	})
+}
+func (p *PaintRequests) Close() {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	p.Closed.Store(true)
+	p.generation++
+	if p.timer != nil {
+		p.timer.Stop()
+		p.timer = nil
+	}
+}

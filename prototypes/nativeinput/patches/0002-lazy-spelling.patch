+package textcore
+
+import (
+	"cogentcore.org/core/core"
+	"cogentcore.org/core/text/spell"
+	"testing"
+)
+
+func TestVellumLazySpell(t *testing.T) {
+	previous := core.SystemSettings.Editor.SpellCorrect
+	defer func() { core.SystemSettings.Editor.SpellCorrect = previous }()
+	core.SystemSettings.Editor.SpellCorrect = false
+	ed := NewEditor()
+	ed.Lines.SetText([]byte("hello world"))
+	if ed.spell != nil || spell.Spell != nil {
+		t.Fatal("constructor initialized spelling")
+	}
+	if ed.isSpellEnabled(ed.CursorPos) || spell.Spell != nil {
+		t.Fatal("disabled spelling initialized dictionary")
+	}
+	ed.SpellCheckLineErrors(0)
+	if ed.spell == nil || spell.Spell == nil {
+		t.Fatal("explicit spelling did not initialize")
+	}
+	suggestions, known := spell.Spell.CheckWord("hello")
+	if !known {
+		t.Fatalf("dictionary lost ordinary word: %v", suggestions)
+	}
+}

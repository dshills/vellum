+package core
+
+import "testing"
+
+func TestVellumCompositionCommitUndoCancel(t *testing.T) {
+	tf := &TextField{text: "A👩Z", editText: []rune("A👩Z"), cursorPos: 1}
+	if !tf.ApplyNativeEdit("Aに👩Z", 2, 2, 1, 2, "mark") || !tf.ApplyNativeEdit("A日本👩Z", 1, 3, 1, 3, "mark") {
+		t.Fatal("mark rejected")
+	}
+	if len(tf.undos.stack) != 0 || tf.text != "A👩Z" {
+		t.Fatal("preedit became committed undo state")
+	}
+	if !tf.ApplyNativeEdit("A日本👩Z", 3, 3, -1, -1, "insert") || len(tf.undos.stack) != 1 {
+		t.Fatal("composition undo grouping")
+	}
+	tf.undo()
+	if string(tf.editText) != "A👩Z" {
+		t.Fatal("undo did not restore original")
+	}
+	tf.redo()
+	if string(tf.editText) != "A日本👩Z" {
+		t.Fatal("redo")
+	}
+	tf.SetEditingSelection(1, 3)
+	original := tf.EditingState()
+	undoCount := len(tf.undos.stack)
+	if !tf.ApplyNativeEdit("A取消👩Z", 3, 3, 1, 3, "mark") || !tf.ApplyNativeEdit("A日本👩Z", 1, 3, -1, -1, "cancel") {
+		t.Fatal("cancel rejected")
+	}
+	after := tf.EditingState()
+	if after.Text != original.Text || after.Anchor != original.Anchor || after.Focus != original.Focus || len(tf.undos.stack) != undoCount {
+		t.Fatal("cancel did not restore selection/history")
+	}
+}
+func TestVellumCompositionValidationAndFocusCommit(t *testing.T) {
+	tf := &TextField{text: "AB", editText: []rune("AB"), cursorPos: 1}
+	before := tf.EditingState()
+	if tf.ApplyNativeEdit("AにB", 9, 9, 1, 2, "mark") || tf.ApplyNativeEdit("A\x00B", 1, 1, -1, -1, "insert") || tf.ApplyNativeEdit("AB", 1, 1, -1, -1, "unknown") {
+		t.Fatal("invalid native state")
+	}
+	if tf.EditingState() != before {
+		t.Fatal("invalid update mutated state")
+	}
+	if !tf.ApplyNativeEdit("AéB", 2, 2, 1, 3, "mark") {
+		t.Fatal("scalar preedit selection")
+	}
+	tf.editDone()
+	if tf.text != "AéB" || tf.nativeComposition != nil || len(tf.undos.stack) != 1 {
+		t.Fatal("focus/commit did not finish composition")
+	}
+	tf.undo()
+	if string(tf.editText) != "AB" {
+		t.Fatal("focus commit undo")
+	}
+}
+
+func TestVellumNativeCommitBoundaryAndReplacement(t *testing.T) {
+	tf := &TextField{text: "B", editText: []rune("B")}
+	if !tf.ApplyNativeEdit("éB", 1, 1, 0, 2, "mark") {
+		t.Fatal("scalar preedit")
+	}
+	if !tf.ApplyNativeEdit("éB", 1, 1, -1, -1, "insert") {
+		t.Fatal("commit")
+	}
+	if state := tf.EditingState(); state.Cursor != 2 {
+		t.Fatalf("commit left interior-grapheme caret %+v", state)
+	}
+	if !tf.ApplyNativeEdit("éXB", 3, 3, 2, 3, "mark") {
+		t.Fatal("second composition")
+	}
+	tf.SetText("B")
+	if tf.nativeComposition != nil || string(tf.editText) != "B" {
+		t.Fatal("explicit value replacement retained preedit")
+	}
+}
+
+func TestVellumCompositionCommitsIdenticalPreeditValue(t *testing.T) {
+	for _, phase := range []string{"insert", "unmark"} {
+		t.Run(phase, func(t *testing.T) {
+			tf := &TextField{text: "AB", editText: []rune("AB"), cursorPos: 1}
+			if !tf.ApplyNativeEdit("A日本B", 3, 3, 1, 3, "mark") || !tf.ApplyNativeEdit("A日本B", 3, 3, -1, -1, phase) {
+				t.Fatal("update rejected")
+			}
+			if !tf.edited || len(tf.undos.stack) != 1 || tf.Text() != "A日本B" {
+				t.Fatal("identical final/preedit text did not reach committed value")
+			}
+		})
+	}
+}

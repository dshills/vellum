+// Experimental single-field native composition seam; UI/render thread only.
+package core
+
+import (
+	"cogentcore.org/core/text/textpos"
+	"image"
+	"strings"
+	"time"
+	"unicode/utf8"
+)
+
+type textFieldNativeComposition struct {
+	before     TextFieldEditingState
+	edited     bool
+	start, end int
+}
+
+// SetNativeEditingListener receives owned snapshots after field layout/rendering.
+// The callback must enqueue geometry; it must not reenter widget rendering.
+func (tf *TextField) SetNativeEditingListener(listener func(TextFieldEditingState)) {
+	tf.nativeListener = listener
+}
+func (tf *TextField) NativeCompositionRange() (start, end int, active bool) {
+	if tf.nativeComposition == nil {
+		return -1, -1, false
+	}
+	return tf.nativeComposition.start, tf.nativeComposition.end, true
+}
+func (tf *TextField) nativeUndo(before TextFieldEditingState) {
+	if tf.undos.pos < len(tf.undos.stack) {
+		tf.undos.stack = tf.undos.stack[:tf.undos.pos+1]
+	}
+	tf.undos.lastSave = time.Time{}
+	tf.undos.saveUndo([]rune(before.Text), before.Cursor)
+	tf.undos.lastSave = time.Time{}
+}
+func (tf *TextField) commitNativeComposition() {
+	if tf.nativeComposition == nil {
+		return
+	}
+	before := tf.nativeComposition.before
+	tf.nativeComposition = nil
+	if before.Text != string(tf.editText) {
+		tf.nativeUndo(before)
+		tf.edited = true
+	}
+}
+
+// ApplyNativeEdit applies an authoritative scalar-aligned snapshot from a native
+// text client. Only preedit permits selection inside graphemes. Multiple marked
+// updates form one undo transaction; cancellation restores the original state.
+func (tf *TextField) ApplyNativeEdit(text string, anchor, focus, start, end int, phase string) bool {
+	if tf.IsReadOnly() || !utf8.ValidString(text) || strings.ContainsRune(text, 0) {
+		return false
+	}
+	runes := []rune(text)
+	n := len(runes)
+	if anchor < 0 || focus < 0 || anchor > n || focus > n {
+		return false
+	}
+	switch phase {
+	case "mark", "insert", "unmark", "cancel":
+	default:
+		return false
+	}
+	if phase == "mark" {
+		if start < 0 || end < start || end > n || anchor < start || anchor > end || focus < start || focus > end {
+			return false
+		}
+		if tf.nativeComposition == nil {
+			tf.nativeComposition = &textFieldNativeComposition{before: tf.EditingState(), edited: tf.edited}
+		}
+		tf.nativeComposition.start, tf.nativeComposition.end = start, end
+	} else if start != -1 || end != -1 {
+		return false
+	}
+	if phase == "cancel" {
+		if tf.nativeComposition == nil {
+			return false
+		}
+		before := tf.nativeComposition
+		tf.nativeComposition = nil
+		text = before.before.Text
+		runes = []rune(text)
+		anchor, focus = before.before.Anchor, before.before.Focus
+		tf.edited = before.edited
+	} else if phase != "mark" {
+		if tf.nativeComposition != nil {
+			before := tf.nativeComposition.before
+			tf.nativeComposition = nil
+			if before.Text != text {
+				tf.nativeUndo(before)
+				tf.edited = true
+			}
+		} else if phase == "insert" && string(tf.editText) != text {
+			tf.nativeUndo(tf.EditingState())
+		}
+		tf.edited = tf.edited || string(tf.editText) != text
+	}
+	if phase != "mark" {
+		if anchor == focus {
+			anchor = textpos.GraphemeAtOrAfter(runes, anchor)
+			focus = anchor
+		} else {
+			lo := textpos.GraphemeAtOrBefore(runes, min(anchor, focus))
+			hi := textpos.GraphemeAtOrAfter(runes, max(anchor, focus))
+			if anchor < focus {
+				anchor, focus = lo, hi
+			} else {
+				anchor, focus = hi, lo
+			}
+		}
+	}
+	tf.editText = runes
+	tf.cursorPos = focus
+	tf.selectInit = anchor
+	tf.selectRange = textpos.Range{Start: min(anchor, focus), End: max(anchor, focus)}
+	tf.selectMode, tf.selectModeShift = false, false
+	tf.renderVisible = nil
+	tf.updateLinePos()
+	tf.NeedsRender()
+	return true
+}
+func (tf *TextField) renderNativeComposition() {
+	c := tf.nativeComposition
+	if c == nil || c.start == c.end || tf.renderVisible == nil {
+		return
+	}
+	start, end := max(c.start, tf.dispRange.Start), min(c.end, tf.dispRange.End)
+	if start >= end {
+		return
+	}
+	a, b := tf.charRenderPos(start), tf.charRenderPos(end)
+	// This seam is exercised only with wrapping disabled and logical LTR input.
+	pc := tf.Scene.Painter
+	fill, stroke, width := pc.Fill.Color, pc.Stroke.Color, pc.Stroke.Width
+	pc.Fill.Color = nil
+	pc.Stroke.Color = tf.CursorColor
+	pc.Stroke.Width.Dot(1)
+	y := a.Y + tf.lineHeight - 1
+	pc.Line(a.X, y, b.X, y)
+	pc.Draw()
+	pc.Fill.Color, pc.Stroke.Color, pc.Stroke.Width = fill, stroke, width
+}
+
+// NativeCaretBounds represents only the current caret, in physical scene pixels.
+func (tf *TextField) NativeCaretBounds() image.Rectangle {
+	caret := tf.EditingState().Caret
+	if caret.Empty() || tf.Scene == nil {
+		return image.Rectangle{}
+	}
+	visible := tf.Geom.ContentBBox.Add(tf.Scene.SceneGeom.Pos)
+	if visible.Empty() {
+		return image.Rectangle{}
+	}
+	// Keep an insertion anchor inside the visible field, including horizontal scroll.
+	height := min(caret.Dy(), visible.Dy())
+	x := max(visible.Min.X, min(caret.Min.X, visible.Max.X-1))
+	y := max(visible.Min.Y, min(caret.Min.Y, visible.Max.Y-height))
+	return image.Rect(x, y, x+1, y+height)
+}
+
+func (tf *TextField) notifyNativeEditing() {
+	if tf.nativeListener == nil {
+		return
+	}
+	state := tf.EditingState()
+	state.Caret = tf.NativeCaretBounds()
+	if state == tf.nativeLastState {
+		return
+	}
+	tf.nativeLastState = state
+	tf.nativeListener(state)
+}

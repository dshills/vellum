+// patchFromExact applies only the supplied line operations to a full line snapshot,
+// then records one grouped replacement. Legacy line-region edits cannot represent
+// deleting/inserting a final empty line. The full replacement trades incremental
+// formatting/selection preservation for exact text; legacy buffers keep their path.
+func (ls *Lines) patchFromExact(ob *Lines, diffs Diffs) bool {
+	if ob == ls {
+		return false
+	}
+	current := ls.strings(false)
+	before := strings.Join(current, "\n")
+	ob.Lock()
+	other := ob.strings(false)
+	ob.Unlock()
+	for i := len(diffs) - 1; i >= 0; i-- {
+		d := diffs[i]
+		var replacement []string
+		switch d.Tag {
+		case 'r', 'i':
+			replacement = other[d.J1:d.J2]
+		case 'd':
+		default:
+			continue
+		}
+		next := make([]string, 0, len(current)-(d.I2-d.I1)+len(replacement))
+		next = append(next, current[:d.I1]...)
+		next = append(next, replacement...)
+		next = append(next, current[d.I2:]...)
+		current = next
+	}
+	after := strings.Join(current, "\n")
+	if before == after {
+		return false
+	}
+	ls.undos.NewGroup()
+	ls.deleteText(textpos.Pos{}, ls.endPos())
+	if after != "" {
+		ls.insertText(textpos.Pos{}, []rune(after))
+	}
+	ls.undos.NewGroup()
+	return true
+}

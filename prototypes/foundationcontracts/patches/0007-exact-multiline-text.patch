+package textcore
+
+import (
+	"cogentcore.org/core/text/lines"
+	"testing"
+)
+
+func TestContractsExactEditorDeleteUndo(t *testing.T) {
+	ed := NewEditor()
+	original := ed.Lines
+	ls := lines.NewLinesExact().SetString("A\n👩‍💻\n")
+	ls.Autosave = false
+	ls.Settings.EmacsUndo = false
+	ed.SetLines(ls)
+	original.Close()
+	defer ls.Close()
+	ed.CursorPos = ls.EndPos()
+	ls.NewUndoGroup()
+	ed.cursorBackspace(1)
+	if ls.String() != "A\n👩‍💻" {
+		t.Fatalf("newline deletion %q", ls.String())
+	}
+	ls.NewUndoGroup()
+	ed.cursorBackspace(1)
+	if ls.String() != "A\n" {
+		t.Fatalf("grapheme deletion %q", ls.String())
+	}
+	if len(ls.Undo()) == 0 || ls.String() != "A\n👩‍💻" {
+		t.Fatalf("undo %q", ls.String())
+	}
+	if len(ls.Undo()) == 0 || ls.String() != "A\n👩‍💻\n" {
+		t.Fatalf("newline undo %q", ls.String())
+	}
+}

+func TestContractsExactDiffPatch(t *testing.T) {
+	for _, tc := range [][2]string{{"local", "disk\n\n"}, {"x\n", "x"}, {"x", "x\n"}, {"", "a\n"}, {"a\n\n", ""}} {
+		ls := NewLinesExact().SetString(tc[0])

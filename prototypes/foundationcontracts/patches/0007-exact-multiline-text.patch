+package lines
+
+import (
+	"cogentcore.org/core/text/textpos"
+	"math/rand"
+	"testing"
+)
+
+func referencePos(text []rune, offset int) textpos.Pos {
+	p := textpos.Pos{}
+	for _, r := range text[:offset] {
+		if r == '\n' {
+			p.Line++
+			p.Char = 0
+		} else {
+			p.Char++
+		}
+	}
+	return p
+}
+func TestContractsExactEditsAgainstReference(t *testing.T) {
+	rng := rand.New(rand.NewSource(17))
+	inserts := []string{"\n", "\n\n", "abc", "日本語", "👩‍💻", "é", "\r\n", "אבג"}
+	for range 40 {
+		ref := []rune(inserts[rng.Intn(len(inserts))])
+		ls := NewLinesExact().SetString(string(ref))
+		ls.Autosave = false
+		ls.Settings.EmacsUndo = false
+		for range 20 {
+			before := string(ref)
+			ls.NewUndoGroup()
+			if rng.Intn(2) == 0 || len(ref) == 0 {
+				offset := rng.Intn(len(ref) + 1)
+				txt := []rune(inserts[rng.Intn(len(inserts))])
+				ls.InsertTextBytes(referencePos(ref, offset), []byte(string(txt)))
+				next := append([]rune{}, ref[:offset]...)
+				next = append(next, txt...)
+				ref = append(next, ref[offset:]...)
+			} else {
+				a := rng.Intn(len(ref))
+				b := a + 1 + rng.Intn(len(ref)-a)
+				ls.DeleteText(referencePos(ref, a), referencePos(ref, b))
+				ref = append(append([]rune{}, ref[:a]...), ref[b:]...)
+			}
+			after := string(ref)
+			if ls.String() != after {
+				t.Fatalf("edit got %q want %q", ls.String(), after)
+			}
+			if len(ls.Undo()) == 0 || ls.String() != before {
+				t.Fatalf("undo got %q want %q", ls.String(), before)
+			}
+			if len(ls.Redo()) == 0 || ls.String() != after {
+				t.Fatalf("redo got %q want %q", ls.String(), after)
+			}
+		}
+		ls.Close()
+	}
+}

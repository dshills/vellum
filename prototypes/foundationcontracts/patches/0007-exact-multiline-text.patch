+func TestContractsExactRoundTrip(t *testing.T) {
+	for _, text := range []string{"", "a", "a\n", "a\n\n", "\n", "\n\n", "a\n\nb", "a\r\nb\r\n", "日本語\n👩‍💻", "العربية\nאבג 123", "é\nनमस्ते\n", "\t \n"} {
+		t.Run(text, func(t *testing.T) {
+			ls := NewLinesExact()
+			defer ls.Close()
+			ls.Autosave = false
+			for range 2 {
+				ls.SetText([]byte(text))
+				if got := string(ls.Text()); got != text {
+					t.Fatalf("Text got %q want %q", got, text)
+				}
+				if got := ls.String(); got != text {
+					t.Fatalf("String got %q", got)
+				}
+				if got := ls.NumLines(); got != strings.Count(text, "\n")+1 {
+					t.Fatalf("lines %d", got)
+				}
+			}
+		})
+	}
+	legacy := NewLines().SetString("one\ntwo")
+	defer legacy.Close()
+	if got := string(legacy.Text()); got != "one\ntwo\n\n" {
+		t.Fatalf("legacy changed: %q", got)
+	}
+}
+func TestContractsExactEditUndoRedo(t *testing.T) {
+	ls := NewLinesExact().SetString("A👩‍💻\n")
+	defer ls.Close()
+	ls.Autosave = false
+	ls.Settings.EmacsUndo = false
+	ls.NewUndoGroup()
+	ls.InsertTextBytes(ls.EndPos(), []byte("日本語\n\n"))
+	edited := "A👩‍💻\n日本語\n\n"
+	if got := ls.String(); got != edited {
+		t.Fatalf("insert %q", got)
+	}
+	if len(ls.Undo()) == 0 || ls.String() != "A👩‍💻\n" {
+		t.Fatalf("undo %q", ls.String())
+	}
+	if len(ls.Redo()) == 0 || ls.String() != edited {
+		t.Fatalf("redo %q", ls.String())
+	}
+	ls.NewUndoGroup()
+	ls.DeleteText(textpos.Pos{Line: 1}, ls.EndPos())
+	if got := ls.String(); got != "A👩‍💻\n" {
+		t.Fatalf("delete %q", got)
+	}
+	if len(ls.Undo()) == 0 || ls.String() != edited {
+		t.Fatalf("delete undo %q", ls.String())
+	}
+	if len(ls.Redo()) == 0 || ls.String() != "A👩‍💻\n" {
+		t.Fatalf("delete redo %q", ls.String())
+	}
+}
+func TestContractsExactLineAPI(t *testing.T) {
+	ls := NewLinesExact()
+	defer ls.Close()
+	ls.Autosave = false
+	ls.SetTextLines([][]byte{[]byte("x"), {}, {}})
+	if ls.String() != "x\n\n" {
+		t.Fatal(ls.String())
+	}
+	ls.SetTextLines(nil)
+	if ls.String() != "" || ls.NumLines() != 1 {
+		t.Fatal(ls.String(), ls.NumLines())
+	}
+}

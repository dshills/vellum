+func TestContractsExactSelectedDiffAndHistory(t *testing.T) {
+	ls := NewLinesExact().SetString("a\nb\n")
+	ls.Autosave = false
+	ls.Settings.EmacsUndo = false
+	ob := NewLinesExact().SetString("A\nB\n")
+	defer ob.Close()
+	defer ls.Close()
+	changed := ls.patchFrom(ob, Diffs{{Tag: 'r', I1: 0, I2: 1, J1: 0, J2: 1}})
+	if !changed || ls.String() != "A\nb\n" {
+		t.Fatalf("selected diff %q", ls.String())
+	}
+	if len(ls.Undo()) == 0 || ls.String() != "a\nb\n" {
+		t.Fatalf("undo %q", ls.String())
+	}
+	if len(ls.Redo()) == 0 || ls.String() != "A\nb\n" {
+		t.Fatalf("redo %q", ls.String())
+	}
+	ls.patchFrom(ob, Diffs{difflib.OpCode{Tag: 'r', I1: 1, I2: 2, J1: 1, J2: 2}})
+	if ls.String() != "A\nB\n" {
+		t.Fatalf("second selected diff %q", ls.String())
+	}
+}
+
+func TestContractsExactDiffMatrix(t *testing.T) {
+	corpus := []string{"", "x", "x\n", "x\n\n", "\n", "\n\n", "a\nb\n", "a\n\nb", "日本語\n👩‍💻", "a\r\nb\r\n"}
+	for _, before := range corpus {
+		for _, after := range corpus {
+			ls := NewLinesExact().SetString(before)
+			ls.Autosave = false
+			ls.Settings.EmacsUndo = false
+			ob := NewLinesExact().SetString(after)
+			changed := ls.patchFrom(ob, ls.diffs(ob))
+			if ls.String() != after {
+				t.Fatalf("diff %q -> %q got %q", before, after, ls.String())
+			}
+			if changed {
+				if len(ls.Undo()) == 0 || ls.String() != before {
+					t.Fatalf("diff undo %q", ls.String())
+				}
+				if len(ls.Redo()) == 0 || ls.String() != after {
+					t.Fatalf("diff redo %q", ls.String())
+				}
+			}
+			ls.Close()
+			ob.Close()
+		}
+	}

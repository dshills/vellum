+package shapedgt
+
+import (
+	"github.com/go-text/typesetting/shaping"
+	"reflect"
+	"testing"
+)
+
+func TestFoundationGlyphLookupDescendingAndClusterInterior(t *testing.T) {
+	r := &Run{Output: shaping.Output{Glyphs: []shaping.Glyph{{ClusterIndex: 6, RuneCount: 1}, {ClusterIndex: 5, RuneCount: 1}, {ClusterIndex: 4, RuneCount: 1}}}}
+	for i, want := range map[int][]int{4: {2}, 5: {1}, 6: {0}, 3: nil, 7: nil} {
+		if got := r.GlyphsAt(i); !reflect.DeepEqual(got, want) {
+			t.Fatalf("rune %d: %v != %v", i, got, want)
+		}
+	}
+	r = &Run{Output: shaping.Output{Glyphs: []shaping.Glyph{{ClusterIndex: 0, RuneCount: 3}, {ClusterIndex: 3, RuneCount: 1}}}}
+	for _, i := range []int{0, 1, 2} {
+		if got := r.GlyphsAt(i); !reflect.DeepEqual(got, []int{0}) {
+			t.Fatalf("ligature interior %d: %v", i, got)
+		}
+	}
+}

+func nativeEditor(source string) *Editor {
+	ed := NewEditor()
+	original := ed.Lines
+	ls := lines.NewLinesExact().SetString(source)
+	ls.Autosave = false
+	ls.Settings.EmacsUndo = false
+	ed.SetLines(ls)
+	original.Close()
+	return ed

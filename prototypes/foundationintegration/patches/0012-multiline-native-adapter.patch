+func TestVellumEditorNativeCancelRestoresFlagsAndSharedOwnership(t *testing.T) {
+	ed := nativeEditor("A\n")
+	defer ed.Lines.Close()
+	ed.Lines.ClearNotSaved()
+	ed.ApplyNativeEdit("Aに\n", 2, 2, 1, 2, "mark")
+	if !ed.Lines.IsNotSaved() {

+package lines
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestVellumNativeEditorPersistenceSealsComposition(t *testing.T) {
+	ls := NewLinesExact().SetString("A\n")
+	defer ls.Close()
+	owner := ls.NewView(80)
+	filename := filepath.Join(t.TempDir(), "native.txt")
+	if err := ls.SaveFile(filename); err != nil {
+		t.Fatal(err)
+	}
+	// FileInfo uses a fixed timestamp under go test; restore real file stat for
+	// the ordinary external-modification guard exercised by native edits.
+	info, err := os.Stat(filename)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ls.fileInfo.ModTime = info.ModTime()
+	if !ls.ApplyNativeSnapshot(owner, "A\n", "Aに\n", "mark") {
+		t.Fatal("mark")
+	}
+	if err := ls.autoSave(); err != nil {
+		t.Fatal(err)
+	}
+	saved, err := os.ReadFile(ls.AutosaveFilename())
+	if err != nil || string(saved) != "A\n" {
+		t.Fatal("autosave persisted preedit", string(saved), err)
+	}
+	if err := ls.SaveFile(filename); err != nil {
+		t.Fatal(err)
+	}
+	if ls.NativeCompositionActive(owner) || ls.ApplyNativeSnapshot(owner, "Aに\n", "A\n", "cancel") {
+		t.Fatal("save left obsolete cancel baseline")
+	}
+	saved, err = os.ReadFile(filename)
+	if err != nil || string(saved) != "Aに\n" {
+		t.Fatal("save lost committed preedit", string(saved), err)
+	}
+	if len(ls.Undo()) == 0 || ls.String() != "A\n" {
+		t.Fatal("save lost composition undo")
+	}
+}
+
+func TestVellumNativeEditorCloseDiscardsComposition(t *testing.T) {
+	ls := NewLinesExact().SetString("old\n")
+	ls.Autosave = false
+	owner := ls.NewView(80)
+	if !ls.ApplyNativeSnapshot(owner, "old\n", "oldに\n", "mark") {
+		t.Fatal("mark")
+	}
+	ls.Close()
+	if ls.NativeCompositionActive(owner) {
+		t.Fatal("closed owner retained")
+	}
+	ls.SetString("new\n")
+	if len(ls.Undo()) != 0 || ls.String() != "new\n" {
+		t.Fatal("closed baseline resurrected")
+	}
+	ls.Close()
+}

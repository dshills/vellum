@@ -0,0 +1,365 @@
+// Experimental UI-owner native composition and visible rendered geometry.
+package textcore
+
+import (
+	"cogentcore.org/core/core"
+	"cogentcore.org/core/math32"
+	"cogentcore.org/core/text/shaped"
+	"cogentcore.org/core/text/textpos"
+	"image"
+	"slices"
+	"strings"
+	"unicode/utf8"
+)
+
+// EditorEditingState uses document-wide rune offsets; geometry is window pixels.
+type EditorEditingState = core.TextFieldEditingState
+type editorNativeComposition struct {
+	before     EditorEditingState
+	start, end int
+}
+
+func (ed *Base) SetNativeEditingListener(fn func(EditorEditingState)) {
+	ed.nativeListener = fn
+	ed.NeedsRender()
+}
+
+// nativePos resolves a document offset from the cached line-start index.
+func (ed *Base) nativePos(offset int) textpos.Pos {
+	line, exact := slices.BinarySearch(ed.nativeOffsets, offset)
+	if !exact {
+		line--
+	}
+	if line < 0 {
+		return textpos.Pos{}
+	}
+	return textpos.Pos{Line: line, Char: offset - ed.nativeOffsets[line]}
+}
+func (ed *Base) EditingState() EditorEditingState {
+	state := EditorEditingState{VisualLine: -1}
+	if ed.Lines == nil {
+		return state
+	}
+	ed.refreshNativeDocument()
+	state.Text = ed.nativeText
+	state.Cursor = ed.nativeOffset(ed.CursorPos)
+	state.Anchor, state.Focus = state.Cursor, state.Cursor
+	if !ed.SelectRegion.IsNil() {
+		a, b := ed.nativeOffset(ed.SelectRegion.Start), ed.nativeOffset(ed.SelectRegion.End)
+		if state.Cursor == a {
+			state.Anchor, state.Focus = b, a
+		} else {
+			state.Anchor, state.Focus = a, b
+		}
+	}
+	state.VisualLine = ed.Lines.PosToView(ed.viewId, ed.CursorPos).Line
+	state.Caret = ed.NativeCaretBounds()
+	return state
+}
+func (ed *Base) SetEditingSelection(anchor, focus int) bool {
+	if ed.Lines == nil {
+		return false
+	}
+	ed.refreshNativeDocument()
+	bounds := ed.nativeGraphemes
+	if _, ok := slices.BinarySearch(bounds, anchor); !ok {
+		return false
+	}
+	if _, ok := slices.BinarySearch(bounds, focus); !ok {
+		return false
+	}
+	ed.setNativeSelection(anchor, focus)
+	return true
+}
+func (ed *Base) setNativeSelection(anchor, focus int) {
+	ed.refreshNativeDocument()
+	ed.selectStart = ed.nativePos(anchor)
+	ed.CursorPos = ed.nativePos(focus)
+	ed.cursorColumn = ed.CursorPos.Char
+	lo, hi := ed.selectStart, ed.CursorPos
+	if focus < anchor {
+		lo, hi = hi, lo
+	}
+	ed.SelectRegion = textpos.NewRegionPos(lo, hi)
+	ed.selectMode = false
+	ed.isScrolling = false
+	ed.NeedsRender()
+}
+func (ed *Base) NativeCompositionRange() (int, int, bool) {
+	if ed.nativeComposition == nil || ed.Lines == nil || !ed.Lines.NativeCompositionActive(ed.viewId) {
+		ed.nativeComposition = nil
+		return -1, -1, false
+	}
+	return ed.nativeComposition.start, ed.nativeComposition.end, true
+}
+func (ed *Base) ApplyNativeEdit(text string, anchor, focus, start, end int, phase string) bool {
+	if ed.Lines == nil {
+		return false
+	}
+	ed.refreshNativeDocument()
+	return ed.ApplyNativeEditFrom(ed.nativeText, text, anchor, focus, start, end, phase)
+}
+
+// ApplyNativeEditFrom rejects a native shadow that predates an application edit.
+func (ed *Base) ApplyNativeEditFrom(expected, text string, anchor, focus, start, end int, phase string) bool {
+	if ed.Lines == nil || ed.IsReadOnly() || !utf8.ValidString(text) || strings.ContainsRune(text, 0) {
+		return false
+	}
+	rs := []rune(text)
+	n := len(rs)
+	if anchor < 0 || focus < 0 || anchor > n || focus > n {
+		return false
+	}
+	switch phase {
+	case "mark", "insert", "unmark", "cancel":
+	default:
+		return false
+	}
+	if phase == "mark" {
+		if start < 0 || end < start || end > n || anchor < start || anchor > end || focus < start || focus > end {
+			return false
+		}
+	} else if start != -1 || end != -1 {
+		return false
+	}
+	_, _, active := ed.NativeCompositionRange()
+	c := ed.nativeComposition
+	if phase == "cancel" && !active {
+		return false
+	}
+	before := ed.EditingState()
+	if !ed.Lines.ApplyNativeSnapshot(ed.viewId, expected, text, phase) {
+		return false
+	}
+	if phase == "mark" {
+		if c == nil {
+			c = &editorNativeComposition{before: before}
+		}
+		c.start, c.end = start, end
+		ed.nativeComposition = c
+	} else {
+		if phase == "cancel" {
+			ed.refreshNativeDocument()
+			text = ed.nativeText
+			rs = ed.nativeRunes
+			anchor, focus = c.before.Anchor, c.before.Focus
+		}
+		ed.nativeComposition = nil
+		if anchor == focus {
+			anchor = textpos.GraphemeAtOrAfter(rs, anchor)
+			focus = anchor
+		} else {
+			lo, hi := textpos.GraphemeAtOrBefore(rs, min(anchor, focus)), textpos.GraphemeAtOrAfter(rs, max(anchor, focus))
+			if anchor < focus {
+				anchor, focus = lo, hi
+			} else {
+				anchor, focus = hi, lo
+			}
+		}
+	}
+	ed.nativeGeometry = core.TextFieldGeometry{}
+	ed.setNativeSelection(anchor, focus)
+	return true
+}
+func (ed *Base) nativeViewport() math32.Box2 {
+	if ed.Scene == nil {
+		return math32.Box2{}
+	}
+	bb := ed.renderBBox()
+	bb.Min.X += int(ed.LineNumberPixels())
+	bb.Max.X = min(bb.Max.X, int(ed.Geom.Pos.Content.X+ed.visSizeAlloc.X))
+	bb.Max.Y = min(bb.Max.Y, int(ed.Geom.Pos.Content.Y+ed.visSizeAlloc.Y))
+	return math32.B2FromRect(bb.Add(ed.Scene.SceneGeom.Pos))
+}
+func (ed *Base) NativeTextGeometry() core.TextFieldGeometry {
+	out := core.TextFieldGeometry{Viewport: ed.nativeViewport()}
+	ed.refreshNativeDocument()
+	if ed.Lines == nil || ed.nativeLayoutRevision != ed.nativeRevision {
+		return out
+	}
+	out.Cells = slices.Clone(ed.nativeGeometry.Cells)
+	out.Carets = slices.Clone(ed.nativeGeometry.Carets)
+	return out
+}
+func (ed *Base) NativeCaretBounds() image.Rectangle {
+	if ed.Scene == nil || ed.Lines == nil {
+		return image.Rectangle{}
+	}
+	ed.refreshNativeDocument()
+	offset := ed.nativeOffset(ed.CursorPos)
+	line := ed.Lines.PosToView(ed.viewId, ed.CursorPos).Line
+	if ed.nativeLayoutRevision != ed.nativeRevision {
+		return image.Rectangle{}
+	}
+	for _, c := range ed.nativeGeometry.Carets {
+		if c.Rune == offset && c.Line == line {
+			rect := image.Rect(int(c.Pos.X), int(c.Pos.Y), int(c.Pos.X)+1, int(c.Pos.Y+c.Height))
+			return rect.Intersect(ed.nativeViewport().ToRect())
+		}
+	}
+	return image.Rectangle{}
+}
+func (ed *Base) beginNativeGeometry() {
+	ed.nativeGeometry = core.TextFieldGeometry{}
+	if ed.nativeListener == nil || ed.Lines == nil {
+		return
+	}
+	ed.refreshNativeDocument()
+}
+func (ed *Base) captureNativeSpan(ls *shaped.Lines, pos math32.Vector2, source textpos.Pos, line int, tabWidth float32) {
+	if ed.nativeListener == nil || source.Line >= len(ed.nativeOffsets) {
+		return
+	}
+	base := ed.nativeOffsets[source.Line] + source.Char
+	g := ls.InteractionLayout()
+	off := pos.Add(math32.FromPoint(ed.Scene.SceneGeom.Pos))
+	if tabWidth > 0 {
+		g.Cells = []shaped.Cell{{Range: textpos.Range{Start: 0, End: 1}, Rect: math32.B2(0, 0, tabWidth, ed.charSize.Y)}}
+		g.Carets = []shaped.Caret{{Rune: 0, Pos: math32.Vector2{}, Height: ed.charSize.Y}, {Rune: 1, Pos: math32.Vec2(tabWidth, 0), Height: ed.charSize.Y}}
+	}
+	if len(ls.Source.Join()) == 0 && len(g.Carets) == 0 {
+		g.Carets = []shaped.Caret{{Rune: 0, Height: ed.charSize.Y}}
+	}
+	for _, c := range g.Cells {
+		c.Range.Start += base
+		c.Range.End += base
+		a, _ := slices.BinarySearch(ed.nativeGraphemes, c.Range.Start)
+		if a == len(ed.nativeGraphemes) || ed.nativeGraphemes[a] > c.Range.Start {
+			a--
+		}
+		b, _ := slices.BinarySearch(ed.nativeGraphemes, c.Range.End)
+		if a < 0 || b >= len(ed.nativeGraphemes) {
+			continue
+		}
+		c.Range = textpos.Range{Start: ed.nativeGraphemes[a], End: ed.nativeGraphemes[b]}
+		c.Line = line
+		c.Rect = c.Rect.Translate(off)
+		ed.nativeGeometry.Cells = append(ed.nativeGeometry.Cells, c)
+	}
+	for _, c := range g.Carets {
+		c.Rune += base
+		if _, ok := slices.BinarySearch(ed.nativeGraphemes, c.Rune); !ok {
+			continue
+		}
+		c.Line = line
+		c.Pos = c.Pos.Add(off)
+		ed.nativeGeometry.Carets = append(ed.nativeGeometry.Carets, c)
+	}
+}
+func (ed *Base) finishNativeGeometry() {
+	if ed.nativeListener == nil || ed.Lines == nil {
+		return
+	}
+	type key struct {
+		r    textpos.Range
+		line int
+	}
+	indexes := map[key]int{}
+	cells := ed.nativeGeometry.Cells[:0]
+	for _, c := range ed.nativeGeometry.Cells {
+		k := key{c.Range, c.Line}
+		if i, ok := indexes[k]; ok {
+			cells[i].Rect.ExpandByBox(c.Rect)
+		} else {
+			indexes[k] = len(cells)
+			cells = append(cells, c)
+		}
+	}
+	ed.nativeGeometry.Cells = cells
+	// Native geometry has one insertion stop per offset/physical line, matching
+	// InteractionLayout's strong-caret API and Geometry.Validate. At a styled
+	// fragment boundary prefer the downstream rendered fragment. Secondary bidi
+	// affinity is outside this editor adapter's current interaction policy.
+	type caretKey struct{ r, line int }
+	ci := map[caretKey]int{}
+	carets := ed.nativeGeometry.Carets[:0]
+	for _, c := range ed.nativeGeometry.Carets {
+		k := caretKey{c.Rune, c.Line}
+		if i, ok := ci[k]; ok {
+			carets[i] = c
+		} else {
+			ci[k] = len(carets)
+			carets = append(carets, c)
+		}
+	}
+	ed.nativeGeometry.Carets = carets
+	rs := ed.nativeRunes
+	for _, c := range carets {
+		if c.Rune < len(rs) && rs[c.Rune] == '\n' {
+			ed.nativeGeometry.Cells = append(ed.nativeGeometry.Cells, shaped.Cell{Range: textpos.Range{Start: c.Rune, End: c.Rune + 1}, Line: c.Line, Rect: math32.Box2{Min: c.Pos, Max: c.Pos.Add(math32.Vec2(0, c.Height))}})
+		}
+	}
+	ed.nativeLayoutRevision = ed.nativeRevision
+	ed.nativeGeometry.Viewport = ed.nativeViewport()
+	ed.nativeGeneration++
+	if start, end, ok := ed.NativeCompositionRange(); ok {
+		pc := ed.Scene.Painter
+		fill, stroke, width := pc.Fill.Color, pc.Stroke.Color, pc.Stroke.Width
+		pc.Fill.Color = nil
+		pc.Stroke.Color = ed.CursorColor
+		pc.Stroke.Width.Dot(1)
+		scene := math32.FromPoint(ed.Scene.SceneGeom.Pos)
+		for _, c := range cells {
+			if c.Range.Intersect(textpos.Range{Start: start, End: end}).Len() > 0 && c.Rect.IntersectsBox(ed.nativeGeometry.Viewport) {
+				rect := c.Rect.Intersect(ed.nativeGeometry.Viewport)
+				y := rect.Max.Y - scene.Y - 1
+				pc.Line(rect.Min.X-scene.X, y, rect.Max.X-scene.X, y)
+				pc.Draw()
+			}
+		}
+		pc.Fill.Color, pc.Stroke.Color, pc.Stroke.Width = fill, stroke, width
+	}
+}
+func (ed *Base) notifyNativeEditing() {
+	if ed.nativeListener == nil {
+		return
+	}
+	state := ed.EditingState()
+	if state == ed.nativeLastState && ed.nativeGeneration == ed.nativeLastGeneration {
+		return
+	}
+	ed.nativeLastState = state
+	ed.nativeLastGeneration = ed.nativeGeneration
+	ed.nativeListener(state)
+}
+
+func (ed *Base) NativeEditingEnabled() bool {
+	return ed.Lines != nil && !ed.IsReadOnly() && ed.Lines.NativeEditable()
+}
+
+func (ed *Base) refreshNativeDocument() {
+	if ed.Lines == nil {
+		ed.nativeDocument = nil
+		return
+	}
+	text, revision, changed := ed.Lines.NativeTextSnapshot(ed.nativeRevision, ed.nativeDocument == ed.Lines)
+	if !changed {
+		return
+	}
+	ed.nativeDocument = ed.Lines
+	ed.nativeRevision = revision
+	ed.nativeText = text
+	ed.nativeRunes = []rune(text)
+	ed.nativeGraphemes = textpos.GraphemeBounds(ed.nativeRunes)
+	ed.nativeOffsets = []int{0}
+	for i, r := range ed.nativeRunes {
+		if r == '\n' {
+			ed.nativeOffsets = append(ed.nativeOffsets, i+1)
+		}
+	}
+	ed.nativeGeometry = core.TextFieldGeometry{}
+}
+func (ed *Base) nativeOffset(pos textpos.Pos) int {
+	if pos.Line < 0 {
+		return 0
+	}
+	if pos.Line >= len(ed.nativeOffsets) {
+		return len(ed.nativeRunes)
+	}
+	start := ed.nativeOffsets[pos.Line]
+	end := len(ed.nativeRunes)
+	if pos.Line+1 < len(ed.nativeOffsets) {
+		end = ed.nativeOffsets[pos.Line+1] - 1
+	}
+	return start + max(0, min(pos.Char, end-start))
+}

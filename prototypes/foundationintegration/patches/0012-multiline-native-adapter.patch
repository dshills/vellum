+// Experimental exact-buffer composition transactions for native editor clients.
+package lines
+
+import (
+	"cogentcore.org/core/text/runes"
+	"cogentcore.org/core/text/textpos"
+	"strings"
+	"unicode/utf8"
+)
+
+type nativeComposition struct {
+	owner    int
+	before   string
+	changed  bool
+	notSaved bool
+}
+
+// NativeCompositionActive identifies the view owning the current preedit.
+func (ls *Lines) NativeCompositionActive(owner int) bool {
+	ls.Lock()
+	defer ls.Unlock()
+	return ls.nativeComposition != nil && ls.nativeComposition.owner == owner
+}
+
+// ViewSourcePosNoLock maps a rendered fragment while the caller holds Lines.Lock.
+func (ls *Lines) ViewSourcePosNoLock(owner int, pos textpos.Pos) textpos.Pos {
+	vw := ls.view(owner)
+	if vw == nil {
+		return textpos.Pos{}
+	}
+	return ls.posFromView(vw, pos)
+}
+
+func nativePos(rs []rune, offset int) textpos.Pos {
+	p := textpos.Pos{}
+	for _, r := range rs[:offset] {
+		if r == '\n' {
+			p.Line++
+			p.Char = 0
+		} else {
+			p.Char++
+		}
+	}
+	return p
+}
+func nativeDiff(a, b []rune) (start, ae, be int) {
+	for start < len(a) && start < len(b) && a[start] == b[start] {
+		start++
+	}
+	ae, be = len(a), len(b)
+	for ae > start && be > start && a[ae-1] == b[be-1] {
+		ae--
+		be--
+	}
+	return
+}
+func (ls *Lines) recordNativeUndo(before, after string) {
+	if before == after {
+		return
+	}
+	a, b := []rune(before), []rune(after)
+	start, ae, be := nativeDiff(a, b)
+	pos := nativePos(a, start)
+	deletion := textpos.NewEditFromRunes(a[start:ae])
+	deletion.Delete = true
+	deletion.Region = textpos.NewRegionPos(pos, nativePos(a, ae))
+	insertion := textpos.NewEditFromRunes(b[start:be])
+	insertion.Region = textpos.NewRegionPos(pos, nativePos(b, be))
+	insertion.Region.Time = deletion.Region.Time
+	ls.undos.NewGroup()
+	if ae > start {
+		ls.saveUndo(deletion)
+	}
+	if be > start {
+		ls.saveUndo(insertion)
+	}
+	ls.undos.NewGroup()
+}
+
+// Called with the buffer locked, before any ordinary mutation or undo/redo.
+func (ls *Lines) commitNativeComposition() {
+	if ls.nativeUpdating || ls.nativeComposition == nil {
+		return
+	}
+	c := ls.nativeComposition
+	ls.nativeComposition = nil
+	after := string(ls.bytes(0))
+	if after == c.before {
+		ls.changed = c.changed
+		ls.notSaved = c.notSaved
+	} else {
+		ls.recordNativeUndo(c.before, after)
+	}
+}
+
+// ApplyNativeSnapshot is an atomic compare-and-edit for an exact buffer/view.
+// Preedit changes are visible to all views without creating intermediate undo
+// records. Commit records one net transaction; cancellation restores its baseline.
+// Ordinary buffer mutations seal that transaction before editing, so a subsequent
+// native cancellation cannot erase them. Callers own selection and UI state.
+func (ls *Lines) ApplyNativeSnapshot(owner int, expected, next, phase string) bool {
+	if !utf8.ValidString(next) || strings.ContainsRune(next, 0) || len(next) > 1<<20 {
+		return false
+	}
+	if phase != "mark" && phase != "insert" && phase != "unmark" && phase != "cancel" {
+		return false
+	}
+	ls.Lock()
+	if !ls.exactText || ls.readOnly || ls.view(owner) == nil || string(ls.bytes(0)) != expected {
+		ls.Unlock()
+		return false
+	}
+	if ls.nativeComposition == nil && phase != "cancel" {
+		modified := ls.fileModCheck()
+		if !ls.exactText || ls.readOnly || ls.view(owner) == nil || string(ls.bytes(0)) != expected {
+			ls.Unlock()
+			if modified {
+				ls.sendChange()
+			}
+			return false
+		}
+	}
+	c := ls.nativeComposition
+	if c != nil && c.owner != owner {
+		ls.Unlock()
+		return false
+	}
+	if phase == "cancel" {
+		if c == nil {
+			ls.Unlock()
+			return false
+		}
+		next = c.before
+	}
+	if phase == "mark" && c == nil {
+		c = &nativeComposition{owner: owner, before: expected, changed: ls.changed, notSaved: ls.notSaved}
+		ls.nativeComposition = c
+	}
+	ls.nativeUpdating = true
+	a, b := []rune(expected), []rune(next)
+	start, ae, be := nativeDiff(a, b)
+	pos := nativePos(a, start)
+	if ae > start {
+		ls.deleteTextImpl(pos, nativePos(a, ae))
+	}
+	if be > start {
+		ls.insertTextImpl(pos, runes.Split(b[start:be], []rune("\n")))
+	}
+	ls.nativeUpdating = false
+	if phase == "cancel" {
+		ls.changed = c.changed
+		ls.notSaved = c.notSaved
+		ls.nativeComposition = nil
+	} else if phase != "mark" {
+		baseline := expected
+		if c != nil {
+			baseline = c.before
+		}
+		ls.nativeComposition = nil
+		if c != nil && baseline == next {
+			ls.changed = c.changed
+			ls.notSaved = c.notSaved
+		} else {
+			ls.recordNativeUndo(baseline, next)
+		}
+	}
+	changed := expected != next
+	autoSave := phase != "mark" && phase != "cancel" && ls.Autosave
+	ls.Unlock()
+	if changed {
+		ls.sendInput()
+	}
+	if autoSave {
+		go ls.autoSave()
+	}
+	return true
+}
+
+// NativeEditable reports the buffer policy required by this native seam.
+func (ls *Lines) NativeEditable() bool {
+	ls.Lock()
+	defer ls.Unlock()
+	return ls.exactText && !ls.readOnly
+}
+
+// NativeTextSnapshot avoids encoding unchanged text during UI-only redraws.
+func (ls *Lines) NativeTextSnapshot(known uint64, initialized bool) (text string, revision uint64, changed bool) {
+	ls.Lock()
+	defer ls.Unlock()
+	revision = ls.nativeRevision
+	if !initialized || known != revision {
+		return string(ls.bytes(0)), revision, true
+	}
+	return "", revision, false
+}

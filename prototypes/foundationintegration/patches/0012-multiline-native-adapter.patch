+func TestVellumEditorNativeRenderedGeometry(t *testing.T) {
+	b := core.NewBody()
+	b.Scene.AddChild(b)
+	ed := NewEditor(b)
+	original := ed.Lines
+	ls := lines.NewLinesExact().SetString("abc אבג é 👩‍💻\n\tA\tB\nlong words wrapping beyond the visible viewport\n")
+	ls.Autosave = false
+	ed.SetLines(ls)
+	original.Close()
+	defer ls.Close()
+	ed.Styler(func(s *styles.Style) { s.Min.X.Em(16); s.Max.X.Em(16); s.Min.Y = units.Em(4); s.Max.Y = units.Em(4) })
+	count := 0
+	ed.SetNativeEditingListener(func(EditorEditingState) { count++ })
+	if cache := os.Getenv("VELLUM_FONT_CACHE"); cache != "" {
+		preload := shapedgt.NewShaperWithFonts(fonts.Embedded).(*shapedgt.Shaper)
+		if err := preload.FontMap().UseSystemFonts(cache); err != nil {
+			t.Fatal(err)
+		}
+		if err := b.Scene.MakeTextShaper().(*shapedgt.Shaper).FontMap().UseSystemFonts(cache); err != nil {
+			t.Fatal(err)
+		}
+	}
+	b.Scene.Resize(math32.Geom2DInt{Size: image.Pt(320, 130)})
+	b.Scene.LayoutRenderScene()
+	g := ed.NativeTextGeometry()
+	if len(g.Cells) == 0 || len(g.Carets) == 0 || count == 0 {
+		t.Fatal("render geometry missing")
+	}
+	if g.Viewport.Min.X <= float32(ed.renderBBox().Min.X) {
+		t.Fatal("gutter included")
+	}
+	rs := []rune(ed.EditingState().Text)
+	bounds := textpos.GraphemeBounds(rs)
+	for _, c := range g.Cells {
+		if !containsBoundary(bounds, c.Range.Start) || !containsBoundary(bounds, c.Range.End) {
+			t.Fatal("interior grapheme cell", c)
+		}
+	}
+	seenCarets := map[[2]int]bool{}
+	for _, c := range g.Carets {
+		k := [2]int{c.Rune, c.Line}
+		if seenCarets[k] {
+			t.Fatal("duplicate native strong caret", k)
+		}
+		seenCarets[k] = true
+	}
+	// A tab spans the entire whitespace advance rather than one glyph slot.
+	tab := 14 // locate by source rather than assumptions about UTF-8 byte width
+	for i, r := range rs {
+		if r == '\t' {
+			tab = i
+			break
+		}
+	}
+	found := false
+	for _, c := range g.Cells {
+		if c.Range.Start == tab {
+			found = true
+			if c.Rect.Size().X <= ed.charSize.X {
+				t.Fatal("tab advance lost", c)
+			}
+		}
+	}
+	if !found {
+		t.Fatal("tab fixture not visible")
+	}
+	originalX := g.Cells[0].Rect.Min.X
+	g.Cells[0].Rect.Min.X += 100
+	if ed.NativeTextGeometry().Cells[0].Rect.Min.X != originalX {
+		t.Fatal("snapshot aliases mutable layout")
+	}
+	ed.scrollPos = 1.5
+	ed.isScrolling = true
+	ed.NeedsRender()
+	b.Scene.LayoutRenderScene()
+	g = ed.NativeTextGeometry()
+	if len(g.Cells) == 0 || g.Cells[0].Line == 0 {
+		t.Fatal("scroll did not refresh visible cells")
+	}
+	// Layout records painter actions; explicitly execute them before inspecting
+	// pixels. Renderer.Image alone returns an untouched target.
+	b.Scene.Renderer.Render(b.Scene.Painter.RenderDone())
+	if dir := os.Getenv("VELLUM_EDITOR_EVIDENCE"); dir != "" {
+		f, err := os.Create(dir + "/editor-scroll.png")
+		if err != nil {
+			t.Fatal(err)
+		}
+		err = png.Encode(f, b.Scene.Renderer.Image())
+		f.Close()
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	ls.SetString("changed\n")
+	if len(ed.NativeTextGeometry().Cells) != 0 {
+		t.Fatal("stale geometry published")
+	}
+}
+func containsBoundary(bounds []int, r int) bool {
+	for _, b := range bounds {
+		if b == r {
+			return true
+		}
+	}
+	return false
+}

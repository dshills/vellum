+func TestVellumEditorNativeCompositionUndoCancel(t *testing.T) {
+	original := "A\n👩‍💻\n"
+	ed := nativeEditor(original)
+	defer ed.Lines.Close()
+	if !ed.SetEditingSelection(2, 2) {
+		t.Fatal("selection")
+	}
+	if !ed.ApplyNativeEdit("A\nに👩‍💻\n", 3, 3, 2, 3, "mark") || !ed.ApplyNativeEdit("A\n日本👩‍💻\n", 4, 4, 2, 4, "mark") {
+		t.Fatal("marked edits")
+	}
+	if !ed.ApplyNativeEdit("A\n日本👩‍💻\n", 4, 4, -1, -1, "insert") {
+		t.Fatal("commit")
+	}
+	if len(ed.Lines.Undo()) == 0 || ed.Lines.String() != original {
+		t.Fatal("one composition undo", ed.Lines.String())
+	}
+	if len(ed.Lines.Redo()) == 0 || ed.Lines.String() != "A\n日本👩‍💻\n" {
+		t.Fatal("redo")
+	}
+	state := ed.EditingState()
+	ed.SetEditingSelection(4, 2)
+	before := ed.EditingState()
+	ed.ApplyNativeEdit("A\n取消👩‍💻\n", 4, 4, 2, 4, "mark")
+	if !ed.ApplyNativeEdit(before.Text, 2, 2, -1, -1, "cancel") || ed.EditingState().Text != before.Text || ed.EditingState().Anchor != 4 || ed.EditingState().Focus != 2 {
+		t.Fatal("cancel direction", ed.EditingState(), state)
+	}
+	if len(ed.Lines.Undo()) == 0 || ed.Lines.String() != original {
+		t.Fatal("cancel left undo records", ed.Lines.String())
+	}
+}
+func TestVellumEditorNativeExternalEditAndReadonly(t *testing.T) {
+	ed := nativeEditor("A\nB\n")
+	defer ed.Lines.Close()
+	ed.ApplyNativeEdit("Aに\nB\n", 2, 2, 1, 2, "mark")
+	ed.Lines.InsertText(ed.Lines.EndPos(), []rune("X"))
+	if _, _, active := ed.NativeCompositionRange(); active {
+		t.Fatal("external edit did not seal preedit")
+	}
+	current := ed.Lines.String()
+	if ed.ApplyNativeEditFrom("Aに\nB\n", "A\nB\n", 1, 1, -1, -1, "cancel") || ed.Lines.String() != current {
+		t.Fatal("cancel erased shared edit")
+	}
+	if ed.ApplyNativeEditFrom("Aに\nB\n", "stale", 0, 0, -1, -1, "insert") || ed.Lines.String() != current {
+		t.Fatal("stale shadow accepted")
+	}
+	if len(ed.Lines.Undo()) == 0 || ed.Lines.String() != "Aに\nB\n" {
+		t.Fatal("external undo")
+	}
+	if len(ed.Lines.Undo()) == 0 || ed.Lines.String() != "A\nB\n" {
+		t.Fatal("preedit undo")
+	}
+	ed.Lines.SetReadOnly(true)
+	if ed.ApplyNativeEdit("bad", 0, 0, -1, -1, "insert") {
+		t.Fatal("readonly buffer edited")
+	}
+	ed.Lines.SetReadOnly(false)
+	for _, v := range []struct {
+		text       string
+		a, f, s, e int
+		phase      string
+	}{{"a", 2, 2, -1, -1, "insert"}, {"a\x00b", 0, 0, -1, -1, "insert"}, {"a", 0, 0, 1, 2, "mark"}, {"a", 0, 0, -1, -1, "unknown"}} {
+		if ed.ApplyNativeEdit(v.text, v.a, v.f, v.s, v.e, v.phase) {
+			t.Fatal("invalid snapshot accepted", v)
+		}
+	}
+	if ed.Lines.String() != "A\nB\n" {
+		t.Fatal("validation mutated buffer")
+	}
+}

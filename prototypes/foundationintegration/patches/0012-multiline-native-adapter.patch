+	other.SetLines(ed.Lines)
+	original.Close()
+	if other.ApplyNativeEdit("bad", 0, 0, -1, -1, "insert") {
+		t.Fatal("second view stole composition")
+	}
+	ed.Lines.SetReadOnly(true)
+	if ed.NativeEditingEnabled() {
+		t.Fatal("readonly native client remains enabled")
+	}
+	if _, _, active := ed.NativeCompositionRange(); active {
+		t.Fatal("readonly did not seal composition")
+	}
+	ed.Lines.SetReadOnly(false)
+	if len(ed.Lines.Undo()) == 0 || ed.Lines.String() != "A\n" {
+		t.Fatal("readonly transition lost undo")
+	}
+}

+// SPDX-License-Identifier: Unlicense OR BSD-3-Clause
+package font
+
+import (
+	"container/list"
+	"encoding/binary"
+	"fmt"
+	"github.com/go-text/typesetting/font/opentype/tables"
+	"io"
+	"sync"
+	"unsafe"
+)
+
+const glyfRecordLimit = 64 * 1024
+const glyfCacheLimit = 2 * 1024 * 1024
+const glyfCacheEntries = 256
+
+// Static outlines are deferred. Variable gvar fonts retain eager outlines because
+// variation initialization consumes the complete glyph table.
+type lazyGlyf struct {
+	mu      sync.Mutex
+	r       io.ReaderAt
+	offsets []uint32
+	cache   map[gID]*list.Element
+	lru     list.List
+	bytes   int
+}
+type glyfEntry struct {
+	id    gID
+	glyph tables.Glyph
+	bytes int
+}
+
+func newLazyGlyf(r io.ReaderAt, length int64, offsets []uint32) (*lazyGlyf, error) {
+	if len(offsets) < 1 || len(offsets) > 65536 {
+		return nil, fmt.Errorf("invalid glyph count")
+	}
+	for i, v := range offsets {
+		if int64(v) > length || (i > 0 && v < offsets[i-1]) {
+			return nil, fmt.Errorf("invalid glyph offset")
+		}
+	}
+	// Admit the font as a whole. Never silently drop a valid glyph because its
+	// resource requirements exceed this prototype's supported outline policy.
+	var header [10]byte
+	var endpoint [2]byte
+	for i := 0; i+1 < len(offsets); i++ {
+		start, end := offsets[i], offsets[i+1]
+		if start == end {
+			continue
+		}
+		if end-start > glyfRecordLimit {
+			return nil, fmt.Errorf("glyph %d exceeds record limit", i)
+		}
+		if end-start < 10 {
+			return nil, fmt.Errorf("short glyph %d", i)
+		}
+		if _, err := r.ReadAt(header[:], int64(start)); err != nil {
+			return nil, err
+		}
+		contours := int(int16(binary.BigEndian.Uint16(header[:])))
+		if contours >= 0 {
+			if contours > 1024 || uint32(10+2*contours) > end-start {
+				return nil, fmt.Errorf("glyph %d exceeds contour policy or is truncated", i)
+			}
+			if contours > 0 {
+				if _, err := r.ReadAt(endpoint[:], int64(start)+10+int64(2*(contours-1))); err != nil {
+					return nil, err
+				}
+				if binary.BigEndian.Uint16(endpoint[:]) >= 8192 {
+					return nil, fmt.Errorf("glyph %d exceeds point policy", i)
+				}
+			}
+		}
+	}
+	return &lazyGlyf{r: r, offsets: append([]uint32(nil), offsets...), cache: make(map[gID]*list.Element)}, nil
+}
+func (g *lazyGlyf) glyph(id gID) (tables.Glyph, error) {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if int(id) >= len(g.offsets)-1 {
+		return tables.Glyph{}, fmt.Errorf("glyph out of range")
+	}
+	if e := g.cache[id]; e != nil {
+		g.lru.MoveToFront(e)
+		return e.Value.(glyfEntry).glyph, nil
+	}
+	start, end := g.offsets[id], g.offsets[int(id)+1]
+	if start == end {
+		return tables.Glyph{}, nil
+	}
+	if end-start > glyfRecordLimit {
+		return tables.Glyph{}, fmt.Errorf("outline record exceeds budget")
+	}
+	raw := make([]byte, int(end-start))
+	if _, e := g.r.ReadAt(raw, int64(start)); e != nil {
+		return tables.Glyph{}, e
+	}
+	if len(raw) < 10 {
+		return tables.Glyph{}, fmt.Errorf("short glyph")
+	}
+	contours := int(int16(binary.BigEndian.Uint16(raw)))
+	// Bound decompression before ParseGlyph allocates points from contour endpoints.
+	if contours >= 0 {
+		if contours > 1024 || 10+2*contours > len(raw) {
+			return tables.Glyph{}, fmt.Errorf("invalid/oversized contours")
+		}
+		if contours > 0 && binary.BigEndian.Uint16(raw[10+2*(contours-1):]) >= 8192 {
+			return tables.Glyph{}, fmt.Errorf("outline point budget exceeded")
+		}
+	}
+	value, _, e := tables.ParseGlyph(raw)
+	if e != nil {
+		return tables.Glyph{}, e
+	}
+	weight := len(raw) + int(unsafe.Sizeof(value))
+	switch d := value.Data.(type) {
+	case tables.SimpleGlyph:
+		weight += int(unsafe.Sizeof(d)) + cap(d.EndPtsOfContours)*2 + cap(d.Points)*int(unsafe.Sizeof(tables.GlyphContourPoint{}))
+	case tables.CompositeGlyph:
+		weight += int(unsafe.Sizeof(d)) + cap(d.Glyphs)*int(unsafe.Sizeof(tables.CompositeGlyphPart{}))
+	}
+	if weight > glyfCacheLimit {
+		return tables.Glyph{}, fmt.Errorf("decoded outline exceeds cache budget")
+	}
+	for g.bytes+weight > glyfCacheLimit || g.lru.Len() >= glyfCacheEntries {
+		e := g.lru.Back()
+		v := e.Value.(glyfEntry)
+		g.bytes -= v.bytes
+		delete(g.cache, v.id)
+		g.lru.Remove(e)
+	}
+	g.cache[id] = g.lru.PushFront(glyfEntry{id, value, weight})
+	g.bytes += weight
+	return value, nil
+}
+func (f *Font) glyfCount() int {
+	if f.lazyGlyf != nil {
+		return len(f.lazyGlyf.offsets) - 1
+	}
+	return len(f.glyf)
+}
+func (f *Font) glyfGlyph(id gID) (tables.Glyph, bool) {
+	if f.lazyGlyf != nil {
+		g, e := f.lazyGlyf.glyph(id)
+		return g, e == nil
+	}
+	if int(id) >= len(f.glyf) {
+		return tables.Glyph{}, false
+	}
+	return f.glyf[id], true
+}

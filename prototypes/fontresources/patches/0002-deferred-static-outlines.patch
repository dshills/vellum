+package font
+
+import (
+	"bytes"
+	"encoding/binary"
+	ot "github.com/go-text/typesetting/font/opentype"
+	"github.com/go-text/typesetting/font/opentype/tables"
+	"io"
+	"os"
+	"reflect"
+	"testing"
+)
+
+type stableMemory struct{ *bytes.Reader }
+
+func (r stableMemory) StableReaderAt() io.ReaderAt { return r.Reader }
+func TestDeferredGlyfEagerParity(t *testing.T) {
+	for _, path := range []string{"testdata/UbuntuMono-R.ttf", "testdata/Amiri-Regular.ttf", "testdata/Roboto-Regular.ttf", "testdata/Selawik-VF-Subset.ttf"} {
+		raw, e := os.ReadFile(path)
+		if e != nil {
+			t.Fatal(e)
+		}
+		eagerLoader, e := ot.NewLoader(bytes.NewReader(raw))
+		if e != nil {
+			t.Fatal(e)
+		}
+		deferredLoader, e := ot.NewLoader(stableMemory{bytes.NewReader(raw)})
+		if e != nil {
+			t.Fatal(e)
+		}
+		eager, e := NewFont(eagerLoader)
+		if e != nil {
+			t.Fatal(e)
+		}
+		deferred, e := NewFont(deferredLoader)
+		if e != nil {
+			t.Fatal(e)
+		}
+		if eagerLoader.HasTable(ot.MustNewTag("gvar")) {
+			if deferred.lazyGlyf != nil {
+				t.Fatal("variable glyphs unexpectedly deferred")
+			}
+		} else if deferred.lazyGlyf == nil {
+			t.Fatal("static outlines remain eager", path)
+		}
+		a, b := NewFace(eager), NewFace(deferred)
+		for glyph := 0; glyph < eager.nGlyphs; glyph++ {
+			gid := GID(glyph)
+			aa, aok := a.GlyphDataOutline(gid)
+			bb, bok := b.GlyphDataOutline(gid)
+			if aok != bok || !reflect.DeepEqual(aa, bb) {
+				t.Fatalf("outline divergence %s glyph %d", path, glyph)
+			}
+			ae, aok := a.glyphExtentsRaw(gid)
+			be, bok := b.glyphExtentsRaw(gid)
+			if aok != bok || ae != be {
+				t.Fatalf("extents divergence %s glyph %d", path, glyph)
+			}
+			if g := deferred.lazyGlyf; g != nil && (g.bytes > glyfCacheLimit || g.lru.Len() > glyfCacheEntries) {
+				t.Fatal("outline cache exceeded budget")
+			}
+		}
+	}
+}
+func TestDeferredGlyfMalformed(t *testing.T) {
+	if _, e := newLazyGlyf(bytes.NewReader(nil), 10, []uint32{4, 2}); e == nil {
+		t.Fatal("nonmonotone offsets")
+	}
+	for _, spec := range []struct{ size, contours, endpoint int }{{12, 1, 8192}, {2060, 1025, 0}, {glyfRecordLimit + 1, 0, 0}} {
+		raw := make([]byte, spec.size)
+		binary.BigEndian.PutUint16(raw, uint16(spec.contours))
+		if spec.contours > 0 {
+			binary.BigEndian.PutUint16(raw[10+2*(spec.contours-1):], uint16(spec.endpoint))
+		}
+		if _, e := newLazyGlyf(bytes.NewReader(raw), int64(len(raw)), []uint32{0, uint32(len(raw))}); e == nil {
+			t.Fatal("unsupported outline admitted", spec)
+		}
+	}
+	raw := make([]byte, 10)
+	g, e := newLazyGlyf(bytes.NewReader(raw), 10, []uint32{0, 10})
+	if e != nil {
+		t.Fatal(e)
+	}
+	g.r = errorReader{}
+	if _, e = g.glyph(0); e == nil {
+		t.Fatal("read error ignored")
+	}
+	if _, e = g.glyph(5); e == nil {
+		t.Fatal("out-of-range glyph")
+	}
+
+}
+
+type failingGlyphReader struct {
+	r          io.ReaderAt
+	start, end int64
+}
+
+func (r failingGlyphReader) ReadAt(dst []byte, offset int64) (int, error) {
+	if offset < r.end && offset+int64(len(dst)) > r.start {
+		return 0, io.ErrUnexpectedEOF
+	}
+	return r.r.ReadAt(dst, offset)
+}
+func TestDeferredGlyfComponentFailure(t *testing.T) {
+	raw, e := os.ReadFile("testdata/Amiri-Regular.ttf")
+	if e != nil {
+		t.Fatal(e)
+	}
+	loader, _ := ot.NewLoader(stableMemory{bytes.NewReader(raw)})
+	f, e := NewFont(loader)
+	if e != nil {
+		t.Fatal(e)
+	}
+	ordinary, _ := ot.NewLoader(bytes.NewReader(raw))
+	eager, e := NewFont(ordinary)
+	if e != nil {
+		t.Fatal(e)
+	}
+	for id, g := range eager.glyf {
+		data, ok := g.Data.(tables.CompositeGlyph)
+		if !ok || len(data.Glyphs) < 2 {
+			continue
+		}
+		child := int(data.Glyphs[1].GlyphIndex)
+		a, b := f.lazyGlyf.offsets[child], f.lazyGlyf.offsets[child+1]
+		if a == b {
+			continue
+		}
+		f.lazyGlyf.r = failingGlyphReader{f.lazyGlyf.r, int64(a), int64(b)}
+		if _, ok := NewFace(f).GlyphDataOutline(GID(id)); ok {
+			t.Fatal("partial composite outline reported successful", id)
+		}
+		return
+	}
+	t.Fatal("fixture has no suitable composite glyph")
+}

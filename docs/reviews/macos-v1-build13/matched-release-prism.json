      ],
      "tags": [
        "resource-leak",
        "location-corrected"
      ],
      "evidence": "sha = lambda p: hashlib.file_digest(p.open('rb'), 'sha256').hexdigest()",
      "fix": {
        "before": "sha = lambda p: hashlib.file_digest(p.open('rb'), 'sha256').hexdigest()",
        "after": "def sha(p):\n    with p.open('rb') as f:\n        return hashlib.file_digest(f, 'sha256').hexdigest()"
